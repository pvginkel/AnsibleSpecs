@@ -0,0 +1,181 @@
+"""The empty configuration a destroy plans against: a root module with only its declarations.
+
+Each root `*.tf` keeps its `terraform`, `provider` and `variable` blocks, verbatim, and
+loses every other block. With no resource, data source or module left, every resource in
+the state is an orphan Terraform plans to delete, `prevent_destroy` binds nothing, and
+the providers that delete them are configured as the deploy repo configures them.
+
+HCL's native syntax is read only as far as its top level: where a block starts, its
+header, and the brace that closes it. Strings, heredocs, template sequences and comments
+are skipped as units, so a brace inside one never counts.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+from typing import NamedTuple
+
+from .errors import PresyncError
+from .proc import step
+
+KEPT = ("terraform", "provider", "variable")
+
+_IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_-]*")
+_HEREDOC = re.compile(r"<<-?([A-Za-z_][A-Za-z0-9_-]*)[ \t]*\r?\n")
+_SPACE = " \t\r\n"
+
+
+class Block(NamedTuple):
+    """One top-level block: its type, its header as written, and its whole text."""
+
+    type: str
+    header: str
+    text: str
+
+
+def reduce(work: Path) -> None:
+    """Rewrite every root `*.tf` in `work` to its declarations alone."""
+    tf_json = sorted(path.name for path in work.glob("*.tf.json"))
+    if tf_json:
+        raise PresyncError(
+            f"{', '.join(tf_json)}: the destroy reduces native-syntax *.tf only, "
+            "and planning without this file would plan without what it declares"
+        )
+    for source in sorted(work.glob("*.tf")):
+        found = blocks(source.read_text(), source.name)
+        kept = [block.text for block in found if block.type in KEPT]
+        dropped = ", ".join(block.header for block in found if block.type not in KEPT)
+        source.write_text("\n\n".join(kept) + "\n" if kept else "")
+        step(f"{source.name}: keeps {len(kept)} declaration(s), drops {dropped or 'none'}")
+
+
+def blocks(text: str, origin: str) -> list[Block]:
+    """Every top-level block of `text`, in order. Anything else at the top level is refused."""
+    found = []
+    i = _skip_space(text, 0, origin)
+    while i < len(text):
+        start = i
+        kind = _IDENTIFIER.match(text, i)
+        if not kind:
+            raise _unreadable(text, i, origin, "a block type")
+        i = _skip_space(text, kind.end(), origin)
+        while i < len(text) and text[i] != "{":
+            if text[i] == '"':
+                i = _quoted(text, i, origin)
+            elif label := _IDENTIFIER.match(text, i):
+                i = label.end()
+            else:
+                raise _unreadable(text, i, origin, "a block label or `{`")
+            i = _skip_space(text, i, origin)
+        if i == len(text):
+            raise _unreadable(text, start, origin, "a block body")
+        header = " ".join(text[start:i].split())
+        end = _braced(text, i, origin)
+        found.append(Block(kind.group(), header, text[start:end]))
+        i = _skip_space(text, end, origin)
+    return found
+
+
+def _braced(text: str, i: int, origin: str) -> int:
+    """The index just past the `}` that closes the `{` at `i`."""
+    opened = i
+    depth = 0
+    while i < len(text):
+        if text[i] == "{":
+            depth += 1
+            i += 1
+        elif text[i] == "}":
+            depth -= 1
+            i += 1
+            if depth == 0:
+                return i
+        elif text[i] == '"':
+            i = _quoted(text, i, origin)
+        elif text[i] == "#" or text.startswith("//", i):
+            i = _line_end(text, i)
+        elif text.startswith("/*", i):
+            i = _comment_end(text, i, origin)
+        elif text.startswith("<<", i) and (heredoc := _HEREDOC.match(text, i)):
+            i = _heredoc(text, heredoc, origin)
+        else:
+            i += 1
+    raise _unreadable(text, opened, origin, "the `}` that closes this `{`")
+
+
+def _quoted(text: str, i: int, origin: str) -> int:
+    """The index just past the closing quote of the quoted template opened at `i`."""
+    opened = i
+    i += 1
+    while i < len(text):
+        if text[i] == "\\":
+            i += 2
+        elif text[i] == '"':
+            return i + 1
+        elif text[i] == "\n":
+            break
+        else:
+            i = _template(text, i, origin)
+    raise _unreadable(text, opened, origin, "the closing quote of this string")
+
+
+def _heredoc(text: str, opener: re.Match[str], origin: str) -> int:
+    """The index just past the closing marker of the heredoc `opener` opened."""
+    marker = opener.group(1)
+    i = opener.end()
+    line_start = True
+    while i < len(text):
+        if line_start:
+            end = _line_end(text, i)
+            if text[i:end].strip() == marker:
+                return end
+            line_start = False
+        if text[i] == "\n":
+            i += 1
+            line_start = True
+        else:
+            i = _template(text, i, origin)
+    raise _unreadable(text, opener.start(), origin, f"the {marker} that closes this heredoc")
+
+
+def _template(text: str, i: int, origin: str) -> int:
+    """Past one unit of template text: an escaped sequence, an interpolation, or a character."""
+    if text.startswith(("$${", "%%{"), i):
+        return i + 3
+    if text.startswith(("${", "%{"), i):
+        return _braced(text, i + 1, origin)
+    return i + 1
+
+
+def _skip_space(text: str, i: int, origin: str) -> int:
+    while i < len(text):
+        if text[i] in _SPACE:
+            i += 1
+        elif text[i] == "#" or text.startswith("//", i):
+            i = _line_end(text, i)
+        elif text.startswith("/*", i):
+            i = _comment_end(text, i, origin)
+        else:
+            break
+    return i
+
+
+def _line_end(text: str, i: int) -> int:
+    end = text.find("\n", i)
+    return len(text) if end < 0 else end
+
+
+def _comment_end(text: str, i: int, origin: str) -> int:
+    end = text.find("*/", i + 2)
+    if end < 0:
+        raise _unreadable(text, i, origin, "the `*/` that closes this comment")
+    return end + 2
+
+
+def _unreadable(text: str, i: int, origin: str, expected: str) -> PresyncError:
+    line = text.count("\n", 0, i) + 1
+    found = text[i : _line_end(text, i)].strip()[:40]
+    return PresyncError(
+        f"{origin}:{line}: expected {expected} at {found!r}: "
+        "the destroy cannot reduce this file to its declarations"
+    )
diff --git a/argocd-hook/presync/destroy.py b/argocd-hook/presync/destroy.py
new file mode 100644
index 0000000..d6cc8ca
--- /dev/null
+++ b/argocd-hook/presync/destroy.py
@@ -0,0 +1,276 @@
+"""`python3 -m presync.destroy <repo> <revision> <stage> [--apply]`: the Destroy Stage run.
+
+It deletes what a retired stage of a deploy repo left behind: the resources its Terraform
+state holds, then the stage's folder in the state repository (argo-cd D66). The Destroy
+Stage pipeline runs it as a one-off Job in `argocd-hooks`, under the sync hook's
+ServiceAccount and Secret. Its log and its exit code are the build's evidence.
+
+Without `--apply` it is a dry run, which writes nothing: no state, no state lock, no
+commit.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import socket
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+from typing import Any, NamedTuple
+
+from . import backend, declarations, kubeconfig, terraform
+from .environment import require
+from .errors import PresyncError
+from .git import clone_at_revision, clone_branch, push
+from .proc import run, step
+
+KUBERNETES = "registry.terraform.io/hashicorp/kubernetes"
+
+# An apply removes the state repository's argocd/<repo>/<stage>/, so the repo name and
+# the stage are each exactly one path segment.
+SEGMENT = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
+
+# Selects a local copy of the state for the dry run's plan, which therefore cannot
+# reach the state repository.
+DRY_RUN_OVERRIDE = "presync_dry_run_override.tf"
+
+
+class Forgotten(NamedTuple):
+    """A Kubernetes object in the state that lived in a namespace, and that namespace."""
+
+    address: str
+    namespace: str
+
+
+def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
+    """What the Destroy Stage pipeline's Job supplies."""
+    parser = argparse.ArgumentParser(
+        prog="presync.destroy",
+        description="Destroy what a retired stage of a deploy repo left behind.",
+    )
+    parser.add_argument("repo", help="clone URL of the deploy repo")
+    parser.add_argument("revision", help="the exact SHA to clone")
+    parser.add_argument("stage", help="the retired stage, e.g. dev")
+    parser.add_argument(
+        "--apply",
+        action="store_true",
+        help="destroy and remove the state; without it, a dry run that writes nothing",
+    )
+    return parser.parse_args(argv)
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = parse_args(argv)
+    for segment in (backend.repo_name(args.repo), args.stage):
+        if not SEGMENT.fullmatch(segment):
+            raise PresyncError(f"{segment!r} is not one path segment, as a repo or stage is")
+    require("GIT_USERNAME")
+    require("GITHUB_TOKEN")
+    mode = "an apply" if args.apply else "a dry run, which writes nothing"
+    step(f"destroying {args.stage} of {args.repo}: {mode}")
+
+    run_dir = Path(tempfile.mkdtemp(prefix="presync-"))
+    kubeconfig.provide(run_dir / "kubeconfig")
+    # The stage's namespace went with its Application and is not an input of the run, so
+    # Terraform gets the stage alone.
+    os.environ["TF_VAR_stage"] = args.stage
+
+    clone = run_dir / "deploy"
+    clone_at_revision(args.repo, args.revision, clone)
+    work = terraform.working_dir(clone)
+    declarations.reduce(work)
+    tfvars = stage_tfvars(clone, args.stage)
+
+    key = backend.state_key(args.repo, args.stage)
+    url = backend.backend_url(backend.provide(), key)
+    _declared(work, "init", "-input=false", "-no-color", *backend.config_flags(url))
+    state = pull(work)
+    if state is None:
+        step(f"the backend holds no state at {key}: nothing to destroy")
+    elif args.apply:
+        destroy(work, state, tfvars, run_dir)
+    else:
+        dry_run(work, state, tfvars, run_dir)
+
+    remove_state_dir(args.repo, args.stage, args.apply, run_dir)
+    if not args.apply:
+        step("dry run: nothing was written")
+    return 0
+
+
+def stage_tfvars(clone: Path, stage: str) -> list[Path]:
+    """The stage's tfvars, or none once the clone no longer carries `config/<stage>/`."""
+    if not (clone / terraform.CONFIG_DIR / stage).is_dir():
+        step(f"the clone has no {terraform.CONFIG_DIR}/{stage}/: planning without its tfvars")
+        return []
+    return terraform.var_files(clone, stage)
+
+
+def pull(work: Path) -> dict[str, Any] | None:
+    """The stage's state as the backend holds it, or None where it holds none."""
+    pulled = json.loads(_terraform(work, "state", "pull", stdout=subprocess.PIPE).stdout)
+    # Where the http backend holds no state, `state pull` prints an empty one with no
+    # lineage, which every state Terraform has written carries.
+    return pulled if pulled["lineage"] else None
+
+
+def dry_run(work: Path, state: dict[str, Any], tfvars: list[Path], run_dir: Path) -> None:
+    """Show the plan an apply would make once it has forgotten the namespaced objects."""
+    forgotten = namespaced(state)
+    report(forgotten, "an apply forgets")
+    remaining = without(state, {item.address for item in forgotten})
+    if not remaining["resources"]:
+        step("the state lists no resources to destroy: an apply destroys nothing")
+        return
+
+    copy = run_dir / "dry-run.tfstate"
+    copy.write_text(json.dumps(remaining))
+    (work / DRY_RUN_OVERRIDE).write_text(
+        f'terraform {{\n  backend "local" {{\n    path = {json.dumps(str(copy))}\n  }}\n}}\n'
+    )
+    step(f"planning against {copy}: a local copy of the state, as an apply plans against it")
+    _declared(work, "init", "-input=false", "-no-color", "-reconfigure")
+    _declared(work, "plan", "-input=false", "-no-color", *_var_flags(tfvars))
+
+
+def destroy(work: Path, state: dict[str, Any], tfvars: list[Path], run_dir: Path) -> None:
+    """Forget the namespaced objects, destroy the rest, and confirm the state is empty."""
+    forgotten = namespaced(state)
+    report(forgotten, "forgetting")
+    if forgotten:
+        _terraform(work, "state", "rm", "-no-color", *[item.address for item in forgotten])
+
+    if without(state, {item.address for item in forgotten})["resources"]:
+        plan = run_dir / "destroy.tfplan"
+        _declared(work, "plan", "-input=false", "-no-color", f"-out={plan}", *_var_flags(tfvars))
+        _terraform(work, "apply", "-input=false", "-no-color", str(plan))
+    else:
+        step("the state lists no resources to destroy")
+
+    left = _terraform(work, "state", "list", "-no-color", stdout=subprocess.PIPE).stdout.split()
+    if left:
+        raise PresyncError(f"the state still lists {', '.join(left)}: its folder stays")
+    step("the state lists no resources")
+
+
+def remove_state_dir(repo: str, stage: str, apply: bool, run_dir: Path) -> None:
+    """Remove the stage's folder from the state repository, or name it in a dry run."""
+    folder = backend.state_dir(repo, stage)
+    clone = run_dir / "state"
+    clone_branch(backend.STATE_REPO_URL, backend.STATE_REPO_REF, clone)
+    if not (clone / folder).exists():
+        step(f"the state repository has no {folder}/: nothing to remove")
+        return
+    if not apply:
+        step(f"an apply removes {folder}/ from the state repository")
+        return
+
+    git = ["git", "-C", str(clone)]
+    run([*git, "rm", "-r", "--quiet", folder])
+    # Named after the pod, as terraform-backend-git's own commits to the repository are.
+    identity = [
+        "-c",
+        "user.name=argocd-hook",
+        "-c",
+        f"user.email=argocd-hook@{socket.gethostname()}",
+    ]
+    message = f"Remove {folder}/: {stage} of {backend.repo_name(repo)} destroyed"
+    run([*git, *identity, "commit", "--quiet", "-m", message])
+    push(clone, backend.STATE_REPO_REF)
+    step(f"removed {folder}/ from the state repository")
+
+
+def namespaced(state: dict[str, Any]) -> list[Forgotten]:
+    """The Kubernetes objects in `state` that lived in a namespace, by instance address.
+
+    Each lived in the stage's own namespace and went with it when the Application was
+    pruned. The run's ServiceAccount holds no grant there any more, so reading or
+    deleting one is refused with 403: a destroy drops them from the state instead.
+    """
+    found: dict[str, Forgotten] = {}
+    for resource in state["resources"]:
+        if resource["mode"] != "managed" or resource["provider"].split('"')[1] != KUBERNETES:
+            continue
+        for instance in resource["instances"]:
+            namespace = _namespace(instance["attributes"])
+            if namespace:
+                at = address(resource, instance)
+                found.setdefault(at, Forgotten(at, namespace))
+    return list(found.values())
+
+
+def without(state: dict[str, Any], addresses: set[str]) -> dict[str, Any]:
+    """`state` as `terraform state rm` leaves it once `addresses` are dropped."""
+    resources = []
+    for resource in state["resources"]:
+        instances = [i for i in resource["instances"] if address(resource, i) not in addresses]
+        if instances:
+            resources.append({**resource, "instances": instances})
+    return {**state, "resources": resources}
+
+
+def address(resource: dict[str, Any], instance: dict[str, Any]) -> str:
+    """The instance's address, as `terraform state list` prints it."""
+    at = f"{resource['type']}.{resource['name']}"
+    if resource["mode"] == "data":
+        at = f"data.{at}"
+    if resource.get("module"):
+        at = f"{resource['module']}.{at}"
+    if "index_key" in instance:
+        key = instance["index_key"]
+        at += f"[{key}]" if isinstance(key, int) else f"[{json.dumps(key)}]"
+    return at
+
+
+def report(forgotten: list[Forgotten], verb: str) -> None:
+    if not forgotten:
+        step("the state holds no namespaced Kubernetes object: nothing to forget")
+        return
+    step(
+        f"{verb} {len(forgotten)} namespaced Kubernetes object(s), already gone with "
+        "their namespace: dropped from the state, never deleted"
+    )
+    for item in forgotten:
+        step(f"  {item.address} (namespace {item.namespace})")
+
+
+def _namespace(attributes: dict[str, Any]) -> str:
+    # A typed resource carries its one `metadata` block; `kubernetes_manifest` carries
+    # the object it manages, which the state stores as a dynamic value.
+    metadata = attributes.get("metadata")
+    if metadata:
+        return metadata[0].get("namespace") or ""
+    managed = (attributes.get("object") or {}).get("value") or {}
+    return managed.get("metadata", {}).get("namespace") or ""
+
+
+def _var_flags(tfvars: list[Path]) -> list[str]:
+    return [f"-var-file={path.absolute()}" for path in tfvars]
+
+
+def _terraform(work: Path, *argv: str, **kwargs: Any) -> subprocess.CompletedProcess[str]:
+    return run(["terraform", f"-chdir={work}", *argv], **kwargs)
+
+
+def _declared(work: Path, *argv: str) -> None:
+    """Run `terraform <argv>`, whose failure means the empty configuration does not stand."""
+    try:
+        _terraform(work, *argv)
+    except PresyncError as error:
+        raise PresyncError(
+            f"the empty configuration, {terraform.TERRAFORM_DIR}/ reduced to its terraform, "
+            f"provider and variable blocks, does not {argv[0]} (Terraform's error is above): "
+            f"{error}"
+        ) from error
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except PresyncError as error:
+        print(f"presync: {error}", file=sys.stderr)
+        sys.exit(1)
