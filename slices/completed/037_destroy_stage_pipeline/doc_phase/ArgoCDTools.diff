+// Destroys what a retired stage of a deploy repo left behind (argo-cd D66): the resources its
+// Terraform state still holds and its argocd/<repo>/<stage>/ folder in TerraformState, through the
+// argocd-hook image's destroy mode run as a Job in argocd-hooks, then its config/<stage>/ folder,
+// removed from the deploy repo's main. Started by hand, and a dry run unless APPLY is set.
+//
+// It cleans up after an undeployed stage and undeploys nothing: while ArgoCDDeploy's registry or a
+// live Application in argocd-prd still deploys the stage, the build fails before any Job starts. A
+// dry run plans the destroy, names the two folders an apply removes, and writes nothing. An apply
+// destroys from the plan it saved, in the same Job, with no input step. A re-run finishes what a
+// build that stopped halfway left.
+//
+// Its kubectl calls run as jenkins-prd/destroy-stage, never as the agents' shared default
+// ServiceAccount, which gains nothing from this job. destroy-stage may run Jobs in argocd-hooks and
+// read Applications in argocd-prd, and nothing else. The Job runs as the sync hook's own
+// tf-presync, with the hook's credentials.
+//
+// Controller config:
+//   - Job: IaC/Destroy Stage
+//   - SCM: pvginkel/ArgoCDTools, branch main
+//   - Script Path: Jenkinsfile.destroy-stage
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+/**
+ * A repository URL as the guard compares it. GitHub serves a repo under any case of its name, with
+ * or without `.git`, so a URL spelled any of those ways deploys the same repo.
+ */
+@NonCPS
+String repoKey(String url) {
+    String key = url.toLowerCase()
+    if (key.endsWith('/')) {
+        key = key.substring(0, key.length() - 1)
+    }
+    if (key.endsWith('.git')) {
+        key = key.substring(0, key.length() - '.git'.length())
+    }
+    return key
+}
+
+/**
+ * The entries of ArgoCDDeploy's registry that deploy `stage` of the repo `repoKey` names, as
+ * their YAML paths.
+ *
+ * @param values  releases/values.yaml, as readYaml parses it.
+ */
+@NonCPS
+List<String> registryEntries(Map values, String repo, String stage) {
+    List<String> found = []
+    Map apps = values.apps ?: [:]
+    apps.each { key, app ->
+        Map stages = app.stages ?: [:]
+        if (repoKey(app.repo ?: '') == repo && stages.containsKey(stage)) {
+            found << "apps.${key}.stages.${stage}".toString()
+        }
+    }
+    return found
+}
+
+/**
+ * The Applications that deploy `stage` of the repo `repoKey` names: one of their sources is the
+ * repo, and one carries the Helm parameter hook.stage set to `stage`. An upstream app's
+ * Application is multi-source, its hook parameters on its deploy repo's chart source.
+ *
+ * @param list  `kubectl get applications -o json`, as readJSON parses it.
+ */
+@NonCPS
+List<String> liveApplications(Map list, String repo, String stage) {
+    List<String> found = []
+    for (Map application in list.items) {
+        Map spec = application.spec
+        List sources = spec.source ? [spec.source] : (spec.sources ?: [])
+        boolean sourcesRepo = sources.any { source -> repoKey(source.repoURL ?: '') == repo }
+        boolean setsStage = sources.any { source ->
+            (source.helm?.parameters ?: []).any { parameter -> parameter.name == 'hook.stage' && parameter.value == stage }
+        }
+        if (sourcesRepo && setsStage) {
+            found << "${application.metadata.namespace}/${application.metadata.name}".toString()
+        }
+    }
+    return found
+}
+
+/**
+ * Runs the argocd-hook image's destroy mode for `stage` of pvginkel/`repo` at `revision`, as a
+ * one-off Job in argocd-hooks, shows its log, and fails the build unless the run exits 0.
+ *
+ * The destroy-stage Role in argocd-hooks grants Jobs get, create and delete, and pods and their
+ * logs read: no patch, exec or watch. So the Job's name is fresh per build, and only kubectl
+ * steps that get, list, create, delete or read logs drive it.
+ */
+void runDestroyJob(String repo, String stage, String revision, boolean apply) {
+    String namespace = 'argocd-hooks'
+    // tf-presync-<namespace> is the sync hook's name for its Jobs in the same namespace.
+    String job = "destroy-stage-${env.BUILD_NUMBER}"
+    String args = "\"https://github.com/pvginkel/${repo}.git\", \"${revision}\", \"${stage}\"" +
+        (apply ? ', "--apply"' : '')
+    try {
+        // The manifest names its namespace: startJob otherwise puts the Job in the agent's own,
+        // where destroy-stage holds nothing.
+        kubectl.startJob("""\
+            apiVersion: batch/v1
+            kind: Job
+            metadata:
+              name: ${job}
+              namespace: ${namespace}
+              labels:
+                app.kubernetes.io/name: destroy-stage
+                app.kubernetes.io/managed-by: jenkins
+            spec:
+              # A run that failed is run again by a new build, not retried inside this one.
+              backoffLimit: 0
+              activeDeadlineSeconds: 1800
+              template:
+                spec:
+                  serviceAccountName: tf-presync
+                  restartPolicy: Never
+                  containers:
+                    - name: destroy
+                      # The latest hook build: the Charts pin predates the destroy mode.
+                      image: registry:5000/argocd-hook:latest
+                      imagePullPolicy: Always
+                      # The image's entrypoint is the sync hook's.
+                      command: ["python3", "-m", "presync.destroy"]
+                      args: [${args}]
+                      envFrom:
+                        - secretRef:
+                            name: argocd-hook-credentials
+            """.stripIndent())
+        kubectl.waitForJobContainer(job, 'destroy', namespace)
+        String pod = kubectl.getJobPodName(job, namespace)
+        kubectl.savePodLogs(pod, 'destroy', namespace, 'destroy.log')
+        sh 'cat destroy.log'
+
+        String exitCode = kubectl.getContainerExitCode(pod, 'destroy', namespace)
+        if (!exitCode) {
+            String reason = kubectl.getJobFailReason(job, namespace)
+            error("The destroy Job ${job} ended without an exit code (pod ${pod}${reason ? ", reason ${reason}" : ''})")
+        } else if (exitCode != '0') {
+            // A failed run's last log line is `presync: <reason>`.
+            String[] lines = readFile('destroy.log').trim().split('\n')
+            error("The destroy Job ${job} failed with exit code ${exitCode}: ${lines[lines.length - 1]}")
+        }
+    } finally {
+        kubectl.deleteJob(job, namespace)
+    }
+}
