+                        if (!params.REPO) {
+                            error('REPO is empty: name the deploy repo as GitHub spells it, e.g. FieldnotesDeploy. ' +
+                                "A build without parameters, as the job's first is, only registers them.")
+                        }
+                        if (!params.STAGE) {
+                            error('STAGE is empty: name the retired stage, e.g. dev.')
+                        }
+                        // Each is one path segment: of the clone URL, of the Job's state folder and
+                        // of config/<stage>/.
+                        if (!(params.REPO ==~ /[A-Za-z0-9][A-Za-z0-9._-]*/)) {
+                            error("REPO must be a repo name, as GitHub spells it; got '${params.REPO}'")
+                        }
+                        if (!(params.STAGE ==~ /[A-Za-z0-9][A-Za-z0-9._-]*/)) {
+                            error("STAGE must be a stage name, e.g. dev; got '${params.STAGE}'")
+                        }
+                        currentBuild.description = "${params.APPLY ? 'apply' : 'dry run'}: ${params.REPO} ${params.STAGE}"
+
+                        withCredentials([usernamePassword(
+                            credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10',
+                            usernameVariable: 'GIT_USER',
+                            passwordVariable: 'GIT_TOKEN')]) {
+                            sh """
+                                set +x
+                                set -eu
+                                curl -fsS -H "Authorization: Bearer \$GIT_TOKEN" -o github-repo.json \\
+                                    'https://api.github.com/repos/pvginkel/${params.REPO}'
+                                curl -fsS -H "Authorization: Bearer \$GIT_TOKEN" -H 'Accept: application/vnd.github.sha' \\
+                                    -o github-main.sha 'https://api.github.com/repos/pvginkel/${params.REPO}/commits/main'
+                            """
+                        }
+                        // GitHub serves a repo under any case of its name, and TerraformState's paths
+                        // are case-sensitive: a REPO in another case finds no state, and an apply
+                        // would still remove config/<stage>/.
+                        String spelled = readJSON(file: 'github-repo.json', returnPojo: true).name
+                        if (spelled != params.REPO) {
+                            error("GitHub spells pvginkel/${params.REPO} as ${spelled}, the spelling the stage's " +
+                                "state is filed under: run with REPO=${spelled}")
+                        }
+                        revision = readFile('github-main.sha').trim()
+                        echo "pvginkel/${params.REPO}'s main is at ${revision}."
+
+                        String repo = repoKey("https://github.com/pvginkel/${params.REPO}".toString())
+                        List<String> deployedBy = []
+                        List<String> entries = registryEntries(
+                            readYaml(file: 'ArgoCDDeploy/releases/values.yaml'), repo, params.STAGE)
+                        for (int i = 0; i < entries.size(); i++) {
+                            deployedBy << "the registry entry ${entries[i]} in ArgoCDDeploy's releases/values.yaml on main".toString()
+                        }
+                        sh 'kubectl get applications -n argocd-prd -o json > applications.json'
+                        List<String> applications = liveApplications(
+                            readJSON(file: 'applications.json', returnPojo: true), repo, params.STAGE)
+                        for (int i = 0; i < applications.size(); i++) {
+                            deployedBy << "the live Application ${applications[i]}".toString()
+                        }
+                        if (deployedBy) {
+                            error("${params.STAGE} of pvginkel/${params.REPO} is still deployed, by " +
+                                "${deployedBy.join(' and ')}. This build cleans up after an undeployed stage: " +
+                                'delete its registry entry and prune its Application first.')
+                        }
+                        echo "Neither the registry nor a live Application deploys ${params.STAGE} of pvginkel/${params.REPO}."
+                    }
+                }
+            }
+        }
+
+        stage('Plan destroy') {
+            when {
+                expression { !params.APPLY }
+            }
+            steps {
+                container('k8s') {
+                    script {
+                        runDestroyJob(params.REPO, params.STAGE, revision, false)
+
+                        String status
+                        withCredentials([usernamePassword(
+                            credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10',
+                            usernameVariable: 'GIT_USER',
+                            passwordVariable: 'GIT_TOKEN')]) {
+                            status = sh(script: """
+                                set +x
+                                set -eu
+                                curl -sS -o /dev/null -w '%{http_code}' -H "Authorization: Bearer \$GIT_TOKEN" \\
+                                    'https://api.github.com/repos/pvginkel/${params.REPO}/contents/config/${params.STAGE}?ref=${revision}'
+                            """, returnStdout: true).trim()
+                        }
+                        if (status == '200') {
+                            echo "An apply removes config/${params.STAGE}/ from pvginkel/${params.REPO}'s main. This dry run pushed nothing."
+                        } else if (status == '404') {
+                            echo "pvginkel/${params.REPO} has no config/${params.STAGE}/ at ${revision}: an apply removes nothing there."
+                        } else {
+                            error("GitHub answered ${status} for config/${params.STAGE}/ of pvginkel/${params.REPO} at ${revision}")
+                        }
+                    }
+                }
+            }
+        }
+
+        stage('Destroy Terraform resources and state') {
+            when {
+                expression { params.APPLY }
+            }
+            steps {
+                container('k8s') {
+                    script {
+                        runDestroyJob(params.REPO, params.STAGE, revision, true)
+                    }
+                }
+            }
+        }
+
+        // After the Job has succeeded: until then the stage's state exists, and a re-run plans with
+        // the tfvars this folder holds.
+        stage('Remove config folder') {
+            when {
+                expression { params.APPLY }
+            }
+            steps {
+                container('k8s') {
+                    withCredentials([usernamePassword(
+                        credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10',
+                        usernameVariable: 'GIT_USER',
+                        passwordVariable: 'GIT_TOKEN')]) {
+                        // set +x: this is the line where the shell expands the token. The push
+                        // reuses the remote the clone stores, so nothing after it echoes the token.
+                        sh """
+                            set +x
+                            set -eu
+                            git clone --quiet --depth 1 --branch main \\
+                                "https://\$GIT_USER:\$GIT_TOKEN@github.com/pvginkel/${params.REPO}.git" deploy
+                            if [ ! -e 'deploy/config/${params.STAGE}' ]; then
+                                echo 'pvginkel/${params.REPO} has no config/${params.STAGE}/ on main: nothing to remove.'
+                                exit 0
+                            fi
+                            git -C deploy config user.name 'jenkins'
+                            git -C deploy config user.email 'jenkins@webathome.org'
+                            git -C deploy rm -r --quiet -- 'config/${params.STAGE}'
+                            git -C deploy commit --quiet -m 'Remove config/${params.STAGE}/: ${params.STAGE} destroyed by ${env.JOB_NAME} #${env.BUILD_NUMBER}'
+                            git -C deploy push --quiet origin HEAD:main
+                            echo "pvginkel/${params.REPO} \$(git -C deploy rev-parse HEAD) removes config/${params.STAGE}/."
+                        """
+                    }
+                }
+            }
+        }
+    }
+
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+}
