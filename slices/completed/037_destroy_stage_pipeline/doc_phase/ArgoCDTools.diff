+"""The empty configuration: a root module's declarations, and nothing a brace could hide."""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import shutil
+import tempfile
+import unittest
+from pathlib import Path
+
+from presync.declarations import blocks, reduce
+from presync.errors import PresyncError
+
+# Every way a brace can sit inside a block without opening or closing one.
+TRICKY = """\
+# A comment with a } and a {
+terraform {
+  required_providers {
+    github = {
+      source = "integrations/github"
+    }
+  }
+
+  backend "http" {}
+}
+
+resource "github_repository_webhook" "argocd" {
+  count = var.manage_webhook ? 1 : 0 // }
+
+  /* a { block comment
+     that } spans lines */
+  configuration {
+    url    = "https://example.invalid/}{"
+    secret = "${jsonencode({ a = "}" })}"
+    name   = "$${not_an_interpolation"
+    flag   = "%{ if var.manage_webhook }on%{ else }off%{ endif }"
+    quoted = "a \\" and a } after it"
+  }
+}
+
+data "github_repository" "this" {
+  full_name = <<EOT
+{
+}
+${var.repository} }
+EOT
+}
+
+locals {
+  policy = <<-POLICY
+    {"Statement": [{
+    }]}
+    POLICY
+}
+
+variable   "manage_webhook"   {
+  type    = bool
+  default = false
+}
+
+module "cache" { source = "./modules/cache" }
+
+output "url" {
+  value = "${local.policy}}"
+}
+
+provider "github" {
+  owner = "pvginkel"
+}
+"""
+
+
+class BlocksTests(unittest.TestCase):
+    def test_each_top_level_block_is_found_whole_whatever_its_body_holds(self) -> None:
+        found = blocks(TRICKY, "main.tf")
+
+        self.assertEqual(
+            [block.header for block in found],
+            [
+                "terraform",
+                'resource "github_repository_webhook" "argocd"',
+                'data "github_repository" "this"',
+                "locals",
+                'variable "manage_webhook"',
+                'module "cache"',
+                'output "url"',
+                'provider "github"',
+            ],
+        )
+        self.assertEqual(
+            found[4].text,
+            'variable   "manage_webhook"   {\n  type    = bool\n  default = false\n}',
+        )
+        self.assertEqual(found[7].text, 'provider "github" {\n  owner = "pvginkel"\n}')
+
+    def test_an_attribute_at_the_top_level_is_refused_by_file_and_line(self) -> None:
+        with self.assertRaises(PresyncError) as raised:
+            blocks('variable "a" {}\n\nname = "x"\n', "main.tf")
+
+        self.assertIn("main.tf:3:", str(raised.exception))
+
+    def test_a_block_that_never_closes_is_refused(self) -> None:
+        with self.assertRaises(PresyncError) as raised:
+            blocks('variable "a" {\n  default = "}"\n', "variables.tf")
+
+        self.assertIn("variables.tf:1:", str(raised.exception))
+
+    def test_a_heredoc_that_never_closes_is_refused(self) -> None:
+        with self.assertRaises(PresyncError):
+            blocks("locals {\n  a = <<EOT\n}\n", "main.tf")
+
+
+class ReduceTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.work = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, self.work)
+
+    def reduce(self) -> str:
+        reported = io.StringIO()
+        with contextlib.redirect_stderr(reported):
+            reduce(self.work)
+        return reported.getvalue()
+
+    def test_every_root_file_keeps_its_terraform_provider_and_variable_blocks(self) -> None:
+        (self.work / "main.tf").write_text(TRICKY)
+
+        self.reduce()
+
+        kept = [block.header for block in blocks((self.work / "main.tf").read_text(), "main.tf")]
+        self.assertEqual(kept, ["terraform", 'variable "manage_webhook"', 'provider "github"'])
+
+    def test_declarations_split_across_files_are_each_kept_where_they_are(self) -> None:
+        # KubeCoderDeploy's layout: providers.tf reads variables variables.tf declares.
+        providers = (
+            'terraform {\n  backend "http" {}\n}\n\n'
+            'provider "homelab" {\n  zfs_pools = var.zfs_pools\n}\n'
+        )
+        variables = 'variable "zfs_pools" {\n  type = map(string)\n}\n'
+        (self.work / "providers.tf").write_text(providers)
+        (self.work / "variables.tf").write_text(variables)
+        (self.work / "storage.tf").write_text('resource "homelab_zfs_dataset" "this" {}\n')
+
+        reported = self.reduce()
+
+        self.assertEqual((self.work / "providers.tf").read_text(), providers)
+        self.assertEqual((self.work / "variables.tf").read_text(), variables)
+        self.assertEqual((self.work / "storage.tf").read_text(), "")
+        self.assertIn(
+            'storage.tf: keeps 0 declaration(s), drops resource "homelab_zfs_dataset" "this"',
+            reported,
+        )
+
+    def test_a_child_modules_files_are_left_alone(self) -> None:
+        module = self.work / "modules/data/main.tf"
+        module.parent.mkdir(parents=True)
+        module.write_text('resource "terraform_data" "this" {}\n')
+
+        self.reduce()
+
+        self.assertEqual(module.read_text(), 'resource "terraform_data" "this" {}\n')
+
+    def test_a_json_configuration_file_is_refused(self) -> None:
+        (self.work / "main.tf").write_text('variable "a" {}\n')
+        (self.work / "providers.tf.json").write_text("{}\n")
+
+        with self.assertRaises(PresyncError) as raised:
+            self.reduce()
+
+        self.assertIn("providers.tf.json", str(raised.exception))
+        self.assertEqual((self.work / "main.tf").read_text(), 'variable "a" {}\n')
