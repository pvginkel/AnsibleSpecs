+def resource(
+    kind: str, name: str, provider: str, *instances: dict[str, Any], **extra: Any
+) -> dict[str, Any]:
+    """A resource as a version 4 state lists it."""
+    return {
+        "mode": "managed",
+        "type": kind,
+        "name": name,
+        "provider": provider,
+        "instances": list(instances),
+        **extra,
+    }
+
+
+def metadata(name: str, namespace: str = "") -> dict[str, Any]:
+    """A typed Kubernetes resource's attributes; cluster-scoped kinds carry no namespace."""
+    block: dict[str, Any] = {"name": name}
+    if namespace:
+        block["namespace"] = namespace
+    return {"attributes": {"metadata": [block]}}
