+
+
+def clone_branch(repo_url: str, branch: str, dest: Path) -> None:
+    """Check out the tip of `repo_url`'s `branch` in `dest`, which must not exist yet."""
+    _clone(repo_url, branch, dest)
+
+
+def push(clone: Path, branch: str) -> None:
