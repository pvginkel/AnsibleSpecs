+            kubeconfig.SERVICE_ACCOUNT_ENV: str(account),
+            "KUBERNETES_SERVICE_HOST": "127.0.0.1",
+            "KUBERNETES_SERVICE_PORT": "6443",
+            "CHECKPOINT_DISABLE": "1",
+        }
+
+    def destroy(self, *argv: str, sha: str = "") -> str:
+        """Run a destroy of the origin at `sha` in a run dir of its own, returning what it
+        reported."""
+        if any(self.run_dir.iterdir()):
+            self.runs += 1
+            self.run_dir = self.tmp / f"run-{self.runs}"
