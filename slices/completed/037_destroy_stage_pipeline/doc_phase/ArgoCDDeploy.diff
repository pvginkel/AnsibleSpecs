+def reaches(subject, namespace, name):
+    """Whether a binding subject takes in the ServiceAccount namespace/name."""
+    kind = subject.get("kind")
+    if kind == "ServiceAccount":
+        return (subject.get("namespace"), subject.get("name")) == (namespace, name)
+    if kind == "User":
+        return subject.get("name") == f"system:serviceaccount:{namespace}:{name}"
+    if kind == "Group":
+        return subject.get("name") in (
+            "system:authenticated",
+            "system:serviceaccounts",
+            f"system:serviceaccounts:{namespace}",
+        )
+    return False
+
+
+def bindings_reaching(docs, namespace, name):
+    return [
+        doc
+        for doc in docs
+        if doc["kind"] in ("ClusterRoleBinding", "RoleBinding")
+        and any(reaches(subject, namespace, name) for subject in doc.get("subjects", []))
+    ]
+
+
+def check_destroy_stage_rbac(docs):
+    """The Destroy Stage identity holds two namespaced grants and nothing else (D66, Ruling D1)."""
+    identity = f"{DESTROY_STAGE['namespace']}/{DESTROY_STAGE['name']}"
+    bindings = bindings_reaching(docs, DESTROY_STAGE["namespace"], DESTROY_STAGE["name"])
+    placed = sorted(
+        f"{binding['kind']}/{binding['metadata']['name']} -> "
+        f"{binding['metadata'].get('namespace') or 'cluster-wide'}"
+        for binding in bindings
+    )
+    check(
+        sorted((b["kind"], b["metadata"].get("namespace")) for b in bindings)
+        == sorted(("RoleBinding", namespace) for namespace in DESTROY_STAGE_GRANTS),
+        f"{identity} is bound by {placed}, not by one RoleBinding in each of "
+        f"{sorted(DESTROY_STAGE_GRANTS)}",
+    )
+    for binding in bindings:
+        namespace = binding["metadata"].get("namespace")
+        where = f"{binding['kind']}/{binding['metadata']['name']} in {namespace or 'no namespace'}"
+        check(
+            binding.get("subjects") == [DESTROY_STAGE],
+            f"{where} binds {binding.get('subjects')!r}, not {identity} alone",
+        )
+        ref = binding.get("roleRef", {})
+        role = next(
+            (
+                doc
+                for doc in docs
+                if doc["kind"] == "Role"
+                and doc["metadata"]["name"] == ref.get("name")
+                and doc["metadata"].get("namespace") == namespace
+            ),
+            None,
+        )
+        check(
+            ref.get("kind") == "Role" and role is not None,
+            f"{where} names {ref!r}, not a Role this chart creates beside it",
+        )
+        if ref.get("kind") != "Role" or role is None or namespace not in DESTROY_STAGE_GRANTS:
+            continue
+        held = {
+            (group, resource, verb)
+            for rule in role.get("rules", [])
+            for group in rule.get("apiGroups", [])
+            for resource in rule.get("resources", [])
+            for verb in rule.get("verbs", [])
+        }
+        wanted = DESTROY_STAGE_GRANTS[namespace]
+        check(
+            held == wanted,
+            f"Role/{ref['name']} in {namespace} grants {sorted(held - wanted)} beyond what the "
+            f"Destroy Stage pipeline uses and lacks {sorted(wanted - held)}",
+        )
+        shared = sorted(
+            doc["metadata"]["name"]
+            for doc in docs
+            if doc is not binding
+            and doc["kind"] == "RoleBinding"
+            and doc["metadata"].get("namespace") == namespace
+            and doc.get("roleRef", {}).get("kind") == "Role"
+            and doc["roleRef"].get("name") == ref["name"]
+        )
+        check(not shared, f"Role/{ref['name']} in {namespace} is also bound by {shared}")
+
