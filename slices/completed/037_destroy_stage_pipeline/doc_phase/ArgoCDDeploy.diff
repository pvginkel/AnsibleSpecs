+{{/*
+The Destroy Stage pipeline's guard (D66) refuses a stage a live Application
+still deploys, so its identity reads the Applications here: get and list on
+Applications alone. No AppProject, no Secret, nothing that syncs or deletes. Its
+only other grant is the Job lifecycle in the hook namespace (hook-namespace.yaml).
+*/}}
+{{- $destroy := .Values.destroyStage }}
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: {{ $destroy.serviceAccount }}
+  namespace: {{ .Release.Namespace }}
+rules:
+  - apiGroups: [argoproj.io]
+    resources: [applications]
+    verbs: [get, list]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: RoleBinding
+metadata:
+  name: {{ $destroy.serviceAccount }}
+  namespace: {{ .Release.Namespace }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: Role
+  name: {{ $destroy.serviceAccount }}
+subjects:
+  - kind: ServiceAccount
+    name: {{ $destroy.serviceAccount }}
+    namespace: {{ $destroy.namespace }}
