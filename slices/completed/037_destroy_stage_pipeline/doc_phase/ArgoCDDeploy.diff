+---
+{{/*
+The Destroy Stage pipeline's Job lifecycle (D66), and nothing more: the calls
+JenkinsPipelineUtils' kubectl steps make against a Job. startJob's `kubectl
+apply` gets and creates it; getJobPodName and waitForJobContainer get the Job and
+list and get its pod; getContainerExitCode reads the pod, getJobFailReason the
+Job, savePodLogs the pod's log; deleteJob deletes the Job and leaves its pods to
+the garbage collector. No patch: the Role cannot change a Job that already
+exists. No exec, no Secrets.
+
+Creating a Job here is running a pod as tf-presync with argocd-hook-credentials:
+this Role holds what a hook run holds, which is why it is bound to one identity
+alone.
+*/}}
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: {{ $destroy.serviceAccount }}
+  namespace: {{ $hooks.namespace }}
+rules:
+  - apiGroups: [batch]
+    resources: [jobs]
+    verbs: [get, create, delete]
+  - apiGroups: [""]
+    resources: [pods]
+    verbs: [get, list]
+  - apiGroups: [""]
+    resources: [pods/log]
+    verbs: [get]
+---
+apiVersion: rbac.authorization.k8s.io/v1
+kind: RoleBinding
+metadata:
+  name: {{ $destroy.serviceAccount }}
+  namespace: {{ $hooks.namespace }}
+roleRef:
+  apiGroup: rbac.authorization.k8s.io
+  kind: Role
+  name: {{ $destroy.serviceAccount }}
+subjects:
+  - kind: ServiceAccount
+    name: {{ $destroy.serviceAccount }}
+    namespace: {{ $destroy.namespace }}
