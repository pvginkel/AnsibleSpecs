+// Collects the architecture model of every producer registered in pipeline-producers.yaml,
+// validates the federation with the collector, builds the architecture_viewer image that serves it,
+// and pins that image into WebathomeOrgDeploy, which Argo CD syncs to prd. It also sets the job's
+// own triggers.
+//
+// The job builds on a push to this repo, and when any registered producer's job succeeds, except
+// its own (the self-producer) and those marked `trigger: false`: WebathomeOrgDeploy's, which the
+// pin write starts. triggers {} cannot hold a list read at run time, so the Set triggers stage sets
+// them, and the build of the commit that registers a producer wires its trigger.
+//
+// Controller config:
+//   - Job: AaC/Architecture
+//   - SCM: pvginkel/Architecture, branch main
+//   - Script Path: Jenkinsfile
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent kaniko'
+            yamlMergeStrategy merge()
+            yaml podYaml(templates: ['k8s', 'python'])
+        }
+    }
+
+    // --8<-- [start:options]
+    options {
+        disableConcurrentBuilds(abortPrevious: true)
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+    // --8<-- [end:options]
+
+    stages {
+        // --8<-- [start:triggers]
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        // The estate's one properties step. Declarative leaves alone the triggers its
+        // triggers {} did not declare, so the next build keeps these.
+        stage('Set triggers') {
+            steps {
+                script {
+                    List producers = readYaml(file: 'pipeline-producers.yaml').producers ?: []
+                    String upstreamJobs = producers.findAll { !it.self && it.trigger != false }.collect { it.jenkinsJob }.join(', ')
+                    List jobTriggers = [githubPush()]
+                    if (upstreamJobs) {
+                        jobTriggers << upstream(threshold: hudson.model.Result.SUCCESS, upstreamProjects: upstreamJobs)
+                    }
+                    properties([pipelineTriggers(jobTriggers)])
+                }
+            }
+        }
+        // --8<-- [end:triggers]
+
+        stage('Collect producer artifacts') {
+            steps {
+                script {
+                    List producers = readYaml(file: 'pipeline-producers.yaml').producers ?: []
+                    for (producer in producers) {
+                        if (producer.self) {
+                            // The self-producer's artifact is this checkout's docs/architecture/:
+                            // its job's last successful build is this job's previous build.
+                            sh """
+                                set -eu
+                                mkdir -p 'producer-artifacts/${producer.id}/docs/architecture'
+                                cp docs/architecture/*.yaml 'producer-artifacts/${producer.id}/docs/architecture/'
+                            """
+                        } else {
+                            copyArtifacts(
+                                projectName: producer.jenkinsJob,
+                                selector: lastSuccessful(),
+                                filter: '**/architecture/**/*.yaml',
+                                target: "producer-artifacts/${producer.id}",
+                                fingerprintArtifacts: true
+                            )
+                        }
+                    }
+                }
+                // The collector's inputs, archived before it runs, so that a failed collection can be
+                // replayed from them.
+                sh 'tar -czf producer-artifacts.tgz producer-artifacts'
+                archiveArtifacts artifacts: 'producer-artifacts.tgz', fingerprint: true
+            }
+        }
+
+        stage('Validate architecture') {
+            steps {
+                container('python') {
+                    // --relaxed tolerates dangling references between producers while the
+                    // federation is onboarding. The Dockerfile's run-collector stage passes the same
+                    // flag, and the two runs must match.
+                    sh '''
+                        set -eu
+                        pip install --quiet --no-cache-dir poetry
+                        cd tooling
+                        poetry install --no-root --without dev
+                        poetry run python collect.py \
+                            --producers "$WORKSPACE/pipeline-producers.yaml" \
+                            --in "$WORKSPACE/producer-artifacts" \
+                            --out "$WORKSPACE/dist" \
+                            --relaxed
+                    '''
+                }
+                archiveArtifacts artifacts: 'dist/data/v0.1/validation-report.json', fingerprint: true
+            }
+        }
+
+        stage('Build architecture_viewer image') {
+            steps {
+                // The image bundles producer-artifacts/, which .dockerignore keeps out of every other
+                // build of the Dockerfile.
+                sh '''
+                    set -eu
+                    grep -v '^producer-artifacts/$' .dockerignore > .dockerignore.tmp || true
+                    mv .dockerignore.tmp .dockerignore
+                '''
+                container('kaniko') {
+                    script {
+                        helmCharts.kaniko2(destinations: [
+                            "registry:5000/architecture_viewer:${currentBuild.number}",
+                            'registry:5000/architecture_viewer:latest',
+                        ])
+                    }
+                }
+            }
+        }
+
+        stage('Write image pins') {
+            steps {
+                container('k8s') {
+                    script {
+                        cicd.writeVersionPins(repo: 'pvginkel/WebathomeOrgDeploy', pins: [
+                            'config/prd/values.yaml': ['images.architecture_viewer': ":${currentBuild.number}"],
+                        ])
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/docs/examples/artifact-build.groovy b/docs/examples/artifact-build.groovy
new file mode 100644
index 0000000..bc38cd8
--- /dev/null
+++ b/docs/examples/artifact-build.groovy
@@ -0,0 +1,68 @@
+// Builds the ScanToPdf server as a zip of its `dotnet publish` output and archives it, then starts
+// ScanToPdf, which copies the zip into its image.
+//
+// Controller config:
+//   - Job: ScanToPdf/ScanToPdfServer
+//   - SCM: pvginkel/ScanToPdfServer, branch master
+//   - Script Path: Jenkinsfile
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent'
+            yaml podYaml(images: [[image: 'mcr.microsoft.com/dotnet/sdk:8.0', name: 'dotnet-sdk']])
+        }
+    }
+
+    // --8<-- [start:options]
+    options {
+        // Without abortPrevious: an abort between the archive and the start of ScanToPdf leaves
+        // ScanToPdf's image on the previous zip.
+        disableConcurrentBuilds()
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+        copyArtifactPermission('ScanToPdf')
+    }
+    // --8<-- [end:options]
+
+    triggers {
+        githubPush()
+    }
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        // --8<-- [start:stages]
+        stage('Build scantopdf-server.zip') {
+            steps {
+                container('dotnet-sdk') {
+                    sh 'dotnet restore ScanToPdfServer/ScanToPdfServer.csproj'
+                    sh 'dotnet publish ScanToPdfServer/ScanToPdfServer.csproj -c Release -o publish /p:UseAppHost=false'
+                }
+                zip zipFile: 'scantopdf-server.zip', dir: 'publish', archive: true
+            }
+        }
+
+        stage('Trigger ScanToPdf') {
+            steps {
+                build job: 'ScanToPdf', wait: false
+            }
+        }
+        // --8<-- [end:stages]
+    }
+
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+}
diff --git a/docs/examples/configuration-apply.groovy b/docs/examples/configuration-apply.groovy
new file mode 100644
index 0000000..9210af9
--- /dev/null
+++ b/docs/examples/configuration-apply.groovy
@@ -0,0 +1,89 @@
+// Applies YouTrack's configuration, kept as code in this repo, to the live YouTrack: every push is
+// an apply. The apply prints its plan first, so the log says what it changes before it changes it.
+//
+// Controller config:
+//   - Job: YouTrack/YouTrackConfiguration
+//   - SCM: pvginkel/YouTrackConfiguration, branch main
+//   - Script Path: Jenkinsfile
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent'
+            yaml podYaml(templates: ['python'])
+        }
+    }
+
+    options {
+        // Without abortPrevious: an abort in the middle of the apply leaves YouTrack half
+        // configured.
+        disableConcurrentBuilds()
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+
+    parameters {
+        booleanParam(name: 'ROTATE_TOKEN', defaultValue: false,
+            description: 'Also rewrite the webhook token into every project that has webhook URLs. YouTrack masks the token it holds, so a rotation cannot be detected, only asked for.')
+    }
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        // --8<-- [start:stages]
+        stage('Lint') {
+            steps {
+                container('python') {
+                    sh 'uv sync --frozen'
+                    sh 'uv run ruff check src tests'
+                    sh 'uv run ruff format --check src tests'
+                }
+            }
+        }
+
+        stage('Test') {
+            steps {
+                container('python') {
+                    sh 'uv run pytest'
+                }
+            }
+        }
+
+        // Prints the plan, then makes it. Fails when a project has no colour, when a colour is off
+        // the palette, or when the configuration names a project the instance does not have.
+        stage('Apply configuration') {
+            steps {
+                container('python') {
+                    withVault([vaultSecrets: [
+                        [path: 'kv/jenkins/youtrack', engineVersion: 2, secretValues: [
+                            [envVar: 'YOUTRACK_TOKEN', vaultKey: 'admin-token'],
+                            [envVar: 'YOUTRACK_WEBHOOK_TOKEN', vaultKey: 'webhook-token'],
+                        ]],
+                    ]]) {
+                        sh "uv run ytconfig apply ${params.ROTATE_TOKEN ? '--rotate-token' : ''}"
+                    }
+                }
+            }
+        }
+        // --8<-- [end:stages]
+    }
+
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+}
diff --git a/docs/examples/deploy-architecture.groovy b/docs/examples/deploy-architecture.groovy
new file mode 100644
index 0000000..281944b
--- /dev/null
+++ b/docs/examples/deploy-architecture.groovy
@@ -0,0 +1,64 @@
+// Generates the architecture of charts's prd stage as producer charts-deploy, validates it against
+// the architecture service, and archives it as the producer's artifact, which AaC/Architecture
+// collects.
+//
+// The artifact is generated, never committed. gen-architecture renders chart/ the way Argo CD
+// renders it, reads the judgment layer (architecture.yaml at the repo root) and writes
+// docs/architecture/charts-deploy.yaml. One pipeline publishes one stage, from the branch Argo CD
+// syncs it from: main.
+//
+// Controller config:
+//   - Job: AaC/ChartsDeploy
+//   - SCM: pvginkel/ChartsDeploy, branch main
+//   - Script Path: Jenkinsfile.architecture
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent'
+            yaml podYaml(templates: ['aac-tools'])
+        }
+    }
+
+    options {
+        disableConcurrentBuilds(abortPrevious: true)
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        // --8<-- [start:stages]
+        stage('Generate architecture') {
+            steps {
+                container('aac-tools') {
+                    sh 'gen-architecture --stage prd --producer charts-deploy'
+                }
+                archiveArtifacts artifacts: 'docs/architecture/*.yaml', fingerprint: true
+            }
+        }
+
+        // AaC/Architecture copies a producer's last successful build, so a model that fails here
+        // never reaches it, archived or not.
+        stage('Validate architecture') {
+            steps {
+                container('aac-tools') {
+                    sh 'arch-validate docs/architecture/*.yaml'
+                }
+            }
+        }
+        // --8<-- [end:stages]
+    }
+}
diff --git a/docs/examples/firmware-versions.groovy b/docs/examples/firmware-versions.groovy
new file mode 100644
index 0000000..0c6ed7a
--- /dev/null
+++ b/docs/examples/firmware-versions.groovy
@@ -0,0 +1,119 @@
+// Builds the Intercom firmware for each hardware version, 1 and 2, and uploads each over the air
+// through IoTSupport, at https://iot.ginbov.nl, before it builds the next.
+//
+// Controller config:
+//   - Job: Firmware/Intercom
+//   - SCM: pvginkel/Intercom, branch main
+//   - Script Path: Jenkinsfile
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent-large'
+            yaml podYaml(images: [[image: 'espressif/idf:v5.5.3', name: 'idf']])
+        }
+    }
+
+    options {
+        // Without abortPrevious: an upload cut off by an abort leaves the devices on two firmware
+        // versions.
+        disableConcurrentBuilds()
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+
+    stages {
+        stage('Checkout') {
+            steps {
+                dir('Intercom') {
+                    checkout scm
+                }
+                dir('esp-libs') {
+                    git url: 'https://github.com/pvginkel/esp-libs.git', branch: 'main',
+                        credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10'
+                }
+            }
+        }
+
+        // --8<-- [start:versions]
+        // Both hardware versions build into the one build/ directory, so each version is uploaded
+        // before the next version's build overwrites it.
+        stage('Build firmware (v1)') {
+            steps {
+                dir('Intercom') {
+                    container('idf') {
+                        // The idf image cannot run as the agent's uid, and git refuses a checkout
+                        // another uid owns.
+                        sh 'git config --global --add safe.directory \'*\''
+                        sh '/opt/esp/entrypoint.sh idf.py -DHARDWARE_VERSION=1 build'
+                    }
+                }
+            }
+        }
+
+        stage('Deploy firmware (v1)') {
+            steps {
+                dir('Intercom') {
+                    container('idf') {
+                        sh 'chmod +x scripts/upload.sh'
+                        withVault([vaultSecrets: [
+                            [path: 'kv/jenkins/iotsupport-pipeline-oidc', engineVersion: 2, secretValues: [
+                                [envVar: 'IOTSUPPORT_CLIENT_ID', vaultKey: 'client_id'],
+                                [envVar: 'IOTSUPPORT_CLIENT_SECRET', vaultKey: 'client_secret'],
+                            ]],
+                        ]]) {
+                            sh 'scripts/upload.sh https://iot.ginbov.nl'
+                        }
+                    }
+                }
+            }
+        }
+
+        stage('Build firmware (v2)') {
+            steps {
+                dir('Intercom') {
+                    container('idf') {
+                        // The idf image cannot run as the agent's uid, and git refuses a checkout
+                        // another uid owns.
+                        sh 'git config --global --add safe.directory \'*\''
+                        sh '/opt/esp/entrypoint.sh idf.py -DHARDWARE_VERSION=2 build'
+                    }
+                }
+            }
+        }
+
+        stage('Deploy firmware (v2)') {
+            steps {
+                dir('Intercom') {
+                    container('idf') {
+                        sh 'chmod +x scripts/upload.sh'
+                        withVault([vaultSecrets: [
+                            [path: 'kv/jenkins/iotsupport-pipeline-oidc', engineVersion: 2, secretValues: [
+                                [envVar: 'IOTSUPPORT_CLIENT_ID', vaultKey: 'client_id'],
+                                [envVar: 'IOTSUPPORT_CLIENT_SECRET', vaultKey: 'client_secret'],
+                            ]],
+                        ]]) {
+                            sh 'scripts/upload.sh https://iot.ginbov.nl'
+                        }
+                    }
+                }
+            }
+        }
+        // --8<-- [end:versions]
+    }
+
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+}
diff --git a/docs/examples/image-matrix.groovy b/docs/examples/image-matrix.groovy
new file mode 100644
index 0000000..9b4ea57
--- /dev/null
+++ b/docs/examples/image-matrix.groovy
@@ -0,0 +1,205 @@
+// Builds each DockerImages image a push changed, every image built on top of one, and those the
+// `image` parameter names, and pushes each to registry:5000. Every deploy repo that an image's
+// deploy-pins.json names then gets one pin commit for the images this build built.
+//
+// Controller config:
+//   - Job: DockerImages
+//   - SCM: pvginkel/DockerImages, branch main
+//   - Script Path: Jenkinsfile
+
+import org.jenkinsci.plugins.pipeline.modeldefinition.Utils
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+// --8<-- [start:local]
+// Pins for deploy repos (argo-cd D53): an image folder's deploy-pins.json lists every place a deploy
+// repo pins the image, each {"repo": "owner/name", "file": "<values file>", "path": "<dotted YAML
+// path>"}, with an optional "value" template: "{tag}" is the per-build tag this build pushed, and
+// the default ":{tag}" suits the estate's `image: registry:5000/<name>{{ .Values.<path> }}` charts.
+def collectPins(Map<String, String> builtTags) {
+    Map<String, Map<String, Map<String, String>>> byRepo = [:]
+    List<String> images = builtTags.keySet() as List
+    for (int i = 0; i < images.size(); i++) {
+        String file = "${images[i]}/deploy-pins.json"
+        if (!fileExists(file)) {
+            continue
+        }
+        def entries = readJSON(file: file)
+        for (int j = 0; j < entries.size(); j++) {
+            def entry = entries[j]
+            String value = (entry.value ?: ':{tag}').replace('{tag}', builtTags[images[i]])
+            if (!byRepo.containsKey(entry.repo)) {
+                byRepo[entry.repo] = [:]
+            }
+            if (!byRepo[entry.repo].containsKey(entry.file)) {
+                byRepo[entry.repo][entry.file] = [:]
+            }
+            byRepo[entry.repo][entry.file][entry.path] = value
+        }
+    }
+    return byRepo
+}
+
+// Set by the Build images stage, read by Write image pins: each built image's per-build tag, and
+// the pins those tags make, by deploy repo.
+Map<String, String> builtTags = [:]
+Map<String, Map<String, Map<String, String>>> pinsByRepo = [:]
+// --8<-- [end:local]
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent kaniko'
+            yamlMergeStrategy merge()
+            yaml podYaml(templates: ['k8s', 'python'])
+        }
+    }
+
+    // --8<-- [start:properties]
+    options {
+        // Without abortPrevious: this build decides from its change sets what to build, and the
+        // next build's change sets start after an aborted build's commits.
+        disableConcurrentBuilds()
+        skipDefaultCheckout()
+        timeout(time: 180, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+
+    parameters {
+        // The version poller replays the params label kaniko2 stamps ([image: '<image>']) as this
+        // parameter. `all`, or a comma-separated list of images, forces their builds.
+        string(name: 'image', defaultValue: '')
+    }
+    // --8<-- [end:properties]
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        // --8<-- [start:generator]
+        // The one stage generator in the estate: the image variants are listed at run time, from
+        // the image folders, and each gets a stage of its own.
+        stage('Build images') {
+            steps {
+                script {
+                    container('python') {
+                        sh 'python tools/collect-internal-dependencies.py > .deps.json'
+                    }
+                    def deps = readJSON(file: '.deps.json')
+
+                    // A deploy-pins.json pins the one per-build tag a build of its image pushes.
+                    List<String> seen = []
+                    for (variant in deps.variants) {
+                        if (variant.image in seen && fileExists("${variant.image}/deploy-pins.json")) {
+                            error("${variant.image}: deploy-pins.json pins one tag per build, but build-matrix.json lists more than one variant")
+                        }
+                        seen << variant.image
+                    }
+
+                    List<String> forced = []
+                    if (params.image == 'all') {
+                        forced = seen
+                    } else if (params.image) {
+                        forced = params.image.split(',').collect { it.trim() }.findAll { it }
+                    }
+
+                    // The changed and the forced images, each with every image built on top of it.
+                    List<String> build = []
+                    for (variant in deps.variants) {
+                        String image = variant.image
+                        if (!(image in build) && (utils.hasChanges("${image}/.*") || image in forced)) {
+                            build << image
+                            List<String> descendants = deps.descendants[image] ?: []
+                            for (descendant in descendants) {
+                                if (!(descendant in build)) {
+                                    build << descendant
+                                }
+                            }
+                        }
+                    }
+
+                    for (variant in deps.variants) {
+                        String image = variant.image
+                        String label = variant.matrix ? "Build ${image} image (${variant.tag})" : "Build ${image} image"
+                        stage(label) {
+                            if (image in build) {
+                                // Only this build pushes it, so it is the tag deploy repos pin.
+                                String tag = variant.matrix ? "${variant.tag}-${currentBuild.number}" : "${currentBuild.number}"
+                                builtTags[image] = tag
+                                dir(image) {
+                                    if (fileExists('required-artifacts.json')) {
+                                        for (artifact in readJSON(file: 'required-artifacts.json')) {
+                                            copyArtifacts(projectName: artifact.projectName, filter: artifact.filter, target: 'artifacts')
+                                        }
+                                    }
+                                    // Upstream dependencies the version poller rebuilds this image on,
+                                    // e.g. ["npm:@anthropic-ai/claude-code"]. kaniko2 stamps them as a label.
+                                    List<String> depends = fileExists('version-poller.json') ? (readJSON(file: 'version-poller.json').depends ?: []) : []
+                                    container('kaniko') {
+                                        if (variant.matrix) {
+                                            helmCharts.kaniko2(
+                                                destinations: ["registry:5000/${image}:${tag}", "registry:5000/${image}:${variant.tag}"],
+                                                trackingTag: variant.tag,
+                                                buildArgs: variant.args,
+                                                params: [image: image],
+                                                depends: depends
+                                            )
+                                        } else {
+                                            helmCharts.kaniko2(
+                                                destinations: ["registry:5000/${image}:${tag}", "registry:5000/${image}:latest"],
+                                                params: [image: image],
+                                                depends: depends
+                                            )
+                                        }
+                                    }
+                                }
+                            } else {
+                                Utils.markStageSkippedForConditional(label)
+                            }
+                        }
+                    }
+
+                    pinsByRepo = collectPins(builtTags)
+                }
+            }
+        }
+        // --8<-- [end:generator]
+
+        // --8<-- [start:pins]
+        stage('Write image pins') {
+            when {
+                expression { pinsByRepo }
+            }
+            steps {
+                container('k8s') {
+                    script {
+                        List<String> repos = pinsByRepo.keySet() as List
+                        for (int i = 0; i < repos.size(); i++) {
+                            cicd.writeVersionPins(
+                                repo: repos[i],
+                                pins: pinsByRepo[repos[i]],
+                                message: "ci: image pins from DockerImages #${currentBuild.number} (${builtTags.keySet().join(', ')})"
+                            )
+                        }
+                    }
+                }
+            }
+        }
+        // --8<-- [end:pins]
+    }
+
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+}
diff --git a/docs/examples/promotion.groovy b/docs/examples/promotion.groovy
new file mode 100644
index 0000000..0456195
--- /dev/null
+++ b/docs/examples/promotion.groovy
@@ -0,0 +1,235 @@
+// KubeCoder's promote job (D2): moves a validated commit on main to prd, which Argo CD syncs from
+// the prd branch (D34). Started by hand, it promotes main's tip unless `commit` names an earlier
+// commit on main. It retags every image the commit pins in registry:5000, fast-forwards prd to
+// the commit, and pushes an annotated release-<m> tag, <m> this job's build number (D48).
+//
+// D47's order, each step run only once the one before it succeeded, so prd never names a prd-<n>
+// tag that does not exist:
+//   1. every image the commit's config/prd/values.yaml pins to prd-<n> gets that tag, retagged
+//      from Build-Main's dev-<n>;
+//   2. prd fast-forwards to the commit, and the first run creates it (D35);
+//   3. the release-<m> tag goes on the commit.
+//
+// A re-run for the commit prd already names finishes a promotion whose step 3 failed: when no
+// release-* tag points at the commit, the job runs step 3 alone. A commit a release tag records
+// has nothing left to promote.
+//
+// No rollback parameter and no force-move (D47): a rollback is a revert on main, promoted like
+// any other commit (D36).
+//
+// Controller config:
+//   - Job: KubeCoder/Promote-PRD
+//   - SCM: pvginkel/KubeCoderDeploy, branch main
+//   - Script Path: Jenkinsfile.promote
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+// --8<-- [start:local]
+/**
+ * Build-Main's seven pins in a prd values file (D47), as the references prd deploys: the five
+ * `images.*` tag suffixes the chart appends to `registry:5000/kubecoder-<key>`, and the two whole
+ * references under `controllerConfig.images`.
+ *
+ * Every one must be a `prd-<n>` tag in registry:5000, which is also what keeps each reference
+ * safe to quote into a shell line.
+ *
+ * @param values  config/prd/values.yaml of the commit being promoted, as readYaml parses it.
+ * @return [image:, build: '<n>', tag: 'prd-<n>'] per pin.
+ */
+List<Map<String, String>> prdPins(Map values) {
+    Map suffixes = values.images instanceof Map ? values.images : [:]
+    Map controllerConfig = values.controllerConfig instanceof Map ? values.controllerConfig : [:]
+    Map wholeReferences = controllerConfig.images instanceof Map ? controllerConfig.images : [:]
+
+    List<String> paths = []
+    List<String> references = []
+    List<String> suffixed = ['controller', 'bot', 'mcp', 'ingress', 'manual']
+    for (int i = 0; i < suffixed.size(); i++) {
+        String key = suffixed[i]
+        paths << "images.${key}".toString()
+        references << (suffixes[key] == null ? null : "registry:5000/kubecoder-${key}${suffixes[key]}".toString())
+    }
+    List<String> whole = ['worker', 'vsix']
+    for (int i = 0; i < whole.size(); i++) {
+        String key = whole[i]
+        paths << "controllerConfig.images.${key}".toString()
+        references << wholeReferences[key]?.toString()
+    }
+
+    List<Map<String, String>> pins = []
+    for (int i = 0; i < references.size(); i++) {
+        String reference = references[i]
+        if (reference == null || !(reference ==~ /registry:5000\/kubecoder-[a-z]+:prd-[0-9]+/)) {
+            error("config/prd/values.yaml pins ${paths[i]} to '${reference}', not a " +
+                'registry:5000/kubecoder-<name>:prd-<n> reference (D47)')
+        }
+        int colon = reference.lastIndexOf(':')
+        String tag = reference.substring(colon + 1)
+        pins << [image: reference.substring(0, colon), build: tag.substring('prd-'.length()), tag: tag]
+    }
+    return pins
+}
+
+// Set by the Validate commit stage, read by the stages after it.
+String promoted
+boolean recordOnly = false
+List<Map<String, String>> pins
+// --8<-- [end:local]
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent'
+            yaml podYaml(templates: ['k8s'])
+        }
+    }
+
+    options {
+        // Without abortPrevious: an abort between the retag, the prd push and the tag push leaves
+        // the promotion half made.
+        disableConcurrentBuilds()
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    parameters {
+        string(name: 'commit', defaultValue: '', trim: true,
+            description: 'SHA of the commit on main to promote, full or abbreviated. Empty promotes the tip of main.')
+    }
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        // `checkout scm` fetches every branch and tag of the repo, which is all this gate reads.
+        stage('Validate commit') {
+            steps {
+                script {
+                    String requested = params.commit ?: ''
+                    if (requested && !(requested ==~ /[0-9a-f]{7,40}/)) {
+                        error("commit must be the SHA of a commit on main, full or abbreviated; got '${requested}'")
+                    }
+                    promoted = sh(script: "git rev-parse --verify '${requested ?: 'origin/main'}^{commit}'", returnStdout: true).trim()
+
+                    if (sh(script: "git merge-base --is-ancestor '${promoted}' origin/main", returnStatus: true) != 0) {
+                        error("${promoted} is not on main, and prd carries only commits main does (D35)")
+                    }
+
+                    String current = sh(script: 'git rev-parse --quiet --verify refs/remotes/origin/prd || true', returnStdout: true).trim()
+                    if (current == promoted) {
+                        String recorded = sh(script: "git tag --list 'release-*' --points-at '${promoted}'", returnStdout: true).trim()
+                        if (recorded) {
+                            error("prd is already at ${promoted}, released as ${recorded.replace('\n', ', ')}: nothing to promote")
+                        }
+                        recordOnly = true
+                    }
+                    if (current && sh(script: "git merge-base --is-ancestor '${current}' '${promoted}'", returnStatus: true) != 0) {
+                        error("prd is at ${current}, which ${promoted} does not descend from: a promotion only " +
+                            'fast-forwards prd (D35), and a rollback is a revert on main, promoted (D36)')
+                    }
+                    if (sh(script: "git tag --list 'release-${currentBuild.number}'", returnStdout: true).trim()) {
+                        error("release-${currentBuild.number} already exists on origin")
+                    }
+
+                    pins = prdPins(readYaml(text: sh(script: "git show '${promoted}:config/prd/values.yaml'", returnStdout: true)))
+                    currentBuild.description = "release-${currentBuild.number}: ${promoted.substring(0, 12)}"
+                    if (recordOnly) {
+                        // Advance prd's handoff line, for the promotion that pushes nothing.
+                        echo "pvginkel/KubeCoderDeploy ${promoted} already on prd: nothing pushed."
+                    }
+                }
+            }
+        }
+
+        stage('Retag images') {
+            when {
+                expression { !recordOnly }
+            }
+            steps {
+                container('k8s') {
+                    script {
+                        for (int i = 0; i < pins.size(); i++) {
+                            Map<String, String> pin = pins[i]
+                            // An existing prd-<n> was retagged from dev-<n> by an earlier promotion
+                            // and is left as it is. D47 caps the dev- family apart from the prd- one,
+                            // so a rollback promoting an older commit (D36) can pin a prd-<n> whose
+                            // dev-<n> is already reaped.
+                            sh """
+                                set -eu
+                                if crane --insecure digest '${pin.image}:${pin.tag}' >/dev/null 2>&1; then
+                                    echo '${pin.image}:${pin.tag} exists; left as it is'
+                                else
+                                    crane --insecure tag '${pin.image}:dev-${pin.build}' '${pin.tag}'
+                                fi
+                            """
+                        }
+                    }
+                }
+            }
+        }
+
+        // --8<-- [start:push]
+        stage('Advance prd') {
+            when {
+                expression { !recordOnly }
+            }
+            steps {
+                withCredentials([usernamePassword(
+                    credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10',
+                    usernameVariable: 'GIT_USER',
+                    passwordVariable: 'GIT_TOKEN')]) {
+                    // No `+` and no --force: GitHub refuses the push unless it fast-forwards prd,
+                    // whatever moved prd since the check.
+                    sh """
+                        set -eu
+                        git clone --quiet "https://\$GIT_USER:\$GIT_TOKEN@github.com/pvginkel/KubeCoderDeploy.git" advance
+                        git -C advance push --quiet origin '${promoted}:refs/heads/prd'
+                    """
+                }
+                // The handoff track_build.py (DockerImages kube-coder-dev-local-home) parses to
+                // follow prd's Argo CD sync, in the shape of cicd.writeVersionPins' pin line. Only
+                // this `pushed to` form moved prd and so brings a sync.
+                echo "pvginkel/KubeCoderDeploy ${promoted} pushed to prd."
+            }
+        }
+        // --8<-- [end:push]
+
+        stage('Tag release') {
+            steps {
+                script {
+                    String references = pins.collect { "${it.image}:${it.tag}\n" }.join('')
+                    String event = recordOnly
+                        ? "${promoted} was already on prd; recorded by ${env.JOB_NAME} #${currentBuild.number}"
+                        : "${promoted} promoted to prd by ${env.JOB_NAME} #${currentBuild.number}"
+                    withEnv(["RELEASE_MESSAGE=release-${currentBuild.number}: ${event}\n\n${references}"]) {
+                        withCredentials([usernamePassword(
+                            credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10',
+                            usernameVariable: 'GIT_USER',
+                            passwordVariable: 'GIT_TOKEN')]) {
+                            sh """
+                                set -eu
+                                git clone --quiet "https://\$GIT_USER:\$GIT_TOKEN@github.com/pvginkel/KubeCoderDeploy.git" release
+                                git -C release config user.name 'jenkins'
+                                git -C release config user.email 'jenkins@webathome.org'
+                                git -C release tag -a 'release-${currentBuild.number}' -m "\$RELEASE_MESSAGE" '${promoted}'
+                                git -C release push --quiet origin 'refs/tags/release-${currentBuild.number}'
+                            """
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+}
diff --git a/docs/examples/snapshot-producer.groovy b/docs/examples/snapshot-producer.groovy
new file mode 100644
index 0000000..f86134b
--- /dev/null
+++ b/docs/examples/snapshot-producer.groovy
@@ -0,0 +1,73 @@
+// Generates the home-automation-fleet architecture snapshot from the live Home Assistant every day,
+// validates it against the architecture service, and archives it as the producer's artifact, which
+// AaC/Architecture collects. It only reads Home Assistant.
+//
+// The producer is registered in pipeline-producers.yaml as home-automation-fleet, with this job and
+// no repo, so AaC/Architecture copies this job's last successful artifact. HA_URL is a global
+// environment variable of the controller. HA_TOKEN, a Home Assistant long-lived access token, is in
+// OpenBao.
+//
+// Controller config:
+//   - Job: AaC/Home Assistant Fleet
+//   - SCM: pvginkel/Architecture, branch main
+//   - Script Path: Jenkinsfile.ha-fleet
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent'
+            yaml podYaml(images: [[image: 'python:slim', name: 'python']])
+        }
+    }
+
+    // --8<-- [start:properties]
+    options {
+        disableConcurrentBuilds(abortPrevious: true)
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        cron('H 4 * * *')
+    }
+    // --8<-- [end:properties]
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        // --8<-- [start:generate]
+        stage('Generate architecture') {
+            steps {
+                container('python') {
+                    sh 'pip install --quiet --no-cache-dir websocket-client pyyaml'
+                    withVault([vaultSecrets: [
+                        [path: 'kv/jenkins/home-automation-fleet', engineVersion: 2, secretValues: [
+                            [envVar: 'HA_TOKEN', vaultKey: 'ha_token'],
+                        ]],
+                    ]]) {
+                        sh 'python3 tools/ha-fleet/gen-ha-fleet.py'
+                    }
+                }
+                archiveArtifacts artifacts: 'tools/ha-fleet/out/architecture/home-automation-fleet.yaml', fingerprint: true
+            }
+        }
+        // --8<-- [end:generate]
+
+        // AaC/Architecture copies a producer's last successful build, so a snapshot that fails here
+        // never reaches it, archived or not.
+        stage('Validate architecture') {
+            steps {
+                container('python') {
+                    sh 'python3 .claude/architecture/arch-validate.py tools/ha-fleet/out/architecture/home-automation-fleet.yaml'
+                }
+            }
+        }
+    }
+}
diff --git a/docs/examples/validation-job.groovy b/docs/examples/validation-job.groovy
new file mode 100644
index 0000000..0b17d79
--- /dev/null
+++ b/docs/examples/validation-job.groovy
@@ -0,0 +1,209 @@
+// Tests SSEGateway by running its validation image as a Kubernetes Job beside a RabbitMQ, then
+// builds the ssegateway image, pushes the tested commit to the stable branch, and pins the image
+// into Zigbee2mqttDeploy, ElectronicsInventoryDeploy, IotDeploy and DnsmasqDeploy, which Argo CD
+// syncs to prd.
+//
+// Controller config:
+//   - Job: SSEGateway/SSEGateway
+//   - SCM: pvginkel/SSEGateway, branch main
+//   - Script Path: Jenkinsfile
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent kaniko'
+            yamlMergeStrategy merge()
+            yaml podYaml(templates: ['k8s'])
+        }
+    }
+
+    options {
+        // Without abortPrevious: an abort between the stable push and the pin write leaves stable
+        // ahead of the image the deploy repos run.
+        disableConcurrentBuilds()
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        stage('Build ssegateway-validation image') {
+            steps {
+                container('kaniko') {
+                    script {
+                        helmCharts.kaniko2(
+                            dockerfile: 'Dockerfile.validation',
+                            destinations: ["registry:5000/ssegateway-validation:${currentBuild.number}"]
+                        )
+                    }
+                }
+            }
+        }
+
+        // --8<-- [start:test]
+        stage('Test') {
+            steps {
+                container('k8s') {
+                    script {
+                        String namespace = kubectl.currentNamespace()
+                        String job = "ssegateway-validation-${currentBuild.number}"
+                        try {
+                            kubectl.startJob("""\
+                                apiVersion: batch/v1
+                                kind: Job
+                                metadata:
+                                  name: ${job}
+                                  labels:
+                                    app.kubernetes.io/name: ssegateway-validation
+                                    app.kubernetes.io/managed-by: jenkins
+                                    jenkins/build-number: "${currentBuild.number}"
+                                spec:
+                                  backoffLimit: 0
+                                  activeDeadlineSeconds: 600
+                                  ttlSecondsAfterFinished: 3600
+                                  template:
+                                    spec:
+                                      restartPolicy: Never
+                                      containers:
+                                        - name: validation
+                                          image: registry:5000/ssegateway-validation:${currentBuild.number}
+                                          imagePullPolicy: Always
+                                          resources:
+                                            requests:
+                                              cpu: 500m
+                                              memory: 256Mi
+                                        - name: rabbitmq
+                                          image: rabbitmq:4.3-management
+                                """.stripIndent())
+                            kubectl.waitForJobContainer(job, 'validation', namespace)
+                            String pod = kubectl.getJobPodName(job, namespace)
+                            kubectl.savePodLogs(pod, 'validation', namespace, 'validation-raw.log')
+
+                            // The suite writes each JUnit file into its log, base64-encoded between
+                            // an ===JUNIT:<file>=== line and an ===JUNIT_END=== line.
+                            sh '''
+                                set -eu
+                                mkdir -p test-results
+                                awk '
+                                    /^===JUNIT:.*===$/ {
+                                        fname = $0
+                                        sub(/^===JUNIT:/, "", fname)
+                                        sub(/===$/, "", fname)
+                                        content = ""
+                                        capture = 1
+                                        next
+                                    }
+                                    /^===JUNIT_END===$/ {
+                                        print content | "base64 -d > test-results/" fname
+                                        close("base64 -d > test-results/" fname)
+                                        capture = 0
+                                        next
+                                    }
+                                    capture { content = content (content ? "\\n" : "") $0 }
+                                    !capture { print }
+                                ' validation-raw.log > validation-stripped.log
+                            '''
+                            utils.cleanLog('validation-stripped.log', 'validation.log')
+                            archiveArtifacts artifacts: 'validation.log, test-results/*.xml', allowEmptyArchive: true
+                            junit testResults: 'test-results/*.xml', allowEmptyResults: true
+
+                            // scripts/validation-entrypoint.sh ends the log with
+                            // ===SUITE_RESULT:<name>:<passed>:<failed>:<skipped>===.
+                            String result = readFile('validation.log').split('\n').find { it.startsWith('===SUITE_RESULT:') }
+                            if (result) {
+                                String[] counts = result.replace('===SUITE_RESULT:', '').replace('===', '').split(':')
+                                currentBuild.description = "${counts[1]} passed, ${counts[2]} failed, ${counts[3]} skipped"
+                            }
+
+                            String exitCode = kubectl.getContainerExitCode(pod, 'validation', namespace)
+                            if (!exitCode) {
+                                String reason = kubectl.getJobFailReason(job, namespace)
+                                error("Validation failed: no exit code (pod ${pod}${reason ? ", reason ${reason}" : ''})")
+                            } else if (exitCode != '0') {
+                                error("Validation failed: exit code ${exitCode}")
+                            }
+                        } finally {
+                            kubectl.deleteJob(job, namespace)
+                        }
+                    }
+                }
+            }
+        }
+        // --8<-- [end:test]
+
+        stage('Build ssegateway image') {
+            steps {
+                container('kaniko') {
+                    script {
+                        helmCharts.kaniko2(destinations: [
+                            "registry:5000/ssegateway:${currentBuild.number}",
+                            'registry:5000/ssegateway:latest',
+                        ])
+                    }
+                }
+            }
+        }
+
+        // --8<-- [start:push]
+        // The Checkout stage's clone holds no credential to push with, so the push goes from a clone
+        // made inside withCredentials.
+        stage('Push stable branch') {
+            steps {
+                script {
+                    String commit = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
+                    withCredentials([usernamePassword(
+                        credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10',
+                        usernameVariable: 'GIT_USER',
+                        passwordVariable: 'GIT_TOKEN')]) {
+                        sh """
+                            set -eu
+                            git clone --quiet "https://\$GIT_USER:\$GIT_TOKEN@github.com/pvginkel/SSEGateway.git" stable
+                            git -C stable push --quiet origin '${commit}:refs/heads/stable'
+                        """
+                    }
+                }
+            }
+        }
+        // --8<-- [end:push]
+
+        stage('Write image pins') {
+            steps {
+                container('k8s') {
+                    script {
+                        List<String> repos = [
+                            'pvginkel/Zigbee2mqttDeploy',
+                            'pvginkel/ElectronicsInventoryDeploy',
+                            'pvginkel/IotDeploy',
+                            'pvginkel/DnsmasqDeploy',
+                        ]
+                        for (int i = 0; i < repos.size(); i++) {
+                            cicd.writeVersionPins(repo: repos[i], pins: [
+                                'config/prd/values.yaml': ['images.sseGateway': ":${currentBuild.number}"],
+                            ])
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+}
