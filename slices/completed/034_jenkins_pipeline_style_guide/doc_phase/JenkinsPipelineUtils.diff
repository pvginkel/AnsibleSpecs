index 0000000..49e1065
--- /dev/null
+++ b/docs/examples/app-architecture.groovy
@@ -0,0 +1,47 @@
+// Validates Ginbov's hand-authored architecture model, docs/architecture/*.yaml, against the
+// architecture service, and archives it as the producer's artifact, which AaC/Architecture
+// collects.
+//
+// Controller config:
+//   - Job: AaC/Ginbov
+//   - SCM: pvginkel/Ginbov, branch main
+//   - Script Path: Jenkinsfile.architecture
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent'
+            yaml podYaml(templates: ['aac-tools'])
+        }
+    }
+
+    options {
+        disableConcurrentBuilds(abortPrevious: true)
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        stage('Validate architecture') {
+            steps {
+                container('aac-tools') {
+                    sh 'arch-validate docs/architecture/*.yaml'
+                }
+                archiveArtifacts artifacts: 'docs/architecture/*.yaml', fingerprint: true
+            }
+        }
+    }
+}
