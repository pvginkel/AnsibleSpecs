+// --8<-- [start:header]
+// Builds the ginbov_nl image from app/ and pins it into GinbovNlDeploy, which Argo CD syncs to
+// prd.
+//
+// Controller config:
+//   - Job: Ginbov
+//   - SCM: pvginkel/Ginbov, branch main
+//   - Script Path: Jenkinsfile
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+// --8<-- [end:header]
+
+pipeline {
+    // --8<-- [start:agent]
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent kaniko'
+            yamlMergeStrategy merge()
+            yaml podYaml(templates: ['k8s'])
+        }
+    }
+    // --8<-- [end:agent]
+
+    // --8<-- [start:properties]
+    options {
+        disableConcurrentBuilds(abortPrevious: true)
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+    // --8<-- [end:properties]
+
+    stages {
+        // --8<-- [start:stages]
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        stage('Build ginbov_nl image') {
+            steps {
+                dir('app') {
+                    container('kaniko') {
+                        script {
+                            helmCharts.kaniko2(destinations: [
+                                "registry:5000/ginbov_nl:${currentBuild.number}",
+                                'registry:5000/ginbov_nl:latest',
+                            ])
+                        }
+                    }
+                }
+            }
+        }
+
+        stage('Write image pins') {
+            steps {
+                container('k8s') {
+                    script {
+                        cicd.writeVersionPins(repo: 'pvginkel/GinbovNlDeploy', pins: [
+                            'config/prd/values.yaml': ['images.ginbov_nl': ":${currentBuild.number}"],
+                        ])
+                    }
+                }
+            }
+        }
+        // --8<-- [end:stages]
+    }
+}
diff --git a/docs/lint_examples.py b/docs/lint_examples.py
new file mode 100644
index 0000000..c7c45d6
--- /dev/null
+++ b/docs/lint_examples.py
@@ -0,0 +1,59 @@
+"""Every example Jenkinsfile in examples/ through the Jenkins controller's declarative linter.
+
+Run from this directory: `uv run --locked python lint_examples.py`. JENKINS_TOKEN in the
+environment is the API token of the controller's `admin` user.
+
+Each file goes to the linter as the site publishes it: without the section-marker lines that the
+guide's pages cut their excerpts by. An excerpt is those lines' span of the published file, so every
+excerpt the site shows is checked inside the complete file it is cut from. The controller runs the
+full declarative check on a `pipeline {}` file and answers "Jenkinsfile successfully validated."
+when it passes.
+"""
+
+import base64
+import os
+import sys
+from pathlib import Path
+from urllib.parse import urlencode
+from urllib.request import Request, urlopen
+
+from pymdownx.snippets import SnippetPreprocessor
+
+HERE = Path(__file__).resolve().parent
+EXAMPLES = HERE / "examples"
+VALIDATE = "https://jenkins.webathome.org/pipeline-model-converter/validate"
+PASSED = "Jenkinsfile successfully validated."
+
+
+def published(path: Path) -> str:
+    """The file as a whole-file snippet include renders it: every section-marker line dropped."""
+    lines = path.read_text(encoding="utf8").splitlines(keepends=True)
+    return "".join(
+        line for line in lines if not SnippetPreprocessor.RE_SNIPPET_SECTION.match(line.rstrip("\n"))
+    )
+
+
+def validate(text: str, token: str) -> str:
+    credentials = base64.b64encode(f"admin:{token}".encode()).decode()
+    request = Request(
+        VALIDATE,
+        data=urlencode({"jenkinsfile": text}).encode(),
+        headers={"Authorization": f"Basic {credentials}"},
+    )
+    with urlopen(request, timeout=60) as response:
+        return response.read().decode("utf8").strip()
+
+
+def main() -> int:
+    token = os.environ["JENKINS_TOKEN"]
+    failed = 0
+    for path in sorted(EXAMPLES.rglob("*.groovy")):
+        answer = validate(published(path), token)
+        print(f"{path.relative_to(HERE)}: {answer}")
+        if answer != PASSED:
+            failed += 1
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
