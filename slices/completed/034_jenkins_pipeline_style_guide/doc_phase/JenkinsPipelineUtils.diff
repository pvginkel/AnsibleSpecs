diff --git a/docs/nginx.conf b/docs/nginx.conf
new file mode 100644
index 0000000..ec50ead
--- /dev/null
+++ b/docs/nginx.conf
@@ -0,0 +1,25 @@
+# The pipelines.home site: the landing page at /, the MkDocs build under /docs/ (Dockerfile). TLS
+# is terminated by the estate's nginx layer in front of this pod, so this serves plain HTTP on :80,
+# the port PipelinesDeploy's Service sends traffic to.
+server {
+    listen 80;
+    server_name _;
+
+    root /usr/share/nginx/html;
+    index index.html;
+
+    # MkDocs uses directory URLs, so `/docs/guide/pod` 301s to `/docs/guide/pod/`. nginx builds that
+    # redirect absolute from this pod's own scheme, plain http behind the TLS edge; relative, it is
+    # the path alone.
+    absolute_redirect off;
+
+    # llms.txt, llms-full.txt and the pages' .md copies are UTF-8 text. mime.types has no .md, which
+    # would otherwise go out as application/octet-stream.
+    charset utf-8;
+    charset_types text/plain text/markdown text/css application/javascript;
+
+    location ~ \.md$ {
+        types { }
+        default_type text/markdown;
+    }
+}
