new file mode 100644
index 0000000..f64864b
--- /dev/null
+++ b/Jenkinsfile
@@ -0,0 +1,66 @@
+// Builds the pipelines.home site, the Jenkins pipeline style guide and this library's reference,
+// into the pipelines-home image, and pins it into PipelinesDeploy, which Argo CD syncs to prd.
+//
+// The job builds and publishes the site and nothing else. The library's tests run in the repo's
+// `kc project test`.
+//
+// Controller config:
+//   - Job: IaC/JenkinsPipelineUtils
+//   - SCM: pvginkel/JenkinsPipelineUtils, branch main
+//   - Script Path: Jenkinsfile
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent kaniko'
+            yamlMergeStrategy merge()
+            yaml podYaml(templates: ['k8s'])
+        }
+    }
+
+    options {
+        disableConcurrentBuilds(abortPrevious: true)
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        stage('Build pipelines-home image') {
+            steps {
+                container('kaniko') {
+                    script {
+                        helmCharts.kaniko2(dockerfile: 'docs/Dockerfile', destinations: [
+                            "registry:5000/pipelines-home:${currentBuild.number}",
+                            'registry:5000/pipelines-home:latest',
+                        ])
+                    }
+                }
+            }
+        }
+
+        stage('Write image pins') {
+            steps {
+                container('k8s') {
+                    script {
+                        cicd.writeVersionPins(repo: 'pvginkel/PipelinesDeploy', pins: [
+                            'config/prd/values.yaml': ['images.pipelines': ":${currentBuild.number}"],
+                        ])
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/docs/Dockerfile b/docs/Dockerfile
new file mode 100644
index 0000000..e35936c
--- /dev/null
+++ b/docs/Dockerfile
@@ -0,0 +1,37 @@
+# The pipelines.home image (registry:5000/pipelines-home): the landing page, landing/, at / and
+# the docs site, mkdocs.yml, under /docs/, served by nginx on port 80. The Jenkinsfile at the repo
+# root builds it and pins it into PipelinesDeploy.
+#
+# The build context is the repo ROOT, not docs/: pages/reference is a symlink to ../../vars, so
+# the builder needs vars/ beside docs/. The root .dockerignore keeps the context to those two.
+
+# ---- build: the static site, checked ------------------------------------------------------------
+FROM python:3.13-slim AS build
+
+COPY --from=ghcr.io/astral-sh/uv:0.12.20 /uv /uvx /bin/
+
+WORKDIR /src
+COPY docs/ docs/
+COPY vars/ vars/
+WORKDIR /src/docs
+
+# The toolchain is pyproject.toml's dependencies, locked in uv.lock; --locked fails when the two
+# disagree. uv uses the image's Python rather than downloading one.
+ENV UV_PYTHON_PREFERENCE=only-system
+RUN uv sync --locked
+
+# The repo's `kc project test docs`: the strict build, then check_site.py over its output in site/.
+# Jenkins runs no other check of the site before it ships.
+RUN uv run --no-sync mkdocs build --strict && uv run --no-sync python check_site.py
+
+# ---- ship: plain nginx --------------------------------------------------------------------------
+FROM nginx:alpine
+
+COPY docs/nginx.conf /etc/nginx/conf.d/default.conf
+
+# The served layout check_site.py checks the landing page's links against.
+COPY docs/landing/ /usr/share/nginx/html/
+COPY --from=build /src/docs/site /usr/share/nginx/html/docs
+
+# Jenkins never runs this container, so this is the only check the config gets before prd.
+RUN nginx -t
