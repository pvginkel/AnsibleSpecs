diff --git a/docs/mkdocs.yml b/docs/mkdocs.yml
new file mode 100644
index 0000000..05773e4
--- /dev/null
+++ b/docs/mkdocs.yml
@@ -0,0 +1,71 @@
+# The docs site served at https://pipelines.home/docs/: the estate's Jenkins pipeline style guide
+# and the reference for this library's global vars. landing/index.html is the page served at the
+# site root, /, and links here. The toolchain is locked in pyproject.toml + uv.lock beside this
+# file.
+#
+# The build IS the gate — `--strict` turns MkDocs' warnings into errors. From this directory:
+#
+#     uv run --locked mkdocs build --strict
+#
+# `kc project test docs` runs it, then check_site.py over the output in site/.
+site_name: Jenkins pipelines
+site_description: >-
+  How the estate writes its Jenkins pipelines: the style guide every Jenkinsfile follows, and the
+  reference for JenkinsPipelineUtils, the shared library every pipeline loads.
+
+# Required: mkdocs-llmstxt refuses to load without it. The site has one address, and this is it.
+# Internal links and asset refs stay relative in the built HTML; what carries the origin is the
+# absolute-URL surfaces: <link rel="canonical">, sitemap.xml (and its .gz twin), and the llms.txt
+# entries.
+site_url: https://pipelines.home/docs/
+
+docs_dir: pages
+
+theme:
+  name: material
+  features:
+    - navigation.top
+    - navigation.sections
+    - content.code.copy
+
+markdown_extensions:
+  # Syntax-highlighted fenced code blocks, Groovy included.
+  - pymdownx.highlight
+  - pymdownx.superfences
+
+plugins:
+  - search
+  - llmstxt:
+      markdown_description: >-
+        Every link below is a page's Markdown copy. llms-full.txt, beside this file, holds every
+        page's Markdown in one file.
+      # llms-full.txt inlines EVERY page's markdown into one file, emitted at the site root next to
+      # llms.txt.
+      full_output: llms-full.txt
+      sections:
+        Docs:
+          # fnmatch, not pathlib globbing — `*` crosses `/`, so this single pattern matches every
+          # page at any depth. Keep it that way: a page NOT matched by a `sections` pattern is
+          # absent from llms.txt and llms-full.txt, and --strict stays green. check_site.py is
+          # what fails on it.
+          - "*.md"
+
+validation:
+  nav:
+    # Default is INFO, which --strict ignores. As a warning it becomes a build failure, so a page
+    # that exists but was never added to the nav cannot ship orphaned.
+    omitted_files: warn
+    not_found: warn
+  links:
+    # A root-absolute link (/docs/...) is not validated by MkDocs and breaks the moment the site
+    # moves; write relative links between pages instead.
+    absolute_links: warn
+    # MkDocs checks that a link's target PAGE exists, but not that its `#fragment` resolves — so a
+    # renamed heading silently orphans every link into it. As a warning that becomes a build
+    # failure, on the same page and across pages.
+    anchors: warn
+
+# Add a page and its nav row in the SAME change: --strict fails on a nav entry pointing at a
+# missing file, and (see `validation.nav.omitted_files` above) on a page missing from the nav.
+nav:
+  - Home: index.md
