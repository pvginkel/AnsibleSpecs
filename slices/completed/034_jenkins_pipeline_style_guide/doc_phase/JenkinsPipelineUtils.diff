diff --git a/docs/examples/change-detection.groovy b/docs/examples/change-detection.groovy
new file mode 100644
index 0000000..fcac33e
--- /dev/null
+++ b/docs/examples/change-detection.groovy
@@ -0,0 +1,106 @@
+// Builds the iac image from support/iac-image/ and pushes it to registry:5000, when a push changes
+// what the image is built from or the build's `image` parameter names it. It pins nothing.
+//
+// Controller config:
+//   - Job: IaC/IaC Docker Image
+//   - SCM: pvginkel/Ansible, branch main
+//   - Script Path: Jenkinsfile.iac-image
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+// --8<-- [start:local]
+// Whether this build builds the image. A build that names the image builds it whatever its change
+// sets hold: the version poller's weekly rebuild, or Build with Parameters with image=iac.
+def imageBuildRequired() {
+    if (params.image == 'all') {
+        return true
+    }
+    if (params.image) {
+        def forced = params.image.split(',').collect { it.trim() }
+        if ('iac' in forced) {
+            return true
+        }
+    }
+
+    // Everything support/iac-image/Dockerfile builds from, and this file, which carries the
+    // Dockerfile path, the context and the destinations. utils.hasChanges matches a changed file's
+    // whole repo-relative path, so a directory prefix ends in /.*.
+    return (
+        utils.hasChanges('Jenkinsfile\\.iac-image') ||
+        utils.hasChanges('support/iac-image/.*') ||
+        utils.hasChanges('pyproject\\.toml') ||
+        utils.hasChanges('poetry\\.lock') ||
+        utils.hasChanges('ansible/roles/baseline/files/homelab-root\\.crt') ||
+        utils.hasChanges('ansible/files/known_hosts\\.d/homelab')
+    )
+}
+// --8<-- [end:local]
+
+pipeline {
+    agent {
+        kubernetes {
+            inheritFrom 'jenkins-agent kaniko'
+            yamlMergeStrategy merge()
+        }
+    }
+
+    // --8<-- [start:properties]
+    options {
+        // Without abortPrevious: this build decides from its change sets what to build, and the
+        // next build's change sets start after an aborted build's commits.
+        disableConcurrentBuilds()
+        skipDefaultCheckout()
+        timeout(time: 60, unit: 'MINUTES')
+        timestamps()
+    }
+
+    triggers {
+        githubPush()
+    }
+
+    parameters {
+        // The version poller replays the params label kaniko2 stamps ([image: 'iac']) as this
+        // parameter. `all`, or a comma-separated list holding `iac`, forces the build.
+        string(name: 'image', defaultValue: '')
+    }
+    // --8<-- [end:properties]
+
+    stages {
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        // --8<-- [start:build]
+        stage('Build iac image') {
+            when {
+                expression { imageBuildRequired() }
+            }
+            steps {
+                container('kaniko') {
+                    script {
+                        helmCharts.kaniko2(
+                            dockerfile: 'support/iac-image/Dockerfile',
+                            context: '.',
+                            destinations: [
+                                "registry:5000/iac:${currentBuild.number}",
+                                'registry:5000/iac:latest',
+                            ],
+                            params: [image: 'iac']
+                        )
+                    }
+                }
+            }
+        }
+        // --8<-- [end:build]
+    }
+
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+}
