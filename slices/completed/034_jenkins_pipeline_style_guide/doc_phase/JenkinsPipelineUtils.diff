index 0000000..506432b
--- /dev/null
+++ b/docs/examples/iac-controller.groovy
@@ -0,0 +1,114 @@
+// --8<-- [start:header]
+// Restarts the calico-node DaemonSet every week: a rolling restart on k8s prd, then on k8s dev
+// when srvk8sdev is up.
+//
+// Works around projectcalico/calico#8777: on a long-running calico-node pod the token_watch.go
+// loop stops refreshing the CNI kubeconfig token, and once the token expires, new pod sandboxes
+// on that node fail with "connection is unauthorized: Unauthorized". A weekly restart keeps every
+// calico-node pod younger than that. Re-evaluate after each microk8s upgrade.
+//
+// Controller config:
+//   - Job: IaC/Scheduled Calico Rollout
+//   - SCM: pvginkel/Ansible, branch main
+//   - Script Path: Jenkinsfile.iac-scheduled-calico
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+// --8<-- [end:header]
+
+// --8<-- [start:local]
+// srvk8sdev can be down: it starts with pve, but may be stopped by hand. `-T 5` caps the connect,
+// so a down box costs seconds rather than a playbook's worth of connection retries.
+def devUp() {
+    return sh(
+        returnStatus: true,
+        script: '''
+            iac -c '
+                cd /work/Ansible/ansible
+                ansible k8s_dev -m ping -T 5
+            '
+        '''
+    ) == 0
+}
+// --8<-- [end:local]
+
+pipeline {
+    agent { label 'iac-controller' }
+
+    // --8<-- [start:properties]
+    options {
+        // Without abortPrevious: an abort in the middle of a rolling restart leaves the cluster
+        // half restarted.
+        disableConcurrentBuilds()
+        skipDefaultCheckout()
+        timeout(time: 4, unit: 'HOURS')
+        timestamps()
+    }
+
+    triggers {
+        // Wednesday: clear of the Sunday OS-update roll, so the two never run together.
+        cron('H 4 * * 3')
+    }
+    // --8<-- [end:properties]
+
+    stages {
+        // --8<-- [start:stages]
+        stage('Checkout') {
+            steps {
+                checkout scm
+            }
+        }
+
+        stage('Restart calico-node (k8s prd)') {
+            steps {
+                sh '''
+                    iac -c '
+                        set -euo pipefail
+                        cd /work/Ansible/ansible
+                        ansible-playbook --diff playbooks/refresh-calico-token.yml --limit k8s_prd
+                    '
+                '''
+            }
+        }
+
+        // --8<-- [start:dev]
+        // A dev box that is down or broken never fails the build: the stage marks it UNSTABLE, and
+        // pages only when the restart itself failed.
+        stage('Restart calico-node (k8s dev)') {
+            steps {
+                script {
+                    if (!devUp()) {
+                        unstable('srvk8sdev is unreachable — dev calico roll skipped')
+                        return
+                    }
+                    int rc = sh(
+                        returnStatus: true,
+                        script: '''
+                            iac -c '
+                                set -euo pipefail
+                                cd /work/Ansible/ansible
+                                timeout --kill-after=1m 15m ansible-playbook --diff playbooks/refresh-calico-token.yml --limit k8s_dev
+                            '
+                        '''
+                    )
+                    if (rc != 0) {
+                        String message = "dev calico roll failed on srvk8sdev (exit ${rc})"
+                        notify.warning(message)
+                        unstable(message)
+                    }
+                }
+            }
+        }
+        // --8<-- [end:dev]
+        // --8<-- [end:stages]
+    }
+
+    // --8<-- [start:post]
+    post {
+        aborted {
+            script {
+                notify.error("${env.JOB_NAME} #${env.BUILD_NUMBER} aborted (timeout or hand)")
+            }
+        }
+    }
+    // --8<-- [end:post]
+}
