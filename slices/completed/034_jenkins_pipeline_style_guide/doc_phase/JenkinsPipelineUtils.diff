@@ -0,0 +1,14 @@
+# The docs site's toolchain — MkDocs, Material and the llmstxt plugin, for mkdocs.yml beside it —
+# locked in uv.lock, so every `uv run --locked` / `uv sync --locked` installs the same versions.
+# A virtual project (`package = false`): the site is not a Python package.
+[project]
+name = "jenkins-pipeline-utils-docs"
+version = "0"
+requires-python = ">=3.13"
+dependencies = [
+    "mkdocs-material>=9.7",
+    "mkdocs-llmstxt>=0.5",
+]
+
+[tool.uv]
+package = false
