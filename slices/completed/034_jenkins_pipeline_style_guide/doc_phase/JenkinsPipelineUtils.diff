@@ -0,0 +1,80 @@
+"""What the docs site promises beyond `mkdocs build --strict`, checked over the build in site/.
+
+Run from this directory, after the build: `uv run --locked python check_site.py`.
+
+- Every documentation page has its Markdown copy and is in llms.txt and llms-full.txt. The
+  llmstxt plugin leaves out a page its `sections` patterns do not match without a warning, so
+  --strict stays green without it.
+- Every link on landing/index.html resolves in the served tree — the landing page at /, the site
+  under /docs/ — and one of them is the docs home.
+"""
+
+import sys
+from html.parser import HTMLParser
+from pathlib import Path, PurePosixPath
+from urllib.parse import urljoin, urlsplit
+
+from mkdocs.config import load_config
+from mkdocs.structure.files import get_files
+
+HERE = Path(__file__).resolve().parent
+LANDING = HERE / "landing"
+SITE_PREFIX = "/docs/"
+
+
+class _Links(HTMLParser):
+    def __init__(self) -> None:
+        super().__init__()
+        self.links: list[str] = []
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
+        self.links += [value for name, value in attrs if name in ("href", "src") and value]
+
+
+def _served_file(site: Path, link: str) -> Path | None:
+    """The file the served tree answers a relative landing-page link with, or None."""
+    path = urljoin("/", urlsplit(link).path)
+    if path.startswith(SITE_PREFIX):
+        target = site / path.removeprefix(SITE_PREFIX)
+    else:
+        target = LANDING / path.removeprefix("/")
+    if path.endswith("/") or target.is_dir():
+        target = target / "index.html"
+    return target if target.is_file() else None
+
+
+def check() -> list[str]:
+    config = load_config(str(HERE / "mkdocs.yml"))
+    site = Path(config.site_dir)
+    llms = (site / "llms.txt").read_text(encoding="utf8")
+    full = (site / "llms-full.txt").read_text(encoding="utf8")
+    errors = []
+
+    for page in get_files(config).documentation_pages():
+        copy_uri = PurePosixPath(page.dest_uri).with_suffix(".md").as_posix()
+        copy = site / copy_uri
+        if not copy.is_file():
+            errors.append(f"{page.src_uri}: no Markdown copy at site/{copy_uri}")
+            continue
+        if f"]({urljoin(config.site_url, copy_uri)})" not in llms:
+            errors.append(f"{page.src_uri}: not listed in llms.txt")
+        if copy.read_text(encoding="utf8").strip() not in full:
+            errors.append(f"{page.src_uri}: not inlined in llms-full.txt")
+
+    parser = _Links()
+    parser.feed((LANDING / "index.html").read_text(encoding="utf8"))
+    relative = [link for link in parser.links if not urlsplit(link).scheme]
+    served = {link: _served_file(site, link) for link in relative}
+    for link in relative:
+        if served[link] is None:
+            errors.append(f"landing/index.html: {link} resolves to nothing")
+    if site / "index.html" not in served.values():
+        errors.append("landing/index.html: no link to the docs home, docs/")
+    return errors
+
+
+if __name__ == "__main__":
+    errors = check()
+    for error in errors:
+        print(error, file=sys.stderr)
+    sys.exit(1 if errors else 0)
