+++ b/terraform/providers.tf
@@ -0,0 +1,18 @@
+# Applied only by the Argo CD PreSync hook (ArgoCDTools argocd-hook), from its own clone. It
+# fills the empty http backend at init, exports its environment (TF_VAR_*, GITHUB_TOKEN) and
+# passes config/<stage>/*.tfvars at apply.
+
+terraform {
+  required_providers {
+    github = {
+      source = "integrations/github"
+    }
+  }
+
+  backend "http" {}
+}
+
+# Authenticates with GITHUB_TOKEN.
+provider "github" {
+  owner = "pvginkel"
+}
diff --git a/terraform/variables.tf b/terraform/variables.tf
new file mode 100644
index 0000000..c8cbc17
--- /dev/null
+++ b/terraform/variables.tf
@@ -0,0 +1,14 @@
+# From the hook's environment.
+
+variable "github_webhook_secret" {
+  description = "Argo CD's shared webhook secret, the one the relay verifies deliveries against (TF_VAR_github_webhook_secret)."
+  type        = string
+  sensitive   = true
+}
+
+# From config/<stage>/*.tfvars.
+
+variable "manage_webhook" {
+  description = "Whether this stage's state owns the repository's GitHub webhook. True in exactly one stage: the webhook is per repository and the state per stage, so a second owner's apply fails on GitHub's hook-already-exists."
+  type        = bool
+}
diff --git a/terraform/webhook.tf b/terraform/webhook.tf
new file mode 100644
index 0000000..39ac870
--- /dev/null
+++ b/terraform/webhook.tf
@@ -0,0 +1,16 @@
+# This repository's push deliveries, to the webhook relay, which verifies the signature and
+# forwards each delivery to argocd-server (argo-cd D39, D49).
+resource "github_repository_webhook" "argocd" {
+  count = var.manage_webhook ? 1 : 0
+
+  repository = "PipelinesDeploy"
+  active     = true
+  events     = ["push"]
+
+  configuration {
+    url          = "https://deploy-hooks.webathome.org/api/webhook"
+    content_type = "json"
+    insecure_ssl = false
+    secret       = var.github_webhook_secret
+  }
+}
