+
+# The image is built by the JenkinsPipelineUtils repo (its docs site baked into nginx), not
+# DockerImages, so this producer owns the product.
+images:
+  pipelines-home: ss:pipelines-home
+
+products:
+  - id: ss:pipelines-home
+    label: Jenkins pipelines docs site
+    summary: Static nginx serving the Jenkins pipeline style guide and the JenkinsPipelineUtils library reference — the MkDocs site built from that repo's docs/ — at pipelines.home.
+    homepage: https://github.com/pvginkel/JenkinsPipelineUtils
+    logo: jenkins
