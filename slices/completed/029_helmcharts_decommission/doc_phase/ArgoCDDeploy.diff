diff --git a/tools/registry-equivalence.py b/tools/registry-equivalence.py
new file mode 100755
index 0000000..4ed2eb6
--- /dev/null
+++ b/tools/registry-equivalence.py
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""Read-only: does the registry render the live Applications, spec for spec?
+
+Renders releases/ from this checkout the way Argo renders it into argocd-prd,
+reads the Applications in argocd-prd on the prd cluster, and compares each
+pair's spec and finalizers. Exits non-zero on any difference, and on an
+Application only one side has. Owner references, labels and annotations are
+reported per Application, not compared: that is the tracking metadata D64's
+registry switch changes, and nothing in the render sets them.
+
+Needs helm and a kubeconfig that can read Applications in argocd-prd; the
+default one can. From the repo root: cexec iac tools/registry-equivalence.py
+"""
+
+import difflib
+import json
+import pathlib
+import subprocess
+import sys
+
+import yaml
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+CONTEXT = "prd"
+NAMESPACE = "argocd-prd"
+
+
+def run(*args):
+    result = subprocess.run(args, cwd=REPO, capture_output=True, text=True)
+    if result.returncode != 0:
+        sys.exit(f"{' '.join(args)} failed:\n{result.stderr}")
+    return result.stdout
+
+
+def rendered():
+    out = run("helm", "template", "releases", "releases", "--namespace", NAMESPACE)
+    return {doc["metadata"]["name"]: doc for doc in yaml.safe_load_all(out) if doc}
+
+
+def live():
+    out = run(
+        "kubectl", "--context", CONTEXT, "--namespace", NAMESPACE,
+        "get", "applications.argoproj.io", "--output", "json",
+    )
+    return {doc["metadata"]["name"]: doc for doc in json.loads(out)["items"]}
+
+
+def compared(app):
+    """What the render fixes: the spec, and the finalizer that makes deletion an undeploy."""
+    return {"finalizers": app["metadata"].get("finalizers", []), "spec": app["spec"]}
+
+
+def tracking(app):
+    metadata = app["metadata"]
+    owners = [f"{o['kind']}/{o['name']}" for o in metadata.get("ownerReferences", [])]
+    notes = [f"owner {', '.join(owners) or 'none'}"]
+    for field in ("labels", "annotations"):
+        if metadata.get(field):
+            notes.append(f"{field} {sorted(metadata[field])}")
+    return "; ".join(notes)
+
+
+def dump(value):
+    return yaml.safe_dump(value, sort_keys=True).splitlines()
+
+
+def main():
+    desired, current = rendered(), live()
+    differ = 0
+    for name in sorted(desired.keys() | current.keys()):
+        if name not in current:
+            differ += 1
+            print(f"ONLY IN REGISTRY  {name}: no live Application of this name")
+            continue
+        if name not in desired:
+            differ += 1
+            print(f"ONLY LIVE         {name}: the registry carries no entry for it")
+            continue
+        want, have = compared(desired[name]), compared(current[name])
+        if want == have:
+            print(f"equal             {name} ({tracking(current[name])})")
+            continue
+        differ += 1
+        print(f"DIFFERS           {name}")
+        for line in difflib.unified_diff(dump(have), dump(want), "live", "registry", lineterm=""):
+            print(f"    {line}")
+    print(
+        f"{len(desired)} rendered, {len(current)} live in {NAMESPACE}, "
+        f"{differ} differing"
+    )
+    sys.exit(1 if differ else 0)
+
+
+main()

