+          "items": { "type": "string", "minLength": 1 }
+        },
+        "stages": {
+          "$comment": "A stage is deployed by being here (D27 as amended), so an app with none has no entry.",
+          "type": "object",
+          "minProperties": 1,
+          "propertyNames": { "$ref": "#/definitions/name" },
+          "additionalProperties": { "$ref": "#/definitions/stage" }
+        }
+      },
+      "if": { "required": ["upstream"] },
+      "then": {
+        "properties": { "stages": { "additionalProperties": { "required": ["version"] } } }
+      },
+      "else": {
+        "properties": { "stages": { "additionalProperties": { "not": { "required": ["version"] } } } }
+      }
