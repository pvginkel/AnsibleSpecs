+        }
+      }
+    }
+  },
+  "definitions": {
+    "name": {
+      "$comment": "An app or stage key; <app>-<stage> is a namespace name, so both are DNS labels.",
+      "type": "string",
+      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
+    },
+    "app": {
+      "type": "object",
+      "required": ["repo", "stages"],
+      "additionalProperties": false,
+      "properties": {
+        "repo": {
+          "$comment": "A deploy repo under the owner the repo credential and the AppProject's source glob cover.",
+          "type": "string",
+          "pattern": "^https://github\\.com/pvginkel/[A-Za-z0-9._-]+\\.git$"
