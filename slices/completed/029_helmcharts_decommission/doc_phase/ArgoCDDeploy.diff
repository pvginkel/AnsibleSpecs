+{{/*
+The registry's own Application (D63): it syncs releases/, the registry chart,
+which renders one Application per app-stage into `releases`' destination
+namespace. That is Argo's own namespace, where Argo reads Applications, and the
+project admits it there (D10).
+
+`releases.owner` chooses between this Application and the two ApplicationSets
+(applicationsets.yaml), so the two never own the live Applications at the same
+moment. The registry switch flips it once (D64).
+
+Nothing `releases` does deletes an Application:
+- No finalizer, so deleting `releases`, or pruning it out of this render, deletes
+  it alone and leaves every Application it created (D64).
+- Automated sync without prune, so an entry deleted from the registry shows as
+  requiring pruning until the operator prunes it (D27 as amended). No self-heal,
+  and the retry block every auto-synced Application carries (D5).
+- `releases.autoSync` off renders no automated sync at all: that is how
+  `releases` comes up at the switch, so the operator's first sync is one whose
+  diff they have read (D64).
+
+A registry push reaches `releases` through ArgoCDDeploy's relay webhook, and
+nothing polls (D6 as amended).
+*/}}
+{{- $releases := .Values.releases }}
+{{- $owner := required "releases.owner is a stage fact: set it in config/{stage}/values.yaml" $releases.owner }}
+{{- if not (has $owner (list "applicationsets" "releases")) }}
+{{- fail (printf "releases.owner is %q, and it is either applicationsets or releases" $owner) }}
+{{- end }}
+{{- if not (kindIs "bool" $releases.autoSync) }}
+{{- fail "releases.autoSync is a stage fact, true or false: set it in config/{stage}/values.yaml" }}
