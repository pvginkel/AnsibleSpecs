+# The registry chart (D63): values.yaml is the registry, and the chart renders
+# one plain Application per app-stage from it.
+apiVersion: v2
+name: releases
+version: "0.1"
+type: application
diff --git a/releases/templates/_helpers.tpl b/releases/templates/_helpers.tpl
new file mode 100644
index 0000000..633b4f0
--- /dev/null
+++ b/releases/templates/_helpers.tpl
@@ -0,0 +1,19 @@
+{{/*
+The four hook parameters, all of them: the library chart `required`-guards every
+one (/work/Charts/charts/homelab-shared/templates/_tf-presync-hook.tpl:45-48), so
+three fails the whole render of every app that includes the hook.
+`$ARGOCD_APP_REVISION` is Argo's, substituted with the synced SHA at build time
+(D30): the only way the hook learns which commit to clone. hook.namespace is the
+destination namespace, so the hook's PV reattach filters on the namespace Argo is
+syncing into (D29, D33).
+*/}}
+{{- define "releases.hookParameters" -}}
+- name: hook.repo
+  value: {{ .repo | quote }}
+- name: hook.revision
+  value: "$ARGOCD_APP_REVISION"
+- name: hook.stage
+  value: {{ .stage | quote }}
+- name: hook.namespace
+  value: {{ .name | quote }}
+{{- end }}
diff --git a/releases/templates/applications.yaml b/releases/templates/applications.yaml
new file mode 100644
index 0000000..99dbd02
--- /dev/null
+++ b/releases/templates/applications.yaml
@@ -0,0 +1,83 @@
+{{/*
+One Application per app-stage (D63). Name and destination namespace are the one
+string <app>-<stage> (D24), in the project ArgoCDDeploy's chart/ creates (D10).
+The finalizer makes deleting an Application an undeploy that cascades to its
+namespace and everything tracked with it (D27).
+
+An upstream app is multi-source (D18): the chart from its own Helm repository at
+the stage's pinned version, the values from the deploy repo, and the deploy
+repo's companion chart/ (D56) with the hook parameters. Each source builds at its
+own revision, so $ARGOCD_APP_REVISION in the third is the deploy repo's SHA. A
+local app reads its stage's values out of the chart path (D19).
+
+autoSync turns on `prune`, because a manifest that leaves the render leaves the
+cluster (D46), and no `selfHeal`, so a debug edit to a tracked resource stays
+until someone syncs (D5). `default` would turn an explicit `autoSync: false`
+into true, hence `hasKey`.
+*/}}
+{{- range $app, $entry := .Values.apps }}
+{{- range $stage, $settings := $entry.stages }}
+{{- $name := printf "%s-%s" $app $stage }}
+{{- $revision := $settings.targetRevision | default "main" }}
+{{- $autoSync := ternary $settings.autoSync true (hasKey $settings "autoSync") }}
+{{- $hook := dict "repo" $entry.repo "stage" $stage "name" $name }}
+---
+apiVersion: argoproj.io/v1alpha1
+kind: Application
+metadata:
+  name: {{ $name | quote }}
+  namespace: {{ $.Release.Namespace }}
+  finalizers:
+    - resources-finalizer.argocd.argoproj.io
+spec:
+  project: releases
+  {{- if $entry.upstream }}
+  sources:
+    - repoURL: {{ $entry.upstream.repo | quote }}
+      chart: {{ $entry.upstream.chart | quote }}
+      targetRevision: {{ $settings.version | quote }}
+      helm:
+        valueFiles:
+          - {{ printf "$values/config/%s/values.yaml" $stage | quote }}
+    - repoURL: {{ $entry.repo | quote }}
+      targetRevision: {{ $revision | quote }}
+      ref: values
+    - repoURL: {{ $entry.repo | quote }}
+      targetRevision: {{ $revision | quote }}
+      path: chart
+      helm:
+        parameters:
+          {{- include "releases.hookParameters" $hook | nindent 10 }}
+  {{- else }}
+  source:
+    repoURL: {{ $entry.repo | quote }}
+    targetRevision: {{ $revision | quote }}
+    path: chart
+    helm:
+      valueFiles:
+        - {{ printf "../config/%s/values.yaml" $stage | quote }}
+      parameters:
+        {{- include "releases.hookParameters" $hook | nindent 8 }}
+  {{- end }}
+  destination:
+    name: in-cluster
+    namespace: {{ $name | quote }}
+  {{- if or $autoSync $entry.syncOptions }}
+  syncPolicy:
+    {{- if $autoSync }}
+    automated:
+      prune: true
+      selfHeal: false
+    retry:
+      limit: 3
+      backoff:
+        duration: 30s
+        factor: 2
+    {{- end }}
+    {{- with $entry.syncOptions }}
+    syncOptions:
+      {{- toYaml . | nindent 6 }}
+    {{- end }}
+  {{- end }}
+{{- end }}
+{{- end }}
