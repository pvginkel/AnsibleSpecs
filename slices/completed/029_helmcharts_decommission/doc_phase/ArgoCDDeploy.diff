+# The registry (D63): every app-stage Argo CD deploys, one entry per app. The
+# chart renders one Application per stage, named and namespaced <app>-<stage>
+# (D24). values.schema.json refuses an entry that is not this shape.
+#
+#   repo         the deploy repo.
+#   upstream     {repo, chart}: the chart comes from a Helm repository (D18); the
+#                deploy repo supplies the stage values and a companion chart/
+#                (D56), and every stage pins the chart's `version` (D22).
+#   syncOptions  passed through to each of the app's Applications (D62).
+#   stages       <stage>: {autoSync, targetRevision, version}. autoSync defaults
+#                to true and targetRevision to main; `version` is an upstream
+#                app's, and required there.
+#
+# A stage is deployed by being here; undeploying it is deleting its entry, which
+# leaves its Application requiring pruning until the operator prunes it (D27 as
+# amended). D64's registry switch hands the live Applications to this chart, and
+# tools/registry-equivalence.py compares its render with them.
+apps:
+  # Argo CD's own entry (D3): the Application through which Argo manages itself.
+  # values.schema.json pins its repo, its prd stage and its autoSync.
+  argocd:
+    repo: https://github.com/pvginkel/ArgoCDDeploy.git
+    stages:
+      # Tracks main: D34's dev-tracks-main / prd-tracks-prd split is per-app, and
+      # ArgoCDDeploy carries no `prd` branch.
+      prd:
+        # Permanent, not a cutover default (D3's sharp edge): a self-sync can
+        # restart the application controller or the repo-server mid-sync, so an
+        # Argo upgrade is a manual sync at a moment the operator picks.
+        autoSync: false
