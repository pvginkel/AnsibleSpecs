+---
+# The registry switch's rehearsal (docs/runbooks/registry-switch.md, step 1):
+# a throwaway ApplicationSet shaped like releases-local, generating one
+# throwaway Application. The operator applies it with kubectl.
+apiVersion: argoproj.io/v1alpha1
+kind: ApplicationSet
+metadata:
+  name: switch-rehearsal-set
+  namespace: argocd-prd
+spec:
+  goTemplate: true
+  goTemplateOptions: ["missingkey=error"]
+  generators:
+    - list:
+        elements:
+          - stage: tst
+  template:
+    metadata:
+      name: 'switch-rehearsal-{{ .stage }}'
+      finalizers:
