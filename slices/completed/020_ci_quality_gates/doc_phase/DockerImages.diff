 library identifier: 'JenkinsPipelineUtils', changelog: false
 
+// Nothing in the scan may change the build or stage result: a failing trivy only
+// logs its exit status, and catchError swallows any other error. trivy's --timeout
+// bounds the scan, not a timeout() step: a timeout() expiry is an interruption,
+// which catchInterruptions: false rethrows so that a user abort still aborts.
+def scanImage(String ref) {
+    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS', catchInterruptions: false) {
+        container('trivy') {
+            int rc = sh(returnStatus: true, script: """
+                trivy image --no-progress --image-src remote --insecure --scanners vuln \\
+                    --severity CRITICAL,HIGH --timeout 15m --format json --output .trivy.json '${ref}' &&
+                trivy convert --quiet --format table .trivy.json
+            """)
+            if (rc != 0) {
+                echo "trivy could not scan ${ref} (exit ${rc}); the build result is unchanged"
+            } else {
+                def fixable = sh(returnStdout: true, script: '''
+                    trivy convert --quiet --format template --template '{{ range . }}{{ range .Vulnerabilities }}{{ if and (eq .Severity "CRITICAL") .FixedVersion }}{{ println .VulnerabilityID }}{{ end }}{{ end }}{{ end }}' .trivy.json
+                ''').split('\n').collect { it.trim() }.findAll { it != '' }
+                if (fixable) {
+                    notify.warning("trivy: ${ref} has ${fixable.size()} CRITICAL findings with a fixed version")
+                }
+            }
+        }
+    }
+}
