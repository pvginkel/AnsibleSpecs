+def lint(release: Release, extra_args: list[str]) -> None:
+    """helm lint over the chart source, with the values `template`
+    renders. Lint takes no post-renderer, and an upstream chart has no
+    source in this repo to lint."""
+    if release.chart_name is None:
+        raise ReleaseError(f"{release.chart_dir} is infra-only (chart: null) — nothing to lint")
+    if release.upstream:
+        print(f"{release.chart_ref} is an upstream chart — no chart source to lint", file=sys.stderr)
+        return
+    helm = _helm()
+    _setup_repos(release, helm)
+    _run(
+        helm
+        + ["lint", str(release.chart_path), "--namespace", release.namespace]
+        + _values_args(release)
+        + release.helm_args
+        + extra_args
+    )
