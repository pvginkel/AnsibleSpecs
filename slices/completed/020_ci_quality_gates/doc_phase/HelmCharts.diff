@@ -0,0 +1,105 @@
+"""The media chart's values.schema.json, against the values a prd deploy
+hands helm.
+
+Reads the real chart and prd values; writes nothing. helm validates the
+coalesced values — chart defaults, then the release's values file, then the
+deploy's --set args — so the tests merge them in that order.
+"""
+
+import copy
+import json
+from pathlib import Path
+
+import pytest
+import yaml
+from jsonschema import Draft7Validator
+
+from chart_tools.resolve_helm_args import get_helm_images
+
+ROOT = Path(__file__).resolve().parents[1]
+CHART = ROOT / "charts" / "media"
+PRD_VALUES = ROOT / "configs" / "prd" / "media" / "prd" / "values.yaml"
+DIGEST = "@sha256:" + "0" * 64
+
+
+def _merge(base, override):
+    merged = copy.deepcopy(base)
+    for key, value in override.items():
+        if isinstance(value, dict) and isinstance(merged.get(key), dict):
+            merged[key] = _merge(merged[key], value)
+        else:
+            merged[key] = value
+    return merged
+
+
+def _tree(path, value):
+    """The values tree `--set <path>=<value>` contributes."""
+    for key in reversed(path.split(".")):
+        value = {key: value}
+    return value
+
+
+@pytest.fixture(scope="module")
+def validator():
+    schema = json.loads((CHART / "values.schema.json").read_text())
+    Draft7Validator.check_schema(schema)
+    return Draft7Validator(schema)
+
+
+@pytest.fixture(scope="module")
+def defaults():
+    return yaml.safe_load((CHART / "values.yaml").read_text())
+
+
+@pytest.fixture(scope="module")
+def injected():
+    """The --set args the Jenkinsfile and the deploy CLI add: the stage, the
+    git token and one digest per image resolve-helm-args finds."""
+    images = get_helm_images({"chart_name": "media", "values_file": PRD_VALUES}, str(ROOT))
+    assert images
+    return {
+        "global.environment": "prd",
+        "gitToken": "ghp_token",
+        **{image["value"]: DIGEST for image in images.values()},
+    }
+
+
+@pytest.fixture(scope="module")
+def deployed(defaults, injected):
+    values = _merge(defaults, yaml.safe_load(PRD_VALUES.read_text()))
+    for path, value in injected.items():
+        values = _merge(values, _tree(path, value))
+    return values
+
+
+def test_chart_defaults_pass(validator, defaults):
+    assert list(validator.iter_errors(defaults)) == []
+
+
+def test_prd_deploy_values_pass(validator, deployed):
+    assert list(validator.iter_errors(deployed)) == []
+
+
+@pytest.mark.parametrize(
+    ("path", "value", "where"),
+    [
+        # The 2024-08 key: the chart reads storage.plex.imageName.
+        ("storage.plex.subvolumeName", "x", ["storage", "plex"]),
+        ("bogus", "x", []),
+        ("global.enviroment", "prd", ["global"]),
+        ("images.plx", DIGEST, ["images"]),
+        ("resources.media.plx", {}, ["resources", "media"]),
+        ("externalSecrets.secrets.gluetun-wg.targetNme", "x", ["externalSecrets", "secrets", "gluetun-wg"]),
+        (
+            "externalSecrets.secrets.gluetun-wg.data",
+            [{"secretKey": "config", "path": "p", "propery": "config"}],
+            ["externalSecrets", "secrets", "gluetun-wg", "data", 0],
+        ),
+    ],
+)
+def test_a_key_the_chart_does_not_define_fails(validator, deployed, path, value, where):
+    errors = list(validator.iter_errors(_merge(deployed, _tree(path, value))))
+
+    assert [(list(e.absolute_path), e.validator) for e in errors] == [
+        (where, "additionalProperties")
+    ]
