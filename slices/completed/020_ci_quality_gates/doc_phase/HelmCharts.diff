+"""The lint verb, and template's stdout carrying the rendered manifests alone.
+
+_run is stubbed throughout, so no helm runs: what is under test is the
+command line each verb hands helm and where helm's output goes.
+"""
+
+import sys
+
+import pytest
+import yaml
+
+from deploy_cli import helmops
+from deploy_cli import main as main_mod
+from deploy_cli.release import ReleaseError, resolve
+
+UPSTREAM = {"repo_name": "up", "repo_url": "https://charts.example", "chart": "up/bar"}
+
+
+@pytest.fixture
+def helm_calls(monkeypatch):
+    calls = []
+    monkeypatch.setattr(helmops, "_helm", lambda: ["helm"])
+    monkeypatch.setattr(helmops, "_run", lambda cmd, check=True, **kwargs: calls.append((cmd, kwargs)))
+    return calls
+
+
+def _with_dependency(chart_dir):
+    (chart_dir / "Chart.yaml").write_text(yaml.safe_dump({
+        "name": chart_dir.name,
+        "version": "0.1.0",
+        "dependencies": [{"name": "dep", "version": "1.0.0", "repository": "https://deps.example"}],
+    }))
+
+
+def test_lint_hands_helm_the_values_template_renders_with(make_chart, make_stage, helm_calls):
+    chart = make_chart("foo")
+    stage = make_stage("prd", "foo", "prd", release_yaml={"helm_args": ["--set", "a=b"]})
+    release = resolve("prd/foo", None)
+
+    helmops.lint(release, ["--set", "gitToken=t"])
+    helmops.template(release, ["--set", "gitToken=t"])
+
+    lint_cmd, template_cmd = [cmd for cmd, _ in helm_calls]
+    assert lint_cmd == [
+        "helm", "lint", str(chart), "--namespace", "foo-prd",
+        "-f", str(stage / "values.yaml"), "--set", "global.environment=prd",
+        "--set", "a=b", "--set", "gitToken=t",
+    ]
+    assert template_cmd[template_cmd.index("-f"):] == lint_cmd[lint_cmd.index("-f"):]
+
+
+def test_lint_builds_the_charts_dependencies_first(make_chart, make_stage, helm_calls):
+    chart = make_chart("foo")
+    _with_dependency(chart)
+    make_stage("prd", "foo", "prd")
+
+    helmops.lint(resolve("prd/foo", None), [])
+
+    assert [cmd[1:3] for cmd, _ in helm_calls] == [
+        ["repo", "add"], ["dependency", "build"], ["lint", str(chart)],
+    ]
+
+
+def test_lint_leaves_an_upstream_chart_to_the_render(make_chart, make_stage, helm_calls, capsys):
+    make_chart("bar", chart_yaml=False)
+    make_stage("prd", "bar", "prd", release_yaml={"upstream": UPSTREAM})
+
+    helmops.lint(resolve("prd/bar", None), ["--version", "1.2.3"])
+
+    assert helm_calls == []
+    assert "up/bar" in capsys.readouterr().err
+
+
+def test_lint_refuses_an_infra_only_release(make_stage, helm_calls):
+    make_stage("prd", "baz", "prd", release_yaml={"chart": None})
+
+    with pytest.raises(ReleaseError, match="nothing to lint"):
+        helmops.lint(resolve("prd/baz", None), [])
+    assert helm_calls == []
+
+
+@pytest.mark.parametrize("upstream", [False, True], ids=["local-dependency", "upstream"])
+def test_template_stdout_is_the_render_alone(make_chart, make_stage, helm_calls, upstream):
+    chart = make_chart("foo", chart_yaml=not upstream)
+    if upstream:
+        make_stage("prd", "foo", "prd", release_yaml={"upstream": UPSTREAM})
+    else:
+        _with_dependency(chart)
+        make_stage("prd", "foo", "prd")
+
+    helmops.template(resolve("prd/foo", None), [])
+
+    *setup, (render_cmd, render_kwargs) = helm_calls
+    assert len(setup) == 2
+    assert all(kwargs.get("stdout") is sys.stderr for _, kwargs in setup)
+    assert render_cmd[1] == "template"
+    assert "stdout" not in render_kwargs
+
+
+def test_deploy_lint_reaches_helmops_lint_with_the_extra_args(make_chart, make_stage, monkeypatch):
+    make_chart("foo")
+    make_stage("prd", "foo", "prd")
+    monkeypatch.setattr(main_mod, "apply_cluster_environment", lambda release: None)
+    linted = []
+    monkeypatch.setattr(main_mod.helmops, "lint",
+                        lambda release, extra: linted.append((release.release_name, extra)))
+    monkeypatch.setattr(sys, "argv", ["deploy", "lint", "prd/foo", "--stage=prd",
+                                      "--kube-version=1.35.0", "--set", "gitToken=t"])
+
+    assert main_mod.main_deploy() == 0
+    assert linted == [("foo-prd", ["--kube-version=1.35.0", "--set", "gitToken=t"])]
