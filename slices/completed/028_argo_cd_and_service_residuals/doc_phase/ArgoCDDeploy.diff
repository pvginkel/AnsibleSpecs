+def check_application_metrics(docs):
+    """Prometheus scrapes the controller's application metrics (D7 as amended)."""
+    template = find(docs, "StatefulSet", CONTROLLER)["spec"]["template"]
+    pod_labels = template["metadata"]["labels"]
+    container = next(c for c in template["spec"]["containers"] if c["name"] == "application-controller")
+    args = container.get("args", [])
+
+    conditions = set()
+    for index, arg in enumerate(args):
+        if arg.startswith("--metrics-application-conditions="):
+            conditions.update(arg.split("=", 1)[1].split(","))
+        elif arg == "--metrics-application-conditions" and index + 1 < len(args):
+            conditions.update(args[index + 1].split(","))
+    missing = sorted(set(APP_CONDITIONS) - conditions)
+    check(not missing, f"the controller exports no argocd_app_condition series for {missing}")
+
+    listen = next((a.split("=", 1)[1] for a in args if a.startswith("--metrics-port=")), None)
+    check(listen is not None, "the controller's args name no --metrics-port")
+    metrics_port = int(listen) if listen is not None else None
+    ports = {p["name"]: p["containerPort"] for p in container.get("ports", []) if "name" in p}
+
+    service = find(docs, "Service", f"{CONTROLLER}-metrics")
+    check(service is not None, "the controller has no metrics Service, so Prometheus discovers no target")
+    if service is None:
+        return
+    # PrometheusDeploy's kubernetes-service-endpoints job keeps a Service on the
+    # scrape annotation alone, and the port and path annotations, when present,
+    # replace the endpoint's own port and /metrics.
+    annotations = service["metadata"].get("annotations", {})
+    check(
+        annotations.get("prometheus.io/scrape") == "true",
+        f"{CONTROLLER}-metrics is not annotated for scraping: {annotations!r}",
+    )
+    check(
+        annotations.get("prometheus.io/port", str(metrics_port)) == str(metrics_port),
+        f"{CONTROLLER}-metrics redirects the scrape to port {annotations.get('prometheus.io/port')!r}",
+    )
+    check(
+        annotations.get("prometheus.io/path", "/metrics") == "/metrics",
+        f"{CONTROLLER}-metrics redirects the scrape to {annotations.get('prometheus.io/path')!r}",
+    )
+    selector = service["spec"].get("selector", {})
+    check(
+        bool(selector) and all(pod_labels.get(k) == v for k, v in selector.items()),
+        f"{CONTROLLER}-metrics selects no application-controller pod: {selector!r}",
+    )
+    for port in service["spec"].get("ports", []):
+        target = port.get("targetPort", port["port"])
+        check(
+            (ports.get(target) if isinstance(target, str) else target) == metrics_port,
+            f"{CONTROLLER}-metrics port {port.get('name')!r} reaches {target!r}, "
+            f"not the controller's --metrics-port {metrics_port}",
+        )
+
+    # Prometheus scrapes from its own namespace, so every NetworkPolicy on the
+    # controller has to admit the metrics port from outside argocd-prd.
+    for policy in docs:
+        if policy["kind"] != "NetworkPolicy" or policy["metadata"].get("namespace") != NAMESPACE:
+            continue
+        spec = policy["spec"]
+        match = spec.get("podSelector", {}).get("matchLabels", {})
+        if not all(pod_labels.get(k) == v for k, v in match.items()):
+            continue
+        if "Ingress" not in spec.get("policyTypes", ["Ingress"]):
+            continue
+        admitted = any(
+            (not rule.get("ports") or any(p.get("port") in ("metrics", metrics_port) for p in rule["ports"]))
+            and (
+                not rule.get("from")
+                or any(peer.get("namespaceSelector") == {} and "podSelector" not in peer for peer in rule["from"])
+            )
+            for rule in spec.get("ingress", [])
+        )
+        check(
+            admitted,
+            f"NetworkPolicy/{policy['metadata']['name']} refuses the controller's metrics port to Prometheus",
+        )
+
+
+def check_login_urls(docs):
+    """A login completes on every name the vhost answers on (ANS-46)."""
+    cm = find(docs, "ConfigMap", "argocd-cm")["data"]
+    check(cm.get("url") == URL, f"argocd-cm url is {cm.get('url')!r}, and every notification link moves with it")
+    # Argo only warns when additionalUrls does not decode, and carries on with none.
+    additional = yaml.safe_load(cm.get("additionalUrls") or "[]")
+    check(
+        isinstance(additional, list) and all(isinstance(u, str) for u in additional),
+        f"argocd-cm additionalUrls is not a list of URLs: {cm.get('additionalUrls')!r}",
+    )
+    if not isinstance(additional, list):
+        return
+    allowed = [urlsplit(u) for u in (cm.get("url", ""), *additional) if isinstance(u, str)]
+    # A return_url is accepted only when its scheme and host match an allowed
+    # URL's and its path lies under that URL's path (v3.5.1 util/oidc/oidc.go
+    # isValidRedirectURL); nginx serves every name over TLS.
+    for u in allowed:
+        check(
+            u.scheme == "https" and u.path in ("", "/"),
+            f"argocd-cm allows {u.geturl()!r}, which covers no login on the https vhost's root",
+        )
+    hosts = {u.netloc for u in allowed}
+    for name in server_names(docs):
+        check(
+            name in hosts,
+            f"a login started at https://{name}/ is refused: argocd-cm allows no URL on that host",
+        )
+
+
