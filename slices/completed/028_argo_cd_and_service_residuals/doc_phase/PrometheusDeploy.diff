+# The argocd group, over synthetic application-controller series. A sample is 1: what a series
+# says is in its labels. When an app's status changes, its argocd_app_info series changes labels,
+# so the old one ends `stale` in the scrape where the new one starts. A series of a controller
+# pod that is gone, or of a failed scrape, ends `stale` too. The tests assert the rules' own
+# windows and model no retry policy.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: a failed automated sync stands 10m after it ends, holds through a sync that fails again, and resolves 5m after the last sync's final scrape; drift, a hand-synced app and a long retry stay quiet
+    interval: 1m
+    input_series:
+      # kubecoder-prd: its sync runs until 4 m and ends failed, SyncError from 5 m. A new commit
+      # syncs 30-37 m and fails, with SyncError back at 39 m, one scrape later. A manual sync runs
+      # 50-52 m and succeeds.
