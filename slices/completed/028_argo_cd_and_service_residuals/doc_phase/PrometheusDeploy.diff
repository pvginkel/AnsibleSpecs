+#!/usr/bin/env python3
+"""Alertmanager's route tree as the upstream chart renders config/prd/values.yaml, at the pin
+architecture.yaml's `upstream:` gives.
+
+Every alert prd's rules raise reaches the Telegram receiver its severity picks, loud for
+critical and silent otherwise, and gets a "resolved" when it clears. D7's two Argo CD events,
+which Alertmanager expires at resolve_timeout whether or not the app recovered, reach receivers
+that send no "resolved" and are otherwise the same. The tree is walked the way Alertmanager's
+dispatcher walks it, for the route keys and matcher forms below; anything else fails the test.
+"""
+
+import pathlib
+import re
+import subprocess
+import sys
+
+import yaml
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+# D7's events, labelled as ArgoCDDeploy's notification templates label them.
+EVENTS = [
+    {"alertname": "ArgoCDSyncFailed", "severity": "critical", "application": "kubecoder-prd", "namespace": "kubecoder-prd"},
+    {"alertname": "ArgoCDHealthDegraded", "severity": "warning", "application": "kubecoder-prd", "namespace": "kubecoder-prd"},
+]
+ROUTE_KEYS = {"receiver", "matchers", "routes", "continue", "group_by", "group_wait", "group_interval", "repeat_interval"}
+MATCHER = re.compile(r'\s*([a-zA-Z_][a-zA-Z0-9_]*)\s*(=~|!~|!=|=)\s*"([^"\\]*)"\s*')
+# The flags a receiver may differ in; everything else in its telegram config is shared.
+FLAGS = ("disable_notifications", "send_resolved")
+
+
+def render():
+    upstream = yaml.safe_load((REPO / "architecture.yaml").read_text())["upstream"]
+    out = subprocess.run(
+        ["helm", "template", "prometheus-prd", upstream["chart"], "--repo", upstream["repo"],
+         "--version", str(upstream["version"]), "--namespace", "prometheus-prd",
+         "--values", "config/prd/values.yaml",
+         "--show-only", "charts/alertmanager/templates/configmap.yaml",
+         "--show-only", "templates/cm.yaml"],
+        cwd=REPO, check=True, capture_output=True, text=True).stdout
+    data = {}
+    for doc in yaml.safe_load_all(out):
+        data.update(doc["data"])
+    return yaml.safe_load(data["alertmanager.yml"]), yaml.safe_load(data["alerting_rules.yml"])
+
+
+def check_tree(route):
+    unknown = set(route) - ROUTE_KEYS
+    if unknown:
+        sys.exit(f"route keys this test does not model: {sorted(unknown)}")
+    for child in route.get("routes", []):
+        check_tree(child)
+
+
+def matches(matcher, labels):
+    parsed = MATCHER.fullmatch(matcher)
+    if not parsed:
+        sys.exit(f"matcher this test does not model: {matcher}")
+    name, op, value = parsed.groups()
+    actual = labels.get(name, "")
+    if op == "=":
+        return actual == value
+    if op == "!=":
+        return actual != value
+    hit = re.fullmatch(value, actual) is not None
+    return hit if op == "=~" else not hit
+
+
+def receivers(route, labels, inherited=None):
+    receiver = route.get("receiver", inherited)
+    found = []
+    for child in route.get("routes", []):
+        if all(matches(m, labels) for m in child.get("matchers", [])):
+            found += receivers(child, labels, receiver)
+            if not child.get("continue", False):
+                break
+    return found or [receiver]
+
+
+def main():
+    config, rules = render()
+    check_tree(config["route"])
+    telegram = {}
+    for receiver in config["receivers"]:
+        (telegram[receiver["name"]],) = receiver["telegram_configs"]
+    alerts = [{"alertname": rule["alert"], **rule.get("labels", {})}
+              for group in rules["groups"] for rule in group["rules"] if "alert" in rule]
+    event_names = {event["alertname"] for event in EVENTS}
+    failures = []
+
+    shared = {name: {k: v for k, v in cfg.items() if k not in FLAGS} for name, cfg in telegram.items()}
+    first = next(iter(shared.values()))
+    for name, cfg in shared.items():
+        if cfg != first:
+            failures.append(f"receiver {name} differs from the others beyond {FLAGS}: {cfg}")
+
+    for labels in alerts + EVENTS:
+        reached = receivers(config["route"], labels)
+        if len(reached) != 1:
+            failures.append(f"{labels['alertname']} reaches {reached}, not one receiver")
+            continue
+        (name,) = reached
+        cfg = telegram[name]
+        loud = labels.get("severity") == "critical"
+        resolved = labels["alertname"] not in event_names
+        print(f"{labels['alertname']} ({labels.get('severity')}) -> {name}")
+        if cfg["disable_notifications"] is loud:
+            failures.append(f"{labels['alertname']}: {name} is {'silent' if loud else 'loud'}")
+        if cfg["send_resolved"] is not resolved:
+            failures.append(f"{labels['alertname']}: {name} has send_resolved {cfg['send_resolved']}")
+
+    if failures:
+        print("\n".join(["FAILED:", *failures]), file=sys.stderr)
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
