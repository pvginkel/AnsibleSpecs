+#!/bin/sh
+# Readies Gitblit's Lucene state on the git volume ($1) before Gitblit starts. The gitblit pod's
+# clean-lucene-locks init container runs it on busybox, which has no git; tests/clean-lucene.sh
+# runs it over a fixture.
+set -eu -o pipefail
+root=$1
+
+find "$root" -type f -path '*/lucene/*' \
+  \( -name 'write.lock' -o -name 'gb_lucene.conf.lock*' \) -exec rm {} +
+
+# <repo>.git/lucene/<index version>/gb_lucene.conf holds, for each branch Gitblit has indexed, an
+# [aliases] entry (SHA-1 of the ref name = the ref name) and a [branches] entry under the same key
+# (the last commit indexed). Gitblit never removes them. On every index cycle it deletes the
+# documents of each aliased branch it no longer indexes, and reopens the repository's index
+# writer to do so. Both entries go for each such branch.
+#
+# Gitblit 1.10 indexes the local branches that the repository config's gitblit.indexBranch lists.
+# When that list holds "default", it also indexes the first local branch whose tip is HEAD's
+# commit, or any local branch when HEAD does not resolve. Every branch that could be that one
+# stays: a dropped [branches] entry makes Gitblit index the branch's whole history again.
+find "$root" -type f -path '*/lucene/*/gb_lucene.conf' | while IFS= read -r conf; do
+  # The pruned copy carries the lock name the find above deletes, so an interrupted run leaves
+  # nothing behind.
+  awk -v repo="${conf%/lucene/*/gb_lucene.conf}" -v out="$conf.lock" '
+    # A git config value, as a ref name can spell it: ref names hold no blanks or control
+    # characters, so only quotes, backslash escapes and a trailing comment need undoing.
+    function decode(s,    v, q, c, i) {
+      v = ""; q = 0
+      for (i = 1; i <= length(s); i++) {
+        c = substr(s, i, 1)
+        if (c == "\\") v = v substr(s, ++i, 1)
+        else if (c == "\"") q = !q
+        else if (!q && (c == "#" || c == ";")) break
+        else if (c != " " && c != "\t") v = v c
+      }
+      return v
+    }
+    function section(line) {
+      sub(/^[ \t]*\[/, "", line); sub(/\].*/, "", line); gsub(/[ \t]/, "", line)
+      return tolower(line)
+    }
+    function key(line) {
+      if (line ~ /^[ \t]*([#;]|$)/) return ""
+      sub(/=.*/, "", line); gsub(/[ \t]/, "", line)
+      return tolower(line)
+    }
+    function value(line) {
+      return decode(substr(line, index(line, "=") + 1))
+    }
+    # The object a ref resolves to, the loose ref before packed-refs; "" when there is none.
+    function tip(ref,    f, line) {
+      f = repo "/" ref
+      if ((getline line < f) > 0) {
+        close(f)
+        return line ~ /^ref: / ? tip(substr(line, 6)) : line
+      }
+      close(f)
+      return ref in packed ? packed[ref] : ""
+    }
+    function indexed(ref,    t) {
+      if (ref in listed) return 1
+      if (!("default" in listed)) return 0
+      t = tip(ref)
+      return t != "" && (head == "" || t == head)
+    }
+    BEGIN {
+      f = repo "/config"
+      while ((getline line < f) > 0) {
+        if (line ~ /^[ \t]*\[/) s = section(line)
+        else if (s == "gitblit" && key(line) == "indexbranch") listed[value(line)] = 1
+      }
+      close(f)
+      if ("default" in listed) {
+        f = repo "/packed-refs"
+        while ((getline line < f) > 0)
+          if (split(line, p, " ") == 2 && p[1] ~ /^[0-9a-f]+$/) packed[p[2]] = p[1]
+        close(f)
+        head = tip("HEAD")
+      }
+    }
+    FNR == 1 {
+      s = ""
+      if (++pass == 2) {
+        for (k in alias)
+          if (!indexed(alias[k])) { stale[k] = 1; n++; print FILENAME ": dropped " alias[k] }
+        if (!n) exit
+      }
+    }
+    /^[ \t]*\[/ { s = section($0); if (pass == 2) print > out; next }
+    pass == 1 { if (s == "aliases" && (k = key($0)) != "") alias[k] = value($0); next }
+    !((s == "aliases" || s == "branches") && (key($0) in stale)) { print > out }
+  ' "$conf" "$conf"
+  [ -e "$conf.lock" ] || continue
+  chown "$(stat -c %u:%g "$conf")" "$conf.lock"
+  chmod "$(stat -c %a "$conf")" "$conf.lock"
+  mv "$conf.lock" "$conf"
+done
