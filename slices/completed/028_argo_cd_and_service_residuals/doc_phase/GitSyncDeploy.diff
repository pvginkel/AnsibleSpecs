@@ -0,0 +1,154 @@
+#!/bin/sh
+# chart/files/clean-lucene.sh, the script the gitblit pod's clean-lucene-locks init container runs,
+# over a fixture laid out like the git volume, with busybox's applets as the only commands.
+# Run it under busybox: `busybox sh tests/clean-lucene.sh`.
+set -eu
+cd "$(dirname "$0")/.."
+script=$PWD/chart/files/clean-lucene.sh
+busybox=$(command -v busybox)
+tmp=$("$busybox" mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+mkdir "$tmp/bin"
+for applet in $("$busybox" --list); do ln -s "$busybox" "$tmp/bin/$applet"; done
+PATH=$tmp/bin
+
+git=$tmp/git
+failed=0
+fail() { echo "FAIL: $*"; failed=1; }
+
+key() { printf %s "$1" | sha1sum | cut -c1-40; }
+
+# A config value as git and JGit write it.
+quote() {
+  case $1 in
+    *[#\;]*) printf '"%s"' "$1" ;;
+    *) printf %s "$1" ;;
+  esac
+}
+
+# gb_lucene.conf as Gitblit writes it, for the given refs, each indexed up to a made-up commit.
+lucene_conf() {
+  printf '[aliases]\n'
+  for ref; do printf '\t%s = %s\n' "$(key "$ref")" "$(quote "$ref")"; done
+  printf '[branches]\n'
+  for ref; do printf '\t%s = %s\n' "$(key "$ref")" "$(key "commit $ref")"; done
+}
+
+# A bare mirror as git-sync leaves it: repo <path> <HEAD's branch>, its gitblit.indexBranch values
+# on stdin.
+repo() {
+  mkdir -p "$git/$1/refs/heads" "$git/$1/lucene/6_54"
+  printf 'ref: refs/heads/%s\n' "$2" > "$git/$1/HEAD"
+  {
+    printf '[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = true\n'
+    printf '[remote "origin"]\n\turl = https://github.com/%s\n' "$1"
+    printf '\tfetch = +refs/*:refs/*\n\tmirror = true\n'
+    printf '[gitblit]\n'
+    while IFS= read -r ref; do printf '\tindexBranch = %s\n' "$(quote "$ref")"; done
+    printf '[fetch]\n\tunpackLimit = 1\n'
+  } > "$git/$1/config"
+}
+
+conf() { echo "$git/$1/lucene/6_54/gb_lucene.conf"; }
+
+main=1111111111111111111111111111111111111111
+older=2222222222222222222222222222222222222222
+
+# Branches listed by full ref name, as git-sync writes them (tags included, which Gitblit never
+# indexes). Two branches are gone from the list.
+repo owner/listed.git main <<EOF
+refs/heads/main
+refs/tags/v1.0
+refs/heads/fix#12
+refs/heads/feature/search
+EOF
+lucene_conf refs/heads/main refs/heads/gone 'refs/heads/fix#12' refs/heads/feature/search \
+  'refs/heads/old;wip' > "$(conf owner/listed.git)"
+chmod 640 "$(conf owner/listed.git)"
+
+# "default" beside a listed branch. HEAD's branch is loose at $main over a packed $older; twin shares
+# HEAD's commit, so Gitblit can take it for the default branch; diverged does not; deleted is gone.
+repo owner/default.git main <<EOF
+default
+refs/heads/release
+EOF
+printf '%s\n' '# pack-refs with: peeled fully-peeled sorted ' \
+  "$older refs/heads/diverged" "$older refs/heads/main" "$older refs/heads/release" \
+  "$main refs/heads/twin" > "$git/owner/default.git/packed-refs"
+echo "$main" > "$git/owner/default.git/refs/heads/main"
+lucene_conf refs/heads/main refs/heads/twin refs/heads/diverged refs/heads/deleted \
+  refs/heads/release > "$(conf owner/default.git)"
+
+# "default" with HEAD naming a branch that is gone: Gitblit then takes its most recently updated
+# branch, which can be any of them.
+repo owner/dangling.git gone <<EOF
+default
+EOF
+echo "$main" > "$git/owner/dangling.git/refs/heads/kept"
+lucene_conf refs/heads/kept refs/heads/deleted > "$(conf owner/dangling.git)"
+
+# Nothing stale.
+repo other/clean.git main <<EOF
+refs/heads/main
+refs/heads/dev
+EOF
+lucene_conf refs/heads/main refs/heads/dev > "$(conf other/clean.git)"
+
+touch "$git/owner/listed.git/lucene/6_54/write.lock" "$git/other/clean.git/lucene/6_54/gb_lucene.conf.lock"
+listed_attrs=$(stat -c '%u:%g %a' "$(conf owner/listed.git)")
+clean_before=$(stat -c '%i %Y' "$(conf other/clean.git)")
+
+sh "$script" "$git" > "$tmp/run1"
+
+expect() {
+  if ! cmp -s "$2" "$tmp/expected"; then
+    fail "$1"
+    diff -u "$tmp/expected" "$2" || true
+  fi
+}
+
+lucene_conf refs/heads/main 'refs/heads/fix#12' refs/heads/feature/search > "$tmp/expected"
+expect 'owner/listed.git: stale entries dropped, listed ones kept' "$(conf owner/listed.git)"
+[ "$(stat -c '%u:%g %a' "$(conf owner/listed.git)")" = "$listed_attrs" ] ||
+  fail 'owner/listed.git: owner or mode changed'
+
+lucene_conf refs/heads/main refs/heads/twin refs/heads/release > "$tmp/expected"
+expect 'owner/default.git: branches at HEAD'"'"'s commit and listed ones kept' "$(conf owner/default.git)"
+
+lucene_conf refs/heads/kept > "$tmp/expected"
+expect 'owner/dangling.git: existing branches kept' "$(conf owner/dangling.git)"
+
+lucene_conf refs/heads/main refs/heads/dev > "$tmp/expected"
+expect 'other/clean.git: content unchanged' "$(conf other/clean.git)"
+[ "$(stat -c '%i %Y' "$(conf other/clean.git)")" = "$clean_before" ] ||
+  fail 'other/clean.git: rewritten'
+
+for lock in owner/listed.git/lucene/6_54/write.lock other/clean.git/lucene/6_54/gb_lucene.conf.lock; do
+  [ ! -e "$git/$lock" ] || fail "$lock: not deleted"
+done
+[ -z "$(find "$git" -name 'gb_lucene.conf.lock*')" ] || fail 'a pruned copy was left behind'
+
+{
+  echo "$(conf owner/listed.git): dropped refs/heads/gone"
+  echo "$(conf owner/listed.git): dropped refs/heads/old;wip"
+  echo "$(conf owner/default.git): dropped refs/heads/diverged"
+  echo "$(conf owner/default.git): dropped refs/heads/deleted"
+  echo "$(conf owner/dangling.git): dropped refs/heads/deleted"
+} | sort > "$tmp/expected"
+sort "$tmp/run1" > "$tmp/run1.sorted"
+expect 'first run: one line per dropped branch' "$tmp/run1.sorted"
+
+snapshot() {
+  find "$git" | sort | while IFS= read -r f; do
+    stat -c '%n %i %Y %a' "$f"
+    [ ! -f "$f" ] || sha1sum "$f"
+  done
+}
+snapshot > "$tmp/expected"
+sh "$script" "$git" > "$tmp/run2"
+[ ! -s "$tmp/run2" ] || fail "second run dropped: $(cat "$tmp/run2")"
+snapshot > "$tmp/after"
+expect 'second run: nothing changed' "$tmp/after"
+
+[ "$failed" = 0 ] && echo 'clean-lucene: all checks passed'
+exit "$failed"
