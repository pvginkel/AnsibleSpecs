+#!/usr/bin/env python3
+"""The handover keeps the ids — the real case, run end to end.
+
+    cexec iac python3 aac-tools/checks/handover_equality.py
+
+Clones a deploy repo, copies the annotation layer beside this script into it, runs the
+generator from source over the clone for one stage, and compares what it wrote with
+what the app's current producer publishes for that app and stage: the same element
+ids, the same relation ids, and every field equal bar three. Exit 0 means a producer
+could take the app over today and no inbound edge in the federation would dangle.
+
+Not part of `kc project test`, and not meant to be: this needs a sibling deploy-repo
+checkout, the chart repository and the live published dataset, and CI and a cold
+checkout have none of the three. The checkout is cloned rather than used in place
+because a run reads `architecture.yaml` at the repo root and writes
+`docs/architecture/`, and neither file belongs to the deploy repo yet.
+
+The reference side is live, so a chart or values change published between two runs
+moves the target: a container added or removed shifts the element count and its edges,
+an exposed host changed shifts the interfaces. That is the check working — the counts
+below are derived from the dataset every run, never pinned.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import urllib.request
+from pathlib import Path
+
+import yaml
+
+HERE = Path(__file__).resolve().parent
+GENERATOR = HERE.parent / "image" / "gen_architecture.py"
+FIXTURE = HERE / "kubecoder-architecture.yaml"
+
+ELEMENT_ARRAYS = (
+    "systemSoftware",
+    "applicationComponents",
+    "applicationServices",
+    "applicationInterfaces",
+)
+
+# The fields that may differ, and why none of them is a defect:
+#   producer    — by construction; the whole point of a handover.
+#   logo        — added centrally when the federation merges producers; no generator
+#                 emits it.
+#   stats.image — the two repos pin different tags today, a real difference in what
+#                 each would deploy rather than a difference in the model.
+IGNORED_FIELDS = frozenset({"producer", "logo"})
+IGNORED_STATS = frozenset({"image"})
+
+
+def _generator_module():
+    """The generator's own constants, so the check cannot drift from the file it runs.
+
+    Loaded from its path because the image installs it as a command, not as a package
+    on PYTHONPATH. The run itself is a subprocess — the way a pipeline invokes it.
+    """
+    spec = importlib.util.spec_from_file_location("gen_architecture", GENERATOR)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+gen = _generator_module()
+
+
+def git(cwd, *args):
+    return subprocess.run(
+        ["git", *args], cwd=cwd, check=True, capture_output=True, text=True
+    ).stdout.strip()
+
+
+def clone(source, dest):
+    """A throwaway checkout of the deploy repo at its committed HEAD.
+
+    The clone is given the source's own origin: `hook.repo` is the repository Argo
+    syncs, and cloning from a path would hand the render a local one.
+    """
+    origin = git(source, "remote", "get-url", "origin")
+    git(None, "clone", "--quiet", str(source), str(dest))
+    git(dest, "remote", "set-url", "origin", origin)
+    return git(dest, "rev-parse", "HEAD")
+
+
+def generate(repo, stage, producer, dataset):
+    """Run the generator over the clone and read back what it wrote."""
+    env = dict(
+        os.environ,
+        # Both sides read one snapshot, so a publish between the two reads cannot
+        # look like a difference.
+        ARCH_DATASET_URL=dataset,
+        # The published dataset is the whole reference here: an overlay would resolve
+        # ids the reference side does not carry.
+        ARCH_DATASET_OVERLAY="",
+    )
+    subprocess.run(
+        [
+            sys.executable,
+            str(GENERATOR),
+            "--stage",
+            stage,
+            "--producer",
+            producer,
+            "--repo",
+            str(repo),
+        ],
+        check=True,
+        env=env,
+    )
+    written = repo / "docs" / "architecture" / f"{producer}.yaml"
+    return yaml.safe_load(written.read_text(encoding="utf-8"))
+
+
+def load_dataset(source):
+    """The merged published dataset, from a URL or a file — the generator's own rule."""
+    if re.match(r"^[a-z][a-z0-9+.\-]*://", source):
+        with urllib.request.urlopen(source, timeout=60) as resp:
+            return yaml.safe_load(resp.read().decode("utf-8"))
+    return yaml.safe_load(Path(source).read_text(encoding="utf-8"))
+
+
+def hint(element_id):
+    """`app:kubecoder-prd-bot,<uuid>` -> `kubecoder-prd-bot` — a composite id's natural half."""
+    return element_id.split(":", 1)[1].split(",", 1)[0]
+
+
+def elements(envelope):
+    return {e["id"]: e for array in ELEMENT_ARRAYS for e in (envelope.get(array) or [])}
+
+
+def relations(envelope):
+    return {r["id"]: r for r in (envelope.get("relations") or [])}
+
+
+def app_elements(dataset, producer, app):
+    """Everything `producer` publishes for `app`, in every stage.
+
+    The published model keys a container to its app through `stats.release`, but an
+    ingress interface carries no release at all. What both carry is an id minted from
+    a natural key that starts with the app's name. An exposed host renamed off that
+    prefix drops out of the target and surfaces as an extra on the generated side —
+    the check fails rather than passing quietly.
+    """
+    return {
+        e["id"]: e
+        for array in ELEMENT_ARRAYS
+        for e in (dataset.get(array) or [])
+        if e.get("producer") == producer
+        and (hint(e["id"]) == app or hint(e["id"]).startswith(f"{app}-"))
+    }
+
+
+def split_relations(dataset, target_ids, app_ids):
+    """The published relations the target owns, and the cross-stage ones among them.
+
+    A relation belongs to the target when at least one endpoint is in it. Left out are
+    those whose other endpoint is the same app in another stage: the current producer
+    renders every stage in one run and resolves a Service consumer by host alone, so
+    both stages' providers match and every consumer gets an edge from each. A
+    single-stage run has one namespace's instances to choose from and draws the true
+    edge only — the omission is a property of the handover, not a hole in the port.
+    """
+    target, cross = {}, {}
+    for r in dataset.get("relations") or []:
+        if r["source"] not in target_ids and r["target"] not in target_ids:
+            continue
+        other = r["target"] if r["source"] in target_ids else r["source"]
+        bucket = cross if other in app_ids and other not in target_ids else target
+        bucket[r["id"]] = r
+    return target, cross
+
+
+def normalize(element):
+    kept = {k: v for k, v in element.items() if k not in IGNORED_FIELDS}
+    if kept.get("stats"):
+        kept["stats"] = {k: v for k, v in kept["stats"].items() if k not in IGNORED_STATS}
+    return kept
+
+
+def differences(published, generated, label, prepare=lambda e: e):
+    lines = []
+    for eid in sorted(set(published) - set(generated)):
+        lines.append(f"{label} published but not generated: {eid}")
+    for eid in sorted(set(generated) - set(published)):
+        lines.append(f"{label} generated but not published: {eid}")
+    for eid in sorted(set(published) & set(generated)):
+        was, now = prepare(published[eid]), prepare(generated[eid])
+        for field in sorted(set(was) | set(now)):
+            if was.get(field) != now.get(field):
+                lines.append(
+                    f"{label} {eid}: {field}: published {was.get(field)!r} "
+                    f"!= generated {now.get(field)!r}"
+                )
+    return lines
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="handover_equality.py",
+        description="Prove a deploy repo's generator reproduces what the app's "
+        "current producer publishes for one stage.",
+    )
+    parser.add_argument(
+        "--deploy-repo",
+        default="/work/KubeCoderDeploy",
+        help="the deploy repo to clone and render (default: %(default)s)",
+    )
+    parser.add_argument("--stage", default="prd", help="the stage to render (default: %(default)s)")
+    parser.add_argument(
+        "--annotations",
+        default=str(FIXTURE),
+        help="the annotation layer to copy into the clone "
+        "(default: the fixture beside this script)",
+    )
+    parser.add_argument(
+        "--published-producer",
+        default="helm-charts",
+        help="the producer that publishes the app today (default: %(default)s)",
+    )
+    parser.add_argument(
+        "--producer",
+        default="kubecoder-deploy",
+        # Nothing rests on the value: it names the artifact and fills the envelope's
+        # `producer`, the one field the comparison is required to ignore. The id the
+        # deploy repo publishes under is registered in a later slice.
+        help="the producer id to generate under (default: %(default)s)",
+    )
+    parser.add_argument(
+        "--dataset",
+        default=gen.DATASET_URL,
+        help="the merged published dataset, a URL or a file (default: %(default)s)",
+    )
+    return parser.parse_args(argv)
+
+
+def main():
+    args = parse_args()
+    source = Path(args.deploy_repo).resolve()
+    dataset = load_dataset(args.dataset)
+
+    with tempfile.TemporaryDirectory() as tmp:
+        repo = Path(tmp) / source.name
+        head = clone(source, repo)
+        shutil.copyfile(args.annotations, repo / gen.ANNOTATIONS)
+        app = gen.chart_metadata(repo)["name"]
+        envelope = generate(repo, args.stage, args.producer, args.dataset)
+
+    published = app_elements(dataset, args.published_producer, app)
+    target = {i: e for i, e in published.items() if e.get("environment") == args.stage}
+    target_rel, cross = split_relations(dataset, set(target), set(published))
+    generated, generated_rel = elements(envelope), relations(envelope)
+
+    print(f"handover equality — {app} {args.stage}")
+    print(f"  deploy repo  {source} at {head[:12]}")
+    print(f"  dataset      {args.dataset}")
+    print(
+        f"  published    {args.published_producer}: {len(target)} elements, "
+        f"{len(target_rel)} relations"
+    )
+    print(
+        f"  generated    {args.producer}: {len(generated)} elements, {len(generated_rel)} relations"
+    )
+    for rid in sorted(cross):
+        print(f"  excluded (crosses the stage boundary): {rid}")
+
+    diffs = differences(target, generated, "element", normalize)
+    diffs += differences(target_rel, generated_rel, "relation")
+    if diffs:
+        for line in diffs:
+            print(line)
+        raise SystemExit(f"{len(diffs)} difference(s): the handover does not hold as it stands")
+    print("  equal — every id matches; producer, logo and stats.image are all that differ")
+
+
+if __name__ == "__main__":
+    main()
