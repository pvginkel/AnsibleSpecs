+#!/usr/bin/env python3
+"""Generate a deploy repo's architecture artifact for one stage.
+
+A deploy repo holds one app: the chart under `chart/`, one values file per stage
+under `config/<stage>/`, and the annotation layer this generator reads at the repo
+root. Argo CD renders a stage as `chart/` under the Application's own name
+`<app>-<stage>`, into the namespace of that name, with `../config/<stage>/values.yaml`
+and four `hook.*` parameters; this renders it the same way and parses the *rendered*
+manifests. Every container of every workload (init + main) becomes a running instance
+element, keyed `<namespace>.<workload>.<container>` with a deterministic UUID5 id.
+Each instance Specializes its product, is Served by the Kubernetes platform, realizes
+any annotated capabilities, and — where it mounts a Ceph PVC — is Served by the
+matching cluster storage service.
+
+One run emits exactly one stage: the artifact is attached to a pipeline, and a
+pipeline that listened to two stages would make the artifact flap. `--stage` is
+required and single-valued; nothing here reads the branch, and nothing here rules on
+which stages a repo may publish.
+
+On top of the structural model, the generator resolves the **runtime dependency**
+edges a deployment defines but does not own the recipe for:
+
+* `boundBy` edges — a consumer producer (e.g. DockerImages) authors
+  `app:<x> —Association→ cap:<y>` (or `svc:<y>`) carrying `boundBy: env:VAR`. We read
+  the rendered value of VAR off the consuming container, resolve the host to the
+  concrete provider instance, and emit `provider —Serving→ consumer`. Only the
+  renderer can do this — the value is runtime state, fenced out of the published
+  dataset.
+* the OpenBao secret-store edge — the ClusterSecretStore that points the External
+  Secrets Operator at OpenBao is a deployer-owned manifest, so `OpenBao —Serving→ ESO`
+  is ours to draw.
+* `upstream` edges — a generic proxy (mcp-filter) has no intrinsic target; the chart
+  declares the wire on its image entry and we draw `upstream —Serving→ proxy` from the
+  rendered env var (resolve_upstreams).
+
+Cross-producer ids (the DockerImages `app:`/`svc:` UUIDs, Ansible's OpenBao/platform
+UUIDs) are resolved from the published merged dataset (`load_dataset`), with local
+producer checkouts overlaid so freshly-authored — not-yet-published — recipes resolve
+while testing.
+
+Judgment lives in `architecture.yaml` at the repo root:
+
+    introduced: '2026-06-17'     # the app's date; a deploy repo's git history dates
+                                 #   the repo, so it cannot be derived here
+    images:                      # image name (registry:5000/<name>) -> product
+      dnsmasq-config-generator: app:dnsmasq-config-generator
+      dnsmasq:                   # long form when a capability/kind is needed
+        product: ss:dnsmasq
+        realizes: [cap:dns, cap:dhcp]
+      mcp-filter:                # a proxy: `env` locates the pod it fronts,
+        product: app:mcp-filter  #   `providers` names that pod's containers
+        upstream:                #   serving it (omitted when the host is a
+          env: MCP_UPSTREAM_URL  #   cross-producer element)
+          providers: [server]
+    cnpg:                        # CloudNativePG CRs -> product (Cluster/Pooler)
+      Cluster:                   #   the operator materializes these at runtime,
+        product: ss:postgresql   #   so there's no walkable workload — we read
+        realizes: [cap:relational-database]   # the CRs directly (see CNPG_KINDS)
+      Pooler:
+        product: ss:pgbouncer
+        realizes: [cap:relational-database]
+    products:                    # upstream «SoftwareProduct» entries this app owns
+      - id: ss:dnsmasq
+        label: dnsmasq
+        summary: Lightweight DNS forwarder and DHCP server.
+        homepage: https://thekelleys.org.uk/dnsmasq/doc.html
+    exposures:                   # service name -> the container its host routes to,
+      git-sync: gitblit          #   when the port cannot name it
+    webUi:                       # exposed hosts that are human, browser-facing
+      - grafana.home             #   UIs -> the interface carries `webUi: true`
+    mcpClients:                  # container -> the rendered ConfigMap listing the
+      intercom-server:           #   MCP servers it connects to
+        configMap: mcp-servers
+        key: servers.json
+        providers: {trello: [server]}
+
+Kind is derived from the product prefix (app: -> ApplicationComponent, ss: ->
+SystemSoftware). An image with no annotation is reported as a gap.
+
+The artifact is a build output: regenerate it, do not commit it and do not hand-edit
+it.
+
+Usage: gen-architecture --stage <stage> --producer <id> [--repo <path>]
+
+Environment:
+  ARCH_DATASET_URL      base merged dataset (default: live webathome.org);
+                        a value without a scheme is read as a local file.
+  ARCH_DATASET_OVERLAY  glob of local producer architecture files overlaid on
+                        the base (default: ../DockerImages/*/architecture.yaml
+                        beside the repo, if that sibling checkout exists).
+"""
+
+import argparse
+import datetime
+import glob
+import json
+import os
+import re
+import subprocess
+import sys
+import tempfile
+import urllib.request
+import uuid
+from pathlib import Path
+
+import yaml
+
+# The deploy-repo layout the releases ApplicationSet renders
+# (/work/ArgoCDDeploy/chart/templates/applicationsets.yaml): the chart, the stage's
+# values out of the chart path, and the annotation layer beside them.
+CHART_DIR = "chart"
+CONFIG_DIR = "config"
+ANNOTATIONS = "architecture.yaml"
+
+# Deterministic id namespace for this producer (UUID5 of a fixed URL). Ids are a pure
+# function of a stable natural key, so "never re-mint" holds by construction. The URL
+# still names `helm-charts` because these ids are the same ids: an app that moves from
+# HelmCharts to its own deploy repo keeps every element id and only changes owner, so
+# inbound edges from other producers never dangle. Changing this string re-mints the
+# estate's whole deploy-side model.
+NS = uuid.uuid5(uuid.NAMESPACE_URL, "https://architecture.webathome.org/producers/helm-charts")
+
+# Cross-producer attach points. The platform every pod runs on is a stable,
+# always-needed reference; the others are resolved from the published dataset
+# (see load_dataset / cross_producer_id). Kept as a constant only because it is
+# referenced unconditionally by every instance.
+MICROK8S_PRD = "ss:microk8s-prd,54ca8c6c-27ec-4e0d-ac17-cf3f65e7c5d4"
+
+# Published merged dataset (all producers) — the source of cross-producer UUIDs.
+DATASET_URL = "https://architecture.webathome.org/data/v0.1/architecture.yaml"
+
+# Connection-string host -> the cross-producer element (kind, hint) it names.
+# The host appears in a rendered value / store config; the UUID behind the hint
+# comes from the dataset, so only the host->hint mapping is hand-maintained.
+CROSS_PRODUCER_HOST_HINTS = {
+    "secrets.home": ("svc", "openbao-api-prd"),  # OpenBao (Ansible)
+    "ceph": ("svc", "ceph-vip-prd"),  # Ceph RGW S3 via the VIP
+    "homeassistant.webathome.org": ("ss", "home-assistant-prd"),  # Home Assistant (Architecture)
+}
+
+# Cluster-local storage services, referenced but not owned here: the elements are
+# minted by the producer that deploys the CSI drivers, and a deploy repo resolves the
+# same ids from the same namespace and natural key. CSI driver -> (service id, hint,
+# capability-suffix).
+CEPH_DRIVERS = {
+    "rbd.csi.ceph.com": ("svc:cluster-ceph-rbd", "cluster-ceph-rbd", "block"),
+    "cephfs.csi.ceph.com": ("svc:cluster-ceph-cephfs", "cluster-ceph-cephfs", "shared-fs"),
+}
+
+WORKLOAD_KINDS = {"Deployment", "StatefulSet", "DaemonSet", "Job", "CronJob"}
+
+# CloudNativePG declares its database substrate as custom resources the operator
+# materializes at runtime: a `Cluster` (the PostgreSQL instances) and a `Pooler`
+# (the PgBouncer front-end apps connect to). The operator-created pods/Services
+# never appear in `helm template`, so a chart that deploys these CRs has no
+# walkable workload for the database — we detect the CRs directly and emit the
+# substrate instances + the pooler's in-cluster Service host (see
+# emit_cnpg_substrate). Keyed by CR kind in the `cnpg:` annotation.
+CNPG_API_GROUP = "postgresql.cnpg.io"
+CNPG_KINDS = {"Cluster", "Pooler"}
+
+# Service annotations that expose a workload at an external host. server-name
+# drives the custom NGINX ingress; dns.webathome.org/hostname drives the
+# LoadBalancer/DNS path (e.g. step-ca at ca.home). Both name a host that a
+# boundBy value can resolve to.
+SERVER_NAME_ANNOTATION = "nginx.webathome.org/server-name"
+DNS_HOSTNAME_ANNOTATION = "dns.webathome.org/hostname"
+
+# Argo CD's lifecycle marker (see is_hook).
+HOOK_ANNOTATION = "argocd.argoproj.io/hook"
+
+
+def image_basename(ref):
+    """registry:5000/dnsmasq:latest -> dnsmasq; quay.io/keycloak/keycloak:24 -> keycloak."""
+    return ref.split("@", 1)[0].rsplit("/", 1)[-1].split(":", 1)[0]
+
+
+def run(args, cwd):
+    proc = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
+    if proc.returncode != 0:
+        # Surface the child's output before raising — otherwise a failing
+        # `helm template` (e.g. a malformed values file) shows only an opaque
+        # CalledProcessError in CI, with the real helm error hidden.
+        sys.stderr.write(proc.stdout)
+        sys.stderr.write(proc.stderr)
+        proc.check_returncode()
+    return proc.stdout
+
+
+def elt_uuid(natural_key):
+    # Honest UUID5 of the natural key (the schema id pattern is version-agnostic).
+    return str(uuid.uuid5(NS, natural_key))
+
+
+def composite(prefix, hint, natural_key):
+    return f"{prefix}:{hint},{elt_uuid(natural_key)}"
+
+
+def product_id(bare):
+    """Composite id for a «SoftwareProduct» catalog entry we own.
+
+    `bare` is the annotation form, e.g. `ss:dnsmasq` / `app:git-sync`; the
+    returned id keeps the hint and appends the deterministic UUID5.
+    """
+    prefix, name = bare.split(":", 1)
+    return composite(prefix, name, f"product.{bare}")
+
+
+def bare(ref):
+    """Strip the ,<uuid> off a composite id -> the `prefix:hint` form."""
+    return ref.split(",", 1)[0]
+
+
+def hint_of(ref):
+    """The hint part of a `prefix:hint[,uuid]` reference."""
+    b = bare(ref)
+    if ":" not in b:
+        raise ValueError(f"reference {ref!r} is not in `prefix:hint[,uuid]` form (no ':')")
+    return b.split(":", 1)[1]
+
+
+def pod_spec(doc):
+    spec = doc["spec"]
+    if doc["kind"] == "CronJob":
+        return spec["jobTemplate"]["spec"]["template"]["spec"]
+    return spec["template"]["spec"]
+
+
+def pod_labels(doc):
+    spec = doc["spec"]
+    tmpl = spec["jobTemplate"]["spec"]["template"] if doc["kind"] == "CronJob" else spec["template"]
+    return (tmpl.get("metadata") or {}).get("labels") or {}
+
+
+def kind_for(product):
+    return "SystemSoftware" if product.startswith("ss:") else "ApplicationComponent"
+
+
+def kebab(host):
+    return "".join(ch if ch.isalnum() else "-" for ch in host.lower()).strip("-")
+
+
+def container_ports(c):
+    """(set of declared containerPort numbers, set of port names) for a container."""
+    nums, names = set(), set()
+    for p in c.get("ports") or []:
+        cp = p.get("containerPort")
+        if cp is not None:
+            nums.add(int(cp))
+        if p.get("name"):
+            names.add(p["name"])
+    return nums, names
+
+
+# Helm-randomized one-shot Jobs name themselves `<base>-{{ randAlphaNum 5 |
+# lower }}` so each upgrade creates a fresh (immutable) Job. The suffix is
+# deploy noise, not identity — strip it so the instance id is stable across
+# renders. Scoped to Job (CronJob/Deployment names are already stable).
+RANDOM_JOB_SUFFIX = re.compile(r"-[a-z0-9]{5}$")
+
+
+def stable_workload_name(kind, name):
+    return RANDOM_JOB_SUFFIX.sub("", name) if kind == "Job" else name
+
+
+LOOPBACK_HOSTS = {"127.0.0.1", "localhost", "::1", "0.0.0.0"}
+
+# The storage service ids, derived rather than minted (see CEPH_DRIVERS).
+CEPH_SERVICE_IDS = {
+    svc: composite("svc", hint, f"svc.{hint}") for svc, hint, _suffix in CEPH_DRIVERS.values()
+}
+
+
+# --------------------------------------------------------------------------- #
+# The deploy repo: what it is called, what it renders, what it annotates
+# --------------------------------------------------------------------------- #
+
+
+def chart_metadata(repo):
+    return yaml.safe_load((repo / CHART_DIR / "Chart.yaml").read_text(encoding="utf-8"))
+
+
+def annotations(repo):
+    """The repo-root annotation layer, and the app's `introduced` date.
+
+    `introduced` cannot be derived here: HelmCharts reads the first commit touching
+    `charts/<chart>`, but a deploy repo's history dates the repo, not the app. An
+    unquoted YAML date resolves to a `date` object, so normalize — the schema wants
+    the ISO string and quoting is not the annotation author's to remember.
+    """
+    path = repo / ANNOTATIONS
+    if not path.exists():
+        raise SystemExit(
+            f"gen-architecture: {path} does not exist; a generated "
+            f"producer's judgment layer is not optional"
+        )
+    ann = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
+    introduced = ann.get("introduced")
+    if not introduced:
+        raise SystemExit(
+            f"gen-architecture: {path} declares no `introduced:`; a "
+            f"deploy repo's git history dates the repo, not the app"
+        )
+    if isinstance(introduced, datetime.date):
+        introduced = introduced.isoformat()
+    return ann, introduced
+
+
+def release_label(app, stage):
+    """What an element's summary and `stats.release` quote.
+
+    The published model names the prd release by the app alone and suffixes every
+    other stage. Kept verbatim so an app that moves to its own deploy repo keeps the
+    release name its elements already carry.
+    """
+    return app if stage == "prd" else f"{app}@{stage}"
+
+
+def dependency_urls(meta):
+    """The chart repositories `helm dependency build` has to be told about.
+
+    Only a remote repository needs adding; a `file://` dependency resolves off disk.
+    """
+    urls = []
+    for dep in meta.get("dependencies") or []:
+        url = dep.get("repository") or ""
+        if url.startswith(("http://", "https://")) and url not in urls:
+            urls.append(url)
+    return urls
+
+
+def build_dependencies(repo, meta, repo_config):
+    """Resolve `chart/Chart.lock` into `chart/charts/`, as Argo's repo-server does.
+
+    Helm cannot template an unresolved dependency, and `helm dependency build`
+    resolves a dependency's repository through helm's local repository list, so each
+    entry has to exist first. The list is built in a temporary file: a run must not
+    depend on — or rewrite — the caller's helm configuration.
+    """
+    urls = dependency_urls(meta)
+    if not urls:
+        return
+    for url in urls:
+        run(
+            [
+                "helm",
+                "repo",
+                "add",
+                kebab(url.split("://", 1)[1]),
+                url,
+                "--force-update",
+                "--repository-config",
+                str(repo_config),
+            ],
+            cwd=repo,
+        )
+    run(
+        ["helm", "dependency", "build", CHART_DIR, "--repository-config", str(repo_config)],
+        cwd=repo,
+    )
+
+
+def hook_parameters(repo, stage, namespace):
+    """The four `hook.*` parameters the ApplicationSet passes every app it syncs.
+
+    The shared library `required`-guards all four
+    (/work/Charts/charts/homelab-shared/templates/_tf-presync-hook.tpl), so a render
+    missing one fails whole for any app that includes the Terraform PreSync hook —
+    not just the hook Job. The values reach no element: every hook resource is
+    dropped from the render (HOOK_ANNOTATION).
+    """
+    return {
+        "hook.repo": run(["git", "remote", "get-url", "origin"], cwd=repo).strip(),
+        "hook.revision": run(["git", "rev-parse", "HEAD"], cwd=repo).strip(),
+        "hook.stage": stage,
+        "hook.namespace": namespace,
+    }
+
+
+def template_args(stage, namespace, release_name, parameters):
+    """The `helm template` call the releases ApplicationSet has Argo make: the chart
+    under the Application's own name, into its namespace, with the stage's values
+    reached out of the chart path."""
+    args = [
+        "helm",
+        "template",
+        release_name,
+        CHART_DIR,
+        "--namespace",
+        namespace,
+        "--values",
+        f"{CONFIG_DIR}/{stage}/values.yaml",
+    ]
+    for name, value in parameters.items():
+        args += ["--set", f"{name}={value}"]
+    return args
+
+
+def is_hook(doc):
+    """An Argo CD lifecycle hook, which the model leaves to the deployment.
+
+    A hook resource is deploy machinery, not the app's architecture — and the
+    estate's Terraform PreSync hook Job carries `generateName` only, so it has no
+    name to build a natural key from either.
+    """
+    return HOOK_ANNOTATION in ((doc.get("metadata") or {}).get("annotations") or {})
+
+
+def render(repo, meta, stage, namespace, release_name):
+    """The stage's rendered manifests, the way Argo CD's repo-server renders them."""
+    with tempfile.TemporaryDirectory() as tmp:
+        build_dependencies(repo, meta, Path(tmp) / "repositories.yaml")
+    out = run(
+        template_args(stage, namespace, release_name, hook_parameters(repo, stage, namespace)),
+        cwd=repo,
+    )
+    return [d for d in yaml.safe_load_all(out) if d and not is_hook(d)]
+
+
+# --------------------------------------------------------------------------- #
+# Cross-producer dataset ingestion
+# --------------------------------------------------------------------------- #
+
+
+class Dataset:
+    """In-memory index over the published merged model + local overlays.
+
+    Only used to resolve *cross-producer* references to their UUIDs and to
+    read the consumer recipes (boundBy edges, app->service realizations) that
+    other producers author. We never look our own elements up here.
+    """
+
+    def __init__(self):
+        self.by_hint = {}  # (kind, hint) -> composite id
+        self.relations = []  # every relation across all envelopes
+        self.boundby_by_source = {}  # bare source id -> [relation,...] (boundBy set)
+        self.app_provides_svc = {}  # bare app id -> [svc composite id,...]
+        self.svc_provider_app = {}  # bare svc id -> bare app id
+
+    def add_envelope(self, env):
+        for key, val in (env or {}).items():
+            if key == "relations" or not isinstance(val, list):
+                continue
+            for el in val:
+                if isinstance(el, dict) and "id" in el:
+                    # Only composite `prefix:hint[,uuid]` ids are cross-producer
+                    # references we index by hint. Plain-slug constructs (e.g.
+                    # `views` entries, whose ids are bare names) aren't elements
+                    # and aren't resolvable by hint — skip them.
+                    if ":" not in bare(el["id"]):
+                        continue
+                    prefix, _, _rest = el["id"].partition(":")
+                    self.by_hint[(prefix, hint_of(el["id"]))] = el["id"]
+        for r in (env or {}).get("relations") or []:
+            self.relations.append(r)
+            if "boundBy" in r:
+                self.boundby_by_source.setdefault(bare(r["source"]), []).append(r)
+            if r.get("type") == "Realization":
+                s, t = bare(r["source"]), bare(r["target"])
+                if s.startswith("app:") and t.startswith("svc:"):
+                    self.app_provides_svc.setdefault(s, []).append(r["target"])
+                    self.svc_provider_app[t] = s
+
+    def full(self, kind, hint):
+        return self.by_hint.get((kind, hint))
+
+
+def load_dataset(repo):
+    """Build the cross-producer index: live merged dataset + local overlay.
+
+    Base = ARCH_DATASET_URL (default the live merged dataset; a scheme-less
+    value is read as a file). Overlay = ARCH_DATASET_OVERLAY (default the
+    sibling DockerImages checkout if present) — its envelopes are added so a
+    producer whose data is authored but not yet published still resolves. The
+    overlay may be several globs joined by os.pathsep (':'), so more than one
+    sibling producer checkout can be overlaid at once.
+    """
+    ds = Dataset()
+
+    base = os.environ.get("ARCH_DATASET_URL", DATASET_URL)
+    if re.match(r"^[a-z][a-z0-9+.\-]*://", base):
+        try:
+            with urllib.request.urlopen(base, timeout=30) as resp:
+                text = resp.read().decode("utf-8")
+        except Exception as e:  # noqa: BLE001 — surface the URL and bail
+            raise SystemExit(f"gen-architecture: cannot fetch dataset {base}: {e}") from e
+    else:
+        text = Path(base).read_text(encoding="utf-8")
+    for env in yaml.safe_load_all(text):
+        if env:
+            ds.add_envelope(env)
+
+    overlay = os.environ.get(
+        "ARCH_DATASET_OVERLAY", str(repo.parent / "DockerImages" / "*" / "architecture.yaml")
+    )
+    seen = set()
+    for pattern in overlay.split(os.pathsep):
+        for path in sorted(glob.glob(pattern.strip())):
+            if path in seen:
+                continue
+            seen.add(path)
+            ds.add_envelope(yaml.safe_load(Path(path).read_text(encoding="utf-8")))
+
+    return ds
+
+
+def cross_producer_id(host, ds):
+    """Resolve a connection-string host to a cross-producer element id."""
+    kindhint = CROSS_PRODUCER_HOST_HINTS.get(host)
+    if not kindhint:
+        return None
+    return ds.full(*kindhint)
+
+
+# --------------------------------------------------------------------------- #
+# boundBy host parsing
+# --------------------------------------------------------------------------- #
+
+# Kubernetes `$(VAR)` dependent-env reference (and the `$$(` escape for a
+# literal `$(`). The kubelet expands `$(VAR)` to a *preceding* env var's value
+# in the same container; a name with no match is left verbatim. We mirror that
+# so a connection string assembled from sibling vars — e.g. DATABASE_URL =
+# `...@$(DB_HOST)/$(DB_NAME)` with DB_HOST a literal chart value — yields the
+# real host before parse_host sees it.
+ENV_REF = re.compile(r"\$\(([A-Za-z_][A-Za-z0-9_]*)\)|\$\$\(")
+
+
+def expand_env_refs(value, env):
+    """Resolve `$(VAR)` references in `value` against the container's `env` map.
+
+    `env` is the {name: value} map of literal-valued env vars on the same
+    container (valueFrom entries aren't here — a `$(SECRET_VAR)` therefore stays
+    verbatim, which is correct: its runtime value is unpublished state, and a
+    host is never carried in a secret). Recursive references resolve depth-first;
+    a reference cycle or a name resolving to itself is broken by leaving the
+    unresolved reference verbatim (the kubelet would too — it only substitutes
+    *preceding* vars). `$$(` is the documented escape for a literal `$(`.
+    """
+
+    def repl(m, _seen):
+        if m.group(0) == "$$(":
+            return "$("
+        name = m.group(1)
+        if name not in env or name in _seen:
+            return m.group(0)
+        return ENV_REF.sub(lambda mm: repl(mm, _seen | {name}), env[name])
+
+    return ENV_REF.sub(lambda m: repl(m, frozenset()), value)
+
+
+def parse_host(value):
+    """(host, port) from a connection string, preserving identity.
+
+    Strips scheme (incl. compound `postgresql+psycopg`, `amqp`), `user:pass@`
+    and `/path` — but keeps host AND port, because same-pod/localhost services
+    differ only by port and collapsing it would lose identity. port is None
+    when absent.
+    """
+    v = value.strip()
+    v = re.sub(r"^[a-zA-Z][a-zA-Z0-9+.\-]*://", "", v)  # scheme
+    v = v.split("/", 1)[0]  # drop /path
+    v = v.rsplit("@", 1)[-1]  # drop user:pass@
+    if v.startswith("["):  # IPv6 [::1]:port
+        host, _, rest = v[1:].partition("]")
+        port = rest[1:] if rest.startswith(":") else None
+    elif v.count(":") == 1:
+        host, port = v.split(":", 1)
+    else:
+        host, port = v, None
+    return host, (port or None)
+
+
+def normalize_incluster(host, consumer_ns):
+    """(ns, svc) if host is Kubernetes Service DNS, else None.
+
+    Recognizes exactly `<svc>`, `<svc>.<ns>`, `<svc>.<ns>.svc[.cluster.local]`.
+    A bare name takes the consumer's namespace; the dotted forms carry their
+    own. Never strips ports, never strips arbitrary domains — a non-cluster
+    host like `ca.home` falls through to None unless an actual (ns,svc) of that
+    shape exists (the caller checks membership before trusting the result).
+    """
+    h = host
+    for suffix in (".svc.cluster.local", ".svc"):
+        if h.endswith(suffix):
+            h = h[: -len(suffix)]
+            break
+    parts = h.split(".")
+    if len(parts) == 1:
+        return (consumer_ns, parts[0])
+    if len(parts) == 2:
+        return (parts[1], parts[0])
+    return None
+
+
+# --------------------------------------------------------------------------- #
+# Provider index + resolvers
+# --------------------------------------------------------------------------- #
+
+
+def build_provider_index(all_services, workloads_by_ns):
+    """external: host -> [instance id,...]; incluster: (ns,svc) -> [instance id,...].
+
+    Backing instances are every container of a workload the Service selects,
+    SystemSoftware included — an upstream app's exposed host is backed by an
+    ss: container (Keycloak/Jenkins), not an ApplicationComponent.
+    """
+    external, incluster = {}, {}
+    for svc in all_services:
+        doc, ns = svc["doc"], svc["ns"]
+        name = doc["metadata"]["name"]
+        selector = (doc.get("spec") or {}).get("selector") or {}
+        backing = []
+        if selector:
+            for w in workloads_by_ns.get(ns, []):
+                if all(w["labels"].get(k) == v for k, v in selector.items()):
+                    backing.extend(w["all"])
+        if backing:
+            incluster.setdefault((ns, name), []).extend(backing)
+        anns = doc["metadata"].get("annotations") or {}
+        hosts = []
+        for a in (SERVER_NAME_ANNOTATION, DNS_HOSTNAME_ANNOTATION):
+            hosts += [h.strip() for h in (anns.get(a) or "").split(",") if h.strip()]
+        for h in hosts:
+            external.setdefault(h, []).extend(backing)
+    return external, incluster
+
+
+def resolve_host(host, consumer_ns, external, incluster, ds):
+    """(provider instance ids, is_cross_producer) or ([], None) if unresolved."""
+    nk = normalize_incluster(host, consumer_ns)
+    if nk and nk in incluster:
+        return incluster[nk], False
+    if host in external:
+        return external[host], False
+    xid = cross_producer_id(host, ds)
+    if xid:
+        return [xid], True
+    return [], None
+
+
+def resolve_svc_target(svc_target, value, consumer, instances_by_product, ds):
+    """A boundBy `svc:<id>` names an in-house provider service: map it to the
+    app that realizes it, then to the long-running instance we deploy of that
+    app. When the app runs in several workloads, the rendered value *locates*
+    which one — a loopback host means the same pod, else a same-release backing
+    workload; otherwise the workload whose name appears in the host (e.g.
+    `dns-0.dns-headless` -> the `dns` workload)."""
+    app_bare = ds.svc_provider_app.get(bare(svc_target))
+    if not app_bare:
+        return None
+    cands = [i for i in instances_by_product.get(app_bare, []) if not i["is_init"]]
+    if len(cands) <= 1:
+        return cands
+    host, _ = parse_host(value)
+    if host in LOOPBACK_HOSTS:
+        # localhost cannot cross the pod, let alone the namespace/release: resolve
+        # to the same pod, else a same-release backing workload. Never fall back
+        # to every release's instance — that fans one sidecar recipe out across
+        # every app deploying the same product (e.g. the SSE gateway sidecar).
+        # Empty → the caller reports the recipe unresolved.
+        same_pod = [i for i in cands if i["ns"] == consumer["ns"] and i["wl"] == consumer["wl"]]
+        same_release = [i for i in cands if i["release"] == consumer["release"]]
+        return same_pod or same_release
+    narrowed = [i for i in cands if i["wl"] in host]
+    return narrowed or cands
+
+
+# --------------------------------------------------------------------------- #
+# main
+# --------------------------------------------------------------------------- #
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(
+        prog="gen-architecture",
+        description="Generate a deploy repo's architecture artifact for one stage.",
+    )
+    # One run, one stage: the artifact is attached to a pipeline, and a pipeline
+    # listening to two stages would make it flap. No default, no "all stages", and
+    # nothing here reads the branch.
+    parser.add_argument(
+        "--stage",
+        required=True,
+        help="the stage to render (names config/<stage>/values.yaml "
+        "and the <app>-<stage> namespace)",
+    )
+    parser.add_argument(
+        "--producer",
+        required=True,
+        help="the producer id this artifact is published under, as "
+        "registered in the federation's pipeline-producers.yaml",
+    )
+    parser.add_argument(
+        "--repo", default=".", help="the deploy repo's checkout (default: the current directory)"
+    )
+    return parser.parse_args(argv)
+
+
+def main():
+    args = parse_args()
+    repo = Path(args.repo).resolve()
+    stage, producer = args.stage, args.producer
+
+    ann, introduced = annotations(repo)
+    meta = chart_metadata(repo)
+    app = meta["name"]
+    # Argo names the Application, its namespace and the helm release `<app>-<stage>`.
+    ns = release_name = f"{app}-{stage}"
+    env = stage
+    release = release_label(app, stage)
+
+    elements = {
+        "systemSoftware": {},
+        "applicationComponents": {},
+        "applicationServices": {},
+        "applicationInterfaces": {},
+    }
+    relations = {}
+    gaps = []
+    deferred = set()  # bare cross-producer refs no producer resolves yet
+    # «SoftwareProduct» catalog entries this producer owns: bare ref (ss:/app:
+    # from the annotations) -> composite id. Specialization edges resolve their
+    # target through this, then the dataset, then dangle (deferred).
+    owned = {}
+
+    # Accumulated for the post-render dependency passes.
+    instances = []  # every emitted container instance (dicts)
+    workloads_by_ns = {}  # ns -> [{name, labels, all:[id], ac:[(hint,id)]}]
+    all_services = []  # [{doc, ns}] — every Service (for in-cluster DNS)
+    exposed = []  # [{doc, ns, env, introduced, release}] — annotated
+    secret_stores = []  # [{doc, ns, release, release_name}]
+    mcp_clients = []  # [{ns, chart, container, configMap, key, hostField}]
+    configmaps = {}  # (ns, name) -> data dict (for mcp client lists)
+    cnpg_pooler_svcs = {}  # (ns, svc-name) -> [pooler instance id] for the index
+
+    ds = load_dataset(repo)
+
+    def add_rel(rid, source, target, rtype):
+        relations[rid] = {"id": rid, "source": source, "target": target, "type": rtype}
+
+    def resolve_product(ref):
+        """bare product ref -> composite id: owned, else dataset, else dangling."""
+        if ref in owned:
+            return owned[ref]
+        prefix, name = ref.split(":", 1)
+        full = ds.full(prefix, name)
+        if full:
+            return full
+        deferred.add(ref)
+        return ref
+
+    images = ann.get("images") or {}
+
+    # Deployer-owned MCP-client bindings: a consuming container plus the rendered
+    # ConfigMap that lists the MCP servers it connects to.
+    for cname, spec in (ann.get("mcpClients") or {}).items():
+        mcp_clients.append(
+            {
+                "ns": ns,
+                "chart": app,
+                "container": cname,
+                "configMap": spec["configMap"],
+                "key": spec["key"],
+                "hostField": spec.get("hostField", "url"),
+                "providers": spec.get("providers") or {},
+            }
+        )
+
+    # Upstream «SoftwareProduct» entries this app owns.
+    for prod in ann.get("products") or []:
+        cid = product_id(prod["id"])
+        owned[prod["id"]] = cid
+        entry = dict(
+            prod,
+            id=cid,
+            stereotype="SoftwareProduct",
+            lifecycle="active",
+            introduced=prod.get("introduced", introduced),
+        )
+        arr = "systemSoftware" if prod["id"].startswith("ss:") else "applicationComponents"
+        elements[arr].setdefault(prod["id"], entry)
+
+    docs = render(repo, meta, stage, ns, release_name)
+
+    # Classify each PVC by its statically-bound PV's CSI driver
+    # (PVC.spec.volumeName -> PV.spec.csi.driver); the PVC's own
+    # storageClassName is empty for static binding.
+    pv_driver = {
+        d["metadata"]["name"]: (d["spec"].get("csi") or {}).get("driver")
+        for d in docs
+        if d.get("kind") == "PersistentVolume"
+    }
+    pvc_driver = {
+        d["metadata"]["name"]: pv_driver.get(d["spec"].get("volumeName"))
+        for d in docs
+        if d.get("kind") == "PersistentVolumeClaim"
+    }
+
+    rel_workloads = workloads_by_ns.setdefault(ns, [])
+    for doc in docs:
+        if doc.get("kind") not in WORKLOAD_KINDS:
+            continue
+        wl = stable_workload_name(doc["kind"], doc["metadata"]["name"])
+        pspec = pod_spec(doc)
+        wl_backing = []  # the containers that back an exposed Service (dicts)
+        wl_all = []  # every container instance id (for Service backing)
+        wl_products = set()  # bare product refs of this workload's containers
+        vol_claim = {
+            v["name"]: v["persistentVolumeClaim"]["claimName"]
+            for v in pspec.get("volumes") or []
+            if "persistentVolumeClaim" in v
+        }
+        init_names = {c["name"] for c in pspec.get("initContainers") or []}
+        containers = (pspec.get("initContainers") or []) + pspec["containers"]
+        for c in containers:
+            image = c["image"]
+            image_name = image_basename(image)
+            if image_name in images:
+                img_ann = images[image_name]  # present (may be null = no product)
+            else:
+                gaps.append(f"{app}: image '{image_name}' (in {wl}/{c['name']})")
+                img_ann = None
+            if isinstance(img_ann, str):
+                img_ann = {"product": img_ann}
+            img_ann = img_ann or {}
+            product = img_ann.get("product")
+            kind = img_ann.get("kind") or (kind_for(product) if product else "ApplicationComponent")
+            nkey = f"{ns}.{wl}.{c['name']}"
+            hint = f"{ns}-{wl}-{c['name']}"
+            prefix = "ss" if kind == "SystemSoftware" else "app"
+            arr = "systemSoftware" if kind == "SystemSoftware" else "applicationComponents"
+            inst_id = composite(prefix, hint, nkey)
+            elements[arr][nkey] = {
+                "id": inst_id,
+                "label": f"{wl}/{c['name']} ({env})",
+                "summary": f"{kind} container '{c['name']}' of workload "
+                f"'{wl}' in release '{release}'.",
+                "introduced": introduced,
+                "lifecycle": "active",
+                "environment": env,
+                "cluster": "prd",
+                "stats": {
+                    "release": release,
+                    "workload": wl,
+                    "container": c["name"],
+                    "image": image,
+                },
+            }
+            realizes = {t for t in img_ann.get("realizes") or []}
+            instances.append(
+                {
+                    "id": inst_id,
+                    "product": product,
+                    "ns": ns,
+                    "wl": wl,
+                    "container": c["name"],
+                    "release": release,
+                    "chart": app,
+                    "hint": hint,
+                    "is_init": c["name"] in init_names,
+                    "env": {e["name"]: e["value"] for e in (c.get("env") or []) if "value" in e},
+                    "realizes": realizes,
+                    "upstream": img_ann.get("upstream"),
+                }
+            )
+            wl_all.append(inst_id)
+            if product:
+                wl_products.add(product)
+            # A non-init container backs an exposed Service. Both layers
+            # count: an upstream app's serving container is SystemSoftware
+            # (Keycloak/Jenkins), not an ApplicationComponent. Its declared
+            # ports let the exposure resolve to the one container on the
+            # Service's HTTP port (see resolve_exposed_realizers).
+            if product and c["name"] not in init_names:
+                nums, names = container_ports(c)
+                wl_backing.append(
+                    {
+                        "hint": hint,
+                        "id": inst_id,
+                        "container": c["name"],
+                        "port_nums": nums,
+                        "port_names": names,
+                    }
+                )
+            # Platform: Kubernetes serves this workload.
+            add_rel(f"rel:{hint}-platform", MICROK8S_PRD, inst_id, "Serving")
+            # Specialization to its product (owned -> dataset -> dangling).
+            if product:
+                add_rel(f"rel:{hint}-spec", inst_id, resolve_product(product), "Specialization")
+            # Realizations: capabilities (bare cap:) and the cluster storage
+            # services (resolve svc: to the id the storage producer mints).
+            for tgt in img_ann.get("realizes") or []:
+                add_rel(
+                    f"rel:{hint}-realizes-{hint_of(tgt)}",
+                    inst_id,
+                    CEPH_SERVICE_IDS.get(tgt, tgt),
+                    "Realization",
+                )
+            # Served-by: a backend service serves this container (e.g. the
+            # Ceph VIP serving a CSI driver).
+            for svc in img_ann.get("served_by") or []:
+                add_rel(f"rel:{hint}-servedby-{hint_of(svc)}", svc, inst_id, "Serving")
+            # Ceph storage: services serve the containers that mount the PVC.
+            for m in c.get("volumeMounts") or []:
+                drv = pvc_driver.get(vol_claim.get(m["name"]))
+                if drv in CEPH_DRIVERS:
+                    svc_id, _hint, kindsuffix = CEPH_DRIVERS[drv]
+                    add_rel(
+                        f"rel:{hint}-storage-{kindsuffix}",
+                        CEPH_SERVICE_IDS[svc_id],
+                        inst_id,
+                        "Serving",
+                    )
+        rel_workloads.append(
+            {
+                "name": wl,
+                "labels": pod_labels(doc),
+                "backing": wl_backing,
+                "all": wl_all,
+                "products": wl_products,
+            }
+        )
+
+    emit_cnpg_substrate(
+        docs,
+        ann.get("cnpg") or {},
+        ns,
+        env,
+        release,
+        introduced,
+        elements,
+        instances,
+        owned,
+        resolve_product,
+        add_rel,
+        cnpg_pooler_svcs,
+        gaps,
+        app,
+    )
+
+    for doc in docs:
+        if doc.get("kind") == "Service":
+            all_services.append({"doc": doc, "ns": ns})
+            anns = doc["metadata"].get("annotations") or {}
+            if anns.get(SERVER_NAME_ANNOTATION) or anns.get(DNS_HOSTNAME_ANNOTATION):
+                exposed.append(
+                    {
+                        "doc": doc,
+                        "ns": ns,
+                        "env": env,
+                        "introduced": introduced,
+                        "release": release,
+                        "exposures": ann.get("exposures") or {},
+                        "webUi": ann.get("webUi") or [],
+                    }
+                )
+        elif doc.get("kind") in ("SecretStore", "ClusterSecretStore"):
+            secret_stores.append(
+                {"doc": doc, "ns": ns, "release": release, "release_name": release_name}
+            )
+        elif doc.get("kind") == "ConfigMap":
+            configmaps[(ns, doc["metadata"]["name"])] = doc.get("data") or {}
+
+    inst_by_id = {i["id"]: i for i in instances}
+    instances_by_product = {}
+    for i in instances:
+        if i["product"]:
+            instances_by_product.setdefault(i["product"], []).append(i)
+
+    external, incluster = build_provider_index(all_services, workloads_by_ns)
+    # The CNPG Pooler's Service is operator-created, so it never reached
+    # all_services; register it so an app's DB_HOST (the pooler DNS name)
+    # resolves to the pooler instance the substrate emitted.
+    for nk, pids in cnpg_pooler_svcs.items():
+        incluster.setdefault(nk, []).extend(pids)
+
+    errors = []
+    reconcile_exposed_services(exposed, workloads_by_ns, elements, add_rel, ds, gaps)
+    resolve_boundby(instances_by_product, inst_by_id, external, incluster, ds, add_rel, errors)
+    resolve_upstreams(instances, inst_by_id, external, incluster, ds, add_rel, errors)
+    resolve_secret_stores(secret_stores, instances, ds, add_rel, errors)
+    resolve_mcp_clients(
+        mcp_clients, configmaps, inst_by_id, instances, external, incluster, ds, add_rel, errors
+    )
+
+    if errors:
+        for e in errors:
+            sys.stderr.write(e + "\n")
+        sys.stderr.write(f"gen-architecture: {len(errors)} unresolved edge(s); no output written\n")
+        raise SystemExit(1)
+
+    envelope = {"schemaVersion": "0.1", "producer": producer}
+    for arr in (
+        "systemSoftware",
+        "applicationComponents",
+        "applicationServices",
+        "applicationInterfaces",
+    ):
+        if elements[arr]:
+            envelope[arr] = sorted(elements[arr].values(), key=lambda e: e["id"])
+    if relations:
+        envelope["relations"] = sorted(relations.values(), key=lambda r: r["id"])
+
+    output = repo / "docs" / "architecture" / f"{producer}.yaml"
+    output.parent.mkdir(parents=True, exist_ok=True)
+    with open(output, "w", encoding="utf-8") as f:
+        f.write("# GENERATED by gen-architecture — do not edit by hand.\n")
+        f.write(f"# Edit {ANNOTATIONS} at the repo root and regenerate.\n")
+        yaml.safe_dump(envelope, f, sort_keys=False, default_flow_style=False, allow_unicode=True)
+
+    n = sum(len(elements[a]) for a in elements)
+    sys.stderr.write(
+        f"wrote {output.relative_to(repo)} — {n} elements, {len(relations)} relations\n"
+    )
+    for g in gaps:
+        sys.stderr.write(f"gap: {g}\n")
+    for d in sorted(deferred):
+        sys.stderr.write(f"deferred (cross-producer, unresolved): {d}\n")
+
+
+def emit_cnpg_substrate(
+    docs,
+    cnpg_ann,
+    ns,
+    env,
+    release,
+    introduced,
+    elements,
+    instances,
+    owned,
+    resolve_product,
+    add_rel,
+    cnpg_pooler_svcs,
+    gaps,
+    chart,
+):
+    """Model a CloudNativePG `Cluster`/`Pooler` declared in the rendered chart.
+
+    The operator turns these CRs into the actual PostgreSQL pods and the
+    PgBouncer pooler Service at runtime, none of which `helm template` emits.
+    So we read the CRs directly and emit a SystemSoftware instance per CR
+    (keyed `<ns>.<cr-name>`), driven by the `cnpg:` annotation — a map of CR
+    kind -> {product, realizes, served_by}, mirroring the `images:` form. The
+    instance Specializes its product, is Served by the platform, and realizes
+    its annotated capabilities. The pooler is additionally Served by its backing
+    `Cluster` (read off `spec.cluster.name`), and its Service DNS name is
+    registered so a consumer's DB_HOST resolves to it (the apps connect through
+    the pooler, never the operator-internal Service directly).
+    """
+    cnpg_docs = [
+        d
+        for d in docs
+        if d.get("kind") in CNPG_KINDS and str(d.get("apiVersion", "")).startswith(CNPG_API_GROUP)
+    ]
+    cluster_inst = {}  # cluster CR name -> instance id (for the pooler edge)
+    # Clusters before Poolers so a Pooler's backing-cluster edge resolves
+    # regardless of the order the chart renders them in.
+    for doc in sorted(cnpg_docs, key=lambda d: d["kind"] != "Cluster"):
+        kind = doc["kind"]
+        name = doc["metadata"]["name"]
+        if kind not in cnpg_ann:
+            gaps.append(f"{chart}: cnpg {kind} '{name}' (no `cnpg:` annotation)")
+            continue
+        spec = cnpg_ann[kind] or {}
+        product = spec.get("product")
+        nkey = f"{ns}.{name}"
+        hint = f"{ns}-{name}"
+        inst_id = composite("ss", hint, nkey)
+        elements["systemSoftware"][nkey] = {
+            "id": inst_id,
+            "label": f"{name} ({env})",
+            "summary": f"CloudNativePG {kind} '{name}' of release '{release}'.",
+            "introduced": introduced,
+            "lifecycle": "active",
+            "environment": env,
+            "cluster": "prd",
+            "stats": {"release": release, "resource": f"{kind}/{name}"},
+        }
+        realizes = {t for t in spec.get("realizes") or []}
+        instances.append(
+            {
+                "id": inst_id,
+                "product": product,
+                "ns": ns,
+                "wl": name,
+                "container": name,
+                "release": release,
+                "chart": chart,
+                "hint": hint,
+                "is_init": False,
+                "env": {},
+                "realizes": realizes,
+            }
+        )
+        add_rel(f"rel:{hint}-platform", MICROK8S_PRD, inst_id, "Serving")
+        if product:
+            add_rel(f"rel:{hint}-spec", inst_id, resolve_product(product), "Specialization")
+        for tgt in realizes:
+            add_rel(f"rel:{hint}-realizes-{hint_of(tgt)}", inst_id, tgt, "Realization")
+        for svc in spec.get("served_by") or []:
+            add_rel(f"rel:{hint}-servedby-{hint_of(svc)}", svc, inst_id, "Serving")
+        if kind == "Cluster":
+            cluster_inst[name] = inst_id
+        elif kind == "Pooler":
+            backing_cluster = (doc["spec"].get("cluster") or {}).get("name")
+            if backing_cluster in cluster_inst:
+                add_rel(
+                    f"rel:{ns}-{backing_cluster}-serves-{hint}",
+                    cluster_inst[backing_cluster],
+                    inst_id,
+                    "Serving",
+                )
+            # Apps reach the pooler by its Service DNS; register every cluster-DNS
+            # form so DB_HOST (any of <svc>, <svc>.<ns>, *.svc[.cluster.local])
+            # resolves to this instance.
+            cnpg_pooler_svcs.setdefault((ns, name), []).append(inst_id)
+
+
+def reconcile_exposed_services(exposed, workloads_by_ns, elements, add_rel, ds, gaps):
+    """Mint ApplicationService + ApplicationInterface(s) for an exposed Service.
+
+    For an **in-house** app (a backing product DockerImages owns, that realizes
+    its own `svc:`), reference that service's UUID and attach the public host as
+    an ApplicationInterface — we do not mint a second service or an instance
+    Realization (DockerImages already owns app->svc). For an **upstream** app we
+    own the whole exposure, so we mint our own service.
+
+    A workload pod is often several containers (app + UI + sidecars) behind one
+    Service, so the minted service is realized by the single container the host
+    actually routes to — the one on the Service's HTTP target port
+    (resolve_exposed_realizers). An `exposures:` entry overrides that when the
+    front door is a reverse proxy whose port can't name the product (e.g.
+    git-sync's nginx fronting Gitblit). When neither resolves a container, every
+    backer realizes the service and a gap is reported.
+    """
+    for entry in exposed:
+        doc, ns, env, introduced = entry["doc"], entry["ns"], entry["env"], entry["introduced"]
+        release = entry["release"]
+        anns = doc["metadata"].get("annotations") or {}
+        server_name = anns.get(SERVER_NAME_ANNOTATION) or anns.get(DNS_HOSTNAME_ANNOTATION)
+        svcname = doc["metadata"]["name"]
+        hosts = [h.strip() for h in server_name.split(",") if h.strip()]
+        # Hosts the `webUi:` annotation marks as human, browser-facing UIs (the
+        # homeapps launcher tiles every interface carrying `webUi: true`).
+        # Per-host, not per-app: one app can mix UI and machine ingresses (e.g.
+        # design-assistant's frontend/portal vs its API hosts).
+        webui = set(entry.get("webUi") or [])
+
+        selector = (doc.get("spec") or {}).get("selector") or {}
+        matched = [
+            w
+            for w in workloads_by_ns.get(ns, [])
+            if selector and all(w["labels"].get(k) == v for k, v in selector.items())
+        ]
+
+        # If exactly one in-house app (DockerImages-owned, realizing its own
+        # svc:) backs this Service, reference that service instead of minting.
+        inhouse_svc = _inhouse_service_for(matched, ds)
+
+        if inhouse_svc is not None:
+            asvc_id = inhouse_svc
+        else:
+            # Upstream: mint our own service; its workload realizations follow.
+            akey = f"appsvc.{ns}.{svcname}"
+            asvc_id = composite("svc", f"{ns}-{svcname}", akey)
+            elements["applicationServices"][akey] = {
+                "id": asvc_id,
+                "label": f"{svcname} ({env})",
+                "summary": f"Application service '{svcname}' of release '{release}', "
+                f"reachable at {', '.join(hosts)}.",
+                "introduced": introduced,
+                "lifecycle": "active",
+                "environment": env,
+                "cluster": "prd",
+                "stats": {"hosts": ", ".join(hosts)},
+            }
+
+        for host in hosts:
+            ikey = f"appif.{host}"
+            interface = {
+                "id": composite("if", kebab(host), ikey),
+                "label": host,
+                "summary": f"Ingress endpoint {host} exposing '{svcname}'.",
+                "introduced": introduced,
+                "lifecycle": "active",
+                "environment": env,
+                "cluster": "prd",
+                "stats": {"url": host},
+            }
+            if host in webui:
+                interface["webUi"] = True
+            elements["applicationInterfaces"][ikey] = interface
+            add_rel(f"rel:{ns}-{kebab(host)}-exposes", interface["id"], asvc_id, "Assignment")
+
+        if inhouse_svc is not None:
+            continue
+
+        all_backing = [b for w in matched for b in w["backing"]]
+        identity = entry["exposures"].get(svcname)
+        if identity:
+            realizers = [b for b in all_backing if b["container"] == identity]
+            if not realizers:
+                gaps.append(
+                    f"{release}: exposures[{svcname}] names container "
+                    f"'{identity}', which no backing workload has"
+                )
+        else:
+            realizers = resolve_exposed_realizers(doc, all_backing)
+        if not realizers:
+            # A real port-match failure (backers exist, none on the HTTP port) is
+            # worth a gap; an empty backing set is a headless / per-pod-selector
+            # or unannotated-image service, reported elsewhere.
+            if all_backing and not identity:
+                gaps.append(
+                    f"{release}: exposed service '{svcname}' — HTTP target "
+                    f"port matches no backing container; realized by all "
+                    f"(set exposures[{svcname}] or declare the containerPort)"
+                )
+            realizers = all_backing
+        for b in realizers:
+            add_rel(f"rel:{b['hint']}-provides-{kebab(svcname)}", b["id"], asvc_id, "Realization")
+
+
+def resolve_exposed_realizers(doc, all_backing):
+    """The backing container(s) the Service's HTTP front routes to, or None.
+
+    Resolution order: the explicit `nginx.webathome.org/target-port`; else, if
+    every Service port maps to one container, that container (covers a single
+    HTTP port and multi-port L4 services like Samba alike); else the port named
+    `http` (the web front of a split multi-port pod, e.g. dnsmasq's dhcp). A
+    targetPort is matched to a container by number, or by name when it is a
+    named port. None when nothing matches — a port-less or proxy-fronted front.
+    """
+
+    def match(num=None, name=None):
+        return [
+            b
+            for b in all_backing
+            if (num is not None and num in b["port_nums"])
+            or (name is not None and name in b["port_names"])
+        ]
+
+    anns = doc["metadata"].get("annotations") or {}
+    tp = anns.get("nginx.webathome.org/target-port")
+    if tp and tp.isdigit():
+        return match(num=int(tp)) or None
+
+    ports = (doc.get("spec") or {}).get("ports") or []
+
+    def port_match(p):
+        t = p.get("targetPort")
+        if isinstance(t, int) or (isinstance(t, str) and t.isdigit()):
+            return match(num=int(t))
+        return match(name=t) if isinstance(t, str) else []
+
+    containers = {b["container"] for p in ports for b in port_match(p)}
+    if len(containers) == 1:
+        return [b for b in all_backing if b["container"] == next(iter(containers))]
+
+    http = next((p for p in ports if p.get("name") == "http"), None)
+    return (http and port_match(http)) or None
+
+
+def _inhouse_service_for(matched, ds):
+    """The DockerImages svc UUID if exactly one in-house app backs the Service."""
+    svcs = set()
+    for w in matched:
+        for prod in w.get("products", []):
+            for svc in ds.app_provides_svc.get(prod, []):
+                svcs.add(svc)
+    if len(svcs) == 1:
+        return next(iter(svcs))
+    return None
+
+
+def resolve_boundby(instances_by_product, inst_by_id, external, incluster, ds, add_rel, errors):
+    """Emit provider —Serving→ consumer for every resolvable boundBy recipe.
+
+    For each product we deploy that has boundBy edges authored against it, read
+    the named env off the container(s) that set it, resolve the value's host to
+    a provider, and draw the edge. Any edge that can't resolve (naming chart/
+    release/container/var/value/host) is collected into `errors` and skipped, so
+    one run surfaces *every* breakage at once; main reports them and exits
+    non-zero rather than writing a partial artifact. The breakage is still the
+    signal — there are just no longer one-at-a-time.
+
+    A rendered env always wins. When no deployed container sets the var, the
+    recipe's `boundByDefaultValue` supplants the missing config: it declares
+    that the consumer reaches the provider through a hidden code-default, so
+    the relation holds for *every* deployed instance of the consumer — each
+    must resolve to a co-located provider, and any that can't is a hard-fail.
+    Absent both a setter and a default, the dependency is simply unwired in
+    this deployment: there is no Serving edge, so none is drawn. We model what
+    is deployed, not what ought to be — a mandatory wire left unset is the
+    app's own runtime failure, not ours to pre-empt. A value that *is* wired
+    but resolves nowhere still fails loudly: that is a configured connection
+    the model can't place, a real hole, not an absent dependency. (So an
+    *optional* dependency just carries no default and surfaces its host as a
+    literal env only where it applies — e.g. the SSEGateway RabbitMQ backplane:
+    only the release wiring RABBITMQ_URL draws the edge, and when none does,
+    say design-assistant is disabled, the gateway has no backplane edge at all.)
+
+    A loopback host on a `cap:` target — whether rendered (e.g. gitblit-mcp-
+    server -> gitblit on localhost:8080) or supplied by a localhost default — is
+    a same-pod sidecar: resolve to a same-pod cap-realizing instance. No
+    same-release fallback: localhost cannot leave the pod; the old fallback only
+    ever masked vaulted connection strings, which now surface their real host
+    and resolve in-cluster. Mirrors `resolve_svc_target` for `svc:` targets.
+    """
+    for prod_bare, prod_instances in instances_by_product.items():
+        for edge in ds.boundby_by_source.get(prod_bare, []):
+            var = edge["boundBy"].split("env:", 1)[1]
+            tgt_bare = bare(edge["target"])
+            default = edge.get("boundByDefaultValue")
+            setters = [i for i in prod_instances if var in i["env"]]
+            if not setters:
+                if default is None:
+                    # No instance wires this dependency and there is no code
+                    # default to stand in: there is no Serving edge to draw. We
+                    # describe deployed reality, not enforce it — a missing
+                    # mandatory wire surfaces as the app's own runtime failure.
+                    continue
+                setters = prod_instances
+            for inst in setters:
+                value = inst["env"].get(var, default)
+                # A connection string assembled from sibling env vars via
+                # Kubernetes `$(VAR)` substitution (e.g. DATABASE_URL =
+                # `...@$(DB_HOST)/...`, where DB_HOST is a literal chart value)
+                # carries the real host only after the kubelet expands it.
+                # Expand it here against this container's other literal-valued
+                # env so parse_host sees the resolved host, not the placeholder.
+                value = expand_env_refs(value, inst["env"])
+                loc = (
+                    f"{inst['chart']}/{inst['release']} "
+                    f"{inst['ns']}.{inst['wl']}.{inst['container']}"
+                )
+                if tgt_bare.startswith("svc:"):
+                    providers = resolve_svc_target(
+                        edge["target"], value, inst, instances_by_product, ds
+                    )
+                    if not providers:
+                        errors.append(
+                            f"gen-architecture: boundBy: {loc}: {var}={value!r} "
+                            f"svc target {tgt_bare} maps to no deployed instance"
+                        )
+                        continue
+                    provider_ids = [p["id"] for p in providers]
+                else:
+                    host, _port = parse_host(value)
+                    if host in LOOPBACK_HOSTS:
+                        # Loopback on a cap: target — a genuine same-pod sidecar
+                        # reached over the pod loopback (e.g. gitblit-mcp-server
+                        # -> gitblit on localhost:8080). Resolve to a same-pod
+                        # instance realizing the capability; mirrors
+                        # resolve_svc_target's same-pod rule. Vaulted connection
+                        # strings no longer reach here — charts surface the real
+                        # host, so they resolve in-cluster below.
+                        chosen = [
+                            i
+                            for i in inst_by_id.values()
+                            if not i["is_init"]
+                            and tgt_bare in i["realizes"]
+                            and i["ns"] == inst["ns"]
+                            and i["wl"] == inst["wl"]
+                        ]
+                        if not chosen:
+                            errors.append(
+                                f"gen-architecture: boundBy: {loc}: {var}={value!r} -> "
+                                f"loopback host names no same-pod provider "
+                                f"realizing {tgt_bare}"
+                            )
+                            continue
+                        provider_ids = [i["id"] for i in chosen]
+                    else:
+                        pids, is_cross = resolve_host(host, inst["ns"], external, incluster, ds)
+                        if not pids:
+                            errors.append(
+                                f"gen-architecture: boundBy: {loc}: {var}={value!r} -> "
+                                f"host {host!r} resolves to no provider "
+                                f"(in-cluster / exposed host / cross-producer)"
+                            )
+                            continue
+                        if is_cross:
+                            provider_ids = pids
+                        else:
+                            # cap-invariant: keep providers that actually realize the
+                            # capability — and that serve it (a one-shot init
+                            # container sharing the image is not a provider).
+                            provider_ids = [
+                                p
+                                for p in pids
+                                if p in inst_by_id
+                                and not inst_by_id[p]["is_init"]
+                                and tgt_bare in inst_by_id[p]["realizes"]
+                            ]
+                            if not provider_ids:
+                                errors.append(
+                                    f"gen-architecture: boundBy: {loc}: {var}={value!r} "
+                                    f"host {host} -> provider does not Realize {tgt_bare}"
+                                )
+                                continue
+                for pid in provider_ids:
+                    add_rel(
+                        f"rel:{kebab(hint_of(pid))}-serves-{inst['hint']}-{kebab(hint_of(tgt_bare))}",
+                        pid,
+                        inst["id"],
+                        "Serving",
+                    )
+
+
+def resolve_upstreams(instances, inst_by_id, external, incluster, ds, add_rel, errors):
+    """Emit upstream —Serving→ proxy for each image entry declaring `upstream`.
+
+    A generic proxy (mcp-filter) fronts whatever the deployment points it at:
+    after DockerImages' filter recipe went with cap:mcp there is no capability or
+    service to bind it to, so the wire is the deployer's, declared on the image
+    entry like the `mcpClients` providers map. The rendered `env` var locates the
+    pod — a loopback host is the proxy's own pod, any other host resolves through
+    the same in-cluster / exposed-host machinery as boundBy — and `providers`
+    names the containers of that pod that serve the proxy. Not "every other
+    container": the trello pod's auth nginx sits in front of the filter, not
+    behind it. A cross-producer host names an element, not a pod, so it takes no
+    `providers` and is drawn as resolved. An unset var, a host resolving nowhere,
+    a named container missing from the pod and a pod host with no `providers`
+    are hard fails, collected with the other resolvers' errors.
+    """
+    for inst in instances:
+        upstream = inst.get("upstream")
+        if not upstream or inst["is_init"]:
+            continue
+        var = upstream["env"]
+        wanted = upstream.get("providers") or []
+        loc = f"{inst['chart']}/{inst['release']} {inst['ns']}.{inst['wl']}.{inst['container']}"
+        if var not in inst["env"]:
+            errors.append(
+                f"gen-architecture: upstream: {loc}: {var} is not set to a "
+                f"literal value on the container"
+            )
+            continue
+        value = expand_env_refs(inst["env"][var], inst["env"])
+        host, _port = parse_host(value)
+        if host in LOOPBACK_HOSTS:
+            pids = [i["id"] for i in instances if i["ns"] == inst["ns"] and i["wl"] == inst["wl"]]
+            is_cross = False
+        else:
+            pids, is_cross = resolve_host(host, inst["ns"], external, incluster, ds)
+            if not pids:
+                errors.append(
+                    f"gen-architecture: upstream: {loc}: {var}={value!r} -> "
+                    f"host {host!r} resolves to no provider "
+                    f"(in-cluster / exposed host / cross-producer)"
+                )
+                continue
+        if is_cross:
+            provider_ids = pids
+        else:
+            backing = [
+                inst_by_id[p] for p in pids if p in inst_by_id and not inst_by_id[p]["is_init"]
+            ]
+            have = {i["container"] for i in backing}
+            missing = [c for c in wanted if c not in have]
+            if not wanted or missing:
+                declared = "no providers declared" if not wanted else f"providers names {missing}"
+                errors.append(
+                    f"gen-architecture: upstream: {loc}: {var}={value!r} -> "
+                    f"host {host!r}: {declared}; "
+                    f"the pod's containers are {sorted(have)}"
+                )
+                continue
+            provider_ids = [i["id"] for i in backing if i["container"] in wanted]
+        for pid in provider_ids:
+            add_rel(
+                f"rel:{kebab(hint_of(pid))}-serves-{inst['hint']}-upstream",
+                pid,
+                inst["id"],
+                "Serving",
+            )
+
+
+def resolve_mcp_clients(
+    mcp_clients, configmaps, inst_by_id, instances, external, incluster, ds, add_rel, errors
+):
+    """Emit provider —Serving→ consumer for each declared MCP-client binding.
+
+    An MCP client (e.g. intercom-server) fans out to a deployment-chosen set of
+    MCP servers. The set is config, not intrinsic to the image, so it is authored
+    here as deployer-owned wiring (the `mcpClients` annotation) rather than as a
+    DockerImages boundBy recipe — mirroring the OpenBao store edge. For each
+    binding we read the rendered ConfigMap the annotation points at, pull each
+    server's host off the declared `hostField` (no value-shape sniffing — the
+    field is declared) and resolve it through the same in-cluster / exposed-host
+    machinery as boundBy.
+
+    A host resolves to every container of the pod behind it: the MCP server
+    together with its auth proxy, its filter and unrelated neighbours (git.home's
+    pod runs Gitblit itself beside the Gitblit MCP server). The binding's
+    `providers` map names, per server (its `name` in the ConfigMap), the
+    containers of that pod that serve it, and only those draw the edge. A server
+    with no entry, a named container missing from the resolved pod, and an entry
+    naming no rendered server are all hard fails — the breakage is the signal, as
+    everywhere else. A cross-producer host names an element, not a pod, so it is
+    drawn as resolved.
+    """
+    by_ns_container = {}
+    for i in instances:
+        if not i["is_init"]:
+            by_ns_container.setdefault((i["ns"], i["container"]), []).append(i)
+    for client in mcp_clients:
+        loc = f"{client['chart']} {client['ns']}.{client['container']}"
+        consumers = by_ns_container.get((client["ns"], client["container"]))
+        if not consumers:
+            errors.append(
+                f"gen-architecture: mcp client {loc}: no deployed "
+                f"container of that name in the namespace"
+            )
+            continue
+        cm = configmaps.get((client["ns"], client["configMap"]))
+        if cm is None or client["key"] not in cm:
+            errors.append(
+                f"gen-architecture: mcp client {loc}: ConfigMap "
+                f"{client['configMap']}[{client['key']}] not rendered"
+            )
+            continue
+        try:
+            servers = (json.loads(cm[client["key"]]) or {}).get("servers") or []
+        except json.JSONDecodeError as e:
+            errors.append(
+                f"gen-architecture: mcp client {loc}: "
+                f"{client['configMap']}[{client['key']}] is not valid JSON: {e}"
+            )
+            continue
+        providers = client["providers"]
+        named = [
+            (srv.get("name", srv.get(client["hostField"])), srv.get(client["hostField"]))
+            for srv in servers
+        ]
+        for stale in sorted(set(providers) - {name for name, _ in named}):
+            errors.append(
+                f"gen-architecture: mcp client {loc}: providers[{stale!r}] "
+                f"names no server in {client['configMap']}[{client['key']}]"
+            )
+        for name, url in named:
+            if not url:
+                continue
+            host, _ = parse_host(url)
+            pids, is_cross = resolve_host(host, client["ns"], external, incluster, ds)
+            if not pids:
+                errors.append(
+                    f"gen-architecture: mcp client {loc}: server "
+                    f"{name!r} host {host!r} resolves to no provider "
+                    f"(in-cluster / exposed host / cross-producer)"
+                )
+                continue
+            if is_cross:
+                provider_ids = pids
+            else:
+                wanted = providers.get(name) or []
+                backing = [
+                    inst_by_id[p] for p in pids if p in inst_by_id and not inst_by_id[p]["is_init"]
+                ]
+                have = {i["container"] for i in backing}
+                missing = [c for c in wanted if c not in have]
+                if not wanted or missing:
+                    errors.append(
+                        f"gen-architecture: mcp client {loc}: server "
+                        f"{name!r} host {host} -> providers[{name!r}] "
+                        f"{'is not declared' if not wanted else f'names {missing}'}; "
+                        f"the host's containers are {sorted(have)}"
+                    )
+                    continue
+                provider_ids = [i["id"] for i in backing if i["container"] in wanted]
+            for c in consumers:
+                for pid in provider_ids:
+                    add_rel(
+                        f"rel:{kebab(hint_of(pid))}-serves-{c['hint']}-mcp", pid, c["id"], "Serving"
+                    )
+
+
+def resolve_secret_stores(secret_stores, instances, ds, add_rel, errors):
+    """OpenBao —Serving→ the ESO controller, from the ClusterSecretStore.
+
+    The store names the OpenBao backend (provider.vault.server); the consumer is
+    the External Secrets Operator that reads it — the workload in the store's
+    release that realizes cap:secrets-management, primary controller only
+    (name == release), so the webhook/cert-controller pods don't get a false
+    edge. Apps never talk to OpenBao (they read the materialized k8s Secret), so
+    no per-app edge is drawn.
+    """
+    for store in secret_stores:
+        vault = ((store["doc"].get("spec") or {}).get("provider") or {}).get("vault")
+        if not vault or not vault.get("server"):
+            continue
+        host, _ = parse_host(vault["server"])
+        provider_id = cross_producer_id(host, ds)
+        if not provider_id:
+            errors.append(
+                f"gen-architecture: secret store {store['doc']['metadata']['name']}: "
+                f"backend host {host!r} is not a known cross-producer provider"
+            )
+            continue
+        cands = [
+            i
+            for i in instances
+            if i["release"] == store["release"] and "cap:secrets-management" in i["realizes"]
+        ]
+        primary = [i for i in cands if i["wl"] == store["release_name"]] or cands
+        for i in primary:
+            add_rel(f"rel:openbao-serves-{i['hint']}", provider_id, i["id"], "Serving")
+
+
+if __name__ == "__main__":
+    main()
