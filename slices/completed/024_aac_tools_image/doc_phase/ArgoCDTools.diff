index 0000000..60fd81d
--- /dev/null
+++ b/aac-tools/tests/test_deploy_repo.py
@@ -0,0 +1,254 @@
+"""The deploy-repo layer: the command line, the render, and the ids that carry over.
+
+What this file covers is everything the port replaced — HelmCharts' generator walks a
+config tree, shells out to a deploy CLI and dates a chart from git; a deploy repo
+holds one app, renders it the way Argo CD does, and states the rest in an annotation
+layer at its root.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import io
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+from .support import load
+
+ga = load("gen_architecture")
+
+# Ids the federation publishes today for KubeCoder's prd stage and for the cluster
+# storage services, read off https://architecture.webathome.org/data/v0.1/architecture.yaml
+# on 2026-09-20 (producer `helm-charts`). They are what a handover has to reproduce:
+# an id this generator mints differently is an element re-minted under a new owner,
+# and every inbound edge other producers author against it dangles.
+PUBLISHED_CONTAINER = (
+    "app:kubecoder-prd-kubecoder-bot-kubecoder-bot,87f8c15c-1076-52d4-86c9-56e063d29ec0"
+)
+PUBLISHED_INTERFACE = "if:kubecoder-home,6c9379fd-d644-51e6-af52-2b3aefa783c8"
+PUBLISHED_CEPH = {
+    "svc:cluster-ceph-rbd": "svc:cluster-ceph-rbd,02509593-ffcf-5740-9fa9-c14f90c1a160",
+    "svc:cluster-ceph-cephfs": "svc:cluster-ceph-cephfs,6d5615a9-59fd-59c7-822a-d31c86cd476c",
+}
+
+
+class KeptIdentityTests(unittest.TestCase):
+    def test_a_container_keeps_the_id_the_published_model_carries(self):
+        self.assertEqual(
+            ga.composite(
+                "app",
+                "kubecoder-prd-kubecoder-bot-kubecoder-bot",
+                "kubecoder-prd.kubecoder-bot.kubecoder-bot",
+            ),
+            PUBLISHED_CONTAINER,
+        )
+
+    def test_an_exposed_host_keeps_the_id_the_published_model_carries(self):
+        host = "kubecoder.home"
+        self.assertEqual(ga.composite("if", ga.kebab(host), f"appif.{host}"), PUBLISHED_INTERFACE)
+
+    def test_the_storage_services_are_referenced_not_re_minted(self):
+        """The elements belong to whoever deploys the CSI drivers. A deploy repo draws
+        the storage edge to the id that producer already publishes, and emits no
+        element of its own — two producers publishing one id is one element too many."""
+        self.assertEqual(ga.CEPH_SERVICE_IDS, PUBLISHED_CEPH)
+
+
+ORIGIN = "https://github.com/pvginkel/KubeCoderDeploy.git"
+
+
+@contextlib.contextmanager
+def _checkout():
+    """A throwaway git checkout with the two things Argo reads off one: an origin and
+    a commit."""
+    with tempfile.TemporaryDirectory() as tmp:
+        root = Path(tmp)
+        for args in (
+            ["init", "-q"],
+            ["remote", "add", "origin", ORIGIN],
+            [
+                "-c",
+                "user.name=aac-tools tests",
+                "-c",
+                "user.email=aac-tools@tests.invalid",
+                "commit",
+                "-q",
+                "--allow-empty",
+                "-m",
+                "root",
+            ],
+        ):
+            subprocess.run(["git", *args], cwd=root, check=True, capture_output=True, text=True)
+        yield root
+
+
+class CommandLineTests(unittest.TestCase):
+    def test_the_stage_is_required_and_has_no_default(self):
+        """One run, one stage: the artifact is attached to a pipeline, and a pipeline
+        listening to two stages would make it flap."""
+        with contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit):
+                ga.parse_args(["--producer", "kubecoder-deploy"])
+
+    def test_the_producer_is_required(self):
+        """`kubecoder` is another producer's id in the federation registry, so there
+        is no id this command could default to."""
+        with contextlib.redirect_stderr(io.StringIO()):
+            with self.assertRaises(SystemExit):
+                ga.parse_args(["--stage", "prd"])
+
+    def test_a_run_names_one_stage_one_producer_and_a_checkout(self):
+        args = ga.parse_args(["--stage", "prd", "--producer", "kubecoder-deploy"])
+
+        self.assertEqual((args.stage, args.producer, args.repo), ("prd", "kubecoder-deploy", "."))
+
+    def test_the_stage_takes_a_single_value(self):
+        """Not a list and not repeatable-into-a-list: `--stage` is one stage."""
+        args = ga.parse_args(["--stage", "prd", "--producer", "p"])
+
+        self.assertIsInstance(args.stage, str)
+
+
+class RenderContractTests(unittest.TestCase):
+    def test_the_template_call_is_the_one_argo_makes(self):
+        """The releases ApplicationSet templates `chart/` under the Application's own
+        name, into that namespace, with the stage's values reached out of the chart
+        path and the hook parameters set."""
+        args = ga.template_args(
+            "prd",
+            "kubecoder-prd",
+            "kubecoder-prd",
+            {"hook.stage": "prd", "hook.namespace": "kubecoder-prd"},
+        )
+
+        self.assertEqual(
+            args,
+            [
+                "helm",
+                "template",
+                "kubecoder-prd",
+                "chart",
+                "--namespace",
+                "kubecoder-prd",
+                "--values",
+                "config/prd/values.yaml",
+                "--set",
+                "hook.stage=prd",
+                "--set",
+                "hook.namespace=kubecoder-prd",
+            ],
+        )
+
+    def test_only_remote_chart_repositories_are_added(self):
+        """A `file://` dependency resolves off disk; a repository named twice is one
+        repository."""
+        meta = {
+            "dependencies": [
+                {"name": "homelab-shared", "repository": "https://charts.home"},
+                {"name": "other", "repository": "https://charts.home"},
+                {"name": "local", "repository": "file://../local"},
+                {"name": "aliased"},
+            ]
+        }
+
+        self.assertEqual(ga.dependency_urls(meta), ["https://charts.home"])
+
+    def test_a_chart_without_dependencies_adds_nothing(self):
+        self.assertEqual(ga.dependency_urls({"name": "app", "version": "0.1"}), [])
+
+    def test_an_argo_lifecycle_hook_is_not_part_of_the_model(self):
+        """The estate's Terraform PreSync hook is a Job in another namespace carrying
+        `generateName` only — deploy machinery with no natural key to be keyed on."""
+        hook = {
+            "kind": "Job",
+            "metadata": {
+                "generateName": "tf-presync-",
+                "namespace": "argocd-hooks",
+                "annotations": {ga.HOOK_ANNOTATION: "PreSync"},
+            },
+        }
+        workload = {"kind": "Deployment", "metadata": {"name": "kubecoder-bot"}}
+
+        self.assertTrue(ga.is_hook(hook))
+        self.assertFalse(ga.is_hook(workload))
+
+    def test_the_hook_parameters_are_the_four_the_library_guards(self):
+        """The shared library `required`-guards all four, so a render missing one
+        fails whole — not just the hook Job it would have rendered. Two of them are
+        what Argo passes: the repo the Application syncs and the commit it synced."""
+        with _checkout() as root:
+            parameters = ga.hook_parameters(root, "prd", "kubecoder-prd")
+
+            self.assertEqual(
+                sorted(parameters), ["hook.namespace", "hook.repo", "hook.revision", "hook.stage"]
+            )
+            self.assertEqual(parameters["hook.stage"], "prd")
+            self.assertEqual(parameters["hook.namespace"], "kubecoder-prd")
+            self.assertEqual(parameters["hook.repo"], ORIGIN)
+            self.assertEqual(
+                parameters["hook.revision"],
+                subprocess.run(
+                    ["git", "rev-parse", "HEAD"],
+                    cwd=root,
+                    capture_output=True,
+                    text=True,
+                    check=True,
+                ).stdout.strip(),
+            )
+
+
+class ReleaseNameTests(unittest.TestCase):
+    def test_prd_is_named_by_the_app_alone(self):
+        """What the published model already quotes in every prd element's summary and
+        `stats.release`."""
+        self.assertEqual(ga.release_label("kubecoder", "prd"), "kubecoder")
+
+    def test_every_other_stage_is_suffixed(self):
+        self.assertEqual(ga.release_label("kubecoder", "dev"), "kubecoder@dev")
+
+
+@contextlib.contextmanager
+def _repo(annotation):
+    with tempfile.TemporaryDirectory() as tmp:
+        root = Path(tmp)
+        if annotation is not None:
+            (root / ga.ANNOTATIONS).write_text(annotation, encoding="utf-8")
+        yield root
+
+
+class AnnotationLayerTests(unittest.TestCase):
+    def test_a_repo_with_no_annotation_layer_is_refused(self):
+        """Without it every image is a gap and no element carries a date: a generated
+        producer's judgment layer is not optional."""
+        with _repo(None) as root:
+            with self.assertRaises(SystemExit):
+                ga.annotations(root)
+
+    def test_an_annotation_layer_without_introduced_is_refused(self):
+        """A deploy repo's git history dates the repo, not the app, so there is
+        nothing to fall back to."""
+        with _repo("images:\n  kubecoder-bot: app:kubecoder-bot\n") as root:
+            with self.assertRaises(SystemExit):
+                ga.annotations(root)
+
+    def test_an_unquoted_date_becomes_the_iso_string(self):
+        """YAML resolves an unquoted date to a `date`, and the schema wants the ISO
+        string — quoting is not the annotation author's to remember."""
+        with _repo("introduced: 2026-06-17\n") as root:
+            _ann, introduced = ga.annotations(root)
+
+            self.assertEqual(introduced, "2026-06-17")
+
+    def test_the_judgment_the_annotation_carries_reaches_the_caller(self):
+        with _repo(
+            "introduced: '2026-06-17'\n"
+            "images:\n  kubecoder-bot: app:kubecoder-bot\n"
+            "webUi:\n  - kubecoder.home\n"
+        ) as root:
+            ann, introduced = ga.annotations(root)
+
+            self.assertEqual(introduced, "2026-06-17")
+            self.assertEqual(ann["images"], {"kubecoder-bot": "app:kubecoder-bot"})
+            self.assertEqual(ann["webUi"], ["kubecoder.home"])
