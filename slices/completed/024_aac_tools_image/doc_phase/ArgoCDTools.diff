@@ -0,0 +1,80 @@
+# aac-tools — the estate's architecture-as-code commands in one image. `arch-validate`
+# submits an architecture artifact to the federation's validation service, and is the
+# canonical script from `pvginkel/Architecture` shipped byte for byte, not a fork.
+#
+# Two callers run this image and neither supplies setup of its own: a Jenkins pipeline
+# pulls it and runs a command, and KubeCoder runs it as a toolchain sidecar. KubeCoder
+# replaces a toolchain container's command with its own agent and runs every `kc cexec`
+# command as `bash -lc`, so the commands live on PATH, `bash` is mandatory, and nothing
+# here may depend on an ENTRYPOINT — this image declares none.
+#
+# Contents are what the commands need at run time and nothing more: python3 with PyYAML,
+# helm, git, bash and the homelab step-ca root. No Terraform, and none of HelmCharts'
+# deploy tooling.
+#
+# Ubuntu noble is the runtime the commands target: its python3 is 3.12 (ruff.toml), and
+# its `ubuntu` user is the uid-1000 passwd entry KubeCoder's pod-level runAsUser
+# resolves against.
+FROM ubuntu:noble
+
+ARG DEBIAN_FRONTEND=noninteractive
+
+# Console output interleaves with helm's and git's own, which are unbuffered.
+ENV PYTHONUNBUFFERED=1
+
+# python3-yaml is PyYAML from the distro, so the image runs no pip and carries no
+# virtualenv; git and helm are what generating a deploy repo's architecture reads and
+# renders with; curl fetches the helm installer below.
+RUN apt-get update -yqq && \
+    apt-get install -y --no-install-recommends \
+        ca-certificates \
+        curl \
+        git \
+        python3 \
+        python3-yaml \
+    && \
+    \
+    apt-get clean && \
+    rm -rf /var/lib/apt/lists/*
+
+# The homelab step-ca root, which no default trust store carries. `https://charts.home`
+# — the chart repository a deploy repo resolves its dependencies from — serves a leaf
+# signed by it, so without this helm cannot reach the estate's charts at all. Same cert
+# artefact as the Ansible repo's roles/baseline/files/homelab-root.crt and as
+# argocd-hook/image/homelab-root.crt; a test asserts the two copies here are one file,
+# because the estate rotates every copy in a single change window.
+COPY image/homelab-root.crt /usr/local/share/ca-certificates/homelab-root.crt
+RUN chmod 0644 /usr/local/share/ca-certificates/homelab-root.crt && \
+    update-ca-certificates
+
+# helm 4 from upstream's own installer, as the estate's other images install it — there
+# is no apt suite for helm. Fetched to a file rather than piped, so a failed download
+# cannot be executed as a truncated script.
+RUN curl -fsSL -o /tmp/get-helm-4 \
+        https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-4 && \
+    bash /tmp/get-helm-4 && \
+    rm /tmp/get-helm-4
+
+# The canonical validator, on PATH under the name every caller invokes. It carries its
+# own shebang and imports only the standard library.
+COPY image/arch-validate.py /usr/local/bin/arch-validate
+RUN chmod 0755 /usr/local/bin/arch-validate
+
+# A run needs a passwd entry for the uid it runs as: `kc cexec`'s preflight warns
+# without one, and KubeCoder gives a toolchain sidecar no securityContext of its own, so
+# it inherits the pod's uid 1000 — noble's `ubuntu`.
+USER ubuntu
+
+# Nothing downstream gates the image's contents, and no environment that builds this
+# image can run it, so the build is where what the image promises is proved. The
+# trust-store check verifies the homelab root against the system bundle: a self-signed
+# root verifies there only if update-ca-certificates actually installed it.
+RUN getent passwd "$(id -u)" > /dev/null && \
+    bash --version > /dev/null && \
+    git --version && \
+    helm version && \
+    python3 -c "import sys; assert sys.version_info >= (3, 12), sys.version" && \
+    python3 -c "import yaml" && \
+    arch-validate --help > /dev/null && \
+    openssl verify -CAfile /etc/ssl/certs/ca-certificates.crt \
+        /usr/local/share/ca-certificates/homelab-root.crt
