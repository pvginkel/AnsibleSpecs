index 0000000..f2feb18
--- /dev/null
+++ b/aac-tools/tests/test_gen_architecture.py
@@ -0,0 +1,355 @@
+"""gen-architecture: exposed-host interfaces, upstream wires and MCP-client edges.
+
+The successors of HelmCharts' `tests/test_gen_architecture.py` — the same eleven
+behaviours, under the same names, over the same synthetic in-memory fixtures. They
+exercise the post-render passes, which the port carries across whole.
+"""
+
+from __future__ import annotations
+
+import json
+import unittest
+
+from .support import load
+
+ga = load("gen_architecture")
+
+
+def _service(name, hosts):
+    return {
+        "kind": "Service",
+        "metadata": {"name": name, "annotations": {ga.SERVER_NAME_ANNOTATION: ", ".join(hosts)}},
+        "spec": {
+            "selector": {"app": name},
+            "ports": [{"name": "http", "port": 80, "targetPort": 8080}],
+        },
+    }
+
+
+def _workload(ns, name, product):
+    inst_id = ga.composite("app", f"{ns}-{name}-{name}", f"{ns}.{name}.{name}")
+    return {
+        "name": name,
+        "labels": {"app": name},
+        "backing": [
+            {
+                "hint": f"{ns}-{name}-{name}",
+                "id": inst_id,
+                "container": name,
+                "port_nums": {8080},
+                "port_names": set(),
+            }
+        ],
+        "all": [inst_id],
+        "products": {product},
+    }
+
+
+def _reconcile(ds, product, hosts, webui):
+    ns = "web-prd"
+    exposed = [
+        {
+            "doc": _service("web", hosts),
+            "ns": ns,
+            "env": "prd",
+            "introduced": "2024-01-01",
+            "release": "web",
+            "exposures": {},
+            "webUi": webui,
+        }
+    ]
+    elements = {"applicationServices": {}, "applicationInterfaces": {}}
+    relations = {}
+
+    def add_rel(rid, source, target, rtype):
+        relations[rid] = {"source": source, "target": target, "type": rtype}
+
+    ga.reconcile_exposed_services(
+        exposed, {ns: [_workload(ns, "web", product)]}, elements, add_rel, ds, []
+    )
+    return elements, relations
+
+
+def _inhouse_dataset():
+    ds = ga.Dataset()
+    ds.add_envelope(
+        {
+            "relations": [
+                {
+                    "id": "rel:web-realizes-web-api",
+                    "type": "Realization",
+                    "source": "app:web,00000000-0000-0000-0000-000000000001",
+                    "target": "svc:web-api,00000000-0000-0000-0000-000000000002",
+                }
+            ]
+        }
+    )
+    return ds
+
+
+# An upstream app we own the exposure of, and an in-house one whose service another
+# producer already owns: the two halves reconcile_exposed_services chooses between.
+EXPOSURE_CASES = (("upstream", ga.Dataset, "ss:web"), ("in-house", _inhouse_dataset, "app:web"))
+
+
+class ExposedServiceTests(unittest.TestCase):
+    def test_only_webui_hosts_carry_the_attribute(self):
+        for case, ds_factory, product in EXPOSURE_CASES:
+            with self.subTest(case=case):
+                elements, relations = _reconcile(
+                    ds_factory(), product, ["web.home", "api.home"], ["web.home"]
+                )
+
+                interfaces = elements["applicationInterfaces"]
+                self.assertIs(interfaces["appif.web.home"]["webUi"], True)
+                self.assertNotIn("webUi", interfaces["appif.api.home"])
+                self.assertEqual(
+                    [r for r in relations.values() if r["target"].startswith("cap:")], []
+                )
+
+    def test_every_host_interface_is_assigned_to_its_service(self):
+        for case, ds_factory, product in EXPOSURE_CASES:
+            with self.subTest(case=case):
+                elements, relations = _reconcile(ds_factory(), product, ["web.home"], ["web.home"])
+
+                interface_id = elements["applicationInterfaces"]["appif.web.home"]["id"]
+                [assignment] = [r for r in relations.values() if r["type"] == "Assignment"]
+                self.assertEqual(assignment["source"], interface_id)
+                if product.startswith("app:"):
+                    self.assertEqual(elements["applicationServices"], {})
+                    self.assertEqual(
+                        assignment["target"], "svc:web-api,00000000-0000-0000-0000-000000000002"
+                    )
+                else:
+                    [svc] = elements["applicationServices"].values()
+                    self.assertEqual(assignment["target"], svc["id"])
+
+
+def _inst(ns, wl, container, is_init=False):
+    hint = f"{ns}-{wl}-{container}"
+    return {
+        "id": ga.composite("app", hint, f"{ns}.{wl}.{container}"),
+        "ns": ns,
+        "wl": wl,
+        "container": container,
+        "hint": hint,
+        "is_init": is_init,
+        "product": None,
+        "realizes": set(),
+        "env": {},
+        "release": wl,
+        "chart": wl,
+    }
+
+
+CLIENT = _inst("intercom-prd", "intercom", "intercom-server")
+# An MCP server behind its auth proxy and response filter, as trello-mcp deploys it.
+TRELLO_POD = [_inst("trello-prd", "trello", c) for c in ("auth", "filter", "server")]
+TRELLO = {"name": "trello", "url": "http://trello.home/mcp"}
+
+
+def _resolve_mcp(servers, providers, pod=TRELLO_POD):
+    instances = [CLIENT, *pod]
+    client = {
+        "ns": "intercom-prd",
+        "chart": "intercom",
+        "container": "intercom-server",
+        "configMap": "mcp-servers",
+        "key": "servers.json",
+        "hostField": "url",
+        "providers": providers,
+    }
+    configmaps = {
+        ("intercom-prd", "mcp-servers"): {"servers.json": json.dumps({"servers": servers})}
+    }
+    external = {"trello.home": [i["id"] for i in pod]}
+    relations, errors = {}, []
+
+    def add_rel(rid, source, target, rtype):
+        relations[rid] = {"source": source, "target": target, "type": rtype}
+
+    ga.resolve_mcp_clients(
+        [client],
+        configmaps,
+        {i["id"]: i for i in instances},
+        instances,
+        external,
+        {},
+        ga.Dataset(),
+        add_rel,
+        errors,
+    )
+    return relations, errors
+
+
+def _id(container, pod=TRELLO_POD):
+    return next(i["id"] for i in pod if i["container"] == container)
+
+
+class McpClientTests(unittest.TestCase):
+    def test_mcp_edges_come_from_the_containers_the_binding_names(self):
+        relations, errors = _resolve_mcp([TRELLO], {"trello": ["filter", "server"]})
+
+        self.assertEqual(errors, [])
+        self.assertEqual(
+            {(r["source"], r["target"], r["type"]) for r in relations.values()},
+            {(_id("filter"), CLIENT["id"], "Serving"), (_id("server"), CLIENT["id"], "Serving")},
+        )
+
+    def test_a_server_host_that_resolves_to_no_provider_fails(self):
+        relations, errors = _resolve_mcp(
+            [{"name": "gone", "url": "http://gone.home/mcp"}], {"gone": ["server"]}
+        )
+
+        self.assertEqual(relations, {})
+        self.assertEqual(len(errors), 1)
+        self.assertIn("resolves to no provider", errors[0])
+
+    def test_a_server_with_no_qualifying_provider_fails(self):
+        cases = (
+            ("no-entry", {}, TRELLO_POD),
+            ("empty-entry", {"trello": []}, TRELLO_POD),
+            ("container-not-in-pod", {"trello": ["mcp-server"]}, TRELLO_POD),
+            ("one-named-container-missing", {"trello": ["filter", "gone"]}, TRELLO_POD),
+            (
+                "init-container",
+                {"trello": ["setup"]},
+                TRELLO_POD + [_inst("trello-prd", "trello", "setup", is_init=True)],
+            ),
+        )
+        for case, providers, pod in cases:
+            with self.subTest(case=case):
+                relations, errors = _resolve_mcp([TRELLO], providers, pod)
+
+                self.assertEqual(relations, {})
+                self.assertEqual(len(errors), 1)
+                self.assertIn("'trello'", errors[0])
+
+    def test_a_providers_entry_naming_no_rendered_server_fails(self):
+        _relations, errors = _resolve_mcp([TRELLO], {"trello": ["filter"], "jenkins": ["filter"]})
+
+        self.assertEqual(len(errors), 1)
+        self.assertIn("providers['jenkins']", errors[0])
+
+
+LOOPBACK = "http://127.0.0.1:8002/mcp"
+HOME_ASSISTANT = "ss:home-assistant-prd,00000000-0000-0000-0000-000000000003"
+
+
+def _proxy(ns, wl, url, providers, container="filter", var="MCP_UPSTREAM_URL"):
+    upstream = {"env": var}
+    if providers is not None:
+        upstream["providers"] = providers
+    return dict(_inst(ns, wl, container), env={var: url}, upstream=upstream)
+
+
+def _trello_pod(proxy):
+    return [_inst("trello-prd", "trello", "auth"), proxy, _inst("trello-prd", "trello", "server")]
+
+
+def _resolve_upstreams(instances, incluster=None, ds=None):
+    relations, errors = {}, []
+
+    def add_rel(rid, source, target, rtype):
+        relations[rid] = {"source": source, "target": target, "type": rtype}
+
+    ga.resolve_upstreams(
+        instances,
+        {i["id"]: i for i in instances},
+        {},
+        incluster or {},
+        ds or ga.Dataset(),
+        add_rel,
+        errors,
+    )
+    return {(r["source"], r["target"], r["type"]) for r in relations.values()}, errors
+
+
+class UpstreamTests(unittest.TestCase):
+    def test_a_loopback_upstream_is_the_named_container_of_the_proxys_own_pod(self):
+        proxy = _proxy("trello-prd", "trello", LOOPBACK, ["server"])
+        pod = _trello_pod(proxy)
+        # The same workload name in another namespace is another pod.
+        elsewhere = _inst("other-prd", "trello", "server")
+
+        edges, errors = _resolve_upstreams(pod + [elsewhere])
+
+        self.assertEqual(errors, [])
+        self.assertEqual(edges, {(_id("server", pod), proxy["id"], "Serving")})
+
+    def test_an_in_cluster_upstream_is_the_named_container_behind_the_service(self):
+        init = _inst("jenkins-prd", "jenkins", "install-homelab-ca", is_init=True)
+        jenkins = _inst("jenkins-prd", "jenkins", "jenkins")
+        proxy = _proxy(
+            "jenkins-prd", "jenkins-mcp", "http://jenkins:8080/mcp-server/stateless", ["jenkins"]
+        )
+
+        edges, errors = _resolve_upstreams(
+            [init, jenkins, proxy],
+            incluster={("jenkins-prd", "jenkins"): [init["id"], jenkins["id"]]},
+        )
+
+        self.assertEqual(errors, [])
+        self.assertEqual(edges, {(jenkins["id"], proxy["id"], "Serving")})
+
+    def test_a_cross_producer_upstream_is_the_element_its_host_names(self):
+        ds = ga.Dataset()
+        ds.add_envelope({"systemSoftware": [{"id": HOME_ASSISTANT}]})
+        server = _proxy(
+            "homeassistant-mcp-prd",
+            "homeassistant-mcp",
+            "https://homeassistant.webathome.org",
+            None,
+            container="ha-mcp-server",
+            var="HOMEASSISTANT_URL",
+        )
+
+        edges, errors = _resolve_upstreams([server], ds=ds)
+
+        self.assertEqual(errors, [])
+        self.assertEqual(edges, {(HOME_ASSISTANT, server["id"], "Serving")})
+
+    def test_an_upstream_that_cannot_be_placed_fails(self):
+        cases = (
+            (
+                "var-unset",
+                dict(_proxy("trello-prd", "trello", LOOPBACK, ["server"]), env={}),
+                "MCP_UPSTREAM_URL is not set",
+            ),
+            (
+                "host-unresolved",
+                _proxy("trello-prd", "trello", "http://gone:8080/mcp", ["server"]),
+                "resolves to no provider",
+            ),
+            (
+                "container-not-in-pod",
+                _proxy("trello-prd", "trello", LOOPBACK, ["server", "mcp-server"]),
+                "providers names ['mcp-server']",
+            ),
+            (
+                "empty-providers",
+                _proxy("trello-prd", "trello", LOOPBACK, []),
+                "no providers declared",
+            ),
+            (
+                "missing-providers",
+                _proxy("trello-prd", "trello", LOOPBACK, None),
+                "no providers declared",
+            ),
+        )
+        for case, proxy, message in cases:
+            with self.subTest(case=case):
+                edges, errors = _resolve_upstreams(_trello_pod(proxy))
+
+                self.assertEqual(edges, set())
+                self.assertEqual(len(errors), 1)
+                self.assertIn(message, errors[0])
+
+    def test_every_unplaceable_upstream_is_reported_in_one_run(self):
+        unset = dict(_proxy("a-prd", "a", LOOPBACK, ["server"]), env={})
+        unresolved = _proxy("b-prd", "b", "http://gone:8080/mcp", ["server"])
