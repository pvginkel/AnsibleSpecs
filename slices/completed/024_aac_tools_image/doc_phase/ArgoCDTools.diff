+"""What the aac-tools image has to keep true about what it bakes."""
+
+from __future__ import annotations
+
+import ast
+import hashlib
+import sys
+import unittest
+from pathlib import Path
+
+TESTS = Path(__file__).resolve().parent
+FOLDER = TESTS.parent
+REPO = FOLDER.parent
+
+# `arch-validate.py` as pvginkel/Architecture publishes it, which is the hash every
+# other copy in the estate carries. The image ships that file and no fork of it, so
+# what may not happen to it is an edit — running a formatter over it is exactly how
+# the estate's one drifted copy drifted. ruff.toml excludes it for that reason.
+CANONICAL_ARCH_VALIDATE_MD5 = "9e7e3f8c853efcce868fbe9d7ddedb3b"
+
+# The third-party import roots the image installs — python3-yaml, in the Dockerfile's
+# apt block. Anything else a baked module imports is simply absent at run time: the
+# image runs no pip and carries no virtualenv.
+INSTALLED_IMPORT_ROOTS = {"yaml"}
+
+
+def _baked_sources() -> list[Path]:
+    """Every python source inside the build context; tests are ignored out of it."""
+    return sorted(p for p in FOLDER.rglob("*.py") if TESTS not in p.parents)
+
+
+def _imported_roots(source: Path) -> set[str]:
+    """The top-level modules `source` imports absolutely; relative imports are its own."""
+    roots: set[str] = set()
+    for node in ast.walk(ast.parse(source.read_text())):
+        if isinstance(node, ast.Import):
+            roots.update(alias.name.split(".")[0] for alias in node.names)
+        elif isinstance(node, ast.ImportFrom) and node.level == 0:
+            roots.add(node.module.split(".")[0])
+    return roots
+
+
+class BakedSourceTests(unittest.TestCase):
+    def test_the_image_bakes_python_sources_at_all(self) -> None:
+        """A glob that silently found nothing would pass every assertion below."""
+        self.assertNotEqual(_baked_sources(), [])
+
+    def test_they_import_only_what_the_image_carries(self) -> None:
+        """A third-party import the image does not install fails at run time, in the
+        caller's pipeline or sidecar, with nothing before it to catch."""
+        for source in _baked_sources():
+            with self.subTest(module=str(source.relative_to(FOLDER))):
+                outside = _imported_roots(source) - sys.stdlib_module_names
+                self.assertEqual(outside - INSTALLED_IMPORT_ROOTS, set())
+
+
+class ShippedValidatorTests(unittest.TestCase):
+    def test_arch_validate_is_the_canonical_script(self) -> None:
+        """Byte for byte, or this is one more copy for the estate to reconcile rather
+        than the one canonical script the image exists to distribute."""
+        shipped = (FOLDER / "image" / "arch-validate.py").read_bytes()
+        self.assertEqual(hashlib.md5(shipped).hexdigest(), CANONICAL_ARCH_VALIDATE_MD5)
+
+
+class TrustRootTests(unittest.TestCase):
+    def test_both_images_bake_the_same_ca_root(self) -> None:
+        """The estate rotates the step-ca root across every copy in one change window,
+        and the rotation runbook works off a list of paths. Two copies in one repo that
+        can differ is a rotation that half-lands."""
+        self.assertEqual(
+            (FOLDER / "image" / "homelab-root.crt").read_bytes(),
+            (REPO / "argocd-hook" / "image" / "homelab-root.crt").read_bytes(),
+        )
