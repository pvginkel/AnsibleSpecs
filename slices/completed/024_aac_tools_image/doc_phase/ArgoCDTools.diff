+"""Loading a command the image bakes, the way a test can reach it.
+
+`gen-architecture` is installed as a file on PATH, not as a package on PYTHONPATH, so
+there is no module to import by name — the source is loaded from its path instead.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+IMAGE = Path(__file__).resolve().parent.parent / "image"
+
+
+def load(name):
+    spec = importlib.util.spec_from_file_location(f"aac_tools_{name}", IMAGE / f"{name}.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
diff --git a/aac-tools/tests/test_deploy_repo.py b/aac-tools/tests/test_deploy_repo.py
