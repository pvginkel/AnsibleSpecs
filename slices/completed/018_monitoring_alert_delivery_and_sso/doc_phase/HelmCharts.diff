@@ -0,0 +1,116 @@
+"""The prd Prometheus release's Alertmanager delivery to Telegram, against the
+release's own alert rules.
+
+Reads the real prometheus values and the release's manifests.yaml; writes
+nothing. Every rule is routed through the route tree the way Alertmanager
+matches it (first matching child, anchored regexes), and the inhibition is
+matched against every rule's alertname.
+"""
+
+import re
+from pathlib import Path
+
+import pytest
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+RELEASE = ROOT / "configs" / "prd" / "prometheus" / "prd"
+OPENBAO_PATH = "eso/prd/prometheus/prd/telegram"
+MATCHER = re.compile(r'(?P<name>\w+)(?P<op>=~|!~|!=|=)"(?P<value>.*)"')
+WEDGE_ALERT = "NodeMemoryStallCounterWedged"
+STALL_ALERTS = {"NodeMemoryStalled", "NodeMemoryStallElevated"}
+
+
+@pytest.fixture(scope="module")
+def values():
+    return yaml.safe_load((RELEASE / "values.yaml").read_text())
+
+
+@pytest.fixture(scope="module")
+def alertmanager(values):
+    return values["alertmanager"]
+
+
+@pytest.fixture(scope="module")
+def rule_labels(values):
+    groups = values["serverFiles"]["alerting_rules.yml"]["groups"]
+    return {r["alert"]: {"alertname": r["alert"], **r["labels"]} for g in groups for r in g["rules"]}
+
+
+@pytest.fixture(scope="module")
+def external_secret():
+    (doc,) = [d for d in yaml.safe_load_all((RELEASE / "manifests.yaml").read_text()) if d]
+    assert doc["kind"] == "ExternalSecret"
+    return doc
+
+
+def matches(matcher, labels):
+    m = MATCHER.fullmatch(matcher)
+    assert m, matcher
+    actual = labels.get(m["name"], "")
+    hit = re.fullmatch(m["value"], actual) is not None if "~" in m["op"] else actual == m["value"]
+    return hit != m["op"].startswith("!")
+
+
+def receiver_for(route, labels):
+    for child in route.get("routes") or []:
+        assert not child.get("continue")
+        if all(matches(m, labels) for m in child["matchers"]):
+            return receiver_for(child, labels)
+    return route["receiver"]
+
+
+def telegram(alertmanager, receiver):
+    (found,) = [r for r in alertmanager["config"]["receivers"] if r["name"] == receiver]
+    (config,) = found["telegram_configs"]
+    return config
+
+
+def test_critical_alerts_are_delivered_loud_and_every_other_alert_silent(alertmanager, rule_labels):
+    assert {labels["severity"] for labels in rule_labels.values()} == {"critical", "warning"}
+    route = alertmanager["config"]["route"]
+    for name, labels in rule_labels.items():
+        config = telegram(alertmanager, receiver_for(route, labels))
+        assert config["disable_notifications"] is (labels["severity"] != "critical"), name
+    assert telegram(alertmanager, receiver_for(route, {"alertname": "Unlabelled"}))["disable_notifications"] is True
+
+
+def test_one_nodes_fault_is_one_group(alertmanager):
