+    monkeypatch.setenv("OIDC_CLIENT_SECRET", "client-secret-from-env")
+    source = (CHART / "files" / "config_local.py").read_text()
+    source = source.replace("{{ .Values.oidc.issuerUrl }}", prd_values["oidc"]["issuerUrl"])
+    assert "{{" not in source
+    settings = {}
+    exec(compile(source, "config_local.py", "exec"), settings)
+    return settings
