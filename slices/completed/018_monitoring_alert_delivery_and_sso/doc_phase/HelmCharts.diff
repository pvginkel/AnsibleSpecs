@@ -0,0 +1,29 @@
+# The grafana client's id and secret for Keycloak sign-in, read by
+# values.yaml's envFromSecret. The grafana chart is upstream, so there is no
+# shared.externalsecrets helper to emit this. The Secret's keys are
+# Grafana's environment overrides of [auth.generic_oauth].
+#
+# Applied after `helm upgrade`: on the first deploy the new Grafana pod
+# waits on the Secret until ESO has synced it.
+
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: grafana-oidc
+  namespace: grafana-prd
+spec:
+  refreshInterval: 1h
+  secretStoreRef:
+    name: openbao-prd
+    kind: ClusterSecretStore
+  target:
+    name: grafana-oidc
+  data:
+    - secretKey: GF_AUTH_GENERIC_OAUTH_CLIENT_ID
+      remoteRef:
+        key: eso/prd/grafana/prd/oidc
+        property: client_id
+    - secretKey: GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET
+      remoteRef:
+        key: eso/prd/grafana/prd/oidc
+        property: client_secret
diff --git a/configs/prd/grafana/prd/values.yaml b/configs/prd/grafana/prd/values.yaml
index ed8da21..09a3714 100644
--- a/configs/prd/grafana/prd/values.yaml
+++ b/configs/prd/grafana/prd/values.yaml
@@ -7,6 +7,36 @@ service:
 
 fullnameOverride: grafana
 
+# Keycloak sign-in beside the local admin's login form. The client id and
+# secret reach Grafana as GF_AUTH_GENERIC_OAUTH_* environment overrides from
+# the grafana-oidc Secret (manifests.yaml).
+envFromSecret: grafana-oidc
+
+grafana.ini:
+  server:
+    # Grafana builds the OAuth redirect URI from this; Keycloak's grafana
+    # client registers http://grafana.home/login/generic_oauth.
+    root_url: http://grafana.home/
+  auth.generic_oauth:
+    enabled: true
+    name: Keycloak
+    allow_sign_up: true
+    scopes: openid email profile
+    auth_url: https://auth.ginbov.nl/realms/homelab/protocol/openid-connect/auth
+    token_url: https://auth.ginbov.nl/realms/homelab/protocol/openid-connect/token
+    api_url: https://auth.ginbov.nl/realms/homelab/protocol/openid-connect/userinfo
+    use_pkce: true
+    # Without a refresh token Grafana ends the session when Keycloak's
+    # access token expires.
+    use_refresh_token: true
+    login_attribute_path: preferred_username
+    # Keycloak puts client roles in the access token only. An account
+    # without the grafana client's admin role maps to no role, and strict
+    # mode refuses its login.
+    role_attribute_path: contains(resource_access.grafana.roles[*], 'admin') && 'GrafanaAdmin'
+    role_attribute_strict: true
+    allow_assign_grafana_admin: true
+
 persistence:
   enabled: true
   type: pvc
