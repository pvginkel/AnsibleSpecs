+# Alertmanager's Telegram bot token and chat id, mounted by values.yaml's
+# alertmanager.extraSecretMounts. The prometheus chart is upstream, so there
+# is no shared.externalsecrets helper to emit this.
+#
+# Applied after `helm upgrade`: on the first deploy the Alertmanager pod
+# waits on the Secret's mount until ESO has synced it.
+
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: alertmanager-telegram
+  namespace: prometheus-prd
+spec:
+  refreshInterval: 1h
+  secretStoreRef:
+    name: openbao-prd
+    kind: ClusterSecretStore
+  target:
+    name: alertmanager-telegram
+  data:
+    - secretKey: bot_token
+      remoteRef:
+        key: eso/prd/prometheus/prd/telegram
+        property: bot_token
+    - secretKey: chat_id
+      remoteRef:
+        key: eso/prd/prometheus/prd/telegram
+        property: chat_id
diff --git a/configs/prd/prometheus/prd/values.yaml b/configs/prd/prometheus/prd/values.yaml
index 254e3d3..149919c 100644
--- a/configs/prd/prometheus/prd/values.yaml
+++ b/configs/prd/prometheus/prd/values.yaml
@@ -247,6 +247,76 @@ alertmanager:
     requests:
       memory: 20Mi
 
+  # The Telegram bot token and chat id, materialised by ESO from OpenBao in
+  # manifests.yaml. Outside /etc/alertmanager, where the config ConfigMap is
+  # mounted. The receivers read both as files on every send, so neither value
+  # is in the rendered config.
+  extraSecretMounts:
+    - name: telegram
+      mountPath: /etc/secrets/telegram
+      secretName: alertmanager-telegram
+      readOnly: true
+
+  # The chart emits config and templates with plain toYaml (no `tpl`), so the
+  # {{ }} placeholders below reach Alertmanager verbatim.
+  config:
+    route:
+      receiver: telegram-warning
+      # A rule aggregated by node carries node but no instance; a per-target
+      # rule carries instance. Grouping on both keeps one node's fault one
+      # group under either shape.
+      group_by: [alertname, instance, node]
+      group_wait: 30s
+      group_interval: 5m
+      repeat_interval: 12h
+      routes:
+        - matchers: ['severity="critical"']
+          receiver: telegram-critical
+
+    # A wedged PSI counter reads as a stall forever, so on that node both stall
+    # alerts reduce to their memory and fault signals alone.
+    inhibit_rules:
+      - source_matchers: ['alertname="NodeMemoryStallCounterWedged"']
+        target_matchers: ['alertname=~"NodeMemoryStalled|NodeMemoryStallElevated"']
+        equal: [node]
+
+    # disable_notifications is a static flag, not a template, so loud and
+    # silent need a receiver each. parse_mode "" is plain text: expressions and
+    # annotations carry raw `<`, which Telegram's HTML mode rejects.
+    receivers:
+      - name: telegram-critical
+        telegram_configs:
+          - bot_token_file: /etc/secrets/telegram/bot_token
+            chat_id_file: /etc/secrets/telegram/chat_id
+            parse_mode: ""
+            message: '{{ template "telegram.message" . }}'
+            disable_notifications: false
+            send_resolved: true
+      - name: telegram-warning
+        telegram_configs:
+          - bot_token_file: /etc/secrets/telegram/bot_token
+            chat_id_file: /etc/secrets/telegram/chat_id
+            parse_mode: ""
+            message: '{{ template "telegram.message" . }}'
+            disable_notifications: true
+            send_resolved: true
+
+  # Mounted beside alertmanager.yml, which loads /etc/alertmanager/*.tmpl.
+  templates:
+    telegram.tmpl: |-
+      {{ define "telegram.message" -}}
+      {{ range .Alerts -}}
+      {{ if eq .Status "firing" }}[FIRING]{{ else }}[RESOLVED]{{ end }} {{ .Labels.alertname }}
+      {{ if .Labels.node }}host: {{ .Labels.node }}
+      {{ else if .Labels.instance }}host: {{ .Labels.instance }}
+      {{ end -}}
+      {{ .Annotations.summary }}
+      {{ with .Annotations.description }}
+      {{ . }}
+      {{ end }}
+      {{ end -}}
+      {{ end }}
+
