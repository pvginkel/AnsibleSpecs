@@ -0,0 +1,81 @@
+"""The prd Grafana release offers Keycloak sign-in, gated by the grafana
+client's admin role, beside its local login; the dev-cluster copy keeps its
+local login only.
+
+Reads the real prd and dev grafana releases; writes nothing.
+"""
+
+from pathlib import Path
+
+import pytest
+import yaml
+
+CONFIGS = Path(__file__).resolve().parents[1] / "configs"
+PRD = CONFIGS / "prd" / "grafana" / "prd"
+DEV = CONFIGS / "dev" / "grafana" / "prd"
+REALM = "https://auth.ginbov.nl/realms/homelab"
+OPENBAO_PATH = "eso/prd/grafana/prd/oidc"
+# Grafana reads GF_<SECTION>_<KEY> environment variables over grafana.ini.
+ENV_PROPERTIES = {
+    "GF_AUTH_GENERIC_OAUTH_CLIENT_ID": "client_id",
+    "GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET": "client_secret",
+}
+
+
+@pytest.fixture(scope="module")
+def values():
+    return yaml.safe_load((PRD / "values.yaml").read_text())
+
+
+@pytest.fixture(scope="module")
+def oauth(values):
+    return values["grafana.ini"]["auth.generic_oauth"]
+
+
+@pytest.fixture(scope="module")
+def external_secret():
+    (doc,) = [d for d in yaml.safe_load_all((PRD / "manifests.yaml").read_text()) if d]
+    assert doc["kind"] == "ExternalSecret"
+    return doc
+
+
+def test_keycloak_is_a_login_button_beside_the_local_login_form(values, oauth):
+    assert oauth["enabled"] is True
+    assert oauth["name"] == "Keycloak"
+    assert oauth["auth_url"] == f"{REALM}/protocol/openid-connect/auth"
+    assert oauth["token_url"] == f"{REALM}/protocol/openid-connect/token"
+    assert oauth["api_url"] == f"{REALM}/protocol/openid-connect/userinfo"
+    assert not oauth.get("auto_login")
+    assert not values["grafana.ini"].get("auth", {}).get("disable_login_form")
+
+
+def test_only_the_grafana_clients_admin_role_signs_in_and_as_grafana_admin(oauth):
+    # Keycloak puts client roles in the access token only; Grafana 12 reads
+    # the ID token, userinfo and the access token for the role.
+    assert oauth["role_attribute_path"] == "contains(resource_access.grafana.roles[*], 'admin') && 'GrafanaAdmin'"
+    assert oauth["role_attribute_strict"] is True
+    assert oauth["allow_assign_grafana_admin"] is True
+    assert oauth["allow_sign_up"] is True
+    assert not oauth.get("skip_org_role_sync")
+
+
+def test_the_redirect_is_built_from_the_address_keycloak_registered(values):
+    assert values["grafana.ini"]["server"]["root_url"] == "http://grafana.home/"
+    server_names = values["service"]["annotations"]["nginx.webathome.org/server-name"]
+    assert "grafana.home" in [name.strip() for name in server_names.split(",")]
+
+
+def test_client_id_and_secret_come_from_openbao_as_environment_overrides(values, oauth, external_secret):
+    spec = external_secret["spec"]
+    assert external_secret["metadata"]["namespace"] == "grafana-prd"
+    assert spec["secretStoreRef"] == {"name": "openbao-prd", "kind": "ClusterSecretStore"}
+    assert values["envFromSecret"] == spec["target"]["name"]
+    assert {d["remoteRef"]["key"] for d in spec["data"]} == {OPENBAO_PATH}
+    assert {d["secretKey"]: d["remoteRef"]["property"] for d in spec["data"]} == ENV_PROPERTIES
+    assert not {"client_id", "client_secret"} & set(oauth)
+
+
+def test_the_dev_cluster_copy_keeps_its_local_login_only():
+    values = yaml.safe_load((DEV / "values.yaml").read_text())
+    assert not {"grafana.ini", "envFromSecret", "envFromSecrets"} & set(values)
+    assert not (DEV / "manifests.yaml").exists()

