+def test_the_operators_keycloak_account_is_pre_created_as_admin_with_the_servers(config_local):
+    # A Keycloak sign-in lands in the pre-created account only if pgAdmin
+    # resolves the same username: the email the init container creates it as.
+    (provider,) = config_local["OAUTH2_CONFIG"]
+    assert provider["OAUTH2_USERNAME_CLAIM"] == "email"
+    spec = pod(keycloak=True)
+    init = by_name(spec["initContainers"])
+    assert list(init) == ["build-pgpass", "keycloak-admin"]
+    admin = init["keycloak-admin"]
+    assert admin["image"] == spec["containers"][0]["image"]
+    script = admin["command"][-1]
+    assert (
+        'setup.py add-external-user "$PGADMIN_EMAIL" --auth-source oauth2 --email "$PGADMIN_EMAIL" --admin'
+        in script
+    )
+    assert 'setup.py load-servers servers.json --user "$PGADMIN_EMAIL" --auth-source oauth2 --replace' in script
+    # pgAdmin keys the storage dir, and with it the pgpassfile, on the username.
+    email = by_name(admin["env"])["PGADMIN_EMAIL"]["value"]
+    assert email == by_name(init["build-pgpass"]["env"])["PGADMIN_EMAIL"]["value"]
+    assert email == "HELM(.Values.pgadmin.defaultEmail)"
+    mounts = {m["mountPath"]: m for m in admin["volumeMounts"]}
+    assert mounts["/var/lib/pgadmin"]["name"] == "storage-volume"
+    assert mounts["/pgadmin4/servers.json"] == {
+        "name": "config",
+        "mountPath": "/pgadmin4/servers.json",
+        "subPath": "servers.json",
+    }
+
