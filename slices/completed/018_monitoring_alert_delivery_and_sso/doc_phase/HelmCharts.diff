+    mounts = {m["mountPath"]: m for m in pod(keycloak=True)["containers"][0]["volumeMounts"]}
+    assert mounts["/pgadmin4/config_local.py"] == {
+        "name": "config",
+        "mountPath": "/pgadmin4/config_local.py",
+        "subPath": "config_local.py",
+    }
