+def test_a_release_without_keycloak_renders_its_internal_login_only():
+    spec = pod(keycloak=False)
+    assert [c["name"] for c in spec["initContainers"]] == ["build-pgpass"]
+    assert [v["name"] for v in spec["volumes"]] == ["storage-volume", "config"]
+    app = spec["containers"][0]
+    assert not {"OIDC_CLIENT_ID", "OIDC_CLIENT_SECRET"} & set(by_name(app["env"]))
+    assert "/pgadmin4/config_local.py" not in {m["mountPath"] for m in app["volumeMounts"]}
+    # config_local.py sits in files/ beside servers.json, so no glob may take it.
+    configmap = render_text("pgadmin-configmap.yaml", keycloak=False)
+    assert 'HELM((.Files.Glob "files/servers.json").AsConfig | nindent 2)' in configmap
+    assert "config_local" not in configmap
+
+    chart_values = yaml.safe_load((CHART / "values.yaml").read_text())
+    assert chart_values["oidc"]["issuerUrl"] is None
+    assert "oidc" not in chart_values["externalSecrets"]["secrets"]
