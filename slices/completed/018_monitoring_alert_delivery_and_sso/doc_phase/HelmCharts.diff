+def test_client_id_and_secret_come_from_openbao_as_environment(config_local, prd_values):
+    (provider,) = config_local["OAUTH2_CONFIG"]
+    assert provider["OAUTH2_CLIENT_ID"] == "client-id-from-env"
+    assert provider["OAUTH2_CLIENT_SECRET"] == "client-secret-from-env"
+
+    oidc = prd_values["externalSecrets"]["secrets"]["oidc"]
+    assert {d["path"] for d in oidc["data"]} == {OPENBAO_PATH}
+    assert {d["secretKey"]: d["property"] for d in oidc["data"]} == {
+        "client_id": "client_id",
+        "client_secret": "client_secret",
+    }
+    env = by_name(pod(keycloak=True)["containers"][0]["env"])
+    for variable, key in {"OIDC_CLIENT_ID": "client_id", "OIDC_CLIENT_SECRET": "client_secret"}.items():
+        assert env[variable]["valueFrom"]["secretKeyRef"] == {
+            "name": "HELM(.Values.externalSecrets.secrets.oidc.targetName)",
+            "key": key,
+        }
