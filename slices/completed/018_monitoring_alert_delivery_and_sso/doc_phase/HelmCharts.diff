diff --git a/tests/test_prometheus_node_memory_alerts.py b/tests/test_prometheus_node_memory_alerts.py
new file mode 100644
index 0000000..8997d36
--- /dev/null
+++ b/tests/test_prometheus_node_memory_alerts.py
@@ -0,0 +1,139 @@
+"""The prd Prometheus release's node memory-stall alerts, against the episodes
+their thresholds were set from.
+
+Reads the real prometheus values; writes nothing. Each rule's expression is
+matched whole, its thresholds read out of it, and the recorded episodes walked
+through them: the 2026-08-02 starvation meets the stall alerts' memory signals,
+and the wedged counters (srvk8s3 from 2026-08-13, srvk8s2 2026-09-07..13,
+srvk8s1 from 2026-09-16) meet the wedge warning's instead.
+"""
+
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+import pytest
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+ALERTS = ROOT / "configs" / "prd" / "prometheus" / "prd" / "values.yaml"
+
+JOB = re.escape('{job="kubernetes-service-endpoints"}')
+# Every term aggregates by node, never matching on instance: a node-exporter
+# chart upgrade leaves two series per node that differ only in helm_sh_chart.
+STALL = rf"max by \(node\) \(rate\(node_pressure_memory_stalled_seconds_total{JOB}\[5m\]\)\) > (?P<stall>[\d.]+)"
+AVAILABLE = (
+    rf"min by \(node\) \(\s+node_memory_MemAvailable_bytes{JOB}\s+/ node_memory_MemTotal_bytes{JOB}\s+\)"
+    r" (?P<avail_op>[<>]) (?P<avail>[\d.]+)"
+)
+FAULTS = (
+    rf"max by \(node\) \(rate\(node_vmstat_pgmajfault{JOB}\[(?P<window>\w+)\]\)\)"
+    r" (?P<faults_op>[<>]) (?P<faults>[\d.]+)"
+)
+HOLD = r'max by \(node\) \(max_over_time\(ALERTS\{alertname="(?P<own>\w+)", alertstate="firing"\}\[(?P<look_back>\w+)\]\)\)'
+CORROBORATED = rf"{STALL}\s+and on \(node\) \(\s+{AVAILABLE}\s+or\s+{FAULTS}\s+\)\s*"
+WEDGED = rf"{STALL}\s+and on \(node\) \(\s+\(\s+{AVAILABLE}\s+and on \(node\)\s+{FAULTS}\s+\)\s+or\s+{HOLD}\s+\)\s*"
+# Prometheus' --rules.alert.for-grace-period default; the release does not set it.
+FOR_GRACE_MINUTES = 10
+
+
+@dataclass(frozen=True)
+class Episode:
+    name: str
+    available: float  # MemAvailable / MemTotal
+    faults: float  # major faults/s
+
+
+# AnsibleSpecs handovers/memory-issues/06-eviction.md:73 and
+# 02-measurements.md:136: 0.62 GiB of 15.6, 670-770 major faults/s.
+STARVATION = Episode("2026-08-02 srvk8s1", 0.62 / 15.6, 670)
+# 5.3 GiB of 15.6 at 2.2 faults/s; never under 37% at ~0; 33% at 1.7 faults/s.
+WEDGES = [
+    Episode("srvk8s3 from 2026-08-13", 5.3 / 15.6, 2.2),
+    Episode("srvk8s2 2026-09-07..13", 0.37, 0.0),
+    Episode("srvk8s1 from 2026-09-16", 0.33, 1.7),
+]
+STALL_ALERTS = [("NodeMemoryStalled", 0.05, "10m", "critical"), ("NodeMemoryStallElevated", 0.02, "15m", "warning")]
+WEDGE_ALERT = "NodeMemoryStallCounterWedged"
+
+
+def minutes(duration):
+    value, unit = re.fullmatch(r"(\d+)([mh])", duration).groups()
+    return int(value) * (60 if unit == "h" else 1)
+
+
+def holds(op, value, threshold):
+    return value < threshold if op == "<" else value > threshold
+
+
+def available(terms, episode):
+    return holds(terms["avail_op"], episode.available, float(terms["avail"]))
+
+
+def faulting(terms, episode):
+    return holds(terms["faults_op"], episode.faults, float(terms["faults"]))
+
+
+@pytest.fixture(scope="module")
+def rules():
+    groups = yaml.safe_load(ALERTS.read_text())["serverFiles"]["alerting_rules.yml"]["groups"]
+    (group,) = [g for g in groups if g["name"] == "node-memory-pressure"]
+    return {r["alert"]: r for r in group["rules"]}
+
+
+@pytest.fixture(scope="module")
+def terms(rules):
+    shapes = {name: CORROBORATED for name, *_ in STALL_ALERTS} | {WEDGE_ALERT: WEDGED}
+    found = {}
+    for name, shape in shapes.items():
+        match = re.fullmatch(shape, rules[name]["expr"])
+        assert match, rules[name]["expr"]
+        found[name] = match.groupdict()
+    return found
+
+
+def test_the_group_holds_the_two_stall_alerts_and_the_wedge_warning(rules):
+    assert sorted(rules) == sorted([name for name, *_ in STALL_ALERTS] + [WEDGE_ALERT])
+    for rule in rules.values():
+        assert rule["annotations"]["summary"].startswith("{{ $labels.node }} ")
+
+
+@pytest.mark.parametrize(("name", "stall", "for_", "severity"), STALL_ALERTS)
+def test_stall_alerts_need_the_mixin_memory_signals_on_the_same_node(rules, terms, name, stall, for_, severity):
+    assert float(terms[name]["stall"]) == stall
+    assert rules[name]["for"] == for_
+    assert rules[name]["labels"] == {"severity": severity}
+    assert (terms[name]["avail_op"], float(terms[name]["avail"])) == ("<", 0.10)
+    assert (terms[name]["window"], terms[name]["faults_op"], float(terms[name]["faults"])) == ("5m", ">", 500)
+
+    assert available(terms[name], STARVATION) and faulting(terms[name], STARVATION)
+    for wedge in WEDGES:
+        assert not available(terms[name], wedge) and not faulting(terms[name], wedge), wedge.name
+
+
+def test_wedge_warning_qualifies_on_the_recorded_wedges_and_not_the_starvation(rules, terms):
+    rule, wedged = rules[WEDGE_ALERT], terms[WEDGE_ALERT]
+    assert rule["labels"] == {"severity": "warning"}
+    assert minutes(rule["for"]) >= 60
+    assert (wedged["avail_op"], float(wedged["avail"])) == (">", 0.25)
+    assert (wedged["window"], wedged["faults_op"], float(wedged["faults"])) == ("1h", "<", 50)
+
+    for wedge in WEDGES:
+        assert available(wedged, wedge) and faulting(wedged, wedge), wedge.name
+    assert not available(wedged, STARVATION) and not faulting(wedged, STARVATION)
+
+
+def test_wedge_warning_holds_across_every_stall_either_stall_alert_can_fire_on(rules, terms):
+    rule, wedged = rules[WEDGE_ALERT], terms[WEDGE_ALERT]
+    assert float(wedged["stall"]) <= min(float(terms[name]["stall"]) for name, *_ in STALL_ALERTS)
+    assert wedged["own"] == WEDGE_ALERT
+    # Over the grace period, so a restored alert stays held while pending;
+    # under `for:`, so a counter that stalls again after the warning resolved
+    # has to qualify afresh.
+    assert FOR_GRACE_MINUTES < minutes(wedged["look_back"]) < minutes(rule["for"])
+    server = yaml.safe_load(ALERTS.read_text())["server"]
+    assert "for-grace-period" not in str([server.get("extraArgs"), server.get("extraFlags")])
+
+
+def test_wedge_warning_says_the_stall_alerts_are_blind_until_a_reboot(rules):
+    assert rules[WEDGE_ALERT]["annotations"]["summary"].endswith("its stall alerts are blind until it is rebooted")

