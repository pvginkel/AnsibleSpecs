+"""The pgadmin chart offers Keycloak sign-in, gated by the pgadmin client's
+admin role, beside the internal login when a release sets oidc.issuerUrl; the
+prd release does, and the dev-cluster copy keeps its internal login only.
+
+Reads the real pgadmin chart and its prd and dev releases; writes nothing.
+"""
+
+import re
+from pathlib import Path
+
+import pytest
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+CHART = ROOT / "charts" / "pgadmin"
+PRD = ROOT / "configs" / "prd" / "pgadmin" / "prd"
+DEV = ROOT / "configs" / "dev" / "pgadmin" / "prd"
+REALM = "https://auth.ginbov.nl/realms/homelab"
+OPENBAO_PATH = "eso/prd/pgadmin/prd/oidc"
+GATE = "{{- if .Values.oidc.issuerUrl }}"
+
+
+def render_text(template, keycloak):
+    """The template with the oidc.issuerUrl blocks kept or dropped, every other
+    block kept, and each remaining Helm expression left as HELM(<expr>)."""
+    kept, stack = [], []
+    for line in (CHART / "templates" / template).read_text().splitlines():
+        action = line.strip()
+        if action.startswith("{{") and re.match(r"\{\{-? *if ", action):
+            stack.append(keycloak if action == GATE else True)
+        elif re.fullmatch(r"\{\{-? *end *-?\}\}", action):
+            stack.pop()
+        elif all(stack):
+            kept.append(re.sub(r"\{\{-? *(.*?) *-?\}\}", r"HELM(\1)", line))
+    assert not stack
+    return "\n".join(kept)
+
+
+def pod(keycloak):
+    return yaml.safe_load(render_text("pgadmin-deployment.yaml", keycloak))["spec"]["template"]["spec"]
+
+
+def by_name(items):
+    return {item["name"]: item for item in items}
+
+
