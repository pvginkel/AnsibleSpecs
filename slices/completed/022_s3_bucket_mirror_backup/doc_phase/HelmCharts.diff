@@ -0,0 +1,119 @@
+"""Nightly encrypted mirror of every prd-stage RGW bucket to Google Drive.
+
+Run by the s3-mirror CronJob. Two rclone remotes come from the environment:
+`rgw`, the object gateway read with backup-reader's key, and `mirror`, a crypt
+remote over the Drive folder. The Drive remote and its OAuth token come from a
+private copy of the shared rclone config, so this job never writes the file
+storage-sync-cronjob and storage-refresh-keys-cronjob read.
+
+Each bucket owned by a prd-stage user is mirrored to
+
+    mirror:current/<bucket>/<key>              live state
+    mirror:archive/<bucket>/<run stamp>/<key>  what the run replaced or deleted
+
+and then keeps its KEEP_ARCHIVES newest archive folders. A bucket that fails is
+not pruned; the run carries on with the other buckets and then fails.
+"""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import time
+
+PRD_OWNER_SUFFIX = "-prd"
+RCLONE_EXIT_DIR_NOT_FOUND = 3
+
+
+def rclone(*args):
+    subprocess.run(["rclone", *args], check=True)
+
+
+def obscure(secret):
+    return subprocess.run(
+        ["rclone", "obscure", "-"],
+        input=secret, check=True, text=True, stdout=subprocess.PIPE,
+    ).stdout.strip()
+
+
+def prd_buckets(endpoint, access_key, secret_key):
+    """Every bucket owned by a prd-stage user, from the RGW admin API.
+
+    S3 ListBuckets returns only the caller's own buckets; the admin listing
+    needs backup-reader's buckets=read cap.
+    """
+    proc = subprocess.run(
+        ["curl", "--silent", "--show-error", "--fail-with-body", "--config", "-",
+         "--aws-sigv4", "aws:amz:default:s3",
+         endpoint + "/admin/bucket?format=json&stats=true"],
+        input='user = "%s:%s"\n' % (access_key, secret_key),
+        text=True, stdout=subprocess.PIPE,
+    )
+    if proc.returncode != 0:
+        sys.exit("listing buckets failed (curl exit %d): %s" % (proc.returncode, proc.stdout.strip()))
+    buckets = sorted(b["bucket"] for b in json.loads(proc.stdout) if b["owner"].endswith(PRD_OWNER_SUFFIX))
+    if not buckets:
+        sys.exit("no bucket is owned by a prd-stage user")
+    return buckets
+
+
+def sync(bucket, stamp):
+    rclone(
+        "sync", "rgw:" + bucket, "mirror:current/" + bucket,
+        "--backup-dir", "mirror:archive/%s/%s" % (bucket, stamp),
+        "--verbose",
+    )
+
+
+def prune(bucket, keep):
+    """Purge all but the `keep` newest archive folders of a bucket.
+
+    rclone creates a run's archive folder only when it moves an object into
+    it, so every folder counted is a run that replaced or deleted something.
+    """
+    listing = subprocess.run(
+        ["rclone", "lsf", "--dirs-only", "mirror:archive/" + bucket],
+        text=True, capture_output=True,
+    )
+    if listing.returncode == RCLONE_EXIT_DIR_NOT_FOUND:
+        return
+    sys.stderr.write(listing.stderr)
+    listing.check_returncode()
+    folders = sorted(line.rstrip("/") for line in listing.stdout.splitlines())
+    for folder in folders[:-keep]:
+        print("  pruning archive", folder, flush=True)
+        rclone("purge", "mirror:archive/%s/%s" % (bucket, folder))
+
+
+def main():
+    env = os.environ
+    shutil.copyfile(env["SHARED_RCLONE_CONFIG"], env["RCLONE_CONFIG"])
+    env["RCLONE_CONFIG_MIRROR_PASSWORD"] = obscure(env.pop("CRYPT_PASSWORD"))
+    env["RCLONE_CONFIG_MIRROR_PASSWORD2"] = obscure(env.pop("CRYPT_SALT"))
+    keep = int(env["KEEP_ARCHIVES"])
+
+    buckets = prd_buckets(
+        env["RCLONE_CONFIG_RGW_ENDPOINT"],
+        env["RCLONE_CONFIG_RGW_ACCESS_KEY_ID"],
+        env["RCLONE_CONFIG_RGW_SECRET_ACCESS_KEY"],
+    )
+    print("buckets to mirror:", ", ".join(buckets), flush=True)
+
+    # UTC and fixed width, so lexical order is chronological order.
+    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
+    failures = []
+    for bucket in buckets:
+        print("==> mirroring", bucket, flush=True)
+        try:
+            sync(bucket, stamp)
+            prune(bucket, keep)
+        except subprocess.CalledProcessError as exc:
+            print("ERROR: %s: %s" % (bucket, exc), file=sys.stderr, flush=True)
+            failures.append(bucket)
+    if failures:
+        sys.exit("FAILED buckets: " + ", ".join(failures))
+    print("all buckets mirrored", flush=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/charts/storage/templates/s3-mirror-cronjob.yaml b/charts/storage/templates/s3-mirror-cronjob.yaml
