index 0000000..f534c05
--- /dev/null
+++ b/tests/test_storage_s3_mirror.py
@@ -0,0 +1,228 @@
+"""The storage chart's s3-mirror script, driven with a fake subprocess.run.
+
+The script ships in charts/storage/files/ and runs in the s3-mirror CronJob;
+it is imported from there, and nothing here calls rclone or curl.
+"""
+
+import importlib.util
+import json
+import os
+import re
+import subprocess
+from pathlib import Path
+
+import pytest
+
+SCRIPT = Path(__file__).resolve().parents[1] / "charts" / "storage" / "files" / "s3-mirror" / "s3_mirror.py"
+
+SECRETS = {
+    "RCLONE_CONFIG_RGW_ACCESS_KEY_ID": "AKREADER",
+    "RCLONE_CONFIG_RGW_SECRET_ACCESS_KEY": "SKREADER",
+    "CRYPT_PASSWORD": "crypt-password",
+    "CRYPT_SALT": "crypt-salt",
+}
+
+LIVE_BUCKETS = [
+    {"bucket": "iot-prd-attachments", "owner": "iot-prd"},
+    {"bucket": "design-assistant-dev", "owner": "design-assistant-dev"},
+    {"bucket": "design-assistant-uat", "owner": "design-assistant-uat"},
+    {"bucket": "electronics-inventory-prd-part-attachments", "owner": "electronics-inventory-prd"},
+    {"bucket": "design-assistant-prd", "owner": "design-assistant-prd"},
+]
+
+
+@pytest.fixture
+def s3_mirror():
+    spec = importlib.util.spec_from_file_location("s3_mirror", SCRIPT)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+class FakeRun:
+    """Stands in for subprocess.run; answers by the command it is given."""
+
+    def __init__(self, buckets=LIVE_BUCKETS, curl_exit=0, failing_syncs=(), archives=None):
+        self.buckets = buckets
+        self.curl_exit = curl_exit
+        self.failing_syncs = set(failing_syncs)
+        self.archives = archives or {}
+        self.calls = []
+
+    def __call__(self, argv, input=None, check=False, text=None, stdout=None, capture_output=False):
+        self.calls.append((argv, input))
+        rc, out = self._answer(argv, input)
+        err = "error listing: directory not found\n" if rc else ""
+        if check and rc:
+            raise subprocess.CalledProcessError(rc, argv, out, err)
+        return subprocess.CompletedProcess(argv, rc, out, err)
+
+    def _answer(self, argv, input):
+        if argv[0] == "curl":
+            if self.curl_exit:
+                return self.curl_exit, '{"Code":"AccessDenied"}'
+            return 0, json.dumps(self.buckets)
+        verb = argv[1]
+        if verb == "obscure":
+            return 0, "obscured(%s)\n" % input
+        if verb == "sync":
+            return (1 if argv[2][len("rgw:"):] in self.failing_syncs else 0), None
+        if verb == "lsf":
+            bucket = argv[3][len("mirror:archive/"):]
+            if bucket not in self.archives:
+                return 3, ""
+            return 0, "".join(folder + "/\n" for folder in self.archives[bucket])
+        if verb == "purge":
+            return 0, None
+        raise AssertionError("unexpected command %r" % argv)
+
+    def commands(self, verb):
+        return [argv for argv, _ in self.calls if argv[0] == "rclone" and argv[1] == verb]
+
+
+@pytest.fixture
+def job_env(tmp_path, monkeypatch):
+    shared = tmp_path / "data" / "rclone.conf"
+    shared.parent.mkdir()
+    shared.write_text("[gdrive-pieter]\ntype = drive\n")
+    private = tmp_path / "work" / "rclone.conf"
+    private.parent.mkdir()
+    env = {
+        "SHARED_RCLONE_CONFIG": str(shared),
+        "RCLONE_CONFIG": str(private),
+        "KEEP_ARCHIVES": "30",
+        "RCLONE_CONFIG_RGW_ENDPOINT": "http://ceph:7480",
+        # Set so monkeypatch removes what the script writes here.
+        "RCLONE_CONFIG_MIRROR_PASSWORD": "",
+        "RCLONE_CONFIG_MIRROR_PASSWORD2": "",
+        **SECRETS,
+    }
+    for name, value in env.items():
+        monkeypatch.setenv(name, value)
+    return env
+
+
+def run_job(s3_mirror, monkeypatch, fake):
+    monkeypatch.setattr(s3_mirror.subprocess, "run", fake)
+    s3_mirror.main()
+
+
+def test_mirrors_every_bucket_owned_by_a_prd_stage_user_and_nothing_else(s3_mirror, job_env, monkeypatch):
+    fake = FakeRun()
+    run_job(s3_mirror, monkeypatch, fake)
+
+    syncs = fake.commands("sync")
+    assert [argv[2] for argv in syncs] == [
+        "rgw:design-assistant-prd",
+        "rgw:electronics-inventory-prd-part-attachments",
+        "rgw:iot-prd-attachments",
+    ]
+    stamps = set()
+    for argv in syncs:
+        bucket = argv[2][len("rgw:"):]
+        assert argv[3] == "mirror:current/" + bucket
+        backup_dir = argv[argv.index("--backup-dir") + 1]
+        prefix = "mirror:archive/%s/" % bucket
+        assert backup_dir.startswith(prefix)
+        stamps.add(backup_dir[len(prefix):])
+    assert len(stamps) == 1
+    assert re.fullmatch(r"\d{8}T\d{6}Z", stamps.pop())
+
+
+def test_buckets_are_listed_through_the_admin_api_with_the_key_off_the_command_line(s3_mirror, job_env, monkeypatch):
+    fake = FakeRun()
+    run_job(s3_mirror, monkeypatch, fake)
+
+    (argv, stdin), = [call for call in fake.calls if call[0][0] == "curl"]
+    assert argv[-1] == "http://ceph:7480/admin/bucket?format=json&stats=true"
+    assert "AKREADER:SKREADER" in stdin
+    for argv, _ in fake.calls:
+        assert not any(secret in arg for secret in SECRETS.values() for arg in argv)
+
+
+def test_the_crypt_password_and_salt_reach_rclone_only_obscured(s3_mirror, job_env, monkeypatch):
+    run_job(s3_mirror, monkeypatch, FakeRun())
+
+    assert os.environ["RCLONE_CONFIG_MIRROR_PASSWORD"] == "obscured(crypt-password)"
+    assert os.environ["RCLONE_CONFIG_MIRROR_PASSWORD2"] == "obscured(crypt-salt)"
+    assert "CRYPT_PASSWORD" not in os.environ
+    assert "CRYPT_SALT" not in os.environ
+
+
+def test_rclone_reads_a_private_copy_of_the_shared_config(s3_mirror, job_env, monkeypatch):
+    run_job(s3_mirror, monkeypatch, FakeRun())
+
+    assert Path(job_env["RCLONE_CONFIG"]).read_text() == Path(job_env["SHARED_RCLONE_CONFIG"]).read_text()
+
+
+def test_a_bucket_that_fails_to_sync_fails_the_run_after_the_others_are_mirrored_and_is_not_pruned(
+        s3_mirror, job_env, monkeypatch):
+    fake = FakeRun(failing_syncs={"electronics-inventory-prd-part-attachments"})
+
+    with pytest.raises(SystemExit) as exc:
+        run_job(s3_mirror, monkeypatch, fake)
+
+    assert "electronics-inventory-prd-part-attachments" in str(exc.value.code)
+    assert len(fake.commands("sync")) == 3
+    assert [argv[3] for argv in fake.commands("lsf")] == [
+        "mirror:archive/design-assistant-prd",
+        "mirror:archive/iot-prd-attachments",
+    ]
+
+
+def test_a_failed_bucket_listing_fails_the_run_before_any_sync(s3_mirror, job_env, monkeypatch):
+    fake = FakeRun(curl_exit=22)
+
+    with pytest.raises(SystemExit) as exc:
+        run_job(s3_mirror, monkeypatch, fake)
+
+    assert "AccessDenied" in str(exc.value.code)
+    assert fake.commands("sync") == []
+
+
+def test_no_bucket_owned_by_a_prd_stage_user_fails_the_run(s3_mirror, job_env, monkeypatch):
+    fake = FakeRun(buckets=[{"bucket": "design-assistant-dev", "owner": "design-assistant-dev"}])
+
+    with pytest.raises(SystemExit):
+        run_job(s3_mirror, monkeypatch, fake)
+
+    assert fake.commands("sync") == []
+
+
+def test_each_bucket_keeps_its_newest_archive_folders_and_purges_the_rest(s3_mirror, job_env, monkeypatch):
+    folders = ["202609%02dT013000Z" % day for day in range(1, 31)] + ["20260831T013000Z", "20260830T013000Z"]
+    fake = FakeRun(archives={"iot-prd-attachments": list(reversed(folders)),
+                             "design-assistant-prd": folders[:30]})
+
+    run_job(s3_mirror, monkeypatch, fake)
+
+    assert [argv[2] for argv in fake.commands("purge")] == [
+        "mirror:archive/iot-prd-attachments/20260830T013000Z",
+        "mirror:archive/iot-prd-attachments/20260831T013000Z",
+    ]
+
+
+def test_a_bucket_with_no_archive_yet_purges_nothing(s3_mirror, job_env, monkeypatch):
+    fake = FakeRun()
+
+    run_job(s3_mirror, monkeypatch, fake)
+
+    assert len(fake.commands("lsf")) == 3
+    assert fake.commands("purge") == []
