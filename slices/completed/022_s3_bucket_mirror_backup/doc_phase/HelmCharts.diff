+"""The backup reader's grant through terraform-modules/s3-storage.
+
+Reads the real module, the prd release trees and _providers/clusters.yaml;
+writes nothing and runs no terraform. The module's ask is matched in the one
+shape the provider needs — the namespace's stage suffix, else null — and that
+suffix is applied to every prd stage's resolved namespace.
+"""
+
+import re
+
+import yaml
+
+from deploy_cli.release import repo_root, resolve
+
+ASK = re.compile(
+    r"^\s*grant_backup_reader\s*=\s*"
+    r'endswith\(var\.namespace,\s*"([^"]+)"\)\s*\?\s*true\s*:\s*null\s*$',
+    re.M,
+)
+MODULE_BLOCK = re.compile(r'^module "(?P<label>[^"]+)" \{\n(?P<body>.*?)^\}', re.M | re.S)
+S3_STORAGE_SOURCE = '"./terraform-modules/s3-storage"'
+
+
+def _arg(body, key):
+    match = re.search(rf"^\s*{key}\s*=\s*(.+?)\s*$", body, re.M)
+    return match.group(1) if match else None
+
+
+def _ask_suffix(root):
+    text = (root / "terraform-modules" / "s3-storage" / "main.tf").read_text()
+    assert len(re.findall(r"^\s*grant_backup_reader\s*=", text, re.M)) == 1
+    (suffix,) = ASK.findall(text)
+    return suffix
+
+
+def _s3_storage_namespace_args(stage_dir):
+    """The namespace argument of every s3-storage call in a stage's Terraform,
+    followed through the file's namespace module."""
+    found = []
+    for tf in sorted([*(stage_dir.parent / "_shared").glob("*.tf"), *stage_dir.glob("*.tf")]):
+        modules = {m["label"]: m["body"] for m in MODULE_BLOCK.finditer(tf.read_text())}
+        for body in modules.values():
+            if _arg(body, "source") != S3_STORAGE_SOURCE:
+                continue
+            namespace = _arg(body, "namespace")
+            if namespace == "module.namespace.name":
+                namespace = _arg(modules["namespace"], "name")
+            found.append(namespace)
+    return found
+
+
+def test_a_prd_stage_release_asks_for_the_grant_and_every_other_leaves_it_null():
+    """var.namespace is the resolved release namespace (the deploy CLI exports
+    it as TF_VAR_namespace), so the suffix decides per stage directory."""
+    root = repo_root()
+    suffix = _ask_suffix(root)
+    asks = {}
+
+    for chart in sorted((root / "configs" / "prd").iterdir()):
+        if not chart.is_dir():
+            continue
+        for stage_dir in sorted(chart.iterdir()):
+            if not stage_dir.is_dir() or stage_dir.name == "_shared":
+                continue
+            namespaces = _s3_storage_namespace_args(stage_dir)
+            if not namespaces:
+                continue
+            assert set(namespaces) == {"var.namespace"}, stage_dir
+            namespace = resolve(f"prd/{chart.name}", stage_dir.name).namespace
+            asks[namespace] = namespace.endswith(suffix)
+
+            assert asks[namespace] == (stage_dir.name == "prd"), namespace
+
+    assert True in asks.values()
+    assert False in asks.values()
+
+
+def test_only_the_prd_cluster_names_the_reader_its_storage_release_creates():
+    root = repo_root()
+    clusters = yaml.safe_load((root / "_providers" / "clusters.yaml").read_text())
+    storage_tf = (root / "configs" / "prd" / "storage" / "_shared" / "infrastructure.tf").read_text()
+    (created,) = re.findall(
+        r'^resource "homelab_s3_reader" "[^"]+" \{\n\s*name\s*=\s*"([^"]+)"', storage_tf, re.M
+    )
+
+    assert clusters["prd"]["env"]["HOMELAB_S3_BACKUP_READER"] == created
+    others = {name: cfg for name, cfg in clusters.items() if name != "prd"}
+    assert others
+    for name, cfg in others.items():
+        assert "HOMELAB_S3_BACKUP_READER" not in ((cfg or {}).get("env") or {}), name
