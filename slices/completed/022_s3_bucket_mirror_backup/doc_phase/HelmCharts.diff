+"""The prd Prometheus release's S3 mirror freshness alert, against the storage
+chart's s3-mirror CronJob it watches.
+
+Reads the real prometheus and storage values and the CronJob template; writes
+nothing. Both edges of the rule are walked night by night across a year, so
+both DST changes fall inside the window.
+"""
+
+import re
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import pytest
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+ALERTS = ROOT / "configs" / "prd" / "prometheus" / "prd" / "values.yaml"
+STORAGE_CHART = ROOT / "charts" / "storage"
+STORAGE_PRD_VALUES = ROOT / "configs" / "prd" / "storage" / "prd" / "values.yaml"
+
+SELECTOR = 'namespace="storage-prd",cronjob="s3-mirror"'
+# The CronJob sets no timeZone, so its schedule is in the nodes' zone: the
+# Ansible baseline role's baseline_timezone.
+NODE_ZONE = ZoneInfo("Europe/Amsterdam")
+# From a Job's completion to the alert seeing it: the kube-state-metrics scrape
+# and rule evaluation intervals (1m each on prd), plus controller latency.
+LAG = timedelta(minutes=5)
+NIGHTS = [date(2026, 9, 1) + timedelta(days=n) for n in range(400)]
+
+
+@pytest.fixture(scope="module")
+def rule():
+    groups = yaml.safe_load(ALERTS.read_text())["serverFiles"]["alerting_rules.yml"]["groups"]
+    (found,) = [r for g in groups for r in g["rules"] if r.get("alert") == "S3MirrorStale"]
+    return found
+
+
+@pytest.fixture(scope="module")
+def threshold(rule):
+    match = re.search(r"\)\s*>\s*(\d+)\s*\*\s*3600\s*$", rule["expr"].strip())
+    assert match, rule["expr"]
+    return timedelta(hours=int(match.group(1)))
+
+
+@pytest.fixture(scope="module")
+def mirror():
+    chart = yaml.safe_load((STORAGE_CHART / "values.yaml").read_text())["s3Mirror"]
+    prd = yaml.safe_load(STORAGE_PRD_VALUES.read_text())["s3Mirror"]
+    return {**chart, **prd}
+
+
+@pytest.fixture(scope="module")
+def run_start(mirror):
+    minute, hour, *daily = mirror["schedule"].split()
+    assert daily == ["*", "*", "*"], mirror["schedule"]
+
+    def _start(night):
+        local = datetime(night.year, night.month, night.day, int(hour), int(minute), tzinfo=NODE_ZONE)
+        return local.astimezone(timezone.utc)
+
+    return _start
+
+
+@pytest.fixture(scope="module")
+def run_bound(mirror):
+    return timedelta(seconds=int(mirror["activeDeadlineSeconds"]))
+
+
+def test_rule_is_critical_and_watches_the_prd_mirror_only(rule, mirror):
+    template = (STORAGE_CHART / "templates" / "s3-mirror-cronjob.yaml").read_text()
+    assert re.search(r"kind: CronJob\nmetadata:\n  name: s3-mirror\n", template)
+    assert mirror["enabled"] is True
+
+    assert rule["labels"]["severity"] == "critical"
+    series = re.findall(r"(kube_cronjob_\w+)\{([^}]*)\}", rule["expr"])
+    assert sorted(series) == [
+        ("kube_cronjob_created", SELECTOR),
+        ("kube_cronjob_status_last_successful_time", SELECTOR),
+    ]
+    assert re.search(r"kube_cronjob_status_last_successful_time\{[^}]*\}\s+or\s+kube_cronjob_created", rule["expr"])
+    assert "postgres-backup" not in rule["expr"]
+
+
+def test_one_missed_night_stays_quiet_however_long_the_next_run_takes(threshold, run_start, run_bound):
+    for night in NIGHTS:
+        fastest_success = run_start(night)
+        slowest_success_two_nights_on = run_start(night + timedelta(days=2)) + run_bound
+        assert slowest_success_two_nights_on + LAG - fastest_success < threshold, night
+
+
+def test_two_missed_nights_fire_hours_after_the_second(threshold, run_start, run_bound):
+    for night in NIGHTS:
+        second_failed = run_start(night + timedelta(days=2))
+        third_run = run_start(night + timedelta(days=3))
+        for last_success in (run_start(night), run_start(night) + run_bound):
+            fires = last_success + threshold + LAG
+            assert fires - second_failed <= timedelta(hours=7) + LAG, night
+            assert fires < third_run, night

