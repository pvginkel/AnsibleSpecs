@@ -0,0 +1,102 @@
+{{- if .Values.s3Mirror.enabled }}
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: s3-mirror-script
+data:
+  s3_mirror.py: |
+{{ .Files.Get "files/s3-mirror/s3_mirror.py" | indent 4 }}
+
+---
+
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: s3-mirror
+spec:
+  schedule: {{ .Values.s3Mirror.schedule | quote }}
+  concurrencyPolicy: Forbid
+  jobTemplate:
+    spec:
+      backoffLimit: 1
+      # Bounds the whole Job, retries included; the prd Prometheus release's
+      # S3 mirror freshness threshold carries this bound in its margin.
+      activeDeadlineSeconds: {{ .Values.s3Mirror.activeDeadlineSeconds }}
+      template:
+        metadata:
+          annotations:
+            {{ include "deployment.timestamp" . }}
+        spec:
+          restartPolicy: Never
+          containers:
+            - name: s3-mirror
+              image: registry:5000/rclone-backup{{ .Values.images.rcloneBackup }}
+              command: ["python3", "/scripts/s3_mirror.py"]
+              env:
+                - name: SHARED_RCLONE_CONFIG
+                  value: /data/rclone.conf
+                - name: RCLONE_CONFIG
+                  value: /work/rclone.conf
+                - name: KEEP_ARCHIVES
+                  value: {{ .Values.s3Mirror.keepArchives | quote }}
+                - name: RCLONE_CONFIG_RGW_TYPE
+                  value: s3
+                - name: RCLONE_CONFIG_RGW_PROVIDER
+                  value: Ceph
+                - name: RCLONE_CONFIG_RGW_ENDPOINT
+                  value: {{ required "s3Mirror.s3Endpoint is required" .Values.s3Mirror.s3Endpoint | quote }}
+                - name: RCLONE_CONFIG_RGW_ACCESS_KEY_ID
+                  valueFrom:
+                    secretKeyRef:
+                      name: {{ .Values.s3Mirror.readerSecret }}
+                      key: access_key_id
+                - name: RCLONE_CONFIG_RGW_SECRET_ACCESS_KEY
+                  valueFrom:
+                    secretKeyRef:
+                      name: {{ .Values.s3Mirror.readerSecret }}
+                      key: secret_access_key
+                # A restore reads the mirror only with these crypt settings and
+                # the same password and salt.
+                - name: RCLONE_CONFIG_MIRROR_TYPE
+                  value: crypt
+                - name: RCLONE_CONFIG_MIRROR_REMOTE
+                  value: {{ required "s3Mirror.driveRemote is required" .Values.s3Mirror.driveRemote | quote }}
+                - name: RCLONE_CONFIG_MIRROR_FILENAME_ENCRYPTION
+                  value: standard
+                - name: RCLONE_CONFIG_MIRROR_FILENAME_ENCODING
+                  value: base32
+                - name: RCLONE_CONFIG_MIRROR_DIRECTORY_NAME_ENCRYPTION
+                  value: "true"
+                - name: CRYPT_PASSWORD
+                  valueFrom:
+                    secretKeyRef:
+                      name: {{ .Values.s3Mirror.cryptSecret }}
+                      key: password
+                - name: CRYPT_SALT
+                  valueFrom:
+                    secretKeyRef:
+                      name: {{ .Values.s3Mirror.cryptSecret }}
+                      key: salt
+{{- with index .Values.resources "s3-mirror" "s3-mirror" }}
+              resources:
+                {{- toYaml . | nindent 16 }}
+{{- end }}
+              volumeMounts:
+                - name: scripts
+                  mountPath: /scripts
+                - name: rclone-backup-data
+                  mountPath: /data
+                  readOnly: true
+                - name: work
+                  mountPath: /work
+          volumes:
+            - name: scripts
+              configMap:
+                name: s3-mirror-script
+            - name: rclone-backup-data
+              persistentVolumeClaim:
+                claimName: rclone-backup-pvc
+                readOnly: true
+            - name: work
+              emptyDir: {}
+{{- end }}
