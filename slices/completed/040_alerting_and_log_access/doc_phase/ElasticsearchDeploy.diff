@@ -0,0 +1,24 @@
+#!/bin/sh
+# The setup Job as prd renders it: READER_PASSWORD comes from the ExternalSecret's Secret, never a
+# value; the Job's name hashes its whole spec, so a spec change under the same image pin (the
+# reader's env here) and a pin change each yield a new name, and an unchanged spec keeps it.
+set -eu
+cd "$(dirname "$0")/.."
+render() {
+  helm template elasticsearch-prd chart --namespace elasticsearch-prd --values config/prd/values.yaml \
+    --set hook.repo=x,hook.revision=0123456789abcdef0123456789abcdef01234567,hook.stage=prd,hook.namespace=elasticsearch-prd \
+    --show-only templates/elasticsearch-setup-job.yaml "$@"
+}
+name() { render "$@" | yq -er .metadata.name; }
+
+secret=$(yq -er .externalSecrets.secrets.reader.targetName config/prd/values.yaml)
+render | yq -e '.spec.template.spec.containers[0].env[] | select(.name == "READER_PASSWORD")
+  | select(.valueFrom.secretKeyRef.name == "'"$secret"'" and .valueFrom.secretKeyRef.key == "password" and (has("value") | not))' >/dev/null
+
+base=$(name)
+[ "$base" = "$(name)" ] || { echo "setup Job name is not stable for an unchanged spec" >&2; exit 1; }
+[ "$base" != "$(name --set externalSecrets.secrets.reader.targetName=other)" ] \
+  || { echo "setup Job name did not change with its env" >&2; exit 1; }
+[ "$base" != "$(name --set images.elasticsearchSetup=:0)" ] \
+  || { echo "setup Job name did not change with its image pin" >&2; exit 1; }
+echo "setup Job: $base"
