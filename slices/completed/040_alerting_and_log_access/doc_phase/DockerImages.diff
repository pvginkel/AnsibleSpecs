 def wait_for_elasticsearch(es: Elasticsearch):
@@ -60,6 +63,25 @@ def create_logstash_internal_user(es: Elasticsearch):
     )
 
 
+def create_reader_user(es: Elasticsearch):
+    print("Creating reader user")
+
+    # The built-in viewer role reads every index whose name has no leading
+    # dot (data streams included) and logs into Kibana read-only; it holds no
+    # write, cluster or index management privilege. put_user on an existing
+    # user replaces its password, so a rerun converges onto a rotated one.
+    retry_with_delay(
+        lambda: es.security.put_user(
+            username="reader",
+            body={
+                "password": READER_PASSWORD,
+                "roles": ["viewer"],
+                "full_name": "Read-only reader",
+            },
+        )
+    )
+
+
 def setup_logstash_http_ilm(es: Elasticsearch):
     print("Configuring logstash-http ILM policy and index template")
 
