+            exp_labels: {namespace: dnsmasq-prd, service: dhcp, severity: critical}
+            exp_annotations:
+              summary: MetalLB does not announce LoadBalancer Service dnsmasq-prd/dhcp
+              description: >-
+                No MetalLB speaker has announced the Service's address for 10 m, so nothing
+                outside the cluster reaches it. MetalLB withdraws a Service with no ready
+                endpoints: check that its pods are Ready (kubectl -n dnsmasq-prd get
+                endpointslices -l kubernetes.io/service-name=dhcp). If they are, kubectl -n
+                dnsmasq-prd describe svc dhcp shows whether it has an address, and the speakers'
+                logs in metallb-system say why they do not announce it.
+      - alertname: LoadBalancerNotAnnounced
+        eval_time: 39m
+        exp_alerts:
+          - *ssh_unannounced
+          - *dhcp_unannounced
+      - {alertname: LoadBalancerNotAnnounced, eval_time: 40m}
+      - {alertname: LoadBalancerNotAnnounced, eval_time: 60m}
+      - {alertname: MetalLBAnnouncementsBlind, eval_time: 39m}
+      - {alertname: MetalLBAnnouncementsBlind, eval_time: 49m}
+      - alertname: MetalLBAnnouncementsBlind
+        eval_time: 50m
+        exp_alerts:
+          - exp_labels: {severity: warning}
+            exp_annotations:
+              summary: 'LoadBalancer announcements are unwatched: no MetalLB speaker scraped for 10m'
+              description: >-
+                Prometheus has scraped no MetalLB speaker in metallb-system on :7472 for 10 m, so
+                LoadBalancerNotAnnounced cannot fire. Check the speaker targets in Prometheus.
