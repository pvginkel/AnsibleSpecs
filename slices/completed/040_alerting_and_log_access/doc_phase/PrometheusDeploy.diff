+# The loadbalancers group, over synthetic kube-state-metrics and MetalLB speaker series. A speaker
+# exports one series per Service it announces; when the announcement moves or is withdrawn, the
+# old series ends `stale`, and so does every series of a speaker whose scrape fails, while its `up`
+# reads 0.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: a withdrawn Service and an unlabelled one in kubecoder-prd fire after 10m; a KubeCoder environment, a ClusterIP and a 6m move stay quiet; a failed speaker scrape does not silence them; no speaker scraped up silences them and fires the blind warning after 10m
+    interval: 1m
+    input_series:
+      # srvk8s4's scrape fails from 5 m, as in the outage; srvk8s2's target is gone from 40 m and
+      # srvk8s3's scrape fails from 40 m.
+      - series: up{job="kubernetes-pods", namespace="metallb-system", node="srvk8s4", instance="10.1.3.5:7472", app="metallb", component="speaker"}
+        values: 1x4 0x55
+      - series: up{job="kubernetes-pods", namespace="metallb-system", node="srvk8s2", instance="10.1.0.28:7472", app="metallb", component="speaker"}
+        values: 1x39 stale
+      - series: up{job="kubernetes-pods", namespace="metallb-system", node="srvk8s3", instance="10.1.0.29:7472", app="metallb", component="speaker"}
+        values: 1x39 0x20
+      # The controller is up throughout and is not a speaker.
+      - series: up{job="kubernetes-pods", namespace="metallb-system", node="srvk8s1", instance="172.16.128.205:7472", app="metallb", component="controller"}
+        values: 1x60
+      - series: kube_service_spec_type{job="kubernetes-service-endpoints", namespace="dnsmasq-prd", service="dhcp", type="LoadBalancer"}
+        values: 1x60
+      - series: kube_service_labels{job="kubernetes-service-endpoints", namespace="dnsmasq-prd", service="dhcp"}
+        values: 1x60
+      - series: kube_service_spec_type{job="kubernetes-service-endpoints", namespace="dnsmasq-prd", service="dhcp-app", type="ClusterIP"}
+        values: 1x60
+      - series: kube_service_labels{job="kubernetes-service-endpoints", namespace="dnsmasq-prd", service="dhcp-app"}
+        values: 1x60
+      - series: kube_service_spec_type{job="kubernetes-service-endpoints", namespace="guacamole-prd", service="guacamole", type="LoadBalancer"}
+        values: 1x60
+      - series: kube_service_labels{job="kubernetes-service-endpoints", namespace="guacamole-prd", service="guacamole"}
+        values: 1x60
+      - series: kube_service_spec_type{job="kubernetes-service-endpoints", namespace="registry-prd", service="registry", type="LoadBalancer"}
+        values: 1x60
+      - series: kube_service_labels{job="kubernetes-service-endpoints", namespace="registry-prd", service="registry"}
+        values: 1x60
+      # A stopped KubeCoder environment.
+      - series: kube_service_spec_type{job="kubernetes-service-endpoints", namespace="kubecoder-prd", service="pvginkel-ansible-505ac9", type="LoadBalancer"}
+        values: 1x60
+      - series: kube_service_labels{job="kubernetes-service-endpoints", namespace="kubecoder-prd", service="pvginkel-ansible-505ac9", label_app_kubernetes_io_managed_by="kubecoder"}
+        values: 1x60
+      # A LoadBalancer of KubeCoder's own deploy.
+      - series: kube_service_spec_type{job="kubernetes-service-endpoints", namespace="kubecoder-prd", service="kubecoder-ssh", type="LoadBalancer"}
+        values: 1x60
+      - series: kube_service_labels{job="kubernetes-service-endpoints", namespace="kubecoder-prd", service="kubecoder-ssh", label_app_kubernetes_io_managed_by="Helm"}
+        values: 1x60
+      # dhcp: srvk8s4's speaker announces it until its scrape fails. Every speaker series ends at
+      # 40 m.
+      - series: metallb_speaker_announced{job="kubernetes-pods", namespace="metallb-system", node="srvk8s4", instance="10.1.3.5:7472", ip="10.2.1.10", protocol="layer2", service="dnsmasq-prd/dhcp"}
+        values: 1x4 stale
+      # guacamole: srvk8s2's speaker announces it until 9 m; srvk8s3's takes over at 16 m.
+      - series: metallb_speaker_announced{job="kubernetes-pods", namespace="metallb-system", node="srvk8s2", instance="10.1.0.28:7472", ip="10.2.1.14", protocol="layer2", service="guacamole-prd/guacamole"}
+        values: 1x9 stale
+      - series: metallb_speaker_announced{job="kubernetes-pods", namespace="metallb-system", node="srvk8s3", instance="10.1.0.29:7472", ip="10.2.1.14", protocol="layer2", service="guacamole-prd/guacamole"}
+        values: _x16 1x23 stale
+      - series: metallb_speaker_announced{job="kubernetes-pods", namespace="metallb-system", node="srvk8s3", instance="10.1.0.29:7472", ip="10.2.1.9", protocol="layer2", service="registry-prd/registry"}
+        values: 1x39 stale
