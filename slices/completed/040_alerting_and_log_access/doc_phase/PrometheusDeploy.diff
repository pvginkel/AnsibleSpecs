+# The oidc-discovery group, over the blackbox exporter's probe_success as the oidc-discovery job
+# scrapes it once a minute: 0 when the exporter ran the probe and it failed; when the exporter is
+# down or its scrape fails, the series ends `stale` and there is none.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: a failing probe fires after 5m and resolves when it passes
+    interval: 1m
+    input_series:
+      # Failing 5-14 m.
+      - series: probe_success{job="oidc-discovery", instance="https://auth.ginbov.nl/realms/homelab/.well-known/openid-configuration"}
+        values: 1x4 0x9 1x10
+    alert_rule_test:
+      - {alertname: OIDCDiscoveryFailing, eval_time: 9m}
+      - alertname: OIDCDiscoveryFailing
+        eval_time: 10m
+        exp_alerts:
+          - &failing
+            exp_labels:
+              job: oidc-discovery
+              instance: https://auth.ginbov.nl/realms/homelab/.well-known/openid-configuration
+              severity: critical
+            exp_annotations:
+              summary: OIDC discovery at auth.ginbov.nl has failed for 5m
+              description: >-
+                https://auth.ginbov.nl/realms/homelab/.well-known/openid-configuration does not
+                return the homelab realm's discovery document, so apps that log in through
+                Keycloak cannot start, as DHCPApp could not on 2026-09-25. Check that
+                keycloak-prd's pods are Ready (an image pull stuck there was the 2026-09-25
+                cause), then the ingress in front of it. The probe's own log is at
+                http://blackbox-exporter.prometheus-prd.svc:9115/ from inside the cluster.
+      - alertname: OIDCDiscoveryFailing
+        eval_time: 14m
+        exp_alerts: [*failing]
+      - {alertname: OIDCDiscoveryFailing, eval_time: 15m}
+      - {alertname: OIDCDiscoveryUnprobed, eval_time: 14m}
+
+  - name: a Keycloak restart that fails the probe for 4m stays quiet
+    interval: 1m
+    input_series:
+      # Failing 5-8 m.
+      - series: probe_success{job="oidc-discovery", instance="https://auth.ginbov.nl/realms/homelab/.well-known/openid-configuration"}
+        values: 1x4 0x3 1x10
+    alert_rule_test:
+      - {alertname: OIDCDiscoveryFailing, eval_time: 9m}
+      - {alertname: OIDCDiscoveryFailing, eval_time: 12m}
+
+  - name: no probe result fires the unwatched warning after 10m, not the failure, and resolves when the scrape is back
+    interval: 1m
+    input_series:
+      # The exporter is down 5-19 m.
+      - series: probe_success{job="oidc-discovery", instance="https://auth.ginbov.nl/realms/homelab/.well-known/openid-configuration"}
+        values: 1x4 stale _x14 1x5
+    alert_rule_test:
+      - {alertname: OIDCDiscoveryUnprobed, eval_time: 14m}
+      - alertname: OIDCDiscoveryUnprobed
+        eval_time: 15m
+        exp_alerts:
+          - &unprobed
+            exp_labels: {job: oidc-discovery, severity: warning}
+            exp_annotations:
+              summary: 'OIDC discovery is unwatched: no probe result for 10m'
+              description: >-
+                Prometheus has had no result from the oidc-discovery probe for 10 m, so
+                OIDCDiscoveryFailing cannot fire. The blackbox-exporter pod in prometheus-prd is
+                down or not Ready, or its scrape fails; check the oidc-discovery target in
+                Prometheus.
+      - alertname: OIDCDiscoveryUnprobed
+        eval_time: 19m
+        exp_alerts: [*unprobed]
+      - {alertname: OIDCDiscoveryUnprobed, eval_time: 20m}
+      - {alertname: OIDCDiscoveryFailing, eval_time: 15m}
+
+  - name: a 10m scrape gap stays quiet
+    interval: 1m
+    input_series:
+      # No result 5-14 m.
+      - series: probe_success{job="oidc-discovery", instance="https://auth.ginbov.nl/realms/homelab/.well-known/openid-configuration"}
+        values: 1x4 stale _x9 1x5
+    alert_rule_test:
+      - {alertname: OIDCDiscoveryUnprobed, eval_time: 14m}
+      - {alertname: OIDCDiscoveryUnprobed, eval_time: 15m}

