+# The heartbeat group: Heartbeat fires from the first evaluation on, with no series at all.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: Heartbeat fires on an empty TSDB at every evaluation
+    interval: 1m
+    alert_rule_test:
+      - alertname: Heartbeat
+        eval_time: 0m
+        exp_alerts:
+          - &heartbeat
+            exp_labels: {}
+            exp_annotations:
+              summary: Prometheus and Alertmanager are up; this alert pings healthchecks.io
+              description: >-
+                Always firing, by design. Alertmanager sends it to the healthchecks.io check, never
+                to Telegram; healthchecks.io notifies the operator when the pings stop.
+      - alertname: Heartbeat
+        eval_time: 1d
+        exp_alerts: [*heartbeat]
