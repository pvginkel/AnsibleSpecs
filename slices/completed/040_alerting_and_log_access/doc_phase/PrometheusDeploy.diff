+      # kube-state-metrics emits a container's waiting series only while it
+      # waits, with its current reason. Between back-offs a crash-looping
+      # container runs and the series is gone, and a failing pull flips between
+      # ErrImagePull and ImagePullBackOff, each change a new series. So the rule
+      # takes the three reasons, of containers and init containers (a native
+      # sidecar is one), over a 5 m look-back, by pod. 5 m bridges the running
+      # spells: the longest in 42 days of history was 4 m. A 10 m look-back
+      # would have fired once in those days, on a validation pod whose loop had
+      # cleared after 8 m. The look-back also means a loop whose last wait
+      # falls in the 5 m before its 15th minute still fires, and an alert
+      # resolves 5 m after the pod's last wait, its deletion included.
+      # tests/alert-rules/pods.yml walks these edges on synthetic series.
+      - name: pods
+        rules:
+          - alert: PodStuckInBackOff
+            expr: |
+              max by (namespace, pod) (
+                  max_over_time(kube_pod_container_status_waiting_reason{reason=~"CrashLoopBackOff|ImagePullBackOff|ErrImagePull"}[5m])
+                or
+                  max_over_time(kube_pod_init_container_status_waiting_reason{reason=~"CrashLoopBackOff|ImagePullBackOff|ErrImagePull"}[5m])
+              )
+            for: 15m
+            labels:
+              severity: warning
+            annotations:
+              summary: '{{ $labels.namespace }}/{{ $labels.pod }} has been in CrashLoopBackOff or ImagePullBackOff for 15m'
+              description: >-
+                A container of the pod keeps crashing or cannot pull its image.
+                kubectl -n {{ $labels.namespace }} describe pod {{ $labels.pod }}
+                names the container and its reason; kubectl logs --previous
+                gives a crashed container's last output. This alert resolves
+                5 m after no container of the pod waits on either reason.
+
+      # kube-state-metrics' Ready condition per node; a node whose kubelet
+      # stops posting status reads Unknown, so not true. In 42 days of
+      # history every NotReady spell but the 2026-09-25 outage's lasted at
+      # most 1 m, a reboot; 10 m lets a slow one pass.
+      # tests/alert-rules/nodes.yml walks the window's edges.
+      - name: nodes
+        rules:
+          - alert: NodeNotReady
+            expr: |
+              max by (node) (kube_node_status_condition{condition="Ready", status="true"}) == 0
+            for: 10m
+            labels:
+              severity: critical
+            annotations:
+              summary: '{{ $labels.node }} has been NotReady for 10m'
+              description: >-
+                The node's kubelet has not reported Ready: the node is down, off
+                the network, or its kubelet is failing. kubectl describe node
+                {{ $labels.node }} gives the Ready condition's reason and when it
+                last changed. Its pods are not running until it is back.
+
+      # A MetalLB speaker exports metallb_speaker_announced, as
+      # service="<namespace>/<name>", for each Service it announces, the fact
+      # a ServiceL2Status records. MetalLB withdraws a Service with no ready
+      # endpoints, so one signal covers an unready backend and a Service
+      # MetalLB does not serve; the announcement moves between speakers, so it
+      # is taken by Service.
+      #
+      # KubeCoder environments are out of scope: a stopped one keeps its
+      # LoadBalancer Service unannounced by design. They are recognised by the
+      # app.kubernetes.io/managed-by=kubecoder label KubeCoder puts on them,
+      # which kube-state-metrics exports through the allow-list below, not by
+      # namespace: KubeCoder's own Services share kubecoder-prd.
+      #
+      # A speaker whose scrape fails reads as announcing nothing. That is what
+      # a speaker on a node that is down or off the network does, as srvk8s4's
+      # did for the whole 2026-09-25 outage, so it does not silence the rule.
+      # A speaker that is up and announces nothing exports no series, so only
+      # no speaker scraped up reads as a gap: the rule is silent and
+      # MetalLBAnnouncementsBlind fires.
+      #
+      # From 2026-09-16 to 2026-10-03 a Service's announcement dropped for at
+      # most 6 m around node reboots and rollouts; the outage's dhcp, for
+      # 166 m. 10 m passes the former.
+      # tests/alert-rules/loadbalancers.yml walks these edges on synthetic series.
+      - name: loadbalancers
+        rules:
+          - alert: LoadBalancerNotAnnounced
+            expr: |
+              max by (namespace, service) (kube_service_spec_type{type="LoadBalancer"})
+              unless on (namespace, service)
+                kube_service_labels{label_app_kubernetes_io_managed_by="kubecoder"}
+              unless on (namespace, service)
+                label_replace(
+                  label_replace(max by (service) (metallb_speaker_announced) > 0, "namespace", "$1", "service", "([^/]+)/.*"),
+                  "service", "$1", "service", "[^/]+/(.*)"
+                )
+              and on () (up{job="kubernetes-pods", namespace="metallb-system", component="speaker"} == 1)
+            for: 10m
+            labels:
+              severity: critical
+            annotations:
+              summary: 'MetalLB does not announce LoadBalancer Service {{ $labels.namespace }}/{{ $labels.service }}'
+              description: >-
+                No MetalLB speaker has announced the Service's address for
+                10 m, so nothing outside the cluster reaches it. MetalLB
+                withdraws a Service with no ready endpoints: check that its
+                pods are Ready (kubectl -n {{ $labels.namespace }} get
+                endpointslices -l kubernetes.io/service-name={{ $labels.service }}).
+                If they are, kubectl -n {{ $labels.namespace }} describe svc
+                {{ $labels.service }} shows whether it has an address, and the
+                speakers' logs in metallb-system say why they do not announce it.
+          - alert: MetalLBAnnouncementsBlind
+            expr: |
+              absent(up{job="kubernetes-pods", namespace="metallb-system", component="speaker"} == 1)
+            for: 10m
+            labels:
+              severity: warning
+            annotations:
+              summary: 'LoadBalancer announcements are unwatched: no MetalLB speaker scraped for 10m'
+              description: >-
+                Prometheus has scraped no MetalLB speaker in metallb-system on
+                :7472 for 10 m, so LoadBalancerNotAnnounced cannot fire. Check
+                the speaker targets in Prometheus.
