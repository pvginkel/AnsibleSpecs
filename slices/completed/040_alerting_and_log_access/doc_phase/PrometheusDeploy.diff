+{{/*
+The blackbox exporter the server's oidc-discovery scrape job probes through
+(config/prd/values.yaml, extraScrapeConfigs). The upstream prometheus chart
+carries none, and Argo CD renders one upstream chart per app, so it is estate
+content here. The job addresses the Service by its literal name in this
+namespace.
+
+The module passes only Keycloak's discovery document for the homelab realm: a
+proxy error page or another realm's answer does not carry its issuer.
+*/}}
+{{- $config := `modules:
+  oidc_discovery:
+    prober: http
+    timeout: 8s
+    http:
+      preferred_ip_protocol: ip4
+      valid_status_codes: [200]
+      fail_if_not_ssl: true
+      fail_if_body_not_matches_regexp:
+        - '"issuer":"https://auth\.ginbov\.nl/realms/homelab"'
+` }}
+{{- $selector := dict "app.kubernetes.io/name" "blackbox-exporter" "app.kubernetes.io/instance" .Release.Name }}
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: blackbox-exporter
+  namespace: {{ .Release.Namespace }}
+data:
+  blackbox.yml: |
+    {{- $config | nindent 4 }}
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: blackbox-exporter
+  namespace: {{ .Release.Namespace }}
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      {{- toYaml $selector | nindent 6 }}
+  template:
+    metadata:
+      labels:
+        {{- toYaml $selector | nindent 8 }}
+      annotations:
+        # The exporter reads its config only at start.
+        checksum/config: {{ $config | sha256sum }}
+    spec:
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65534
+        runAsGroup: 65534
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: blackbox-exporter
+          image: quay.io/prometheus/blackbox-exporter:v0.28.0
+          args:
+            - --config.file=/etc/blackbox-exporter/blackbox.yml
+          ports:
+            - name: http
+              containerPort: 9115
+          readinessProbe:
+            httpGet:
+              path: /-/healthy
+              port: http
+          livenessProbe:
+            httpGet:
+              path: /-/healthy
+              port: http
+          resources:
+            requests:
+              memory: 32Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            capabilities:
+              drop:
+                - ALL
+            readOnlyRootFilesystem: true
+          volumeMounts:
+            - name: config
+              mountPath: /etc/blackbox-exporter
+              readOnly: true
+      volumes:
+        - name: config
+          configMap:
+            name: blackbox-exporter
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: blackbox-exporter
+  namespace: {{ .Release.Namespace }}
+spec:
+  selector:
+    {{- toYaml $selector | nindent 4 }}
+  ports:
+    - name: http
+      port: 9115
+      targetPort: http
