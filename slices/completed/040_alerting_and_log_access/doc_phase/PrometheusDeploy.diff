+# The nodes group, over synthetic kube-state-metrics series: the Ready condition's status="true"
+# series reads 0 while the node is NotReady or Unknown.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: a node NotReady fires after 10m and resolves when Ready; a reboot and a 10m spell stay quiet
+    interval: 1m
+    input_series:
+      # srvk8s4: NotReady 5-30 m.
+      - series: kube_node_status_condition{job="kubernetes-service-endpoints", instance="172.16.129.160:8080", node="srvk8s4", condition="Ready", status="true"}
+        values: 1x4 0x25 1x10
+      # srvk8s2: a reboot, NotReady at 5 m.
+      - series: kube_node_status_condition{job="kubernetes-service-endpoints", instance="172.16.129.160:8080", node="srvk8s2", condition="Ready", status="true"}
+        values: 1x4 0 1x35
+      # srvk8s1: NotReady 5-14 m.
+      - series: kube_node_status_condition{job="kubernetes-service-endpoints", instance="172.16.129.160:8080", node="srvk8s1", condition="Ready", status="true"}
+        values: 1x4 0x9 1x26
+    alert_rule_test:
+      - {alertname: NodeNotReady, eval_time: 14m}
+      - alertname: NodeNotReady
+        eval_time: 15m
+        exp_alerts:
+          - &srvk8s4_notready
+            exp_labels: {node: srvk8s4, severity: critical}
+            exp_annotations:
+              summary: srvk8s4 has been NotReady for 10m
+              description: >-
+                The node's kubelet has not reported Ready: the node is down, off the network, or
+                its kubelet is failing. kubectl describe node srvk8s4 gives the Ready condition's
+                reason and when it last changed. Its pods are not running until it is back.
+      - alertname: NodeNotReady
+        eval_time: 30m
+        exp_alerts: [*srvk8s4_notready]
+      - {alertname: NodeNotReady, eval_time: 31m}
