+# The pods group, over synthetic kube-state-metrics series. A container's waiting series exists
+# only while it waits, so each spell ends `stale`, as a scrape that no longer returns it does.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: a crash loop fires after 15m through running spells under 5m and resolves 5m after its last wait; a 5m running spell restarts the 15m
+    interval: 1m
+    input_series:
+      # dhcp: waits 0-3 m, runs 4-7 m, waits 8-11 m, runs 12-15 m, waits 16-30 m, then runs.
+      - series: kube_pod_container_status_waiting_reason{job="kubernetes-service-endpoints", namespace="dnsmasq-prd", pod="dhcp-8456675446-8lp2h", container="dhcpapp-app", reason="CrashLoopBackOff"}
+        values: 1x3 stale _x3 1x3 stale _x3 1x14 stale
+      # dhcp-app: waits 0-3 m, runs 4-8 m, waits from 9 m.
+      - series: kube_pod_container_status_waiting_reason{job="kubernetes-service-endpoints", namespace="dnsmasq-prd", pod="dhcp-app-5c67456949-wr8zc", container="dhcpapp-app", reason="CrashLoopBackOff"}
+        values: 1x3 stale _x4 1x30
+    alert_rule_test:
+      - {alertname: PodStuckInBackOff, eval_time: 14m}
+      - alertname: PodStuckInBackOff
+        eval_time: 15m
+        exp_alerts:
+          - &dhcp_stuck
+            exp_labels: {namespace: dnsmasq-prd, pod: dhcp-8456675446-8lp2h, severity: warning}
+            exp_annotations:
+              summary: dnsmasq-prd/dhcp-8456675446-8lp2h has been in CrashLoopBackOff or ImagePullBackOff for 15m
+              description: >-
+                A container of the pod keeps crashing or cannot pull its image. kubectl -n
+                dnsmasq-prd describe pod dhcp-8456675446-8lp2h names the container and its reason;
+                kubectl logs --previous gives a crashed container's last output. This alert
+                resolves 5 m after no container of the pod waits on either reason.
+      - alertname: PodStuckInBackOff
+        eval_time: 23m
+        exp_alerts: [*dhcp_stuck]
+      - alertname: PodStuckInBackOff
+        eval_time: 24m
+        exp_alerts:
+          - *dhcp_stuck
+          - &dhcp_app_stuck
+            exp_labels: {namespace: dnsmasq-prd, pod: dhcp-app-5c67456949-wr8zc, severity: warning}
+            exp_annotations:
+              summary: dnsmasq-prd/dhcp-app-5c67456949-wr8zc has been in CrashLoopBackOff or ImagePullBackOff for 15m
+              description: >-
+                A container of the pod keeps crashing or cannot pull its image. kubectl -n
+                dnsmasq-prd describe pod dhcp-app-5c67456949-wr8zc names the container and its
+                reason; kubectl logs --previous gives a crashed container's last output. This alert
+                resolves 5 m after no container of the pod waits on either reason.
+      - alertname: PodStuckInBackOff
+        eval_time: 34m
+        exp_alerts:
+          - *dhcp_stuck
+          - *dhcp_app_stuck
+      - alertname: PodStuckInBackOff
+        eval_time: 35m
+        exp_alerts:
