+"""The handover check: which published ids are the app's, and whose edges are whose.
+
+Hand-built envelopes in the shapes the federation publishes — no deploy-repo clone,
+chart repository or live dataset, the three things the check's end-to-end run needs.
+The cases are the published set's own: youtrack next to youtrack-mcp, elasticsearch's
+kibana host, dnsmasq's per-pod Services, keycloak serving IoTSupport's devices.
+"""
+
+from __future__ import annotations
+
+import unittest
+
+from .support import load
+
+he = load("handover_equality", folder="checks")
+gen = he.gen
+
+HC = "helm-charts"
+ARRAYS = he.ELEMENT_ARRAYS
+
+
+class _Published:
+    """A merged dataset under construction: elements by array, and relations."""
+
+    def __init__(self):
+        self.doc = {array: [] for array in ARRAYS}
+        self.doc["relations"] = []
+
+    def add(self, array, element):
+        self.doc[array].append(element)
+        return element["id"]
+
+    def instance(self, app, stage, workload, container, array="applicationComponents"):
+        ns = f"{app}-{stage}"
+        hint = f"{ns}-{workload}-{container}"
+        prefix = "ss" if array == "systemSoftware" else "app"
+        return self.add(
+            array,
+            {
+                "id": gen.composite(prefix, hint, f"{ns}.{workload}.{container}"),
+                "label": f"{workload}/{container} ({stage})",
+                "environment": stage,
+                "producer": HC,
+                "stats": {
+                    "release": gen.release_label(app, stage),
+                    "workload": workload,
+                    "container": container,
+                    "image": f"registry:5000/{container}:latest",
+                },
+            },
+        )
+
+    def service(self, app, stage, name, producer=HC):
+        hint = f"{app}-{stage}-{name}"
+        return self.add(
+            "applicationServices",
+            {
+                "id": gen.composite("svc", hint, f"svc.{hint}"),
+                "label": f"{name} ({stage})",
+                "environment": stage,
+                "producer": producer,
+            },
+        )
+
+    def interface(self, host, stage="prd"):
+        return self.add(
+            "applicationInterfaces",
+            {
+                "id": gen.composite("if", gen.kebab(host), f"key.{host}"),
+                "label": host,
+                "environment": stage,
+                "producer": HC,
+                "stats": {"url": host},
+            },
+        )
+
+    def product(self, name):
+        return self.add(
+            "systemSoftware", {"id": gen.product_id(f"ss:{name}"), "label": name, "producer": HC}
+        )
+
+    def elsewhere(self, array, bare, producer):
+        """An element another producer publishes, `bare` its `<kind>:<name>`."""
+        return self.add(array, {"id": gen.product_id(bare), "producer": producer})
+
+    def rel(self, rid, source, target, rtype):
+        self.doc["relations"].append({"id": rid, "source": source, "target": target, "type": rtype})
+        return rid
+
+    def link(self, instance_id, interface_id):
+        return self.rel(
+            f"rel:{he.hint(instance_id)}-behind-{he.hint(interface_id)}",
+            instance_id,
+            interface_id,
+            "Association",
+        )
+
+
+def _generated(published, element_ids, relation_ids, **changed):
+    """The envelope a deploy repo's render would write: these published ids, under its
+    own producer, with `changed` fields (`id -> {field: value}`) edited in."""
+    envelope = {array: [] for array in ARRAYS}
+    for array in ARRAYS:
+        for e in published.doc[array]:
+            if e["id"] in element_ids:
+                envelope[array].append(dict(e, producer="app-deploy", **changed.get(e["id"], {})))
+    envelope["relations"] = [r for r in published.doc["relations"] if r["id"] in relation_ids]
+    return envelope
+
+
+def _own_relations(published, element_ids):
+    return {
+        r["id"]
+        for r in published.doc["relations"]
+        if r["source"] in element_ids or r["target"] in element_ids
+    }
+
