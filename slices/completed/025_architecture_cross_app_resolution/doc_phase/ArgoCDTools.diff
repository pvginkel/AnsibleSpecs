+def _keycloak():
+    """keycloak's prd instance and the consumers the published set draws it serving."""
+    ds = _Published()
+    kc = ds.instance("keycloak", "prd", "keycloak", "keycloak", "systemSoftware")
+    device = ds.elsewhere(
+        "systemSoftware", "ss:infra-statistics-display-33zykxe5", "iotsupport-app"
+    )
