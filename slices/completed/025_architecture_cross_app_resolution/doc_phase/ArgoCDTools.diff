+def publish_service_interfaces(incluster, external, inst_by_id, stage_of_ns, elements, add_rel):
+    """Publish every Service this render places as an interface linked to its instances.
+
+    Each in-cluster Service (the provider index's, CNPG poolers included) becomes an
+    ApplicationInterface keyed `svcif.<ns>.<svc>`, its host `<svc>.<ns>.svc` in
+    `stats.url`. Every interface — these and the exposed hosts
+    reconcile_exposed_services minted — is linked by an Association from each
+    instance behind it, directly and not through the application service (an
+    in-house app's service is shared by every deployment of the product). Another
+    render resolves a host it cannot place through these links (resolve_host), so
+    they name exactly what this render's own lookup filters from: the backing set
+    without its init containers, which have exited before the Service answers.
+    `stage_of_ns` maps a namespace to the `env` and `introduced` of its release.
+    """
+
+    def link(interface_id, backing):
+        for pid in backing:
+            inst = inst_by_id[pid]
+            if not inst["is_init"]:
+                add_rel(
+                    f"rel:{inst['hint']}-behind-{hint_of(interface_id)}",
+                    pid,
+                    interface_id,
+                    "Association",
+                )
+
+    for ikey, interface in elements["applicationInterfaces"].items():
+        if ikey.startswith("appif."):
+            link(interface["id"], external[interface["stats"]["url"]])
