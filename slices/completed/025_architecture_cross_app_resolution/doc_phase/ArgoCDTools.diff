+    iot_edge = ds.rel("rel:07e2447d-3978-5f39-b469-7e528294069f", kc, device, "Serving")
+    calendar = ds.instance("calendar-support", "prd", "calendar-support", "calendar-support-app")
+    hc_edge = ds.rel(f"rel:{he.hint(kc)}-serves-{he.hint(calendar)}-iam", kc, calendar, "Serving")
+    return ds, kc, iot_edge, hc_edge
