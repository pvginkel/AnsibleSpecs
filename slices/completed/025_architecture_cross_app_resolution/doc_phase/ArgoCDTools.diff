+            "label": host,
+            "summary": f"In-cluster endpoint {host} of Service '{svc}'.",
+            "introduced": stage["introduced"],
+            "lifecycle": "active",
+            "environment": stage["env"],
+            "cluster": "prd",
+            "stats": {"url": host},
+        }
+        elements["applicationInterfaces"][ikey] = interface
+        link(interface["id"], backing)
+
