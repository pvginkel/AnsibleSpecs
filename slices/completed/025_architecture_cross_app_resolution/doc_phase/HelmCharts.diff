+def _relations():
+    relations = {}
+
+    def add_rel(rid, source, target, rtype):
+        relations[rid] = {"source": source, "target": target, "type": rtype}
+
+    return relations, add_rel
+
+
+def _pooler(ns, name, realizes):
+    """A CNPG instance record, as emit_cnpg_substrate appends one."""
+    hint = f"{ns}-{name}"
+    return dict(_inst(ns, name, name), id=ga.composite("ss", hint, f"{ns}.{name}"), hint=hint,
+                realizes=realizes, resource=f"Pooler/{name}")
+
+
+def _exposed_interface(host):
+    """An exposed-host interface as reconcile_exposed_services mints it."""
+    return {"id": ga.composite("if", ga.kebab(host), f"appif.{host}"), "stats": {"url": host}}
+
+
+def _publish(pod, incluster, external):
+    """The envelope a provider's own render publishes: its instances as main writes
+    them, their Realizations, and its interfaces with their links."""
+    elements = {"applicationInterfaces": {f"appif.{h}": _exposed_interface(h) for h in external}}
+    relations, add_rel = _relations()
+    ga.publish_service_interfaces(incluster, external, {i["id"]: i for i in pod},
+                                  {ns: STAGE for ns, _svc in incluster}, elements, add_rel)
+    for i in pod:
+        for cap in i["realizes"]:
+            add_rel(f"rel:{i['hint']}-realizes-{ga.hint_of(cap)}", i["id"], cap, "Realization")
+    return {
+        "applicationComponents": [
+            {"id": i["id"], "stats": ({"resource": i["resource"]} if "resource" in i
+                                      else {"container": i["container"]})}
+            for i in pod],
+        "applicationInterfaces": list(elements["applicationInterfaces"].values()),
+        "relations": [dict(r, id=rid) for rid, r in relations.items()],
+    }
+
+
+def _one_render_and_across(resolve, consumer, pod, incluster, external, recipes=None):
+    """What `resolve` draws when one render holds both sides (HelmCharts today), and
+    when the provider's render has published and the consumer's render holds only
+    the consumer."""
+    one = ga.Dataset()
+    one.add_envelope(recipes)
+    across = ga.Dataset()
+    across.add_envelope(recipes)
+    across.add_envelope(_publish(pod, incluster, external))
+    return (resolve([consumer, *pod], incluster, external, one),
+            resolve([consumer], {}, {}, across))
+
+
+def _boundby(instances, incluster, external, ds):
+    relations, add_rel = _relations()
+    errors = []
+    by_product = {}
+    for i in instances:
+        if i["product"]:
+            by_product.setdefault(i["product"], []).append(i)
+    ga.resolve_boundby(by_product, {i["id"]: i for i in instances}, external, incluster, ds,
+                       add_rel, errors)
+    return relations, errors
+
+
+def _upstreams(instances, incluster, external, ds):
+    relations, add_rel = _relations()
+    errors = []
+    ga.resolve_upstreams(instances, {i["id"]: i for i in instances}, external, incluster, ds,
+                         add_rel, errors)
+    return relations, errors
+
+
+def _recipe(product, var, cap):
+    """A consumer producer's boundBy recipe: `product` reaches `cap` through `var`."""
+    return {"relations": [{
+        "id": f"rel:{ga.hint_of(product)}-uses-{ga.hint_of(cap)}",
+        "source": f"{product},00000000-0000-0000-0000-000000000004",
+        "target": cap, "type": "Association", "boundBy": f"env:{var}"}]}
+
+
+def _consumer(ns, var, value, product="app:bot"):
+    return dict(_inst(ns, "bot", "bot"), product=product, env={var: value})
