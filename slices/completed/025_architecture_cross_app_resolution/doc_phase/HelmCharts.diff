+    recipes = [_recipe("app:bot", "OIDC_ISSUER", "cap:identity"),
+               _recipe("app:bot", "DATABASE_URL", "cap:relational-database")]
+    keycloak = ga.composite("ss", "keycloak-prd-keycloak-keycloak",
