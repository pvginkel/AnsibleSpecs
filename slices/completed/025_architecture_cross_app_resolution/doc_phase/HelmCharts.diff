+    assert sorted((r["source"], r["id"]) for r in published["relations"]
+                  if r["type"] == "Association") == sorted([
+        (keycloak, "rel:keycloak-prd-keycloak-keycloak-behind-auth-ginbov-nl"),
+        (keycloak, "rel:keycloak-prd-keycloak-keycloak-behind-keycloak-keycloak-prd-svc"),
+        (pooler, "rel:postgres-pas-prd-postgres-pooler-rw-behind-"
+                 "postgres-pooler-rw-postgres-pas-prd-svc"),
+    ])
+
+    after = ga.Dataset()
+    for recipe in recipes:
+        after.add_envelope(recipe)
+    after.add_envelope(published)
+    remaining = _render(tmp_path, monkeypatch, after, flipped={"keycloak", "postgres-pas"},
+                        releases=PROVIDERS)
+
+    assert [e["stats"]["release"] for e in remaining["applicationComponents"]] == ["bot"]
+    assert {r["id"]: r for r in remaining["relations"] if r["id"] in served} == served
