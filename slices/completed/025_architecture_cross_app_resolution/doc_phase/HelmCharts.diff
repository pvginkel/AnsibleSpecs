+def test_a_provider_that_left_resolves_through_the_interfaces_it_published(tmp_path, monkeypatch):
+    recipe = _recipe("app:bot", "JENKINS_URL", CI)
+    both = ga.Dataset()
+    both.add_envelope(recipe)
+    published = _render(tmp_path, monkeypatch, both)
+    served = {r["id"]: r for r in published["relations"] if r["type"] == "Serving"
+              and r["source"].startswith("ss:jenkins-prd-jenkins-jenkins,")}
+    [(edge_id, edge)] = served.items()
+
+    # The interface carries its release's stage, and links the server, never the init
+    # container.
+    [interface] = published["applicationInterfaces"]
+    assert (interface["label"], interface["introduced"], interface["environment"]) == (
+        "jenkins.jenkins-prd.svc", "2024-07-24", "prd")
+    assert [(r["id"], r["source"]) for r in published["relations"]
+            if r["type"] == "Association"] == [
+        ("rel:jenkins-prd-jenkins-jenkins-behind-jenkins-jenkins-prd-svc", edge["source"])]
+
+    after = ga.Dataset()
+    after.add_envelope(recipe)
+    after.add_envelope(published)
+    remaining = _render(tmp_path, monkeypatch, after, flipped={"jenkins"})
+
+    assert [e["stats"]["release"] for e in remaining["applicationComponents"]] == ["bot"]
+    assert {r["id"]: r for r in remaining["relations"]}[edge_id] == edge
+
