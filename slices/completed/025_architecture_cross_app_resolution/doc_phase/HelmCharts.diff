+def _render(tmp_path, monkeypatch, ds, flipped=(), releases=RELEASES):
+    """Run main over `releases`; a flipped release is reported with no chart, as
+    `deploy config` reports one Argo CD reconciles."""
+    for chart_dir, (annotations, _docs) in releases.items():
+        (tmp_path / "configs" / "prd" / chart_dir / "prd").mkdir(parents=True, exist_ok=True)
+        (tmp_path / "charts" / chart_dir).mkdir(parents=True, exist_ok=True)
+        (tmp_path / "charts" / chart_dir / "architecture.yaml").write_text(annotations)
+
+    def run(args, cwd):
+        if args[0] == "git":
+            return "2024-07-24\n"
+        verb, release, _stage = args[-3:]
+        chart_dir = release.removeprefix("prd/")
+        if verb == "config":
+            return "---\n" + yaml.safe_dump(
+                _config(chart_dir, None if chart_dir in flipped else chart_dir))
+        return yaml.safe_dump_all(releases[chart_dir][1])
+
+    output = tmp_path / "docs" / "architecture" / "helm-charts.yaml"
+    monkeypatch.setattr(ga, "ROOT", tmp_path)
+    monkeypatch.setattr(ga, "CONFIGS", tmp_path / "configs" / "prd")
+    monkeypatch.setattr(ga, "OUTPUT", output)
+    monkeypatch.setattr(ga, "run", run)
+    monkeypatch.setattr(ga, "load_dataset", lambda: ds)
+    monkeypatch.setattr(sys, "argv", ["gen-architecture"])
+
+    ga.main()
+
+    return yaml.safe_load(output.read_text())
+
