@@ -0,0 +1,284 @@
+package org.webathome.jenkinspipelineutils;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import groovy.lang.GroovyClassLoader;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.junit.jupiter.params.provider.ValueSource;
+
+/**
+ * The surgical write behind cicd.writeVersionPins: applyPins finds each pin's line, replacePin
+ * rewrites its scalar, plainSafe decides whether a value may stay unquoted. All three are
+ * {@code @NonCPS}, so the CPS transform leaves their bodies to run as plain Groovy here.
+ */
+class VersionPinsTest {
+
+    private static final String FILE = "config/dev/values.yaml";
+
+    private static final String VALUES = """
+            # Pinned by KubeCoder/Build-Main; every other line is hand-curated.
+            images:  # the build's own tags
+              controller: dev-523   # the controller image
+              agent: "dev-523"
+              sidecar: 'dev-523'
+            replicas: 1
+
+            notes: |
+              Bump images.controller by hand only in an emergency:
+
+              images:
+                controller: dev-1
+            summary: >
+              images:
+                agent: dev-1
+            env:
+              - name: LOG_LEVEL
+            web:
+              image:
+                tag: dev-523
+              resources:
+                cpu: 1
+            api:
+              image:
+                tag: dev-523
+            """;
+
+    private static GroovyClassLoader loader;
+    private static Object cicd;
+    private static Method applyPins;
+    private static Method replacePin;
+    private static Method plainSafe;
+
+    @BeforeAll
+    static void loadCicd() throws Exception {
+        loader = LibraryCompileTest.trustedLoader();
+        Class<?> type = loader.loadClass("cicd");
+        cicd = type.getDeclaredConstructor().newInstance();
+        applyPins = type.getMethod("applyPins", String.class, String.class, Map.class);
+        replacePin = type.getMethod("replacePin", String.class, String.class);
+        plainSafe = type.getMethod("plainSafe", String.class);
+    }
+
+    @AfterAll
+    static void closeLoader() throws Exception {
+        loader.close();
+    }
+
+    private static Object call(Method method, Object... args) throws Exception {
+        try {
+            return method.invoke(cicd, args);
+        } catch (InvocationTargetException e) {
+            if (e.getCause() instanceof IllegalArgumentException refused) {
+                throw refused;
+            }
+            throw e;
+        }
+    }
+
+    /** Pins are given as dotted path, value, dotted path, value, ... */
+    private static String apply(String text, String... pins) throws Exception {
+        Map<String, String> map = new LinkedHashMap<>();
+        for (int i = 0; i < pins.length; i += 2) {
+            map.put(pins[i], pins[i + 1]);
+        }
+        return (String) call(applyPins, FILE, text, map);
+    }
+
+    @Test
+    void writesEachPinAndLeavesEveryOtherByte() throws Exception {
+        String expected = """
+                # Pinned by KubeCoder/Build-Main; every other line is hand-curated.
+                images:  # the build's own tags
+                  controller: dev-524   # the controller image
+                  agent: "dev-524"
+                  sidecar: 'dev-524'
+                replicas: 1
+
+                notes: |
+                  Bump images.controller by hand only in an emergency:
+
+                  images:
+                    controller: dev-1
+                summary: >
+                  images:
+                    agent: dev-1
+                env:
+                  - name: LOG_LEVEL
+                web:
+                  image:
+                    tag: dev-523
+                  resources:
+                    cpu: 1
+                api:
+                  image:
+                    tag: dev-524
+                """;
+
+        assertEquals(
+                expected,
+                apply(
+                        VALUES,
+                        "images.controller", "dev-524",
+                        "images.agent", "dev-524",
+                        "images.sidecar", "dev-524",
+                        "api.image.tag", "dev-524"));
+    }
+
+    // writeVersionPins commits nothing when the text comes back equal.
+    @Test
+    void pinsTheFileAlreadyHoldsChangeNothing() throws Exception {
+        assertEquals(
+                VALUES,
+                apply(
+                        VALUES,
+                        "images.controller", "dev-523",
+                        "images.agent", "dev-523",
+                        "images.sidecar", "dev-523",
+                        "api.image.tag", "dev-523"));
+    }
+
+    @Test
+    void aFileWithoutAFinalNewlineGainsNone() throws Exception {
+        assertEquals("images:\n  controller: dev-524", apply("images:\n  controller: dev-523", "images.controller", "dev-524"));
+    }
+
+    @ParameterizedTest(name = "{0} is refused")
+    @ValueSource(strings = {
+        // No such key.
+        "images.missing",
+        "image.tag",
+        // A mapping, not a scalar.
+        "images",
+        "web.image",
+        // Beneath a scalar.
+        "web.image.tag.version",
+        // A block scalar, and the prose inside one that reads like YAML.
+        "notes",
+        "notes.images.controller",
+        "summary.images.agent",
+        // A sequence, and a key inside one of its entries.
+        "env",
+        "env.name",
+    })
+    void aPathWithoutAScalarLineIsRefused(String path) {
+        IllegalArgumentException refused =
+                assertThrows(IllegalArgumentException.class, () -> apply(VALUES, path, "dev-524"));
+        assertEquals(
+                "cicd.writeVersionPins: " + FILE + " holds no " + path
+                        + "; a path the file does not already carry is never created",
+                refused.getMessage());
+    }
+
+    @Test
+    void everyMissingPathIsNamed() {
+        IllegalArgumentException refused = assertThrows(
+                IllegalArgumentException.class,
+                () -> apply(VALUES, "images.controller", "dev-524", "images.gateway", "dev-524", "api.tag", "dev-524"));
+        assertTrue(refused.getMessage().contains(" holds no images.gateway, api.tag; "), refused.getMessage());
+    }
+
+    @Test
+    void aPathOnTwoLinesIsRefused() {
+        String twice = """
+                images:
+                  controller: dev-523
+                replicas: 1
+                images:
+                  controller: dev-523
+                """;
+        IllegalArgumentException refused = assertThrows(
+                IllegalArgumentException.class, () -> apply(twice, "images.controller", "dev-524"));
+        assertEquals(
+                "cicd.writeVersionPins: " + FILE + " holds 'images.controller' on both line 2 and line 5",
+                refused.getMessage());
+    }
+
+    static Stream<Arguments> pinnedLines() {
+        return Stream.of(
+                // Plain: the key, its indent and spacing, and whatever trails the scalar stay.
+                Arguments.of("tag: dev-523", "dev-524", "tag: dev-524"),
+                Arguments.of("    tag:   dev-523", "dev-524", "    tag:   dev-524"),
+                Arguments.of("tag: dev-523   # CI writes this", "dev-524", "tag: dev-524   # CI writes this"),
+                Arguments.of("tag: dev-523   ", "dev-524", "tag: dev-524   "),
+                Arguments.of("tag: a#b", "dev-524", "tag: dev-524"),
+                // Plain, with a value plain style would read back as something else: double-quoted.
+                Arguments.of("tag: dev-523", "524", "tag: \"524\""),
+                Arguments.of("tag: dev-523 # CI writes this", ":524", "tag: \":524\" # CI writes this"),
+                Arguments.of("tag: dev-523", "true", "tag: \"true\""),
+                Arguments.of("tag: dev-523", "a #b", "tag: \"a #b\""),
+                Arguments.of("tag: dev-523", "\"q\" \\ x", "tag: \"\\\"q\\\" \\\\ x\""),
+                // Double-quoted stays double-quoted, escapes and all, whatever the old value held.
+                Arguments.of("tag: \"dev-523\"", "dev-524", "tag: \"dev-524\""),
+                Arguments.of("tag: \"523\" # c", "524", "tag: \"524\" # c"),
+                Arguments.of("tag: \"a # b\" # c", "dev-524", "tag: \"dev-524\" # c"),
+                Arguments.of("tag: \"a\\\"b\" # c", "dev-524", "tag: \"dev-524\" # c"),
+                Arguments.of("tag: \"a\\\\\" # c", "dev-524", "tag: \"dev-524\" # c"),
+                Arguments.of("tag: \"x\"", "a\"b\\c", "tag: \"a\\\"b\\\\c\""),
+                // Single-quoted stays single-quoted, a quote inside doubled.
+                Arguments.of("tag: 'dev-523'", "dev-524", "tag: 'dev-524'"),
+                Arguments.of("tag: '523' # c", "524", "tag: '524' # c"),
+                Arguments.of("tag: 'a # b' # c", "dev-524", "tag: 'dev-524' # c"),
+                Arguments.of("tag: 'it''s' # c", "dev-524", "tag: 'dev-524' # c"),
+                Arguments.of("tag: 'it''' # c", "dev-524", "tag: 'dev-524' # c"),
+                Arguments.of("tag: 'x'", "it's", "tag: 'it''s'"));
+    }
+
+    @ParameterizedTest(name = "[{0}] <- {1} is [{2}]")
+    @MethodSource("pinnedLines")
+    void replacesOnlyTheScalar(String line, String value, String expected) throws Exception {
+        assertEquals(expected, call(replacePin, line, value));
+    }
+
+    @ParameterizedTest(name = "{0} stays plain")
+    @ValueSource(strings = {
+        "latest",
+        "dev-524",
+        "node-24",
+        "v1.2.3",
+        "sha-3f9c2a1",
+        "registry:5000/app:57",
+        "a#b",
+        "a b",
+        "yes-please",
+        "nullable",
+    })
+    void plainSafeValues(String value) throws Exception {
+        assertTrue((boolean) call(plainSafe, value));
+    }
+
+    @ParameterizedTest(name = "[{0}] is quoted")
+    @ValueSource(strings = {
+        // Empty, or whitespace a plain scalar drops.
+        "",
+        " latest",
+        "latest ",
+        // A leading indicator character.
+        "-x", "?x", ":524", ",x", "[x", "]x", "{x", "}x", "#x", "&x", "*x", "!x", "|x", ">x",
+        "'x", "\"x", "%x", "@x", "`x",
+        // What may resolve to a number, a date or null.
+        "524", "+1", ".5", "0x1f", ".inf", "2026-09-21", "26.7.3-postgres", "~",
+        // The YAML 1.1 booleans and null, in any case.
+        "y", "Y", "yes", "YES", "n", "no", "No", "true", "True", "false", "FALSE", "on", "On", "off", "null",
+        "Null",
+        // A mapping or a comment inside the value.
+        "a: b",
+        "a #b",
+        "a:",
+    })
+    void valuesPlainStyleWouldRetype(String value) throws Exception {
+        assertFalse((boolean) call(plainSafe, value));
+    }
+}

