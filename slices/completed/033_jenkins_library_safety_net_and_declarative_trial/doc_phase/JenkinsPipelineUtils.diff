+package org.webathome.jenkinspipelineutils;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import groovy.lang.GroovyClassLoader;
+import java.lang.reflect.Method;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+
+/**
+ * notify.escape, which keeps a raisealert marker's message on one log line. It is {@code @NonCPS},
+ * so the CPS transform leaves its body to run as plain Groovy here.
+ */
+class AlertEscapeTest {
+
+    private static GroovyClassLoader loader;
+    private static Object notify;
+    private static Method escape;
+
+    @BeforeAll
+    static void loadNotify() throws Exception {
+        loader = LibraryCompileTest.trustedLoader();
+        Class<?> type = loader.loadClass("notify");
+        notify = type.getDeclaredConstructor().newInstance();
+        escape = type.getMethod("escape", String.class);
+    }
+
+    @AfterAll
+    static void closeLoader() throws Exception {
+        loader.close();
+    }
+
+    static Stream<Arguments> messages() {
+        return Stream.of(
+                Arguments.of("build 57 is green", "build 57 is green"),
+                Arguments.of("", ""),
+                Arguments.of("tab\tstays", "tab\tstays"),
+                // Line breaks become their two-character escapes.
+                Arguments.of("line one\nline two", "line one\\nline two"),
+                Arguments.of("crlf\r\nend", "crlf\\r\\nend"),
+                Arguments.of("lone\rcr", "lone\\rcr"),
+                Arguments.of("trailing\n", "trailing\\n"),
+                // A backslash the message holds is escaped first, so the two characters \n stay
+                // distinguishable from an escaped line break.
+                Arguments.of("literal \\n", "literal \\\\n"),
+                Arguments.of("C:\\dir", "C:\\\\dir"),
+                Arguments.of("both \\n\n", "both \\\\n\\n"));
+    }
+
+    @ParameterizedTest(name = "case {index}")
+    @MethodSource("messages")
+    void escapesBackslashAndLineBreaks(String message, String expected) throws Exception {
+        assertEquals(expected, escape.invoke(notify, message));
+    }
+}
