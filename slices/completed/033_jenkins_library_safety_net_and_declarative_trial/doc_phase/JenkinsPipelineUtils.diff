+package org.webathome.jenkinspipelineutils;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import groovy.lang.GroovyClassLoader;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+import org.codehaus.groovy.runtime.GStringImpl;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+
+/**
+ * podYaml, which renders a declarative Kubernetes agent's pod spec from library sidecars and
+ * pipeline-chosen images. It is {@code @NonCPS}, so the CPS transform leaves its body to run as
+ * plain Groovy here. The sidecars' reference is KubeCoder/Build-Main #558's pod, as the kubernetes
+ * plugin printed it from containerTemplates.k8s and modern_app_toolchain.
+ */
+class PodYamlTest {
+
+    private static final String HEADER = """
+            apiVersion: v1
+            kind: Pod
+            spec:
+              containers:
+            """;
+
+    private static GroovyClassLoader loader;
+    private static Object podYaml;
+    private static Method call;
+
+    @BeforeAll
+    static void loadPodYaml() throws Exception {
+        loader = LibraryCompileTest.trustedLoader();
+        Class<?> type = loader.loadClass("podYaml");
+        podYaml = type.getDeclaredConstructor().newInstance();
+        call = type.getMethod("call", Map.class);
+    }
+
+    @AfterAll
+    static void closeLoader() throws Exception {
+        loader.close();
+    }
+
+    private static String render(Map<String, Object> args) throws Exception {
+        try {
+            return (String) call.invoke(podYaml, args);
+        } catch (InvocationTargetException e) {
+            if (e.getCause() instanceof IllegalArgumentException refused) {
+                throw refused;
+            }
+            throw e;
+        }
+    }
+
+    /** Keys and values alternate; the map keeps their order, as a Groovy map literal does. */
+    private static Map<String, Object> ordered(Object... pairs) {
+        Map<String, Object> map = new LinkedHashMap<>();
+        for (int i = 0; i < pairs.length; i += 2) {
+            map.put((String) pairs[i], pairs[i + 1]);
+        }
+        return map;
+    }
+
+    @Test
+    void librarySidecarsCarryTheirContainerTemplateSettings() throws Exception {
+        String expected = HEADER + """
+                  - name: "k8s"
+                    image: "registry:5000/k8s:1.35.5"
+                    imagePullPolicy: Always
+                    command:
+                    - sleep
+                    args:
+                    - infinity
+                  - name: "modern-app-toolchain"
+                    image: "registry:5000/kube-coder-modern-app-toolchain:node-24"
+                    imagePullPolicy: Always
+                    command:
+                    - sleep
+                    args:
+                    - infinity
+                    securityContext:
+                      runAsUser: 1000
+                """;
+        assertEquals(expected, render(Map.of("templates", List.of("k8s", "modern-app-toolchain"))));
+    }
+
+    @Test
+    void anImageReferenceRunsLikeASidecar() throws Exception {
+        String expected = HEADER + """
+                  - name: "node"
+                    image: "node:24-bookworm"
+                    imagePullPolicy: Always
+                    command:
+                    - sleep
+                    args:
+                    - infinity
+                """;
+        assertEquals(expected, render(Map.of("images", List.of("node:24-bookworm"))));
+    }
+
+    static Stream<Arguments> imageNames() {
+        return Stream.of(
+                Arguments.of("node:24-bookworm", "node"),
+                Arguments.of("registry:5000/kube-coder-go-toolchain:latest", "kube-coder-go-toolchain"),
+                // A registry port is not a tag.
+                Arguments.of("registry:5000/python", "python"),
+                Arguments.of("espressif/idf:v5.3.1", "idf"),
+                Arguments.of("espressif/idf@sha256:0123abcd", "idf"),
+                Arguments.of("espressif/idf:v5.3.1@sha256:0123abcd", "idf"));
+    }
+
+    @ParameterizedTest(name = "{0} -> {1}")
+    @MethodSource("imageNames")
+    void anImageReferenceIsNamedAfterItsLastPathSegment(String image, String name) throws Exception {
+        String rendered = render(Map.of("images", List.of(image)));
+        assertEquals("  - name: \"" + name + "\"", rendered.lines().toList().get(4));
+    }
+
+    // A pipeline interpolates the version it needs: "esp-idf:${version}" is a GString, not a String.
+    @Test
+    void anInterpolatedImageReferenceIsAnImageReference() throws Exception {
+        Object image = new GStringImpl(new Object[] {"v5.3.1"}, new String[] {"espressif/idf:", ""});
+        assertEquals(
+                render(Map.of("images", List.of("espressif/idf:v5.3.1"))),
+                render(Map.of("images", List.of(image))));
+    }
+
+    @Test
+    void aMapEntryOverridesNameResourcesUserAndEnv() throws Exception {
+        Map<String, Object> esp = ordered(
+                "image", "espressif/idf:v5.3.1",
+                "name", "esp-idf",
+                "resources", ordered(
+                        "requests", ordered("cpu", "2", "memory", "2Gi"),
+                        "limits", ordered("cpu", 4, "memory", "4Gi", "ephemeral-storage", "10Gi")),
+                "runAsUser", "1000",
+                "env", ordered("IDF_CCACHE_ENABLE", "1", "HOME", "/tmp"));
+        String expected = HEADER + """
+                  - name: "esp-idf"
+                    image: "espressif/idf:v5.3.1"
+                    imagePullPolicy: Always
+                    command:
+                    - sleep
+                    args:
+                    - infinity
+                    resources:
+                      requests:
+                        "cpu": "2"
+                        "memory": "2Gi"
+                      limits:
+                        "cpu": "4"
+                        "memory": "4Gi"
+                        "ephemeral-storage": "10Gi"
+                    securityContext:
+                      runAsUser: 1000
+                    env:
+                    - name: "IDF_CCACHE_ENABLE"
+                      value: "1"
+                    - name: "HOME"
+                      value: "/tmp"
+                """;
+        assertEquals(expected, render(Map.of("images", List.of(esp))));
+    }
+
+    // What a map entry does not override, it takes from the string form.
+    @Test
+    void aMapEntryWithOnlyAnImageIsTheStringForm() throws Exception {
+        assertEquals(
+                render(Map.of("images", List.of("node:24-bookworm"))),
+                render(Map.of("images", List.of(Map.of("image", "node:24-bookworm")))));
+    }
+
+    static Stream<Arguments> envValues() {
+        return Stream.of(
+                // Unquoted, YAML reads these as null, a boolean and an integer.
+                Arguments.of("", "\"\""),
+                Arguments.of("true", "\"true\""),
+                Arguments.of("1000", "\"1000\""),
+                Arguments.of("# not a comment", "\"# not a comment\""),
+                Arguments.of("C:\\cache \"x\"", "\"C:\\\\cache \\\"x\\\"\""),
+                // Inside double quotes a raw line break folds to a space; the escape keeps it.
+                Arguments.of("a\nb\tc", "\"a\\x0ab\\x09c\""));
+    }
+
+    @ParameterizedTest(name = "value: {1}")
+    @MethodSource("envValues")
+    void anEnvValueStaysTheStringGiven(String value, String scalar) throws Exception {
+        String rendered = render(Map.of("images", List.of(Map.of("image", "node", "env", Map.of("V", value)))));
+        assertEquals("      value: " + scalar, rendered.lines().toList().getLast());
+    }
+
+    // KubeCoder/Build-Main's pod: the library sidecars first, then the pipeline's own images.
+    @Test
+    void templatesComeBeforeImagesEachInTheOrderGiven() throws Exception {
+        Map<String, Object> golang = ordered(
+                "image", "registry:5000/kube-coder-go-toolchain:latest",
+                "name", "golang",
+                "resources", ordered(
+                        "requests", ordered("cpu", "2", "memory", "2Gi"),
+                        "limits", ordered("cpu", "4", "memory", "4Gi")));
+        String expected = HEADER + """
+                  - name: "k8s"
+                    image: "registry:5000/k8s:1.35.5"
+                    imagePullPolicy: Always
+                    command:
+                    - sleep
+                    args:
+                    - infinity
+                  - name: "modern-app-toolchain"
+                    image: "registry:5000/kube-coder-modern-app-toolchain:node-24"
+                    imagePullPolicy: Always
+                    command:
+                    - sleep
+                    args:
+                    - infinity
+                    securityContext:
+                      runAsUser: 1000
+                  - name: "golang"
+                    image: "registry:5000/kube-coder-go-toolchain:latest"
+                    imagePullPolicy: Always
+                    command:
+                    - sleep
+                    args:
+                    - infinity
+                    resources:
+                      requests:
+                        "cpu": "2"
+                        "memory": "2Gi"
+                      limits:
+                        "cpu": "4"
+                        "memory": "4Gi"
+                  - name: "node"
+                    image: "node:24-bookworm"
+                    imagePullPolicy: Always
+                    command:
+                    - sleep
+                    args:
+                    - infinity
+                """;
+        assertEquals(
+                expected,
+                render(ordered(
+                        "templates", List.of("k8s", "modern-app-toolchain"),
+                        "images", List.of(golang, "node:24-bookworm"))));
+    }
+
+    static Stream<Arguments> refusals() {
+        return Stream.of(
+                Arguments.of(
+                        Map.of("templates", List.of("k8s", "helm")),
+                        "podYaml: the library has no template 'helm'; it has k8s, modern-app-toolchain"),
+                Arguments.of(
+                        Map.of("images", List.of(ordered("image", "node:24-bookworm", "cpu", "2"))),
+                        "podYaml: an images entry takes image, name, resources, runAsUser and env; got cpu"),
+                Arguments.of(
+                        Map.of("images", List.of(Map.of("name", "node"))),
+                        "podYaml: an images entry names no image: [name:node]"),
+                Arguments.of(
+                        Map.of("images", List.of(Map.of("image", "node", "resources", Map.of("limit", Map.of("cpu", "1"))))),
+                        "podYaml: resources takes requests and limits; got 'limit'"),
+                Arguments.of(
+                        Map.of("image", List.of("node:24-bookworm")),
+                        "podYaml: takes templates and images; got image"),
+                // A library sidecar and an image of the same name.
+                Arguments.of(
+                        Map.of("templates", List.of("k8s"), "images", List.of("registry:5000/k8s:1.36.0")),
+                        "podYaml: two containers are named 'k8s'"),
+                Arguments.of(
+                        Map.of("images", List.of("node:24-bookworm", "node:22-bookworm")),
+                        "podYaml: two containers are named 'node'"),
+                Arguments.of(
+                        Map.of("templates", List.of("k8s", "k8s")),
+                        "podYaml: two containers are named 'k8s'"));
+    }
+
+    @ParameterizedTest(name = "{1}")
+    @MethodSource("refusals")
+    void aCallItCannotRenderAsGivenIsRefused(Map<String, Object> args, String message) {
+        IllegalArgumentException refused = assertThrows(IllegalArgumentException.class, () -> render(args));
+        assertEquals(message, refused.getMessage());
+    }
+}
