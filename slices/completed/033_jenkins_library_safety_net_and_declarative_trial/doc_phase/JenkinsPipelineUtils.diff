+package org.webathome.jenkinspipelineutils;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import groovy.lang.Binding;
+import groovy.lang.GroovyClassLoader;
+import groovy.lang.Script;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+
+/**
+ * utils.hasChanges, which asks whether the build's change sets touch a path matching a pattern. It
+ * is {@code @NonCPS}, so the CPS transform leaves its body to run as plain Groovy here; without the
+ * annotation the direct call throws CpsCallableInvocation. It reads the {@code currentBuild} global,
+ * which the script binding stands in for, shaped as RunWrapper's changeSets / items /
+ * affectedFiles / path.
+ */
+class ChangedFilesTest {
+
+    private static final Map<String, Object> BUILD = build(
+            changeSet(commit("README.md"), commit("docs/manual.md", "Jenkinsfile")),
+            changeSet(commit("images/k8s/Dockerfile", "images/k8s/versions.env")));
+
+    private static GroovyClassLoader loader;
+    private static Class<?> type;
+    private static Method hasChanges;
+
+    @BeforeAll
+    static void loadUtils() throws Exception {
+        loader = LibraryCompileTest.trustedLoader();
+        type = loader.loadClass("utils");
+        hasChanges = type.getMethod("hasChanges", Object.class);
+    }
+
+    @AfterAll
+    static void closeLoader() throws Exception {
+        loader.close();
+    }
+
+    private static Map<String, Object> commit(String... paths) {
+        return Map.of("affectedFiles", Arrays.stream(paths).map(p -> Map.of("path", p)).toList());
+    }
+
+    @SafeVarargs
+    private static Map<String, Object> changeSet(Map<String, Object>... commits) {
+        return Map.of("items", List.of(commits));
+    }
+
+    @SafeVarargs
+    private static Map<String, Object> build(Map<String, Object>... changeSets) {
+        return Map.of("changeSets", List.of(changeSets));
+    }
+
+    private static Object answer(Map<String, Object> currentBuild, String pattern) throws Exception {
+        Script utils = (Script) type.getDeclaredConstructor().newInstance();
+        utils.setBinding(new Binding(Map.of("currentBuild", currentBuild)));
+        return hasChanges.invoke(utils, pattern);
+    }
+
+    static Stream<Arguments> patterns() {
+        return Stream.of(
+                Arguments.of(".*", true),
+                // A negative lookahead on the empty string matches no path at all.
+                Arguments.of("(?!)", false),
+                // Every change set and every commit in it is searched, not only the first.
+                Arguments.of("images/k8s/.*", true),
+                Arguments.of("Jenkinsfile", true),
+                Arguments.of(".*\\.env", true),
+                // ==~ matches the whole path: a prefix or a bare file name is no match.
+                Arguments.of("images", false),
+                Arguments.of("manual\\.md", false),
+                Arguments.of("charts/.*", false));
+    }
+
+    @ParameterizedTest(name = "{0} -> {1}")
+    @MethodSource("patterns")
+    void answersWhetherAChangedPathMatches(String pattern, boolean expected) throws Exception {
+        assertEquals(expected, answer(BUILD, pattern));
+    }
+
+    // A build with no change sets: the first build of a job, or one started by hand.
+    @Test
+    void noChangeSetsIsNoChange() throws Exception {
+        assertEquals(false, answer(build(), ".*"));
+    }
+}
