index 0000000..09f3ae9
--- /dev/null
+++ b/vars/podYaml.groovy
@@ -0,0 +1,168 @@
+/**
+ * Returns the pod spec, as YAML, for a declarative Kubernetes agent: the library sidecars named in
+ * `templates`, then a container for each entry of `images`, in the order given.
+ *
+ *     agent {
+ *         kubernetes {
+ *             inheritFrom 'jenkins-agent'
+ *             yaml podYaml(templates: ['k8s'], images: ['node:24-bookworm'])
+ *         }
+ *     }
+ *
+ * Every container is kept alive by `sleep infinity` and pulled `Always`; `container('<name>')`
+ * runs a stage's steps in it.
+ *
+ * Declarative evaluates an agent's parameters on the controller before any agent exists, so this
+ * and everything it calls is @NonCPS and calls no step.
+ *
+ * @param templates  Library sidecars by name: `k8s` (kubectl, crane) and `modern-app-toolchain`
+ *                   (KubeCoder's full-stack tool image: Node 24, pnpm, bun, poetry, uv).
+ * @param images     Any other container, as an image reference, named after the image's last
+ *                   path segment without its tag (`node:24-bookworm` runs as `node`), or as a map
+ *                   with `image` and any of `name`, `resources` (`requests` and `limits`, each
+ *                   resource name -> quantity), `runAsUser` and `env` (name -> value).
+ */
+@NonCPS
+String call(Map args) {
+    def unknown = args.keySet().collect { it.toString() } - ['templates', 'images']
+    if (unknown) {
+        throw new IllegalArgumentException("podYaml: takes templates and images; got ${unknown.join(', ')}")
+    }
+
+    Map<String, Map> library = sidecars()
+    List<Map> containers = []
+
+    (args.templates ?: []).each { template ->
+        String name = template.toString()
+        if (!library.containsKey(name)) {
+            throw new IllegalArgumentException(
+                "podYaml: the library has no template '${name}'; it has ${library.keySet().join(', ')}")
+        }
+        containers.add([name: name] + library[name])
+    }
+    (args.images ?: []).each { entry ->
+        if (entry instanceof Map) {
+            containers.add(imageContainer(entry))
+        } else {
+            String image = entry.toString()
+            containers.add([name: containerName(image), image: image])
+        }
+    }
+
+    Set<String> names = []
+    containers.each { container ->
+        if (!names.add(container.name)) {
+            throw new IllegalArgumentException("podYaml: two containers are named '${container.name}'")
+        }
+    }
+
+    List<String> lines = ['apiVersion: v1', 'kind: Pod', 'spec:', '  containers:']
+    containers.each { lines.addAll(containerLines(it)) }
+    return lines.join('\n') + '\n'
+}
+
+/**
+ * The sidecars `templates` names, as `containerTemplates` declares them for a scripted
+ * podTemplate. uid 1000 is the agent's own user: git refuses a checkout another uid owns.
+ */
+@NonCPS
+Map<String, Map> sidecars() {
+    return [
+        'k8s': [image: 'registry:5000/k8s:1.35.5'],
+        'modern-app-toolchain': [image: 'registry:5000/kube-coder-modern-app-toolchain:node-24', runAsUser: 1000],
+    ]
+}
+
+/**
+ * An `images` map entry as a container: every key a String, every value the type it renders as.
+ */
+@NonCPS
+Map imageContainer(Map entry) {
+    Map given = [:]
+    entry.each { key, value -> given[key.toString()] = value }
+
+    def unknown = given.keySet() - ['image', 'name', 'resources', 'runAsUser', 'env']
+    if (unknown) {
+        throw new IllegalArgumentException(
+            "podYaml: an images entry takes image, name, resources, runAsUser and env; got ${unknown.join(', ')}")
+    }
+    if (!given.image) {
+        throw new IllegalArgumentException("podYaml: an images entry names no image: ${entry}")
+    }
+
+    String image = given.image.toString()
+    Map container = [name: given.name ? given.name.toString() : containerName(image), image: image]
+
+    if (given.resources) {
+        Map<String, Map<String, String>> resources = [:]
+        given.resources.each { kind, quantities ->
+            if (!(kind.toString() in ['requests', 'limits'])) {
+                throw new IllegalArgumentException("podYaml: resources takes requests and limits; got '${kind}'")
+            }
+            Map<String, String> byResource = [:]
+            quantities.each { resource, quantity -> byResource[resource.toString()] = quantity.toString() }
+            resources[kind.toString()] = byResource
+        }
+        container.resources = resources
+    }
+    if (given.runAsUser != null) {
+        container.runAsUser = Long.parseLong(given.runAsUser.toString())
+    }
+    if (given.env) {
+        Map<String, String> env = [:]
+        given.env.each { name, value -> env[name.toString()] = value.toString() }
+        container.env = env
+    }
+    return container
+}
+
+/**
+ * The image's last path segment without its tag or digest:
+ * `registry:5000/kube-coder-go-toolchain:latest` -> `kube-coder-go-toolchain`.
+ */
+@NonCPS
+String containerName(String image) {
+    return image.substring(image.lastIndexOf('/') + 1).split(/[:@]/)[0]
+}
+
+@NonCPS
+List<String> containerLines(Map container) {
+    List<String> lines = [
+        "  - name: ${quoted(container.name)}".toString(),
+        "    image: ${quoted(container.image)}".toString(),
+        '    imagePullPolicy: Always',
+        '    command:',
+        '    - sleep',
+        '    args:',
+        '    - infinity',
+    ]
+    if (container.resources) {
+        lines.add('    resources:')
+        container.resources.each { kind, quantities ->
+            lines.add("      ${kind}:".toString())
+            quantities.each { resource, quantity -> lines.add("        ${quoted(resource)}: ${quoted(quantity)}".toString()) }
+        }
+    }
+    if (container.runAsUser != null) {
+        lines.add('    securityContext:')
+        lines.add("      runAsUser: ${container.runAsUser}".toString())
+    }
+    if (container.env) {
+        lines.add('    env:')
+        container.env.each { name, value ->
+            lines.add("    - name: ${quoted(name)}".toString())
+            lines.add("      value: ${quoted(value)}".toString())
+        }
+    }
+    return lines
+}
+
+/**
+ * `value` as a YAML double-quoted scalar, which reads back as exactly that string whatever it
+ * holds: `true`, `1000` and the empty string stay strings.
+ */
+@NonCPS
+String quoted(String value) {
+    String escaped = value.replace('\\', '\\\\').replace('"', '\\"')
+    return '"' + escaped.replaceAll(/[\x00-\x1f\x7f]/) { String c -> String.format('\\x%02x', (int) c.charAt(0)) } + '"'
+}
