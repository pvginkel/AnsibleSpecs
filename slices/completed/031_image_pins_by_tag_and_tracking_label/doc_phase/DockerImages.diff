+def build_number(tag: str, label: str) -> int | None:
+    """The build number of `tag` if it is in the build series of the tracking
+    tag `label`, else None.
+
+    The series rule is kaniko2's `inBuildSeries` (JenkinsPipelineUtils
+    vars/helmCharts.groovy): `latest` owns `<digits>`, `<prefix>-latest` owns
+    `<prefix>-<digits>`, any other label owns `<label>-<digits>`.
+    """
+    if label == "latest" or label.endswith("-latest"):
+        prefix = label[: -len("latest")]
+    else:
+        prefix = label + "-"
+    if not tag.startswith(prefix):
+        return None
+    number = tag[len(prefix) :]
+    return int(number) if _BUILD_NUMBER.fullmatch(number) else None
 
 
