+package org.webathome.jenkinspipelineutils;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import groovy.lang.GroovyClassLoader;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.Arrays;
+import java.util.List;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+
+/**
+ * The tracking tag kaniko2 stamps, and the destination sets it refuses. resolveTrackingTag is
+ * {@code @NonCPS}, so the CPS transform leaves its body to run as plain Groovy here.
+ */
+class TrackingTagTest {
+
+    private static GroovyClassLoader loader;
+    private static Object helmCharts;
+    private static Method resolveTrackingTag;
+
+    @BeforeAll
+    static void loadHelmCharts() throws Exception {
+        loader = LibraryCompileTest.trustedLoader();
+        Class<?> type = loader.loadClass("helmCharts");
+        helmCharts = type.getDeclaredConstructor().newInstance();
+        resolveTrackingTag = type.getMethod("resolveTrackingTag", List.class, String.class);
+    }
+
+    @AfterAll
+    static void closeLoader() throws Exception {
+        loader.close();
+    }
+
+    /** Destination tags are space-separated; an empty trackingTag column passes none. */
+    private static String resolve(String trackingTag, String tags) throws Exception {
+        List<String> destinations = Arrays.stream(tags.split(" "))
+                .map(tag -> "registry:5000/app:" + tag)
+                .toList();
+        try {
+            return (String) resolveTrackingTag.invoke(helmCharts, destinations, trackingTag);
+        } catch (InvocationTargetException e) {
+            if (e.getCause() instanceof IllegalArgumentException refused) {
+                throw refused;
+            }
+            throw e;
+        }
+    }
+
+    @ParameterizedTest(name = "trackingTag={0} destinations=[{1}] -> {2}")
+    @CsvSource({
+        // The destination sets the estate's callers push today.
+        ", 57 latest, latest",
+        ", latest 57, latest",
+        ", dev-57 dev-latest, dev-latest",
+        ", uat-57 uat-latest, uat-latest",
+        ", 26.7.3-postgres-health-ispn, 26.7.3-postgres-health-ispn",
+        ", node-24, node-24",
+        // A lone bare build number falls in the series of `latest`.
+        ", 57, latest",
+        // A matrix build's named tag and its per-build tag.
+        ", 26.7.3-postgres-health-ispn 26.7.3-postgres-health-ispn-57, 26.7.3-postgres-health-ispn",
+        "26.7.3-postgres-health-ispn, 26.7.3-postgres-health-ispn 26.7.3-postgres-health-ispn-57,"
+                + " 26.7.3-postgres-health-ispn",
+        "node-24, node-24-57 node-24, node-24",
+        // An explicit tracking tag need not be pushed itself.
+        "latest, 57, latest",
+        "dev-latest, dev-57, dev-latest",
+    })
+    void resolvesTheTrackingTag(String trackingTag, String tags, String expected) throws Exception {
+        assertEquals(expected, resolve(trackingTag, tags));
+    }
+
+    @ParameterizedTest(name = "trackingTag={0} destinations=[{1}] is refused")
+    @CsvSource({
+        // No destination holds every other one in its build series.
+        ", 57 58",
+        ", latest dev-57",
+        ", dev-latest 57",
+        ", node-24 24",
+        ", 26.7.3-postgres-health-ispn 26.7.3-57",
+        // A destination outside the explicit tracking tag's series.
+        "latest, latest dev-57",
+        "dev-latest, dev-latest 57",
+        "26.7.3-postgres-health-ispn, 26.7.3-postgres-health-ispn 57",
+        "26.7.3-postgres-health-ispn, 26.7.3-postgres-health-ispn-rc1",
+        // A bare build number is never the tracking tag.
+        "57, 57",
+        ", 57 57-1",
+    })
+    void refusesTheDestinations(String trackingTag, String tags) {
+        assertThrows(IllegalArgumentException.class, () -> resolve(trackingTag, tags));
+    }
+}
