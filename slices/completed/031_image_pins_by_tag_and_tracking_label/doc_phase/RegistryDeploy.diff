+#!/usr/bin/env python3
+"""The gate: the chart renders registry-prd the way Argo CD renders it, and the
+registry-cleanup CronJob runs nightly in the mode the stage's dry-run setting names.
+
+The stage is templated under the Application's own name, into that namespace, with
+config/prd/values.yaml and the four `hook.*` helm parameters as `--set`. The library
+dependency is built from chart/Chart.lock, as the repo-server builds it.
+
+Run tests/build-deps.sh first; the render needs chart/charts/ populated.
+"""
+
+import pathlib
+import subprocess
+import sys
+
+import yaml
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+RELEASE = "registry-prd"
+STAGE_VALUES = REPO / "config" / "prd" / "values.yaml"
+HOOK = (
+    "hook.repo=https://github.com/pvginkel/RegistryDeploy.git,"
+    "hook.revision=0123456789abcdef0123456789abcdef01234567,"
+    f"hook.stage=prd,hook.namespace={RELEASE}"
+)
+CRONJOB = "registry-cleanup"
+SETTING = "registryCleanup.dryRun"
+GUARD = f"{SETTING} must be true or false"
+# registry-cleanup accepts exactly "true" or "false" here and exits 2 on anything else
+# (DockerImages registry-cleanup/app/main.py).
+DRY_RUN_ENV = "DRY_RUN"
+
+
+def check(condition, message):
+    if not condition:
+        sys.exit(f"FAIL: {message}")
+
+
+def template(*extra):
+    return subprocess.run(
+        ["helm", "template", RELEASE, "chart", "--namespace", RELEASE,
+         "--values", str(STAGE_VALUES), "--set", HOOK, *extra],
+        cwd=REPO, capture_output=True, text=True,
+    )
+
+
+def cronjob(*extra):
+    result = template(*extra)
+    check(result.returncode == 0, f"helm template {' '.join(extra)} failed:\n{result.stderr}")
+    docs = [d for d in yaml.safe_load_all(result.stdout) if d]
+    found = [d for d in docs if d["kind"] == "CronJob" and d["metadata"]["name"] == CRONJOB]
+    check(len(found) == 1, f"{len(found)} CronJobs named {CRONJOB}")
+    return found[0]
+
+
+def dry_run_env(job):
+    containers = job["spec"]["jobTemplate"]["spec"]["template"]["spec"]["containers"]
+    (container,) = [c for c in containers if c["name"] == CRONJOB]
+    values = [e["value"] for e in container["env"] if e["name"] == DRY_RUN_ENV]
+    check(len(values) == 1, f"{CRONJOB} sets {DRY_RUN_ENV} {len(values)} times")
+    return values[0]
+
+
+def main():
+    job = cronjob()
+    check(not job["spec"].get("suspend"), f"{CRONJOB} is suspended")
+    setting = yaml.safe_load(STAGE_VALUES.read_text())["registryCleanup"]["dryRun"]
+    check(dry_run_env(job) == str(setting).lower(),
+          f"{DRY_RUN_ENV} is {dry_run_env(job)!r}, the stage sets {SETTING}: {setting}")
+
+    for value in ("true", "false"):
+        rendered = dry_run_env(cronjob("--set", f"{SETTING}={value}"))
+        check(rendered == value, f"{SETTING}={value} renders {DRY_RUN_ENV} {rendered!r}")
+
+    for flag, value, what in (("--set", "null", "unset"), ("--set-string", "yes", "a string")):
+        result = template(flag, f"{SETTING}={value}")
+        check(result.returncode != 0 and GUARD in result.stderr,
+              f"a stage with {SETTING} {what} renders")
+
+    print("ok: registry-prd renders; registry-cleanup runs nightly with the stage's dry-run setting")
+
+
+if __name__ == "__main__":
+    main()
