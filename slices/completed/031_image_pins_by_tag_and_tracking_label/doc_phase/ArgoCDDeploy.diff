+def check_relay_pin(image):
+    """The relay runs the build its builds pin in the stage file, and no other."""
+    pin = yaml.safe_load((REPO / CONFIG).read_text()).get("relay", {}).get("image")
+    check(
+        isinstance(pin, str) and RELAY_PIN.fullmatch(pin) is not None,
+        f"{CONFIG} pins relay.image as {pin!r}, not the `:<build>` every relay build writes there",
+    )
+    check(
+        image == f"registry:5000/webhook-relay{pin}",
+        f"the relay runs {image!r}, not the build {CONFIG} pins at relay.image",
+    )
+    result = helm_template(RELEASE, "chart", CONFIG, overlay={"relay": {"image": None}})
+    check(
+        result.returncode != 0 and "relay.image" in result.stderr,
+        "chart/ renders a relay for a stage that pins no build instead of refusing on relay.image",
+    )
+
+
 def check_relay_secret(docs, materialised, entry):
