+"""The postgres-pas chart's backup script, driven with fake psql, pg_dump and
+urllib.request.urlopen.
+
+The script ships inline in the chart's postgres-backup-script ConfigMap and is
+loaded from there; nothing here reaches Postgres or the backup-server.
+"""
+
+import io
+import re
+import subprocess
+import types
+import urllib.parse
+import urllib.request
+from pathlib import Path
+
+import pytest
+import yaml
+
+CONFIGMAP = Path(__file__).resolve().parents[1] / "charts" / "postgres-pas" / "templates" / "backup-configmap.yaml"
+
+BACKUP_URL = "http://backup-server.storage-prd.svc.cluster.local:8080"
+DATABASES = ["app", "electronics_inventory", "keycloak", "postgres"]
+
+
+class Response(io.BytesIO):
+    def __init__(self, body, status):
+        super().__init__(body)
+        self.status = status
+
+
+@pytest.fixture
+def uploads(tmp_path, monkeypatch):
+    """Runs the script's main() over DATABASES; returns each upload's parsed query."""
+    lines = [line for line in CONFIGMAP.read_text().splitlines()
+             if not re.fullmatch(r"\{\{-? *(if .*|end) *-?\}\}", line.strip())]
+    source = yaml.safe_load("\n".join(lines))["data"]["backup.py"]
+
+    monkeypatch.setenv("BACKUP_URL", BACKUP_URL + "/")
+    monkeypatch.setenv("BACKUP_TOKEN", "upload-secret")
+    monkeypatch.setenv("EXCLUDE_DBS", "postgres,app")
+    script = types.ModuleType("backup")
+    exec(compile(source, str(CONFIGMAP), "exec"), script.__dict__)
+    script.WORKDIR = str(tmp_path)
+
+    def run(cmd, check, stdout=None, capture_output=False, text=False):
+        if cmd[0] == "psql":
+            return subprocess.CompletedProcess(cmd, 0, stdout="\n".join(DATABASES) + "\n")
+        stdout.write(b"PGDMP " + cmd[cmd.index("-d") + 1].encode())
+        return subprocess.CompletedProcess(cmd, 0)
+
+    queries = []
+
+    def urlopen(req):
+        url = urllib.parse.urlsplit(req.full_url)
+        assert (url.scheme, url.netloc, url.path) == ("http", "backup-server.storage-prd.svc.cluster.local:8080",
+                                                      "/upload")
+        assert req.get_header("Authorization") == "Bearer upload-secret"
+        queries.append(urllib.parse.parse_qs(url.query, strict_parsing=True))
+        return Response(b'{"object": "postgres-pas/x.age"}', status=201)
+
+    monkeypatch.setattr(subprocess, "run", run)
+    monkeypatch.setattr(urllib.request, "urlopen", urlopen)
+    script.main()
+    return queries
+
+
+def test_each_database_is_its_own_stream_declaring_52_hours(uploads):
+    # backup-server parses valid_for with Go's time.ParseDuration: "52h", not "2d".
+    assert uploads == [
+        {"filename": ["electronics_inventory.dump"], "valid_for": ["52h"]},
+        {"filename": ["keycloak.dump"], "valid_for": ["52h"]},
+    ]

