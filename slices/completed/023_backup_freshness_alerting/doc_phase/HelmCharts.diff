+def test_the_look_backs_equal_the_blind_grace(overdue, blind):
+    # A shorter look-back drops an overdue stream, or the blind alert's last
+    # sample, before the grace has run out; a longer one only holds a stream
+    # that left for good.
+    assert overdue.look_back == blind.look_back == blind.absent_look_back == blind.grace
+
