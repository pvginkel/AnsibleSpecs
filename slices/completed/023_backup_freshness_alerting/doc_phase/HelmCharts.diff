@@ -0,0 +1,64 @@
+"""The storage chart hands backup-server's metrics listener to Prometheus
+inside the cluster and to nothing else, and each storage release's
+manifests.yaml ships only objects the chart reads.
+
+Reads the storage chart's templates and the real dev and prd storage releases;
+writes nothing.
+"""
+
+import re
+from pathlib import Path
+
+import pytest
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+TEMPLATES = ROOT / "charts" / "storage" / "templates"
+RELEASES = [ROOT / "configs" / cluster / "storage" / "prd" for cluster in ("dev", "prd")]
+
+
+def render(template):
+    """The template with every branch of every if-block kept and each remaining
+    Helm expression left as HELM(<expr>)."""
+    kept = []
+    for line in (TEMPLATES / template).read_text().splitlines():
+        if re.fullmatch(r"\{\{-? *(if .*|else|end) *-?\}\}", line.strip()):
+            continue
+        kept.append(re.sub(r"\{\{-? *(.*?) *-?\}\}", r"HELM(\1)", line))
+    return yaml.safe_load("\n".join(kept))
+
+
+@pytest.fixture(scope="module")
+def service():
+    return render("backup-server-service.yaml")
+
+
+@pytest.fixture(scope="module")
+def container_ports():
+    deployment = render("backup-server-deployment.yaml")
+    (container,) = deployment["spec"]["template"]["spec"]["containers"]
+    return {port["name"]: port["containerPort"] for port in container["ports"]}
+
+
+def test_prometheus_scrapes_the_metrics_listener_through_the_service_annotations(service, container_ports):
+    # The stock kubernetes-service-endpoints job keeps a Service annotated
+    # scrape 'true' and rewrites each endpoint's port to the port annotation.
+    annotations = service["metadata"]["annotations"]
+    assert container_ports["metrics"] == 8081
+    assert annotations["prometheus.io/scrape"] == "true"
+    assert annotations["prometheus.io/path"] == "/metrics"
+    assert annotations["prometheus.io/port"] == str(container_ports["metrics"])
+
+
+def test_the_hostname_and_the_service_ports_reach_only_the_api_listener(service, container_ports):
+    assert service["metadata"]["annotations"]["nginx.webathome.org/target-port"] == str(container_ports["http"])
+    assert [port["targetPort"] for port in service["spec"]["ports"]] == [container_ports["http"]]
+
+
+@pytest.mark.parametrize("release", RELEASES, ids=lambda release: release.parts[-3])
+def test_a_storage_release_ships_only_objects_the_chart_reads(release):
+    templates = "\n".join(template.read_text() for template in TEMPLATES.glob("*.yaml"))
+    names = [doc["metadata"]["name"] for doc in yaml.safe_load_all((release / "manifests.yaml").read_text()) if doc]
+    assert names
+    for name in names:
+        assert re.search(rf"^\s*name: {re.escape(name)}$", templates, re.M), name

