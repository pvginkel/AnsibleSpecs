@@ -0,0 +1,294 @@
+"""The prd Prometheus release's backup freshness alerts, against the
+backup-server metrics they read and the postgres-pas dumps they watch.
+
+Reads the real prometheus values, the storage chart's backup-server Service
+template and the postgres-pas chart's values, CronJob and backup script;
+writes nothing. Each rule's expression is matched whole and its look-back and
+grace read out of it. Both rules are then evaluated minute by minute over
+simulated backup-server scrape histories: redeploys, failed cloud-storage
+reads, a target gone, a crash loop. The postgres-pas dumps are walked night by
+night across a year, so both DST changes fall inside the window.
+"""
+
+import re
+from bisect import bisect_right
+from dataclasses import dataclass
+from datetime import date, datetime, timedelta, timezone
+from pathlib import Path
+from zoneinfo import ZoneInfo
+
+import pytest
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+ALERTS = ROOT / "configs" / "prd" / "prometheus" / "prd" / "values.yaml"
+SERVICE = ROOT / "charts" / "storage" / "templates" / "backup-server-service.yaml"
+POSTGRES_CHART = ROOT / "charts" / "postgres-pas"
+POSTGRES_PRD_VALUES = ROOT / "configs" / "prd" / "postgres-pas" / "prd" / "values.yaml"
+
+# backup-server's series (DockerImages backup-server/src/internal/freshness/metrics.go),
+# as the kubernetes-service-endpoints job labels its prd target.
+SELECTOR = re.escape('{namespace="storage-prd",service="backup-server"}')
+VALID_UNTIL = rf"backup_server_stream_valid_until_timestamp_seconds{SELECTOR}"
+LAST_READ = rf"backup_server_refresh_last_success_timestamp_seconds{SELECTOR}"
+OVERDUE = (
+    rf"time\(\) - max by \(scope, filename\) \(\s+max_over_time\({VALID_UNTIL}\[(?P<look_back>\d+)h\]\)\s+\)"
+    r" > 0\s*"
+)
+BLIND = (
+    rf"time\(\) - max by \(namespace, service\) \(\s+max_over_time\({LAST_READ}\[(?P<look_back>\d+)h\]\)\s+\)"
+    rf" > (?P<grace>\d+) \* 3600\s+or\s+absent_over_time\({LAST_READ}\[(?P<absent_look_back>\d+)h\]\)\s*"
+)
+
+MINUTE = 60
+HOUR = 60 * MINUTE
+DAY = 24 * HOUR
+# The prometheus chart's global scrape_interval and evaluation_interval; the
+# release sets neither. Scrapes, evaluations and backup-server's whole-second
+# read times never coincide in the real system, so here each keeps its own
+# second past the minute.
+SCRAPE_AT, EVAL_AT = 20, 40
+# backup-server's full read of its cloud storage: at start and hourly after,
+# each bounded by a timeout (DockerImages backup-server/src/internal/freshness/watcher.go).
+READ_INTERVAL = HOUR
+READ_TIMEOUT = 10 * MINUTE
+# The Deployment is Recreate: the old pod is gone before the new one starts.
+REDEPLOY_GAP = 30 * MINUTE
+T0 = int(datetime(2026, 9, 18, tzinfo=timezone.utc).timestamp())
+
+# The postgres-backup CronJob sets no timeZone, so its schedule is in the
+# nodes' zone: the Ansible baseline role's baseline_timezone.
+NODE_ZONE = ZoneInfo("Europe/Amsterdam")
+# The CronJob sets no activeDeadlineSeconds. Its runs, every database dumped
+# and uploaded in turn, finished within 2 minutes on 2026-09-16..18.
+RUN_BOUND = timedelta(hours=1)
+# From an upload to the alert seeing its validity: the post-upload read of the
+# scope, the scrape and rule evaluation intervals, and slack.
+LAG = timedelta(minutes=5)
+NIGHTS = [date(2026, 9, 1) + timedelta(days=n) for n in range(400)]
+
+
+def ticks(start, end, at):
+    first = start - start % MINUTE + at
+    return range(first if first >= start else first + MINUTE, end, MINUTE)
+
+
+def evals(start, end):
+    return ticks(start, end, EVAL_AT)
+
+
+def always_slow(read):
+    return READ_TIMEOUT
+
+
+@dataclass(frozen=True)
+class Pod:
+    """One backup-server process, scraped each minute from a minute after `up`
+    until `down`. Its full reads start at `up` and hourly after; read k
+    succeeds took(k) after its start unless k is in `failed`."""
+
+    up: int
+    down: int
+    failed: range = range(0)
+    took: object = always_slow
+
+    def reads(self):
+        starts = range(self.up, self.down, READ_INTERVAL)
+        done = [(k, start + self.took(k)) for k, start in enumerate(starts) if k not in self.failed]
+        return [at for k, at in done if at < self.down]
+
+    def scrapes(self):
+        return ticks(self.up + MINUTE, self.down, SCRAPE_AT)
+
+    def last_read(self):
+        """Its refresh_last_success: 0 until its first successful read."""
+        reads = self.reads()
+        return [(t, reads[bisect_right(reads, t) - 1] if bisect_right(reads, t) else 0) for t in self.scrapes()]
+
+    def stream(self, valid_until):
+        """One stream's valid-until, published from its first successful read
+        on while valid_until(t) is not None."""
+        first = self.reads()[:1]
+        return [(t, valid_until(t)) for t in self.scrapes() if first and first[0] <= t and valid_until(t) is not None]
+
+
+class Series:
+    """One metric's samples from every pod, merged: each rule aggregates across
+    pods, so a redeploy's new instance label changes nothing."""
+
+    def __init__(self, *pods):
+        self.samples = sorted(sample for pod in pods for sample in pod)
+        self.times = [t for t, _ in self.samples]
+
+    def max_over_time(self, t, look_back):
+        """None when the range (t - look_back, t] holds no sample."""
+        lo, hi = bisect_right(self.times, t - look_back), bisect_right(self.times, t)
+        return max((v for _, v in self.samples[lo:hi]), default=None)
+
+
+@pytest.fixture(scope="module")
+def rules():
+    groups = yaml.safe_load(ALERTS.read_text())["serverFiles"]["alerting_rules.yml"]["groups"]
+    (group,) = [g for g in groups if g["name"] == "backup-freshness"]
+    return {r["alert"]: r for r in group["rules"]}
+
+
+@pytest.fixture(scope="module")
+def overdue(rules):
+    terms = re.fullmatch(OVERDUE, rules["BackupOverdue"]["expr"])
+    assert terms, rules["BackupOverdue"]["expr"]
+    look_back = int(terms["look_back"]) * HOUR
+
+    def _fires(stream, t):
+        newest = stream.max_over_time(t, look_back)
+        return newest is not None and t - newest > 0
+
+    _fires.look_back = look_back
+    return _fires
+
+
+@pytest.fixture(scope="module")
+def blind(rules):
+    terms = re.fullmatch(BLIND, rules["BackupWatcherBlind"]["expr"])
+    assert terms, rules["BackupWatcherBlind"]["expr"]
+    look_back, grace = int(terms["look_back"]) * HOUR, int(terms["grace"]) * HOUR
+    absent_look_back = int(terms["absent_look_back"]) * HOUR
+
+    def _fires(last_read, t):
+        newest = last_read.max_over_time(t, look_back)
+        return (newest is not None and t - newest > grace) or last_read.max_over_time(t, absent_look_back) is None
+
+    _fires.look_back, _fires.grace, _fires.absent_look_back = look_back, grace, absent_look_back
+    return _fires
+
