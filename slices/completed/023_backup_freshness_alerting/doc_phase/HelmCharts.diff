+def test_a_healthy_watcher_is_never_blind(blind):
+    def alternating(read):
+        return READ_TIMEOUT if read % 2 else 0
+
+    def slow_after_the_failures(read):
+        return READ_TIMEOUT if read >= 28 else 0
+
+    healthy = Pod(T0 - DAY, T0 + 3 * DAY, took=alternating)
+    four_failed = Pod(T0 - DAY, T0 + 3 * DAY, failed=range(24, 28), took=slow_after_the_failures)
+    for pod in (healthy, four_failed):
+        last_read = Series(pod.last_read())
+        assert not any(blind(last_read, t) for t in evals(T0, T0 + 2 * DAY))
+
+    for phase in range(0, READ_INTERVAL, 5 * MINUTE):
+        redeploy = T0 + phase
+        old = Pod(T0 - DAY, redeploy, took=lambda read: 0)
+        new = Pod(redeploy + REDEPLOY_GAP, T0 + 2 * DAY, failed=range(3))
+        last_read = Series(old.last_read(), new.last_read())
+        assert not any(blind(last_read, t) for t in evals(T0, T0 + DAY)), phase
+
+
+def test_a_blind_watcher_fires_once_its_newest_read_is_past_the_grace_and_holds(blind):
+    blinded = T0 + 30 * MINUTE
+    healthy_until_blinded = Pod(T0 - DAY, blinded)
+    reads = healthy_until_blinded.reads()
+    storage_unreadable = [Pod(T0 - DAY, T0 + 2 * DAY, failed=range(len(reads), 10**6))]
+    target_gone = [healthy_until_blinded]
+    # Each pod dies before its first read completes, and restarts after a 5 m back-off.
+    crash_loop = [healthy_until_blinded] + [Pod(up, up + 3 * MINUTE) for up in range(blinded, T0 + DAY, 8 * MINUTE)]
+    for pods in (storage_unreadable, target_gone, crash_loop):
+        last_read = Series(*(pod.last_read() for pod in pods))
+        assert not any(blind(last_read, t) for t in evals(T0, reads[-1] + blind.grace))
+        assert all(blind(last_read, t) for t in evals(reads[-1] + blind.grace, T0 + 2 * DAY))
+
+
+def test_an_overdue_stream_fires_once_its_validity_passes_and_clears_when_a_backup_lands(overdue):
+    passed, landed, pruned = T0 + 6 * HOUR, T0 + 20 * HOUR, T0 + 40 * HOUR
+    pod = Pod(T0 - DAY, T0 + 3 * DAY)
+
+    def valid_until(t):
+        return passed if t < landed else landed + 52 * HOUR
+
+    stream = Series(pod.stream(valid_until))
+    assert not any(overdue(stream, t) for t in evals(T0, passed))
+    assert all(overdue(stream, t) for t in evals(passed, landed))
+    assert not any(overdue(stream, t) for t in evals(landed + MINUTE, T0 + 2 * DAY))
+
+    # A stream that leaves for good (its backups pruned, or its metadata
+    # deleted) clears once its last sample leaves the look-back.
+    stream = Series(pod.stream(lambda t: passed if t < pruned else None))
+    assert all(overdue(stream, t) for t in evals(passed, pruned + overdue.look_back - MINUTE))
+    assert not any(overdue(stream, t) for t in evals(pruned + overdue.look_back, T0 + 3 * DAY))
+
+
+def test_an_overdue_stream_stays_alerting_while_the_watcher_goes_blind(overdue, blind):
+    passed = T0 - 12 * HOUR
+    for phase in range(0, READ_INTERVAL, 5 * MINUTE):
+        blinded = T0 + phase
+        old = Pod(T0 - 2 * DAY, blinded)
+        # A redeploy whose reads all fail, so the new pod publishes no stream;
+        # or no new pod at all.
+        new = Pod(blinded + REDEPLOY_GAP, T0 + 2 * DAY, failed=range(10**6))
+        for pods in ([old, new], [old]):
+            stream = Series(*(pod.stream(lambda t: passed) for pod in pods))
+            last_read = Series(*(pod.last_read() for pod in pods))
+            for t in evals(passed + MINUTE, T0 + DAY):
+                assert overdue(stream, t) or blind(last_read, t), (phase, len(pods), t - blinded)
+
