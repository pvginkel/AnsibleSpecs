+package pipeline
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+)
+
+// stubRclone puts an rclone first on PATH that writes stdout and stderr and
+// exits with code.
+func stubRclone(t *testing.T, stdout, stderr string, code int) {
+	t.Helper()
+	dir := t.TempDir()
+	for name, content := range map[string]string{"stdout": stdout, "stderr": stderr} {
+		if err := os.WriteFile(filepath.Join(dir, name), []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	script := fmt.Sprintf("#!/bin/sh\ncat '%[1]s/stdout'\ncat '%[1]s/stderr' >&2\nexit %[2]d\n", dir, code)
+	if err := os.WriteFile(filepath.Join(dir, "rclone"), []byte(script), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+}
+
+func TestRcloneListing(t *testing.T) {
+	stubRclone(t, `[{"Name":"openbao","IsDir":true},{"Name":"x.age","IsDir":false}]`, "", 0)
+	b := NewRcloneBackend("")
+	dirs, err := b.ListDirs(context.Background(), "remote:")
+	if err != nil || !slices.Equal(dirs, []string{"openbao"}) {
+		t.Errorf("ListDirs = %v, %v; want [openbao]", dirs, err)
+	}
+	files, err := b.List(context.Background(), "remote:")
+	if err != nil || !slices.Equal(files, []string{"x.age"}) {
+		t.Errorf("List = %v, %v; want [x.age]", files, err)
+	}
+}
+
+// Only rclone's directory-not-found exit code means a listing is empty, and
+// only to List: a failure whose text happens to say "not found" or "no such"
+// is still a failure.
+func TestRcloneListingFailures(t *testing.T) {
+	cases := []struct {
+		name         string
+		stderr       string
+		code         int
+		listEmpty    bool
+		listDirsFail bool
+	}{
+		{"dns", `Failed to lsjson: couldn't list directory: dial tcp: lookup www.googleapis.com on 10.152.183.10:53: no such host`, 1, false, true},
+		{"no config", `NOTICE: Config file "/data/rclone.conf" not found - using defaults
+CRITICAL: Failed to create file system for "gdrive-pieter:Homelab Backups": didn't find section in config file ("gdrive-pieter")`, 1, false, true},
+		{"drive 404", `Failed to lsjson: googleapi: Error 404: File not found: 1AbC., notFound`, 1, false, true},
+		{"directory not found", `ERROR : error listing: directory not found
+NOTICE: Failed to lsjson with 2 errors: last error was: error in ListJSON: directory not found`, 3, true, true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			stubRclone(t, "", tc.stderr, tc.code)
+			b := NewRcloneBackend("")
+			names, err := b.List(context.Background(), "remote:scope")
+			if tc.listEmpty {
+				if err != nil || names != nil {
+					t.Errorf("List = %v, %v; want empty and no error", names, err)
+				}
+			} else if err == nil {
+				t.Errorf("List = %v, nil; want an error", names)
+			}
+			if names, err := b.ListDirs(context.Background(), "remote:"); err == nil {
+				t.Errorf("ListDirs = %v, nil; want an error", names)
+			}
+		})
+	}
+}
