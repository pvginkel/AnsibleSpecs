+package pipeline
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// MetadataSuffix marks a backup's metadata file, stored beside the backup as
+// "<backup object name>.metadata.json". Backup object names end in ".age", so
+// no backup name carries this suffix.
+const MetadataSuffix = ".metadata.json"
+
+var ErrValidityInvalid = errors.New("valid_for must be a positive duration such as 52h")
+
+// Metadata is the content of a backup's metadata file. Metadata files are
+// plain JSON, not age-encrypted, so a holder of only the public key can read
+// them.
+type Metadata struct {
+	ValidFor string `json:"valid_for"`
+}
+
+func ValidateValidity(s string) error {
+	d, err := time.ParseDuration(s)
+	if err != nil || d <= 0 {
+		return ErrValidityInvalid
+	}
+	return nil
+}
+
+func MetadataName(objname string) string {
+	return objname + MetadataSuffix
+}
+
+func IsMetadataName(name string) bool {
+	return strings.HasSuffix(name, MetadataSuffix)
+}
+
+func WriteMetadata(ctx context.Context, backend Backend, target string, meta Metadata) error {
+	data, err := json.Marshal(meta)
+	if err != nil {
+		return fmt.Errorf("encode metadata: %w", err)
+	}
+	return backend.Upload(ctx, target, bytes.NewReader(data))
+}
