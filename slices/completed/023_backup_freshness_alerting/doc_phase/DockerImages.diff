+type fakeStorage struct {
+	mu       sync.Mutex
+	objects  map[string][]byte
+	failDirs error
+	failList map[string]error
+	listDirs int
+	lists    map[string]int
+	reads    []string
+}
+
+func newFakeStorage() *fakeStorage {
+	return &fakeStorage{
+		objects:  map[string][]byte{},
+		failList: map[string]error{},
+		lists:    map[string]int{},
+	}
+}
+
+func (f *fakeStorage) ListDirs(_ context.Context, dir string) ([]string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.listDirs++
+	if f.failDirs != nil {
+		return nil, f.failDirs
+	}
+	prefix := dir + "/"
+	seen := map[string]bool{}
+	var dirs []string
+	for k := range f.objects {
+		rest, ok := strings.CutPrefix(k, prefix)
+		if !ok {
+			continue
+		}
+		if d, _, nested := strings.Cut(rest, "/"); nested && !seen[d] {
+			seen[d] = true
+			dirs = append(dirs, d)
+		}
+	}
+	return dirs, nil
+}
+
+func (f *fakeStorage) List(_ context.Context, dir string) ([]string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.lists[dir]++
+	if err := f.failList[dir]; err != nil {
+		return nil, err
+	}
+	prefix := dir + "/"
+	var names []string
+	for k := range f.objects {
+		if rest, ok := strings.CutPrefix(k, prefix); ok && !strings.Contains(rest, "/") {
+			names = append(names, rest)
+		}
+	}
+	return names, nil
+}
+
+func (f *fakeStorage) Read(_ context.Context, target string) ([]byte, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.reads = append(f.reads, target)
+	data, ok := f.objects[target]
+	if !ok {
+		return nil, fmt.Errorf("%s: %w", target, pipeline.ErrNotFound)
+	}
+	return data, nil
+}
+
+// backup stores a backup of filename received at `at`, with a metadata file
+// declaring validFor unless validFor is empty.
+func (f *fakeStorage) backup(scope, filename string, at time.Time, validFor string) string {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	objname := pipeline.ObjectName(at, filename)
+	f.objects[pipeline.JoinTarget(remote, scope, objname)] = []byte("age-encrypted")
+	if validFor != "" {
+		f.objects[pipeline.JoinTarget(remote, scope, pipeline.MetadataName(objname))] = []byte(`{"valid_for":"` + validFor + `"}`)
+	}
+	return objname
+}
+
+func (f *fakeStorage) put(target string, data []byte) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.objects[target] = data
+}
+
+func (f *fakeStorage) remove(prefix string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	for k := range f.objects {
+		if strings.HasPrefix(k, prefix) {
+			delete(f.objects, k)
+		}
+	}
+}
+
+func (f *fakeStorage) counts() (listDirs int, lists map[string]int, reads []string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	lists = map[string]int{}
+	for k, v := range f.lists {
+		lists[k] = v
+	}
+	return f.listDirs, lists, append([]string(nil), f.reads...)
+}
