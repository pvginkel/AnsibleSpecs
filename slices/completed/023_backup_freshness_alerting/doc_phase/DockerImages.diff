+	listDirs, lists, reads3 := s.counts()
+	want := []string{pipeline.JoinTarget(remote, "postgres-pas", pipeline.MetadataName(objname))}
+	if got := reads3[len(reads2):]; !reflect.DeepEqual(got, want) {
+		t.Errorf("scope refresh read %v, want %v", got, want)
