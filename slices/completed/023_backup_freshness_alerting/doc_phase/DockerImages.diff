diff --git a/backup-server/src/internal/freshness/metrics.go b/backup-server/src/internal/freshness/metrics.go
new file mode 100644
index 0000000..9df314e
--- /dev/null
+++ b/backup-server/src/internal/freshness/metrics.go
@@ -0,0 +1,65 @@
+package freshness
+
+import (
+	"net/http"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/prometheus/client_golang/prometheus/promhttp"
+)
+
+var (
+	lastBackupDesc = prometheus.NewDesc(
+		"backup_server_stream_last_backup_timestamp_seconds",
+		"Unix time the stream's newest kept backup was received, from its object name.",
+		[]string{"scope", "filename"}, nil)
+	validUntilDesc = prometheus.NewDesc(
+		"backup_server_stream_valid_until_timestamp_seconds",
+		"Unix time the stream stops being valid: its newest backup's receipt plus the validity declared by its newest declaring backup.",
+		[]string{"scope", "filename"}, nil)
+	lastRefreshDesc = prometheus.NewDesc(
+		"backup_server_refresh_last_success_timestamp_seconds",
+		"Unix time of the last refresh that read every folder under the remote without error; 0 before the first.",
+		nil, nil)
+	startDesc = prometheus.NewDesc(
+		"backup_server_start_time_seconds",
+		"Unix time the server started.",
+		nil, nil)
+)
+
+// MetricsHandler serves GET /metrics from the values the last refreshes
+// read; a scrape never reads the remote.
+func (w *Watcher) MetricsHandler() http.Handler {
+	reg := prometheus.NewRegistry()
+	reg.MustRegister(collector{w})
+	mux := http.NewServeMux()
+	mux.Handle("GET /metrics", promhttp.HandlerFor(reg, promhttp.HandlerOpts{}))
+	return mux
+}
+
+type collector struct{ w *Watcher }
+
+func (c collector) Describe(ch chan<- *prometheus.Desc) {
+	ch <- lastBackupDesc
+	ch <- validUntilDesc
+	ch <- lastRefreshDesc
+	ch <- startDesc
+}
+
+func (c collector) Collect(ch chan<- prometheus.Metric) {
+	streams, lastSuccess := c.w.snapshot()
+	for _, s := range streams {
+		ch <- prometheus.MustNewConstMetric(lastBackupDesc, prometheus.GaugeValue, unixSeconds(s.LastBackup), s.Scope, s.Filename)
+		ch <- prometheus.MustNewConstMetric(validUntilDesc, prometheus.GaugeValue, unixSeconds(s.ValidUntil), s.Scope, s.Filename)
+	}
+	last := 0.0
+	if !lastSuccess.IsZero() {
+		last = unixSeconds(lastSuccess)
+	}
+	ch <- prometheus.MustNewConstMetric(lastRefreshDesc, prometheus.GaugeValue, last)
+	ch <- prometheus.MustNewConstMetric(startDesc, prometheus.GaugeValue, unixSeconds(c.w.started))
+}
+
+func unixSeconds(t time.Time) float64 {
+	return float64(t.Unix())
+}
diff --git a/backup-server/src/internal/freshness/watcher.go b/backup-server/src/internal/freshness/watcher.go
new file mode 100644
index 0000000..e9bc180
--- /dev/null
+++ b/backup-server/src/internal/freshness/watcher.go
@@ -0,0 +1,248 @@
+// Package freshness reads back from the backup remote when each stream's
+// newest backup was received and until when the stream is valid, and serves
+// both as Prometheus metrics. A stream is a scope plus a file name.
+package freshness
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log"
+	"sort"
+	"sync"
+	"time"
+
+	"backup-server/internal/pipeline"
+)
+
+const (
+	RefreshInterval = time.Hour
+	refreshTimeout  = 10 * time.Minute
+)
+
+// Storage is the read side of the backup remote.
+type Storage interface {
+	ListDirs(ctx context.Context, dir string) ([]string, error)
+	List(ctx context.Context, dir string) ([]string, error)
+	Read(ctx context.Context, target string) ([]byte, error)
+}
+
+// Stream is a scope + file name with at least one kept backup that declares
+// a validity.
+type Stream struct {
+	Scope    string
+	Filename string
+	// LastBackup is when the stream's newest backup was received.
+	LastBackup time.Time
+	// ValidUntil is LastBackup plus the validity declared by the stream's
+	// newest declaring backup.
+	ValidUntil time.Time
+}
+
+type Watcher struct {
+	storage Storage
+	remote  string
+	now     func() time.Time
+	started time.Time
+
+	// refreshing serializes refreshes; validities is touched only under it.
+	refreshing sync.Mutex
+	// validities holds, per scope, the validity each stream's newest
+	// declaring metadata file declares. A metadata file never changes once
+	// written, so one held here is not read again.
+	validities map[string]map[string]time.Duration
+
+	// mu guards streams and lastSuccess, which only refreshes write.
+	mu          sync.Mutex
+	streams     map[string][]Stream
+	lastSuccess time.Time
+}
+
+func New(storage Storage, remote string) *Watcher {
+	return &Watcher{
+		storage:    storage,
+		remote:     remote,
+		now:        time.Now,
+		started:    time.Now(),
+		validities: map[string]map[string]time.Duration{},
+		streams:    map[string][]Stream{},
+	}
+}
+
+// Run refreshes at once and then every interval until ctx is done.
+func (w *Watcher) Run(ctx context.Context, interval time.Duration) {
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+	for {
+		if err := w.Refresh(ctx); err != nil {
+			log.Printf("freshness refresh: %v", err)
+		}
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
+
+// Refresh reads every folder directly under the remote. A folder that is
+// gone drops out; one whose read fails keeps the streams last read for it,
+// and the refresh does not count as a success.
+func (w *Watcher) Refresh(ctx context.Context) error {
+	w.refreshing.Lock()
+	defer w.refreshing.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, refreshTimeout)
+	defer cancel()
+
+	scopes, err := w.storage.ListDirs(ctx, w.remote)
+	if err != nil {
+		return fmt.Errorf("list %s: %w", w.remote, err)
+	}
+
+	var errs []error
+	streams := make(map[string][]Stream, len(scopes))
+	validities := make(map[string]map[string]time.Duration, len(scopes))
+	for _, scope := range scopes {
+		found, read, err := w.scan(ctx, scope)
+		if err != nil {
+			errs = append(errs, fmt.Errorf("scope %s: %w", scope, err))
+			found, read = w.streams[scope], w.validities[scope]
+		}
+		if len(found) > 0 {
+			streams[scope] = found
+		}
+		if len(read) > 0 {
+			validities[scope] = read
+		}
+	}
+
+	w.validities = validities
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.streams = streams
+	if len(errs) == 0 {
+		w.lastSuccess = w.now()
+	}
+	return errors.Join(errs...)
+}
+
+// RefreshScope re-reads one scope folder. On failure the scope keeps the
+// streams last read for it.
+func (w *Watcher) RefreshScope(ctx context.Context, scope string) error {
+	w.refreshing.Lock()
+	defer w.refreshing.Unlock()
+	ctx, cancel := context.WithTimeout(ctx, refreshTimeout)
+	defer cancel()
+
+	found, read, err := w.scan(ctx, scope)
+	if err != nil {
+		return fmt.Errorf("scope %s: %w", scope, err)
+	}
+
+	if len(read) > 0 {
+		w.validities[scope] = read
+	} else {
+		delete(w.validities, scope)
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if len(found) > 0 {
+		w.streams[scope] = found
+	} else {
+		delete(w.streams, scope)
+	}
+	return nil
+}
+
+// scan lists one scope folder once. Of the metadata files there, it reads
+// only each stream's newest declaring one, and only if w.validities does not
+// hold it yet. It returns the scope's watched streams and the validities they
+// rest on.
+func (w *Watcher) scan(ctx context.Context, scope string) ([]Stream, map[string]time.Duration, error) {
+	names, err := w.storage.List(ctx, pipeline.ScopeDir(w.remote, scope))
+	if err != nil {
+		return nil, nil, fmt.Errorf("list: %w", err)
+	}
+	present := make(map[string]bool, len(names))
+	for _, name := range names {
+		present[name] = true
+	}
+
+	type newest struct {
+		backup      time.Time
+		declaring   string
+		declaringAt time.Time
+	}
+	byFilename := map[string]*newest{}
+	for _, name := range names {
+		if pipeline.IsMetadataName(name) {
+			continue
+		}
+		received, filename, ok := pipeline.ParseObjectName(name)
+		if !ok {
+			continue
+		}
+		n := byFilename[filename]
+		if n == nil {
+			n = &newest{}
+			byFilename[filename] = n
+		}
+		if received.After(n.backup) {
+			n.backup = received
+		}
+		if present[pipeline.MetadataName(name)] && received.After(n.declaringAt) {
+			n.declaring, n.declaringAt = name, received
+		}
+	}
+
+	known := w.validities[scope]
+	read := map[string]time.Duration{}
+	var streams []Stream
+	for filename, n := range byFilename {
+		if n.declaring == "" {
+			continue
+		}
+		metaName := pipeline.MetadataName(n.declaring)
+		validity, ok := known[metaName]
+		if !ok {
+			target := pipeline.JoinTarget(w.remote, scope, metaName)
+			data, err := w.storage.Read(ctx, target)
+			if err != nil {
+				return nil, nil, fmt.Errorf("read %s: %w", target, err)
+			}
+			if validity, err = pipeline.DecodeValidity(data); err != nil {
+				return nil, nil, fmt.Errorf("%s: %w", target, err)
+			}
+		}
+		read[metaName] = validity
+		streams = append(streams, Stream{
+			Scope:      scope,
+			Filename:   filename,
+			LastBackup: n.backup,
+			ValidUntil: n.backup.Add(validity),
+		})
+	}
+	return streams, read, nil
+}
+
+// Streams returns every watched stream, ordered by scope and file name.
+func (w *Watcher) Streams() []Stream {
+	streams, _ := w.snapshot()
+	return streams
+}
+
+func (w *Watcher) snapshot() ([]Stream, time.Time) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	var streams []Stream
+	for _, s := range w.streams {
+		streams = append(streams, s...)
+	}
+	sort.Slice(streams, func(i, j int) bool {
+		if streams[i].Scope != streams[j].Scope {
+			return streams[i].Scope < streams[j].Scope
+		}
+		return streams[i].Filename < streams[j].Filename
+	})
+	return streams, w.lastSuccess
+}
