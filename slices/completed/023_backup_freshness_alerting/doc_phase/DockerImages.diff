+func TestMetrics(t *testing.T) {
+	s := newFakeStorage()
+	s.backup("openbao", "openbao-backup.tgz", dayN(1), "52h")
+	w := newWatcher(s)
+	h := w.MetricsHandler()
+
+	// Before the first refresh: no streams, and no read has succeeded.
+	want := map[string]float64{
+		"backup_server_refresh_last_success_timestamp_seconds": 0,
+		"backup_server_start_time_seconds":                     float64(w.started.Unix()),
+	}
+	if got := scrape(t, h); !reflect.DeepEqual(got, want) {
+		t.Errorf("before refresh:\n got  %v\n want %v", got, want)
+	}
+
+	// Refreshed on day 10, the stream's valid-until is long past: overdue.
+	refresh(t, w)
