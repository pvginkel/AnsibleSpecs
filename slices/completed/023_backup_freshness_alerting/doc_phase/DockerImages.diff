+	s.put(remote+"/s3-mirror/Q2ZhbmN5IGNyeXB0IG5hbWU", []byte("x"))
+
+	w := newWatcher(s)
+	refresh(t, w)
+	listDirs, lists, reads := s.counts()
+	// A server that has just started reads one metadata file per stream, not
+	// every kept one.
+	if listDirs != 1 || len(reads) != 10 {
+		t.Errorf("first refresh: %d root listings, %d reads; want 1, 10", listDirs, len(reads))
+	}
+	for _, scope := range []string{"openbao", "postgres-pas", "s3-mirror"} {
+		if n := lists[pipeline.ScopeDir(remote, scope)]; n != 1 {
+			t.Errorf("first refresh listed %s %d times, want 1", scope, n)
+		}
+	}
+
+	refresh(t, w)
+	_, lists, reads2 := s.counts()
+	if len(reads2) != len(reads) {
+		t.Errorf("second refresh read again: %v", reads2[len(reads):])
+	}
+	if n := lists[pipeline.ScopeDir(remote, "postgres-pas")]; n != 2 {
+		t.Errorf("after two refreshes postgres-pas listed %d times, want 2", n)
+	}
+
+	// An upload's refresh lists its scope once and reads only the new file.
+	objname := s.backup("postgres-pas", "db4.dump", dayN(4), "52h")
+	if err := w.RefreshScope(context.Background(), "postgres-pas"); err != nil {
+		t.Fatalf("refresh scope: %v", err)
