+package pipeline
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestValidateValidity(t *testing.T) {
+	cases := []struct {
+		in   string
+		want error
+	}{
+		{"52h", nil},
+		{"1h30m", nil},
+		{"90s", nil},
+		{"", ErrValidityInvalid},
+		{"0", ErrValidityInvalid},
+		{"0s", ErrValidityInvalid},
+		{"-52h", ErrValidityInvalid},
+		{"52", ErrValidityInvalid},
+		{"2d", ErrValidityInvalid},
+		{"soon", ErrValidityInvalid},
+	}
+	for _, tc := range cases {
+		t.Run(tc.in, func(t *testing.T) {
+			if err := ValidateValidity(tc.in); !errors.Is(err, tc.want) {
+				t.Errorf("got %v, want %v", err, tc.want)
+			}
+		})
+	}
+}
+
+func TestMetadataName(t *testing.T) {
+	obj := ObjectName(time.Date(2026, 5, 7, 14, 15, 2, 0, time.UTC), "backup.zip")
+	got := MetadataName(obj)
+	if want := "20260507T141502Z_backup.zip.age.metadata.json"; got != want {
+		t.Errorf("got %q want %q", got, want)
+	}
+	if !IsMetadataName(got) {
+		t.Errorf("IsMetadataName(%q) = false", got)
+	}
+	if IsMetadataName(obj) {
+		t.Errorf("IsMetadataName(%q) = true", obj)
+	}
+	// A filename that itself ends in the suffix still yields a backup name.
+	if tricky := ObjectName(time.Now(), "x.metadata.json"); IsMetadataName(tricky) {
+		t.Errorf("IsMetadataName(%q) = true", tricky)
+	}
+}
+
+func TestWriteMetadata(t *testing.T) {
+	b := newFakePruneBackend()
+	target := "remote:scope/20260507T141502Z_backup.zip.age.metadata.json"
+	if err := WriteMetadata(context.Background(), b, target, Metadata{ValidFor: "52h"}); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	if got, want := string(b.objects[target]), `{"valid_for":"52h"}`; got != want {
+		t.Errorf("got %s want %s", got, want)
+	}
+}
