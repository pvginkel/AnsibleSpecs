+# --- the diagnosis of a failed or stalled roll ------------------------------------------------
+
+HOOKS = "argocd-hooks"
+HOOK_JOBS = f"apis/batch/v1/namespaces/{HOOKS}/jobs"
+HOOK_PODS = f"api/v1/namespaces/{HOOKS}/pods"
+NS = "kubecoder-dev"
+DEPLOYMENTS = f"apis/apps/v1/namespaces/{NS}/deployments"
+PODS = f"api/v1/namespaces/{NS}/pods"
+EVENTS = f"api/v1/namespaces/{NS}/events"
+
+
+def hook_job(app, sha, uid, *, condition):
+    """The PreSync hook Job the argocd-hook chart creates for ``app`` at ``sha``."""
+    return {
+        "metadata": {
+            "name": f"tf-presync-{app}",
+            "namespace": HOOKS,
+            "creationTimestamp": "2026-09-27T07:38:29Z",
+            "labels": {"batch.kubernetes.io/controller-uid": uid, "job-name": f"tf-presync-{app}"},
+        },
+        "spec": {
+            "selector": {"matchLabels": {"batch.kubernetes.io/controller-uid": uid}},
+            "template": {
+                "spec": {
+                    "containers": [
+                        {
+                            "name": "terraform",
+                            "image": "registry:5000/argocd-hook:10",
+                            "args": [_url("KubeCoderDeploy"), sha, "dev", app],
+                        }
+                    ]
+                }
+            },
+        },
+        "status": {"conditions": [condition]},
+    }
+
+
+FAILED_JOB = {
+    "type": "Failed",
+    "status": "True",
+    "reason": "BackoffLimitExceeded",
+    "message": "Job has reached the specified backoff limit",
+}
+
+
+def hook_pod(app, uid, suffix, state):
+    return {
+        "metadata": {
+            "name": f"tf-presync-{app}-{suffix}",
+            "namespace": HOOKS,
+            "creationTimestamp": "2026-09-27T07:38:29Z",
+            "labels": {"batch.kubernetes.io/controller-uid": uid, "job-name": f"tf-presync-{app}"},
+        },
+        "spec": {"containers": [{"name": "terraform"}]},
+        "status": {
+            "phase": "Failed" if "terminated" in state else "Pending",
+            "containerStatuses": [
+                {"name": "terraform", "ready": False, "restartCount": 0, "state": state}
+            ],
+        },
+    }
+
+
+def deployment(name, *, replicas=1, updated=1, available=1, generation=2, observed=2, **status):
+    return {
+        "metadata": {"name": name, "namespace": NS, "generation": generation},
+        "spec": {"replicas": replicas},
+        "status": {
+            "observedGeneration": observed,
+            "replicas": replicas,
+            "updatedReplicas": updated,
+            "availableReplicas": available,
+            **status,
+        },
+    }
+
+
+def pod_of(deployment_name, template_hash, suffix, **status):
+    replica_set = f"{deployment_name}-{template_hash}"
+    return {
+        "metadata": {
+            "name": f"{replica_set}-{suffix}",
+            "namespace": NS,
+            "labels": {"pod-template-hash": template_hash},
+            "ownerReferences": [{"kind": "ReplicaSet", "name": replica_set, "controller": True}],
+        },
+        "status": {"phase": "Running", **status},
+    }
+
+
+def warning(kind, name, reason, message, count=1):
+    return {
+        "metadata": {"name": f"{name}.18a2b3c4d5e6f7a8", "namespace": NS},
+        "involvedObject": {"kind": kind, "name": name, "namespace": NS},
+        "reason": reason,
+        "message": message,
+        "count": count,
+        "lastTimestamp": "2026-09-27T09:10:03Z",
+        "type": "Warning",
+    }
+
+
+def entry(group, kind, name, namespace=NS, **extra):
+    """A ``status.resources[]`` entry, as Argo CD v3.5 writes it: no health field."""
+    fields = {
+        "kind": kind,
+        "name": name,
+        "namespace": namespace,
+        "status": "Synced",
+        "version": "v1",
+    }
+    if group:
+        fields["group"] = group
+    return {**fields, **extra}
+
+
+def sections(text) -> dict[str, list[str]]:
+    parts = re.split(r"^== (.+) ==$", text, flags=re.MULTILINE)[1:]
+    return {title: body.strip("\n").split("\n") for title, body in zip(parts[::2], parts[1::2])}
+
