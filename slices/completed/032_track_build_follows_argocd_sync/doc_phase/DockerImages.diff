+def follow_deploys(
+    make_kube,
+    work: str,
+    builds: list[tuple[str, str]],
+    pickup_timeout: float,
+    roll_timeout: float,
+    poll: float,
+    log,
+) -> FollowReport:
+    """Follow the handoffs in green builds' consoles (``(label, console)`` pairs) into Argo CD."""
+    handoffs = [h for label, console in builds for h in parse_handoffs(label, console)]
+    report = FollowReport([label for label, _ in builds], handoffs, pickup_timeout, roll_timeout)
+    if handoffs:
+        try:
+            _follow(report, make_kube(), work, poll, log)
+        except FollowError as exc:
+            log(f"error following into Argo CD: {exc}")
+            report.error = str(exc)
+    return report
+
+
+def _follow(report: FollowReport, kube: Kube, work: str, poll: float, log) -> None:
+    apps = kube.applications()
+    matched: list[tuple[Handoff, dict, list[int]]] = []
+    urls: dict[str, str] = {}
+    for handoff in report.handoffs:
+        found = [(app, idx) for app in apps if (idx := matching_sources(app, handoff))]
+        if not found:
+            log(f"{handoff.repo} {handoff.branch}: no Argo CD Application follows it")
+            report.unmatched.append(handoff)
+        for app, indexes in found:
+            matched.append((handoff, app, indexes))
+            urls.setdefault(handoff.repo, _sources(app)[indexes[0]]["repoURL"])
