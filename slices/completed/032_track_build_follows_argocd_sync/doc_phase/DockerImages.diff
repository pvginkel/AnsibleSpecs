+"""Tests for track_build's follow into Argo CD: parsing the handoff lines a green
+build prints, matching them to Applications, and waiting until each has rolled
+the handed-off commit or reached a stop.
+
+The Application fixtures take the shapes Argo CD v3.5 serves in argocd-prd:
+single-source (`path: chart`, `../config/<stage>/values.yaml`) and three-source
+upstream-chart apps (`$values/config/<stage>/values.yaml` through a `ref: values`
+source). Git questions go to real repositories: a bare origin, a clone that
+pushes to it, and the environment's clone under a temporary /work, which has to
+fetch to learn the pushed commits.
+
+Run: `kc project test kube-coder-dev-local-home` from the DockerImages checkout.
+"""
+
+import collections
+import importlib.util
+import subprocess
+from pathlib import Path
+
+import pytest
+
+_spec = importlib.util.spec_from_file_location(
+    "track_build", Path(__file__).resolve().parent.parent / "track_build.py"
+)
+track_build = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(track_build)
+
+POLL = 5.0
+PICKUP = 120.0
+ROLL = 600.0
+BUILD = "KubeCoder/Build-Main #551"
+DEV = "config/dev/values.yaml"
+PRD = "config/prd/values.yaml"
+
+
+class FakeClock:
+    """A clock that only moves when the code under test sleeps."""
+
+    def __init__(self):
+        self.now = 0.0
+
+    def monotonic(self) -> float:
+        return self.now
+
+    def sleep(self, seconds: float) -> None:
+        self.now += seconds
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    fake = FakeClock()
+    monkeypatch.setattr(track_build.time, "monotonic", fake.monotonic)
+    monkeypatch.setattr(track_build.time, "sleep", fake.sleep)
+    return fake
+
+
+def _git(cwd, *args) -> str:
+    proc = subprocess.run(
+        ["git", "-C", str(cwd), "-c", "user.name=test", "-c", "user.email=test@example.com", *args],
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    return proc.stdout.strip()
+
+
+class DeployRepo:
+    """A deploy repo on its origin, and the environment's clone of it in work/."""
+
+    def __init__(self, root: Path, work: Path, name: str):
+        origin = root / "origin" / f"{name}.git"
+        origin.mkdir(parents=True)
+        _git(origin, "init", "--quiet", "--bare", "--initial-branch=main")
+        self.pusher = root / "pusher" / name
+        _git(root, "clone", "--quiet", str(origin), str(self.pusher))
+        self.initial = self.commit()
+        self.clone = work / name
+        _git(root, "clone", "--quiet", str(origin), str(self.clone))
+
+    def commit(self, branch: str = "main") -> str:
+        """Push a new commit to ``branch``; the environment's clone does not have it yet."""
+        _git(self.pusher, "commit", "--quiet", "--allow-empty", "-m", "ci: image pins")
+        _git(self.pusher, "push", "--quiet", "origin", f"HEAD:{branch}")
+        return _git(self.pusher, "rev-parse", "HEAD")
+
+    def push_to(self, sha: str, branch: str) -> None:
+        _git(self.pusher, "push", "--quiet", "origin", f"{sha}:refs/heads/{branch}")
+
+
+@pytest.fixture
+def work(tmp_path) -> Path:
+    path = tmp_path / "work"
+    path.mkdir()
+    return path
+
+
+@pytest.fixture
+def deploy_repo(tmp_path, work):
+    return lambda name: DeployRepo(tmp_path, work, name)
+
+
+# --- Application fixtures -------------------------------------------------------------------
+
+
+def _url(repo: str) -> str:
+    return f"https://github.com/pvginkel/{repo}.git"
+
+
+def _hook(repo: str, stage: str, namespace: str) -> dict:
+    return {
+        "parameters": [
+            {"name": "hook.repo", "value": _url(repo)},
+            {"name": "hook.revision", "value": "$ARGOCD_APP_REVISION"},
+            {"name": "hook.stage", "value": stage},
+            {"name": "hook.namespace", "value": namespace},
+        ]
+    }
+
+
+def _app(
+    name,
+    spec_sources,
+    revisions_of,
+    compared,
+    *,
+    sync="Synced",
+    health="Healthy",
+    last_sync=None,
+    phase="Succeeded",
+    message="successfully synced (all tasks run)",
+    running=False,
+    automated=True,
+    conditions=(),
+):
+    """An Application compared at ``compared``, whose last sync was of ``last_sync``."""
+    last_sync = last_sync or compared
+    spec = {"destination": {"name": "in-cluster", "namespace": name}, **spec_sources}
+    if automated:
+        spec["syncPolicy"] = {
+            "automated": {"prune": True, "selfHeal": False},
+            "retry": {"backoff": {"duration": "30s", "factor": 2}, "limit": 3},
+        }
+    status = {
+        "sync": {"comparedTo": dict(spec_sources), **revisions_of(compared), "status": sync},
+        "health": {"status": health},
+        "operationState": {
+            "phase": "Running" if running else phase,
+            "message": message,
+            "operation": {"initiatedBy": {"automated": True}, "sync": revisions_of(last_sync)},
+            "syncResult": revisions_of(last_sync),
+        },
+    }
+    if conditions:
+        status["conditions"] = list(conditions)
+    app = {
+        "apiVersion": "argoproj.io/v1alpha1",
+        "kind": "Application",
+        "metadata": {"name": name, "namespace": "argocd-prd"},
+        "spec": spec,
+        "status": status,
+    }
+    if running:
+        app["operation"] = {"initiatedBy": {"automated": True}, "sync": revisions_of(compared)}
+    return app
+
+
+def single_source(name, repo, branch, stage, compared, **state):
+    source = {
+        "helm": {**_hook(repo, stage, name), "valueFiles": [f"../config/{stage}/values.yaml"]},
+        "path": "chart",
+        "repoURL": _url(repo),
+        "targetRevision": branch,
+    }
+    return _app(name, {"source": source}, lambda rev: {"revision": rev}, compared, **state)
+
+
+def three_source(name, repo, chart, version, stage, compared, **state):
+    sources = [
+        {
+            "chart": chart,
+            "helm": {"valueFiles": [f"$values/config/{stage}/values.yaml"]},
+            "repoURL": f"https://{chart}.github.io/helm-charts",
+            "targetRevision": version,
+        },
+        {"ref": "values", "repoURL": _url(repo), "targetRevision": "main"},
+        {
+            "helm": _hook(repo, stage, name),
+            "path": "chart",
+            "repoURL": _url(repo),
+            "targetRevision": "main",
+        },
+    ]
+    return _app(
+        name,
+        {"sources": sources},
+        lambda rev: {"revisions": [version, rev, rev]},
+        compared,
+        **state,
+    )
+
+
+def kubecoder_dev(compared, **state):
+    return single_source("kubecoder-dev", "KubeCoderDeploy", "main", "dev", compared, **state)
+
+
+def kubecoder_prd(compared, **state):
+    return single_source("kubecoder-prd", "KubeCoderDeploy", "prd", "prd", compared, **state)
+
+
+def keycloak(stage, compared, **state):
+    return single_source(f"keycloak-{stage}", "KeycloakDeploy", "main", stage, compared, **state)
+
+
+def grafana_prd(compared, **state):
+    return three_source(
+        "grafana-prd", "GrafanaDeploy", "grafana", "10.5.15", "prd", compared, **state
+    )
+
+
+# --- handoff lines, as the console prints them ------------------------------------------------
+
+
+def pin_line(repo, sha, *files):
+    return f"****/{repo} {sha} pins {', '.join(files)}."
+
+
+def promote_line(sha):
+    return f"pvginkel/KubeCoderDeploy {sha} pushed to prd."
+
+
+def already_on_line(sha):
+    return f"pvginkel/KubeCoderDeploy {sha} already on prd: nothing pushed."
+
+
+def already_carries_line(repo):
+    return f"****/{repo} already carries these pins: nothing committed, nothing pushed."
+
+
+def console(*lines) -> str:
+    """A console excerpt around the handoff lines, with Jenkins' \\r\\n line ends."""
+    body = [
+        "[Pipeline] { (Write image pins)",
+        "+ git commit --quiet -m 'ci: image pins from KubeCoder/Build-Main #551'",
+        *lines,
+        "[Pipeline] }",
+        "Finished: SUCCESS",
+    ]
+    return "\r\n".join(body) + "\r\n"
+
+
+class FakeKube:
+    """Serves scripted states per app: the listing gives every app its first state,
+    each later GET of an app its next one. The last state repeats."""
+
+    def __init__(self, *timelines):
+        self.timelines = {t[0]["metadata"]["name"]: list(t) for t in timelines}
+        self.gets = collections.Counter()
+
+    def applications(self):
+        return [timeline[0] for timeline in self.timelines.values()]
+
+    def application(self, name):
+        self.gets[name] += 1
+        timeline = self.timelines[name]
+        return timeline[min(self.gets[name], len(timeline) - 1)]
+
+
+@pytest.fixture
+def follow(clock, work):
+    """Run follow_deploys over one build's console; return (report, log lines)."""
+
+    def _follow(kube, *lines, pickup=PICKUP, roll=ROLL):
+        log: list[str] = []
+        report = track_build.follow_deploys(
+            lambda: kube, str(work), [(BUILD, console(*lines))], pickup, roll, POLL, log.append
+        )
+        return report, log
+
+    return _follow
+
+
+def states(report) -> dict[str, str]:
+    return {f.name: f.state for f in report.followed}
+
+
+def printed(report, capsys) -> str:
+    track_build.print_follow(report)
+    return capsys.readouterr().out
+
