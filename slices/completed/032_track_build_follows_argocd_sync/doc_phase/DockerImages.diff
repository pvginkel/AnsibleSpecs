+        ctx = _named(config.get("contexts"), context, "context", path)
+        cluster = _named(config.get("clusters"), ctx["cluster"], "cluster", path)
+        user = _named(config.get("users"), ctx["user"], "user", path)
+        self.server = cluster["server"].rstrip("/")
+        ca = base64.b64decode(cluster["certificate-authority-data"]).decode()
+        self._tls = ssl.create_default_context(cadata=ca)
