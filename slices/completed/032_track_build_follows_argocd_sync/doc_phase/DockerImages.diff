+def _read(lines) -> list[str]:
+    # A failed read is written into its own section instead of raised: the roll's verdict is
+    # already decided, and the rest of the diagnosis stands without it.
+    try:
+        return lines()
+    except FollowError as exc:
+        return [f"could not read: {exc}"]
