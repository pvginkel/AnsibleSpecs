+def _ref(resource: dict) -> str:
+    """``apps/Deployment kubecoder-dev/kubecoder-controller`` for a resource entry."""
+    group = f"{resource['group']}/" if resource.get("group") else ""
+    namespace = f"{resource['namespace']}/" if resource.get("namespace") else ""
+    return f"{group}{resource['kind']} {namespace}{resource['name']}"
+
+
+def _condition(condition: dict) -> str:
+    head = " ".join(str(condition[k]) for k in ("type", "status", "reason") if condition.get(k))
+    message = _one_line(condition.get("message", ""))
+    return f"{head}: {message}" if message else head
+
+
+def _unobserved(obj: dict) -> bool:
+    return obj["metadata"].get("generation", 0) > (obj.get("status") or {}).get(
+        "observedGeneration", 0
+    )
+
+
+def _deployment_problem(deployment: dict) -> str | None:
+    spec, status = deployment["spec"], deployment.get("status") or {}
+    if spec.get("paused"):
+        return None
+    if _unobserved(deployment):
+        return "its controller has not observed the latest spec"
+    if any(c.get("reason") == "ProgressDeadlineExceeded" for c in status.get("conditions") or []):
+        return "exceeded its progress deadline"
+    want, updated = spec.get("replicas", 1), status.get("updatedReplicas", 0)
+    if updated < want:
+        return f"{updated} of {want} replicas updated"
+    if (old := status.get("replicas", 0) - updated) > 0:
+        return f"{old} old replicas pending termination"
+    if (available := status.get("availableReplicas", 0)) < updated:
+        return f"{available} of {updated} updated replicas available"
+    return None
+
+
+def _statefulset_problem(statefulset: dict) -> str | None:
+    spec, status = statefulset["spec"], statefulset.get("status") or {}
+    if _unobserved(statefulset):
+        return "its controller has not observed the latest spec"
+    want = spec.get("replicas", 1)
+    if (ready := status.get("readyReplicas", 0)) < want:
+        return f"{ready} of {want} pods ready"
+    strategy = spec.get("updateStrategy") or {}
+    if strategy.get("type") == "OnDelete":
+        return None
+    target = want - (strategy.get("rollingUpdate") or {}).get("partition", 0)
+    if (updated := status.get("updatedReplicas", 0)) < target:
+        return f"{updated} of {target} pods updated"
+    return None
+
+
+def _daemonset_problem(daemonset: dict) -> str | None:
+    spec, status = daemonset["spec"], daemonset.get("status") or {}
+    if _unobserved(daemonset):
+        return "its controller has not observed the latest spec"
+    if (spec.get("updateStrategy") or {}).get("type") == "OnDelete":
+        return None
+    desired = status.get("desiredNumberScheduled", 0)
+    if (updated := status.get("updatedNumberScheduled", 0)) < desired:
+        return f"{updated} of {desired} pods updated"
+    if (available := status.get("numberAvailable", 0)) < desired:
+        return f"{available} of {desired} pods available"
+    return None
+
+
+def _true_conditions(obj: dict) -> set[str]:
+    conditions = (obj.get("status") or {}).get("conditions") or []
+    return {c["type"] for c in conditions if c.get("status") == "True"}
+
+
+def _job_problem(job: dict) -> str | None:
+    true = _true_conditions(job)
+    if "Failed" in true:
+        return "failed"
+    if true & {"Complete", "Suspended"}:
+        return None
+    return f"not finished, {(job.get('status') or {}).get('active', 0)} pods active"
+
+
+def _pvc_problem(claim: dict) -> str | None:
+    phase = (claim.get("status") or {}).get("phase", "Unknown")
+    return None if phase == "Bound" else f"phase {phase}"
+
+
+def _external_secret_problem(secret: dict) -> str | None:
+    return None if "Ready" in _true_conditions(secret) else "not Ready"
+
+
+# The kinds whose health the diagnosis judges from the live object, by (group, kind): the
+# collection they are listed from and what makes one unhealthy. Argo CD v3.5 serves each
+# resource's health only through its API server (resourceHealthSource: appTree), which the
+# kubeconfig's token cannot call, so these follow its rules for the kinds the estate deploys.
+_JUDGED = {
+    ("apps", "Deployment"): ("deployments", _deployment_problem),
+    ("apps", "StatefulSet"): ("statefulsets", _statefulset_problem),
+    ("apps", "DaemonSet"): ("daemonsets", _daemonset_problem),
+    ("batch", "Job"): ("jobs", _job_problem),
+    ("", "PersistentVolumeClaim"): ("persistentvolumeclaims", _pvc_problem),
+    ("external-secrets.io", "ExternalSecret"): ("externalsecrets", _external_secret_problem),
+}
+_JUDGED_KINDS = (
+    "Deployments, StatefulSets, DaemonSets, Jobs, PersistentVolumeClaims and ExternalSecrets"
+)
