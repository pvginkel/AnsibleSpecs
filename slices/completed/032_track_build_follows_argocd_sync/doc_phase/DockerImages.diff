+def _follow_results(report: FollowReport) -> list[str]:
+    if report.error:
+        return [f"Result: following into Argo CD failed — {report.error}"]
+    if report.missing:
+        lines = [
+            "Result: deploy untracked — the builds are green, but the tracker asks git only of "
+            "this environment's own clone of a deploy repo, and these have none:"
+        ]
+        lines += [
+            f"  {repo}: git clone {url} {path}" for repo, (url, path) in report.missing.items()
+        ]
+        lines.append(
+            "Clone them now and re-run this command to follow the deploy. So that the next "
+            "start of this environment clones them, declare each in its .kubecoder/config.yaml."
+        )
+        return lines
+    lines = []
+    if failed := _names(report, FAILED):
+        lines.append(
+            f"Result: the roll FAILED on {failed}; Argo CD's own words are on its line above. "
+            f"Fix the cause and push again."
+        )
+    if not_seen := _names(report, NOT_SEEN):
+        lines.append(
+            f"Result: Argo CD had not seen the commit on {not_seen} after "
+            f"{report.pickup_timeout:g}s (--pickup-timeout). Argo CD syncs on push only, so a "
+            f"lost webhook leaves an app stale but green: ask the operator to refresh it in Argo "
+            f"CD, or to redeliver the push from the GitHub repo's Recent Deliveries, then re-run "
+            f"this command."
+        )
+    if manual := _names(report, MANUAL):
+        lines.append(
+            f"Result: {manual} has no automated sync policy, so Argo CD will not roll the commit "
+            f"on its own, and this tracker only reads. Ask the operator to sync it in Argo CD, "
+            f"then re-run this command."
+        )
+    if not_done := _names(report, NOT_DONE):
+        lines.append(
+            f"Result: {not_done} had not rolled at the {report.roll_timeout:g}s roll deadline "
+            f"(--roll-timeout); its line above is what Argo CD reports, not a verdict on the "
+            f"workload. Argo CD's health can sit stale at Progressing when a commit renders no "
+            f"change and so brings no sync: check the workload itself, or re-run this command "
+            f"to keep waiting."
+        )
+    if not lines:
+        if rolled := _names(report, ROLLED):
+            lines.append(
+                f"Result: rolled — Argo CD runs the handed-off commit, or a later one, on {rolled}."
+            )
+        else:
+            lines.append(
+                "Result: nothing to wait for — no handoff pushed a commit an Application follows."
+            )
+    return lines
+
