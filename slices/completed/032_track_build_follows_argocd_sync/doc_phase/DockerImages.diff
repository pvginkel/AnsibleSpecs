+def _owns(kind: str, name: str, pod: dict) -> bool:
+    """Whether the workload ``kind``/``name`` owns ``pod`` (a Deployment through its ReplicaSet)."""
+    metadata = pod["metadata"]
+    if kind == "Deployment":
+        kind, name = (
+            "ReplicaSet",
+            f"{name}-{(metadata.get('labels') or {}).get('pod-template-hash')}",
+        )
+    return any(
+        o.get("kind") == kind and o.get("name") == name
+        for o in metadata.get("ownerReferences") or []
+    )
+
+
+def _container_problem(status: dict) -> str | None:
+    state = status.get("state") or {}
+    terminated = state.get("terminated")
+    if status.get("ready") or (terminated and terminated.get("exitCode") == 0):
+        return None
+    if waiting := state.get("waiting"):
+        message = f": {_one_line(waiting['message'])}" if waiting.get("message") else ""
+        now = f"waiting {waiting.get('reason', '')}{message}"
+    elif terminated:
+        now = f"exited {terminated.get('exitCode')} ({terminated.get('reason', '')})"
+    else:
+        now = "running, not ready"
+    parts = [f"container {status['name']} {now}"]
+    if status.get("restartCount"):
+        parts.append(f"{status['restartCount']} restarts")
+    if last := (status.get("lastState") or {}).get("terminated"):
+        parts.append(f"last exit {last.get('exitCode')} ({last.get('reason', '')})")
+    return ", ".join(parts)
+
+
+def _pod_problem(pod: dict) -> str | None:
+    status = pod.get("status") or {}
+    phase = status.get("phase", "Unknown")
+    if phase == "Succeeded" or (phase == "Running" and "Ready" in _true_conditions(pod)):
+        return None
+    parts = [phase]
+    parts += [
+        _condition(c)
+        for c in status.get("conditions") or []
+        if c.get("status") != "True" and c.get("message")
+    ]
+    containers = (status.get("initContainerStatuses") or []) + (
+        status.get("containerStatuses") or []
+    )
+    parts += [p for c in containers if (p := _container_problem(c))]
+    return "; ".join(parts)
+
+
+def _event_line(event: dict) -> str:
+    involved = event.get("involvedObject") or {}
+    when = event.get("lastTimestamp") or event.get("eventTime") or "?"
+    count = event.get("count") or (event.get("series") or {}).get("count") or 1
+    return (
+        f"event {when} {event.get('reason', '')} x{count} {involved.get('kind')} "
+        f"{involved.get('name')}: {_one_line(event.get('message', ''))}"
+    )
+
+
+def _unhealthy_lines(kube: Kube, app: dict) -> list[str]:
+    """The live resources the app lists that are not healthy, with their pods and warnings."""
+    lines = [f"Health judged from the live objects: the {_JUDGED_KINDS} the Application lists."]
+    listed: dict[str, dict[str, dict]] = {}
+    unhealthy: list[tuple[dict, dict | None, str]] = []
+    for resource in (app.get("status") or {}).get("resources") or []:
+        key = (resource.get("group", ""), resource["kind"])
+        if key not in _JUDGED or resource.get("hook") or not resource.get("namespace"):
+            continue
+        plural, judge = _JUDGED[key]
+        api = f"apis/{key[0]}" if key[0] else "api"
+        collection = f"{api}/{resource['version']}/namespaces/{resource['namespace']}/{plural}"
+        if collection not in listed:
+            listed[collection] = {o["metadata"]["name"]: o for o in kube.items(collection)}
+        obj = listed[collection].get(resource["name"])
+        reason = judge(obj) if obj is not None else "not in the cluster"
+        if reason:
+            unhealthy.append((resource, obj, reason))
+    if not unhealthy:
+        return lines + ["none: each is healthy"]
+
+    pods: dict[str, list[dict]] = {}
+    events: dict[str, list[dict]] = {}
+    for resource, obj, reason in unhealthy:
+        lines.append(f"{_ref(resource)}: {reason}")
+        if obj is None:
+            continue
+        namespace = resource["namespace"]
+        if namespace not in pods:
+            pods[namespace] = kube.items(f"api/v1/namespaces/{namespace}/pods")
+            events[namespace] = kube.items(
+                f"api/v1/namespaces/{namespace}/events", fieldSelector="type=Warning"
+            )
+        lines += [
+            f"  condition {_condition(c)}"
+            for c in (obj.get("status") or {}).get("conditions") or []
+        ]
+        related = {(resource["kind"], resource["name"])}
+        for pod in pods[namespace]:
+            if _owns(resource["kind"], resource["name"], pod):
+                related.add(("Pod", pod["metadata"]["name"]))
+                related |= {
+                    (o.get("kind"), o.get("name")) for o in pod["metadata"]["ownerReferences"]
+                }
+                if problem := _pod_problem(pod):
+                    lines.append(f"  pod {pod['metadata']['name']}: {problem}")
+        warnings = [
+            e
+            for e in events[namespace]
+            if (
+                (e.get("involvedObject") or {}).get("kind"),
+                (e.get("involvedObject") or {}).get("name"),
+            )
+            in related
+        ]
+        warnings.sort(key=lambda e: e.get("lastTimestamp") or e.get("eventTime") or "")
+        lines += [f"  {_event_line(e)}" for e in warnings]
+    return lines
+
