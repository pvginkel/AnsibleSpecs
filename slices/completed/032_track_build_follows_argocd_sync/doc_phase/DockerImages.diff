+def diagnosis(kube: Kube, followed: Followed) -> str:
+    """What Argo CD and the cluster report on a failed or stalled roll, as text."""
+    app, handoff = followed.app, followed.handoff
+    status = app.get("status") or {}
+    op_state = status.get("operationState") or {}
+    if op_state:
+        sync = (op_state.get("operation") or {}).get("sync") or {}
+        revisions = sync.get("revisions") or [sync.get("revision")]
+        operation = [
+            (
+                f"phase {op_state.get('phase')}, started {op_state.get('startedAt', '?')}, "
+                f"finished {op_state.get('finishedAt', '-')}, "
+                f"retries {op_state.get('retryCount', 0)}"
+            ),
+            f"revisions: {', '.join(rev or '?' for rev in revisions)}",
+            f"message: {_one_line(op_state.get('message', ''))}",
+        ]
+    else:
+        operation = ["none recorded"]
+    failed = [
+        f"{r.get('syncPhase', 'Sync')} {_ref(r)}: {r.get('status')}"
+        + (f", hook {r['hookPhase']}" if r.get("hookType") else "")
+        + f": {_one_line(r.get('message', ''))}"
+        for r in (op_state.get("syncResult") or {}).get("resources") or []
+        if r.get("status") == "SyncFailed" or r.get("hookPhase") in _OP_FAILED
+    ]
+    hook = f"tf-presync-{followed.name}"
+    sections = [
+        (
+            f"{followed.name}: {_LABELS[followed.state]} rolling {handoff.repo} {followed.sha}",
+            [
+                f"handoff: {_handoff_heading(handoff, followed.sha)}",
+                f"Argo CD reports: {describe(app, followed.indexes)}",
+                f"read at {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}",
+            ],
+        ),
+        ("Operation", operation),
+        ("Conditions", [_condition(c) for c in status.get("conditions") or []] or ["none"]),
+        ("Resources the sync failed", failed or ["none"]),
+        ("Resources not healthy", _read(lambda: _unhealthy_lines(kube, app))),
+        (f"PreSync hook Job {_HOOKS_NAMESPACE}/{hook}", _read(lambda: _hook_lines(kube, hook))),
+    ]
+    return "\n\n".join(f"== {title} ==\n" + "\n".join(lines) for title, lines in sections) + "\n"
+
+
+def save_diagnosis(kube: Kube, followed: Followed, log_dir: str) -> str:
+    """Write the app's diagnosis into ``log_dir``; return the file's path."""
+    os.makedirs(log_dir, exist_ok=True)
+    path = os.path.join(log_dir, f"argocd_{followed.name}_{followed.sha[:7]}.log")
+    with open(path, "w") as fh:
+        fh.write(diagnosis(kube, followed))
+    return path
