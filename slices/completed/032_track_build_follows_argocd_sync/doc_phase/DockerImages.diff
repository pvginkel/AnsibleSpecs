+class FollowError(Exception):
+    """An operational failure following a handoff into Argo CD (kubeconfig, API, git)."""
+
+
+@dataclass(frozen=True)
+class Handoff:
+    """A build's report of what it pushed to a deploy repo, or that it pushed nothing."""
+
+    build: str  # the build that printed it, e.g. "KubeCoder/Build-Main #551"
+    repo: str  # the deploy repo's name; its clone is /work/<repo>
+    branch: str
+    sha: str | None  # None for "already carries these pins": the branch head is reported
+    files: tuple[str, ...] | None  # pinned repo-root paths; None matches every app on the branch
+    pushed: bool  # a new commit, so a sync to wait for
+
+
+def parse_handoffs(build: str, console: str) -> list[Handoff]:
+    """The handoff lines in a build's console, in the order it printed them."""
+    out: list[Handoff] = []
+    # splitlines, not a MULTILINE regex: Jenkins consoles carry \r\n line ends.
+    for line in console.splitlines():
+        if match := _HANDOFF_RE.fullmatch(line):
+            repo, sha = match["repo"], match["sha"]
+            if match["files"] is not None:
+                files = tuple(match["files"].split(", "))
+                out.append(Handoff(build, repo, _PIN_BRANCH, sha, files, True))
+            elif match["pushed"] is not None:
+                out.append(Handoff(build, repo, match["pushed"], sha, None, True))
+            else:
+                out.append(Handoff(build, repo, match["already"], sha, None, False))
+        elif match := _ALREADY_PINNED_RE.fullmatch(line):
+            out.append(Handoff(build, match["repo"], _PIN_BRANCH, None, None, False))
+    return out
+
