+def _named(entries: list[dict] | None, name: str, kind: str, path: str) -> dict:
+    for entry in entries or []:
+        if entry.get("name") == name:
+            return entry[kind]
+    raise FollowError(f"the kubeconfig {path} has no {kind} named {name!r}")
