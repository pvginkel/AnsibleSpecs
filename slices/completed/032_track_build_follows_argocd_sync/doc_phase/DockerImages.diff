+def _handoff_heading(handoff: Handoff, commit: str | None) -> str:
+    if handoff.files is not None:
+        what = f"{handoff.sha[:7]} pushed to {handoff.branch}, pins {', '.join(handoff.files)}"
+    elif handoff.pushed:
+        what = f"{handoff.sha[:7]} pushed to {handoff.branch}"
+    elif handoff.sha:
+        what = f"{handoff.sha[:7]} already on {handoff.branch}, nothing pushed"
+    else:
+        head = f"; {handoff.branch} is at {commit[:7]}" if commit else ""
+        what = f"{handoff.branch} already carries these pins, nothing pushed{head}"
+    return f"{handoff.repo} {what} ({handoff.build})"
