+    # Every missing clone is found before anything is waited on, so one stop names them all.
+    clones: dict[str, Clone] = {}
+    for repo, url in urls.items():
+        path = os.path.join(work, repo)
+        if os.path.exists(os.path.join(path, ".git")):
+            clones[repo] = Clone(path)
+        else:
+            report.missing[repo] = (url, path)
+    if report.missing:
+        log(f"no clone in {work} of: {', '.join(report.missing)}")
+        return
+
+    for clone in clones.values():
+        clone.fetch()
+    for handoff in report.handoffs:
+        if handoff.repo in clones:
+            report.commits[handoff] = handoff.sha or clones[handoff.repo].head(handoff.branch)
+    for handoff, app, indexes in matched:
+        report.followed.append(
+            Followed(
+                handoff,
+                app["metadata"]["name"],
+                indexes,
+                app,
+                clones[handoff.repo],
+                report.commits[handoff],
+            )
+        )
+
+    for followed in report.followed:
+        if not followed.handoff.pushed:
+            followed.state = CURRENT
+            state = describe(followed.app, followed.indexes)
+            log(f"{followed.name}: {state} ({followed.relation()})")
+    _wait(
+        [f for f in report.followed if f.handoff.pushed],
+        kube,
+        report.pickup_timeout,
+        report.roll_timeout,
+        poll,
+        log,
+    )
