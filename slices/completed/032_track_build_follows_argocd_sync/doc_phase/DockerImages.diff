+def _wait(
+    followed: list[Followed],
+    kube: Kube,
+    pickup_timeout: float,
+    roll_timeout: float,
+    poll: float,
+    log,
+) -> None:
+    """Poll each app until it has rolled its commit or reaches a stop."""
+    pickup_deadline = time.monotonic() + pickup_timeout
+    announced: dict[int, str] = {}
+    pending = list(followed)
+    while pending:
+        now = time.monotonic()
+        for f in pending:
+            state = app_state(f.app, f.indexes, f.sha, f.clone)
+            if state in (ROLLED, FAILED):
+                f.state = state
+            elif not _automated(f.app):
+                f.state = MANUAL
+            elif state == UNSEEN:
+                f.state = NOT_SEEN if now >= pickup_deadline else UNSEEN
+            else:
+                if f.seen_at is None:
+                    f.seen_at = now
+                f.state = NOT_DONE if now >= f.seen_at + roll_timeout else ROLLING
+            line = (
+                f"{f.name} ({f.handoff.repo} {f.sha[:7]}): {_LABELS[f.state]} — "
+                f"{describe(f.app, f.indexes)}"
+            )
+            if announced.get(id(f)) != line:
+                log(line)
+                announced[id(f)] = line
+        pending = [f for f in pending if f.state in (UNSEEN, ROLLING)]
+        if pending:
+            time.sleep(poll)
+            fresh = {
+                name: kube.application(name) for name in dict.fromkeys(f.name for f in pending)
+            }
+            for f in pending:
+                f.app = fresh[f.name]
+
