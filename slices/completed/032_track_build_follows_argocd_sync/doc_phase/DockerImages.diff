+def _terms(selector: str) -> list[list[str]]:
+    return [term.split("=", 1) for term in selector.split(",") if term]
+
+
+def _selected(obj, field_selector, label_selector) -> bool:
+    """Equality selectors, as the Kubernetes API applies them."""
+    for key, value in _terms(field_selector):
+        node = obj
+        for part in key.split("."):
+            node = node.get(part, {})
+        if node != value:
+            return False
+    labels = obj["metadata"].get("labels") or {}
+    return all(labels.get(key) == value for key, value in _terms(label_selector))
