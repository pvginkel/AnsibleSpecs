+class TestParseHandoffs:
+    def test_the_pin_line_is_read_although_its_owner_is_masked(self):
+        # KubeCoder/Build-Main #551's console. The git commit trace above the pin line is
+        # not a handoff.
+        handoffs = track_build.parse_handoffs(
+            BUILD, console(pin_line("KubeCoderDeploy", SHA, DEV, PRD))
+        )
+        assert handoffs == [
+            track_build.Handoff(BUILD, "KubeCoderDeploy", "main", SHA, (DEV, PRD), True)
+        ]
+
+    def test_every_pin_line_of_a_build_that_pins_several_repos(self):
+        # DockerImages #2548 printed ten, one per deploy repo its images feed.
+        text = console(
+            *(
+                pin_line(repo, SHA, PRD)
+                for repo in ("StorageDeploy", "NginxDeploy", "RegistryDeploy")
+            )
+        )
+        handoffs = track_build.parse_handoffs("DockerImages #2548", text)
+        assert [h.repo for h in handoffs] == ["StorageDeploy", "NginxDeploy", "RegistryDeploy"]
+        assert all(h.pushed and h.branch == "main" and h.files == (PRD,) for h in handoffs)
+
+    def test_a_promotion_that_moved_prd(self):
+        [handoff] = track_build.parse_handoffs(
+            "KubeCoder/Promote-PRD #9", console(promote_line(SHA))
+        )
+        assert handoff == track_build.Handoff(
+            "KubeCoder/Promote-PRD #9", "KubeCoderDeploy", "prd", SHA, None, True
+        )
+
+    def test_a_promotion_that_only_records_a_release_pushed_nothing(self):
+        [handoff] = track_build.parse_handoffs(
+            "KubeCoder/Promote-PRD #9", console(already_on_line(SHA))
+        )
