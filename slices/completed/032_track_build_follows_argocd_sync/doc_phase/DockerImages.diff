+def _hook_lines(kube: Kube, job_name: str) -> list[str]:
+    """The PreSync hook Job's state and its pods' logs."""
+    jobs = kube.items(
+        f"apis/batch/v1/namespaces/{_HOOKS_NAMESPACE}/jobs",
+        fieldSelector=f"metadata.name={job_name}",
+    )
+    if not jobs:
+        return [f"no Job {job_name} in {_HOOKS_NAMESPACE}"]
+    job = jobs[0]
+    true = [
+        _condition(c)
+        for c in (job.get("status") or {}).get("conditions") or []
+        if c.get("status") == "True"
+    ]
+    lines = [
+        f"created {job['metadata'].get('creationTimestamp', '?')}; "
+        + ("; ".join(true) or f"{(job.get('status') or {}).get('active', 0)} pods active")
+    ]
+    lines += [
+        f"container {c['name']} args: {' '.join(c.get('args') or [])}"
+        for c in job["spec"]["template"]["spec"]["containers"]
+    ]
+    selector = ",".join(f"{k}={v}" for k, v in job["spec"]["selector"]["matchLabels"].items())
+    pods = kube.items(f"api/v1/namespaces/{_HOOKS_NAMESPACE}/pods", labelSelector=selector)
+    if not pods:
+        lines.append("no pod of it is left, so no log")
+    for pod in sorted(pods, key=lambda p: p["metadata"].get("creationTimestamp", "")):
+        name = pod["metadata"]["name"]
+        statuses = {s["name"]: s for s in (pod.get("status") or {}).get("containerStatuses") or []}
+        for container in pod["spec"]["containers"]:
+            state = (statuses.get(container["name"]) or {}).get("state") or {}
+            if "running" not in state and "terminated" not in state:
+                reason = (state.get("waiting") or {}).get("reason", "no status yet")
+                lines.append(
+                    f"--- pod {name}, container {container['name']}: not started ({reason}) ---"
+                )
+                continue
+            lines.append(f"--- log of pod {name}, container {container['name']} ---")
+            lines.append(kube.log(_HOOKS_NAMESPACE, name, container["name"]).rstrip("\n"))
+    return lines
+
