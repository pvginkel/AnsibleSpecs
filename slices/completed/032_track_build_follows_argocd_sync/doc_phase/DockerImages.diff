+class Clone:
+    """The environment's clone of a deploy repo, the only place git questions go."""
+
+    def __init__(self, path: str):
+        self.path = path
+        self._contains: dict[tuple[str, str], bool] = {}
+
+    def _git(self, *args: str, check: bool = True) -> subprocess.CompletedProcess:
+        command = f"git -C {self.path} {' '.join(args)}"
+        try:
+            proc = subprocess.run(
+                ["git", "-C", self.path, *args],
+                capture_output=True,
+                text=True,
+                timeout=_GIT_TIMEOUT,
+            )
+        except subprocess.TimeoutExpired as e:
+            raise FollowError(f"{command} did not finish within {_GIT_TIMEOUT}s") from e
+        if check and proc.returncode != 0:
+            raise FollowError(f"{command} failed: {proc.stderr.strip()}")
+        return proc
+
+    def fetch(self) -> None:
+        self._git("fetch", "--quiet", "origin")
+
+    def head(self, branch: str) -> str:
+        return self._git("rev-parse", f"refs/remotes/origin/{branch}").stdout.strip()
+
+    def _has(self, rev: str) -> bool:
+        return self._git("cat-file", "-e", f"{rev}^{{commit}}", check=False).returncode == 0
+
+    def contains(self, rev: str, sha: str) -> bool:
+        """Whether ``rev`` is ``sha`` or a descendant of it."""
+        if rev == sha:
+            return True
+        key = (rev, sha)
+        if key not in self._contains:
+            if not (self._has(rev) and self._has(sha)):
+                self.fetch()
+            proc = self._git("merge-base", "--is-ancestor", sha, rev, check=False)
+            if proc.returncode not in (0, 1):
+                raise FollowError(
+                    f"git -C {self.path} merge-base --is-ancestor {sha} {rev} failed: "
+                    f"{proc.stderr.strip()}"
+                )
+            self._contains[key] = proc.returncode == 0
+        return self._contains[key]
+
+
+def _sources(app: dict) -> list[dict]:
+    spec = app["spec"]
+    return spec["sources"] if spec.get("sources") else [spec["source"]]
+
+
+def _repo_name(url: str) -> str:
+    """``https://github.com/pvginkel/KubeCoderDeploy.git`` -> ``KubeCoderDeploy``."""
+    return url.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git")
+
+
+def _tracks(source: dict, repo: str, branch: str) -> bool:
+    return _repo_name(source.get("repoURL", "")) == repo and source.get("targetRevision") == branch
+
+
+def value_files(app: dict, repo: str, branch: str) -> set[str]:
+    """Repo-root paths of the app's helm valueFiles that ``repo`` at ``branch`` supplies.
+
+    A values file is named relative to its source's ``path`` (``../config/prd/values.yaml``
+    beside ``path: chart``), or through a ``ref`` source (``$values/config/prd/values.yaml``).
+    """
+    sources = _sources(app)
+    refs = {s["ref"]: s for s in sources if s.get("ref")}
+    out: set[str] = set()
+    for source in sources:
+        for name in (source.get("helm") or {}).get("valueFiles") or []:
+            if name.startswith("$"):
+                ref, _, path = name[1:].partition("/")
+                supplier = refs.get(ref)
+            else:
+                supplier = source
+                path = posixpath.normpath(posixpath.join(source.get("path", ""), name))
+            if supplier is not None and _tracks(supplier, repo, branch):
+                out.add(path)
+    return out
+
+
+def matching_sources(app: dict, handoff: Handoff) -> list[int]:
+    """Indexes of the app's sources that roll ``handoff``; empty when the app does not."""
+    indexes = [i for i, s in enumerate(_sources(app)) if _tracks(s, handoff.repo, handoff.branch)]
+    if indexes and handoff.files is not None:
+        if not value_files(app, handoff.repo, handoff.branch) & set(handoff.files):
+            return []
+    return indexes
+
+
+def _revisions(app: dict, block: dict, indexes: list[int]) -> list[str | None]:
+    """The revisions ``block`` (sync status or sync result) records for those sources."""
+    revisions = (
+        block.get("revisions") if app["spec"].get("sources") else [block.get("revision")]
+    ) or []
+    return [revisions[i] if i < len(revisions) else None for i in indexes]
+
+
+def _at(clone: Clone, revisions: list[str | None], sha: str) -> bool:
+    return all(rev and clone.contains(rev, sha) for rev in revisions)
+
+
+def _automated(app: dict) -> bool:
+    automated = (app["spec"].get("syncPolicy") or {}).get("automated")
+    return automated is not None and automated.get("enabled", True)
+
+
+def _error_conditions(app: dict) -> list[dict]:
+    conditions = (app.get("status") or {}).get("conditions") or []
+    return [c for c in conditions if c.get("type", "").endswith("Error")]
+
+
+def _sync_running(app: dict) -> bool:
+    op_state = (app.get("status") or {}).get("operationState") or {}
+    return bool(app.get("operation")) or op_state.get("phase") in _OP_RUNNING
+
+
+def app_state(app: dict, indexes: list[int], sha: str, clone: Clone) -> str:
+    """Where ``app`` stands on commit ``sha``: UNSEEN, ROLLING, ROLLED or FAILED.
+
+    The compared revision moves before any sync, so an app OutOfSync at ``sha`` is
+    still rolling; a commit that renders no change leaves the app Synced with no
+    new sync, and that is rolled.
+    """
+    status = app.get("status") or {}
+    sync = status.get("sync") or {}
+    if not _at(clone, _revisions(app, sync, indexes), sha):
+        return UNSEEN
+    if _error_conditions(app):
+        return FAILED
+    if _sync_running(app):
+        return ROLLING
+    op_state = status.get("operationState") or {}
+    if op_state.get("phase") in _OP_FAILED and _at(
+        clone, _revisions(app, op_state.get("syncResult") or {}, indexes), sha
+    ):
+        return FAILED
+    if sync.get("status") != "Synced":
+        return ROLLING
+    health = (status.get("health") or {}).get("status")
+    if health == "Progressing":
+        return ROLLING
+    return FAILED if health in _UNHEALTHY else ROLLED
+
+
+def _one_line(text: str) -> str:
+    return " ".join(text.split())
+
+
+def describe(app: dict, indexes: list[int]) -> str:
+    """What Argo CD reports for the app, e.g. ``Synced at 46e0aa8, health Healthy``."""
+    status = app.get("status") or {}
+    sync = status.get("sync") or {}
+    revisions = ", ".join(dict.fromkeys((rev or "?")[:7] for rev in _revisions(app, sync, indexes)))
+    parts = [
+        f"{sync.get('status', 'Unknown')} at {revisions}",
+        f"health {(status.get('health') or {}).get('status', 'Unknown')}",
+    ]
+    op_state = status.get("operationState") or {}
+    if _sync_running(app):
+        parts.append("sync running")
+    elif op_state.get("phase") in _OP_FAILED:
+        parts.append(f"last sync {op_state['phase']}: {_one_line(op_state.get('message', ''))}")
+    parts += [f"{c['type']}: {_one_line(c.get('message', ''))}" for c in _error_conditions(app)]
+    if not _automated(app):
+        parts.append("no automated sync policy")
+    return ", ".join(parts)
+
+
+@dataclass
+class Followed:
+    """One Application a handoff touches, and where it stands on the handed-off commit."""
+
+    handoff: Handoff
+    name: str
+    indexes: list[int]
+    app: dict  # as Argo CD last reported it
+    clone: Clone
+    sha: str  # the handed-off commit, or the branch head for "already carries these pins"
+    state: str = UNSEEN
+    seen_at: float | None = None
+
+    def relation(self) -> str:
+        """Where the app's compared revision sits relative to ``sha``."""
+        revisions = _revisions(
+            self.app, (self.app.get("status") or {}).get("sync") or {}, self.indexes
+        )
+        if all(rev == self.sha for rev in revisions):
+            return f"at {self.sha[:7]}"
+        if _at(self.clone, revisions, self.sha):
+            return f"past {self.sha[:7]}"
+        return f"not at {self.sha[:7]}"
+
+
+@dataclass
+class FollowReport:
+    """What following the tracked builds' handoffs into Argo CD found."""
+
+    builds: list[str]
+    handoffs: list[Handoff]
+    pickup_timeout: float
+    roll_timeout: float
+    commits: dict[Handoff, str] = field(default_factory=dict)
+    followed: list[Followed] = field(default_factory=list)
+    unmatched: list[Handoff] = field(default_factory=list)
+    missing: dict[str, tuple[str, str]] = field(default_factory=dict)  # repo -> (URL, clone path)
+    error: str | None = None
+
+    def exit_status(self) -> int:
+        if self.error:
+            return 3
+        if self.missing:
+            return 4
+        states = {f.state for f in self.followed}
+        for state, status in ((FAILED, 5), (NOT_SEEN, 7), (MANUAL, 7), (NOT_DONE, 6)):
+            if state in states:
+                return status
+        return 0
+
