diff --git a/Jenkinsfile.architecture b/Jenkinsfile.architecture
new file mode 100644
index 0000000..62fd976
--- /dev/null
+++ b/Jenkinsfile.architecture
@@ -0,0 +1,39 @@
+// Architecture producer pipeline for the federated Architecture-as-Code model: this
+// repo publishes Argo CD's prd stage as producer `argocd-deploy`.
+//
+// The artifact is generated, never committed. gen-architecture renders chart/ the way
+// Argo CD renders it, reads the judgment layer (architecture.yaml at the repo root)
+// and writes docs/architecture/argocd-deploy.yaml — a path containing an
+// `architecture/` directory, which the federation collector's
+// `**/architecture/**/*.yaml` filter matches.
+//
+// One pipeline publishes one stage: the artifact is attached to the pipeline, so a
+// pipeline building two stages would make it flap. The branch is the one Argo syncs
+// this repo from (HelmCharts configs/prd/argocd/prd/release.yaml, `targetRevision`),
+// and the stage is the one that branch deploys.
+//
+// The agent needs outbound HTTPS to the argo-helm chart repository the chart's
+// dependency resolves from, and to architecture.webathome.org for the published
+// dataset and validation.
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+podTemplate(inheritFrom: 'jenkins-agent', containers: [
+    containerTemplates.aac_tools('aac-tools')
+]) {
+    node(POD_LABEL) {
+        stage('Cloning repo') {
+            git branch: 'main',
+                credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10',
+                url: 'https://github.com/pvginkel/ArgoCDDeploy.git'
+        }
+
+        stage('Architecture') {
+            container('aac-tools') {
+                sh 'gen-architecture --stage prd --producer argocd-deploy'
+                sh 'arch-validate docs/architecture/*.yaml'
+            }
+            archiveArtifacts artifacts: 'docs/architecture/*.yaml', fingerprint: true
+        }
+    }
+}
diff --git a/architecture.yaml b/architecture.yaml
new file mode 100644
index 0000000..effc052
--- /dev/null
+++ b/architecture.yaml
@@ -0,0 +1,43 @@
+# The judgment layer the aac-tools generator reads to publish this repo's prd stage
+# as producer `argocd-deploy` (Jenkinsfile.architecture). Everything else in the
+# artifact is derived from the render; the schema is gen-architecture's docstring.
+
+# The first commit carrying the chart. This repo was created for Argo CD's standup,
+# so its history dates the app.
+introduced: '2026-08-17'
+
+# Upstream products nobody else deploys, so this producer owns their catalog entries.
+products:
+  - id: ss:argo-cd
+    label: Argo CD
+    summary: Declarative GitOps continuous delivery for Kubernetes.
+    homepage: https://argo-cd.readthedocs.io/
+  - id: ss:redis
+    label: Redis
+    summary: In-memory key-value data store.
+    homepage: https://redis.io/
+
+images:
+  # One image runs every Argo CD component, the copyutil init container and the
+  # redis-secret-init Job included. No capability: `realizes` applies to every
+  # container of the image, and the one-shots realize none.
+  argocd: ss:argo-cd
+  # Argo CD's own cache, reached by name at the argocd-prd-redis Service.
+  redis:
+    product: ss:redis
+    realizes: [cap:cache]
+  # DockerImages' component, fronting Argo CD's two webhook receivers. One wire per
+  # receiver URL the pinned build reads (chart/templates/webhook-relay.yaml).
+  webhook-relay:
+    product: app:webhook-relay
+    upstream:
+      - env: ARGOCD_WEBHOOK_URL
+        providers: [server]
+      - env: APPLICATIONSET_WEBHOOK_URL
+        providers: [applicationset-controller]
+
+# Argo CD's UI, on both names its vhost answers to. deploy-hooks.webathome.org is
+# GitHub's machine endpoint, not a UI.
+webUi:
+  - argocd.home
+  - argocd
