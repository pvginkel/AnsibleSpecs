diff --git a/architecture.yaml b/architecture.yaml
new file mode 100644
index 0000000..d004e6c
--- /dev/null
+++ b/architecture.yaml
@@ -0,0 +1,25 @@
+# The judgment layer the aac-tools generator reads to publish this repo's prd stage
+# as producer `kubecoder-deploy` (Jenkinsfile.architecture). Everything else in the
+# artifact is derived from the render; the schema is gen-architecture's docstring.
+
+# The date HelmCharts derives from the first commit touching charts/kubecoder, and
+# the one every published KubeCoder element carries. This repo's history dates the
+# repo, not the app.
+introduced: '2026-06-17'
+
+# kubecoder is an in-house app (registry:5000/kubecoder-*) whose source and
+# «SoftwareProduct» catalog belong to the kubecoder producer (pvginkel/KubeCoder),
+# so we reference its app:* products and the generator resolves them to that
+# producer's UUIDs. No capability `realizes:` is asserted from this side.
+images:
+  kubecoder-controller: app:kubecoder-controller
+  kubecoder-bot: app:kubecoder-bot
+  kubecoder-mcp: app:kubecoder-mcp
+  kubecoder-manual: app:kubecoder-manual
+  # The controller pod's front door is stock nginx with a baked routing config.
+  kubecoder-ingress: ss:nginx
+  # kube-coder-tunnel-reclaim stays unmapped (a reported gap) until the generator
+  # resolves a Service's in-house product from its own container.
+  # Mapped now, the controller workload carries two in-house services and the
+  # generator mints a duplicate kubecoder.home service instead of referencing
+  # svc:kubecoder-controller-api.
