+# KubeCoder's controller pod: four containers behind one Service, two of them in-house
+# apps realizing their own service. The Service's port lands on the nginx `ingress`
+# sidecar; only its target-port annotation names the controller.
+KUBECODER_NS = "kubecoder-prd"
+KUBECODER_API = "svc:kubecoder-controller-api,00000000-0000-0000-0000-00000000000a"
+RECLAIM_API = "svc:kube-coder-tunnel-reclaim,00000000-0000-0000-0000-00000000000b"
+KUBECODER_CONTAINERS = (
+    ("ingress", "ss:nginx", 8090),
+    ("kubecoder-controller", "app:kubecoder-controller", 8080),
+    ("manual", "app:kubecoder-manual", 8081),
+    ("tunnel-reclaim", "app:kube-coder-tunnel-reclaim", 8092),
+)
+
+
+def _kubecoder_dataset():
+    ds = ga.Dataset()
+    ds.add_envelope(
+        {
+            "relations": [
+                {
+                    "id": f"rel:{bare}-provides-api",
+                    "type": "Realization",
+                    "source": f"{bare},00000000-0000-0000-0000-00000000000{n}",
+                    "target": svc,
+                }
+                for n, (bare, svc) in enumerate(
+                    (
+                        ("app:kubecoder-controller", KUBECODER_API),
+                        ("app:kube-coder-tunnel-reclaim", RECLAIM_API),
+                    )
+                )
+            ]
+        }
+    )
+    return ds
+
+
+def _kubecoder_workload(containers=KUBECODER_CONTAINERS):
+    wl = "kubecoder-controller"
+    backing = [
+        {
+            "hint": f"{KUBECODER_NS}-{wl}-{name}",
+            "id": ga.composite(
+                product.split(":")[0], f"{KUBECODER_NS}-{wl}-{name}", f"{KUBECODER_NS}.{wl}.{name}"
+            ),
+            "container": name,
+            "product": product,
+            "port_nums": {port},
+            "port_names": set(),
+        }
+        for name, product, port in containers
+    ]
+    return {
+        "name": wl,
+        "labels": {"app.kubernetes.io/name": wl},
+        "backing": backing,
+        "all": [b["id"] for b in backing],
+    }
+
+
+def _kubecoder_service(target_port_annotation="8080", target_port=8090):
+    anns = {ga.SERVER_NAME_ANNOTATION: "kubecoder.home"}
+    if target_port_annotation:
+        anns["nginx.webathome.org/target-port"] = target_port_annotation
+    return {
+        "kind": "Service",
+        "metadata": {"name": "kubecoder-controller", "annotations": anns},
+        "spec": {
+            "selector": {"app.kubernetes.io/name": "kubecoder-controller"},
+            "ports": [{"port": 8080, "targetPort": target_port}],
+        },
+    }
+
+
+def _reconcile_kubecoder(service, exposures=None, workload=None):
+    exposed = [
+        {
+            "doc": service,
+            "ns": KUBECODER_NS,
+            "env": "prd",
+            "introduced": "2026-06-17",
+            "release": "kubecoder",
+            "exposures": exposures or {},
+            "webUi": [],
+        }
+    ]
+    elements = {"applicationServices": {}, "applicationInterfaces": {}}
+    relations, add_rel = _relations()
+    gaps = []
+    ga.reconcile_exposed_services(
+        exposed,
+        {KUBECODER_NS: [workload or _kubecoder_workload()]},
+        elements,
+        add_rel,
+        _kubecoder_dataset(),
+        gaps,
+    )
+    [assignment] = [r for r in relations.values() if r["type"] == "Assignment"]
+    realizers = {
+        r["source"].split(",")[0] for r in relations.values() if r["type"] == "Realization"
+    }
+    return elements["applicationServices"], assignment["target"], realizers, gaps
+
+
+def _container_hint(container):
+    return f"app:{KUBECODER_NS}-kubecoder-controller-{container}"
