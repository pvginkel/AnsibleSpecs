+
+# Every key the generator reads from a deploy repo's architecture.yaml, by where it sits.
+JUDGMENT_KEYS = {
+    "the top level": {
+        "introduced",
+        "upstream",
+        "images",
+        "cnpg",
+        "products",
+        "exposures",
+        "webUi",
+        "mcpClients",
+    },
+    "upstream": set(ga.UPSTREAM_KEYS),
+    "an image entry": {"product", "kind", "realizes", "served_by", "upstream", "containers"},
+    "an upstream wire": {"env", "providers", "entry"},
+    "a container's entry": ga.SCOPED_KEYS,
+    "cnpg": ga.CNPG_KINDS,
+    "a cnpg entry": {"product", "realizes", "served_by"},
+    "a products entry": {"id", "label", "summary", "homepage", "logo", "introduced"},
+    "an mcpClients entry": {"configMap", "key", "hostField", "providers"},
+}
+
+
+def _help():
+    """What `gen-architecture --help` prints: the script run by path, as the image runs it."""
+    proc = subprocess.run(
+        [sys.executable, str(ROOT / "image" / "gen_architecture.py"), "--help"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return proc.stdout
+
+
+def _sketch(text):
+    """The judgment-layer sketch --help prints: the indented block opening `introduced:`."""
+    lines = text.splitlines()
+    start = next(i for i, line in enumerate(lines) if line.startswith("    introduced:"))
+    block = []
+    for line in lines[start:]:
+        if not line.startswith("    "):
+            break
+        block.append(line)
+    return yaml.safe_load(textwrap.dedent("\n".join(block)))
+
+
+class HelpContractTests(unittest.TestCase):
+    def test_help_prints_the_module_docstring_whole(self):
+        """One source: the contract --help prints is the one the module documents."""
+        self.assertIn(ga.__doc__.strip(), _help())
+
+    def test_help_names_every_key_the_judgment_layer_takes(self):
+        text = _help()
