diff --git a/tests/render-consumer.sh b/tests/render-consumer.sh
index 0c62f41..6bb5df3 100755
--- a/tests/render-consumer.sh
+++ b/tests/render-consumer.sh
@@ -130,6 +130,32 @@ if [ "$rendered_binding" != "$expected_binding" ]; then
 fi
 refute 'the hook identity is bound cluster-wide by the library' 'kind: ClusterRoleBinding'
 
+# --- the synced commit, in an ordinary object (D67) ---------------------------
+# Read whole, like the binding: the object exists so that each commit renders
+# differently, which only holds if it carries the revision it was given and is
+# not a hook — Argo leaves hooks out of its diff.
+rendered_revision="$(awk '
+  /^---/ { if (doc ~ /\nkind: ConfigMap\n/) printf "%s", doc; doc = ""; next }
+  /^# Source:/ { next }
+  { doc = doc "\n" $0 }
+  END { if (doc ~ /\nkind: ConfigMap\n/) printf "%s", doc }
+' "$RENDER" | sed '1{/^$/d}')"
+
+expected_revision='apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: tf-presync-revision
+  namespace: "consumer-prd"
+data:
+  revision: "0123456789abcdef0123456789abcdef01234567"'
+
+if [ "$rendered_revision" != "$expected_revision" ]; then
+  fail 'the hook include renders the wrong revision ConfigMap, or none'
+  printf '      expected:\n%s\n      got:\n%s\n' \
+    "$(printf '%s\n' "$expected_revision" | sed 's/^/        /')" \
+    "$(printf '%s\n' "$rendered_revision" | sed 's/^/        /')" >&2
+fi
+
 # --- the shared helpers ------------------------------------------------------
 expect 'deployment.timestamp'             'deployment: "'
 expect 'zpool2 node affinity key'         'key: homelab.local/storage'
@@ -169,6 +195,12 @@ if ! helm template consumer "$CONSUMER" --set hook.imageTag=42 |
   fail 'an app cannot override hook.imageTag'
 fi
 
+# --- a different commit renders a different object ---------------------------
+if ! helm template consumer "$CONSUMER" --set hook.revision=fedcba9876543210fedcba9876543210fedcba98 |
+  grep -qF -- 'revision: "fedcba9876543210fedcba9876543210fedcba98"'; then
+  fail 'the revision ConfigMap does not follow hook.revision'
+fi
+
 # --- the Job name fits the 63-character limit ---------------------------------
 # tf-presync- plus the longest namespace that fits (52 characters) renders; one
 # more fails the render rather than the sync.
