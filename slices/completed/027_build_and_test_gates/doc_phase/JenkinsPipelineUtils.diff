+package org.webathome.jenkinspipelineutils;
+
+import static org.junit.jupiter.api.Assertions.assertInstanceOf;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import com.cloudbees.groovy.cps.CpsTransformer;
+import com.cloudbees.groovy.cps.SerializableScript;
+import com.cloudbees.groovy.cps.TransformerConfiguration;
+import com.cloudbees.groovy.cps.impl.CpsCallableInvocation;
+import groovy.lang.GroovyClassLoader;
+import java.io.IOException;
+import java.lang.reflect.InvocationTargetException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+import java.util.stream.Stream;
+import org.codehaus.groovy.control.CompilationFailedException;
+import org.codehaus.groovy.control.CompilerConfiguration;
+import org.codehaus.groovy.control.customizers.ImportCustomizer;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+
+class LibraryCompileTest {
+
+    private static final Path LIBRARY = Paths.get(System.getProperty("library.root")).normalize();
+
+    /**
+     * The class loader the controller compiles this library with: it loads it as a Global
+     * Trusted Pipeline Library, so workflow-cps compiles it in the shell
+     * CpsGroovyShellFactory.forTrusted() builds, outside the script-security sandbox, with
+     * the library's src/ and vars/ on the class path. CpsScript, CpsClosure2 and Safepoint are
+     * workflow-cps plugin classes, not groovy-cps ones, so their groovy-cps superclasses and a
+     * no-op safepoint take their place.
+     */
+    private static GroovyClassLoader trustedLoader() throws IOException {
+        ImportCustomizer imports = new ImportCustomizer();
+        imports.addStarImports("com.cloudbees.groovy.cps", "hudson.model", "jenkins.model");
+
+        CpsTransformer transformer = new CpsTransformer();
+        transformer.setConfiguration(
+                new TransformerConfiguration().withSafepoint(LibraryCompileTest.class, "safepoint"));
+
+        CompilerConfiguration config = new CompilerConfiguration();
+        config.addCompilationCustomizers(imports);
+        config.addCompilationCustomizers(transformer);
+        config.setScriptBaseClass(SerializableScript.class.getName());
+
+        GroovyClassLoader loader = new GroovyClassLoader(LibraryCompileTest.class.getClassLoader(), config);
+        loader.addURL(LIBRARY.resolve("src").toUri().toURL());
+        loader.addURL(LIBRARY.resolve("vars").toUri().toURL());
+        return loader;
+    }
+
+    public static void safepoint() {}
+
+    static Stream<String> libraryVariables() throws IOException {
+        try (Stream<Path> files = Files.list(LIBRARY.resolve("vars"))) {
+            return files.map(f -> f.getFileName().toString())
+                    .filter(n -> n.endsWith(".groovy"))
+                    .map(n -> n.substring(0, n.length() - ".groovy".length()))
+                    .sorted()
+                    .toList()
+                    .stream();
+        }
+    }
+
+    // The controller loads a global variable by name from vars/, as this does.
+    @ParameterizedTest(name = "vars/{0}.groovy")
+    @MethodSource("libraryVariables")
+    void libraryVariableCompiles(String name) throws Exception {
+        try (GroovyClassLoader loader = trustedLoader()) {
+            loader.loadClass(name);
+        }
+    }
+
+    @Test
+    void syntaxErrorIsRefused() throws IOException {
+        try (GroovyClassLoader loader = trustedLoader()) {
+            assertThrows(CompilationFailedException.class, () -> loader.parseClass("def broken( {", "control.groovy"));
+        }
+    }
+
+    @Test
+    void synchronizedBlockIsRefused() throws IOException {
+        try (GroovyClassLoader loader = trustedLoader()) {
+            CompilationFailedException refused = assertThrows(
+                    CompilationFailedException.class,
+                    () -> loader.parseClass("def f() { synchronized (this) { 1 } }", "control.groovy"));
+            assertTrue(
+                    refused.getMessage().contains("synchronized is unsupported for CPS transformation"),
+                    refused.getMessage());
+        }
+    }
+
+    // A method the transform rewrote hands its body to the CPS engine instead of running it.
+    @Test
+    void methodBodiesAreCpsTransformed() throws Exception {
+        try (GroovyClassLoader loader = trustedLoader()) {
+            Class<?> control = loader.parseClass("def f() { 1 }", "control.groovy");
+            Object script = control.getDeclaredConstructor().newInstance();
+            InvocationTargetException call =
+                    assertThrows(InvocationTargetException.class, () -> control.getMethod("f").invoke(script));
+            assertInstanceOf(CpsCallableInvocation.class, call.getCause());
+        }
+    }
+}

