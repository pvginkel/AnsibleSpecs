+# Curated entry points for JenkinsPipelineUtils, the shared library every Jenkins job loads
+# unpinned from main. Java and Maven live in the `java` toolchain sidecar, so the verb carries
+# its `cexec` prefix here and only here. No Jenkins job builds this repo.
+
+projects:
+  root:
+    description: >-
+      The estate's shared Jenkins pipeline library — the global variables in vars/
+      that every Jenkinsfile calls, from container templates and git helpers to
+      Helm and kubectl steps and Telegram notifications.
+    # Compiles every vars/*.groovy through the CPS transform at the controller's
+    # workflow-cps version, as the controller loads a trusted library — see
+    # tests/pom.xml for the pin. -q keeps a passing run's Maven output out of the gate.
+    test: cexec java mvn -B -q -f tests/pom.xml test
