diff --git a/tests/alert-rules/node-reservation.yml b/tests/alert-rules/node-reservation.yml
new file mode 100644
index 0000000..3d02749
--- /dev/null
+++ b/tests/alert-rules/node-reservation.yml
@@ -0,0 +1,35 @@
+# The node-reservation group, over synthetic kube-state-metrics series.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: a node left with microk8s' 100Mi default fires after 30m; a node with its reservation, and CPU, stay quiet
+    interval: 1m
+    input_series:
+      # srvk8s1: capacity - allocatable is exactly 100Mi.
+      - series: kube_node_status_capacity{job="kubernetes-service-endpoints", instance="172.16.129.159:8080", node="srvk8s1", resource="memory", unit="byte"}
+        values: 16746078208x40
+      - series: kube_node_status_allocatable{job="kubernetes-service-endpoints", instance="172.16.129.159:8080", node="srvk8s1", resource="memory", unit="byte"}
+        values: 16641220608x40
+      # srvk8s2: 1Gi of kube-reserved on top of the 100Mi; its CPU has nothing reserved.
+      - series: kube_node_status_capacity{job="kubernetes-service-endpoints", instance="172.16.129.159:8080", node="srvk8s2", resource="memory", unit="byte"}
+        values: 16747880448x40
+      - series: kube_node_status_allocatable{job="kubernetes-service-endpoints", instance="172.16.129.159:8080", node="srvk8s2", resource="memory", unit="byte"}
+        values: 15569281024x40
+      - series: kube_node_status_capacity{job="kubernetes-service-endpoints", instance="172.16.129.159:8080", node="srvk8s2", resource="cpu", unit="core"}
+        values: 4x40
+      - series: kube_node_status_allocatable{job="kubernetes-service-endpoints", instance="172.16.129.159:8080", node="srvk8s2", resource="cpu", unit="core"}
+        values: 4x40
+    alert_rule_test:
+      - {alertname: NodeKubeReservedMissing, eval_time: 29m}
+      - alertname: NodeKubeReservedMissing
+        eval_time: 30m
+        exp_alerts:
+          - exp_labels: {node: srvk8s1, severity: warning}
+            exp_annotations:
+              summary: srvk8s1 has no kube-reserved
+              description: >-
+                Nothing is set aside for the OS, kubelet, containerd or (on a control-plane node)
+                kubelite. Re-run site-k8s.yml against the node; check whether a snap refresh
+                rewrote args/kubelet.
diff --git a/tests/alert-rules/s3-mirror.yml b/tests/alert-rules/s3-mirror.yml
new file mode 100644
index 0000000..11d45ea
--- /dev/null
+++ b/tests/alert-rules/s3-mirror.yml
@@ -0,0 +1,54 @@
+# The s3-mirror group, over synthetic kube-state-metrics series. Its threshold is its own 52 h;
+# the CronJob's schedule and deadline it was set from are not modelled.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: fires once the newest success is over 52h old, and clears when a run succeeds
+    interval: 1m
+    input_series:
+      # Succeeded at 1 h, and next at 56 h.
+      - series: kube_cronjob_status_last_successful_time{job="kubernetes-service-endpoints", namespace="storage-prd", cronjob="s3-mirror"}
+        values: 3600x3359 201600x60
+      - series: kube_cronjob_created{job="kubernetes-service-endpoints", namespace="storage-prd", cronjob="s3-mirror"}
+        values: 0x3420
+    alert_rule_test:
+      - {alertname: S3MirrorStale, eval_time: 53h}
+      - alertname: S3MirrorStale
+        eval_time: 53h1m
+        exp_alerts:
+          - &stale
+            exp_labels: {namespace: storage-prd, cronjob: s3-mirror, severity: critical}
+            exp_annotations:
+              summary: S3 bucket mirror has not succeeded for 2d 4h 1m 0s
+              description: >-
+                Two nightly runs of the s3-mirror CronJob in storage-prd have failed, so the
+                Google Drive copy of the prd buckets is no longer refreshed. Read the latest
+                s3-mirror Job's logs: a bucket it cannot list or read, an rclone error, or the
+                2 h deadline each fail the run.
+      - {alertname: S3MirrorStale, eval_time: 56h}
+
+  - name: a CronJob that never succeeded counts from its creation
+    interval: 1m
+    input_series:
+      - series: kube_cronjob_created{job="kubernetes-service-endpoints", namespace="storage-prd", cronjob="s3-mirror"}
+        values: 3600x3181
+    alert_rule_test:
+      - {alertname: S3MirrorStale, eval_time: 53h}
+      - {alertname: S3MirrorStale, eval_time: 53h1m, exp_alerts: [*stale]}
+
+  - name: the newest success counts over the creation, and other CronJobs are not watched
+    interval: 1m
+    input_series:
+      # Created at 0 and succeeded at 50 h; the others last succeeded at 0.
+      - series: kube_cronjob_created{job="kubernetes-service-endpoints", namespace="storage-prd", cronjob="s3-mirror"}
+        values: 0x3600
+      - series: kube_cronjob_status_last_successful_time{job="kubernetes-service-endpoints", namespace="storage-prd", cronjob="s3-mirror"}
+        values: 180000x3600
+      - series: kube_cronjob_status_last_successful_time{job="kubernetes-service-endpoints", namespace="storage-dev", cronjob="s3-mirror"}
+        values: 0x3600
+      - series: kube_cronjob_status_last_successful_time{job="kubernetes-service-endpoints", namespace="storage-prd", cronjob="another-cronjob"}
+        values: 0x3600
+    alert_rule_test:
+      - {alertname: S3MirrorStale, eval_time: 60h}
