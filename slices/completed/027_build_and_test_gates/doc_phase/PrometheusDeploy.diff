+# The youtrack-backup group, over synthetic kube-state-metrics series. Its threshold is its own
+# 52 h; the CronJob's schedule and deadline it was set from are not modelled.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: fires once the newest success is over 52h old, and clears when a run succeeds
+    interval: 1m
+    input_series:
+      # Succeeded at 1 h, and next at 56 h.
+      - series: kube_cronjob_status_last_successful_time{job="kubernetes-service-endpoints", namespace="youtrack-prd", cronjob="youtrack-backup"}
+        values: 3600x3359 201600x60
+      - series: kube_cronjob_created{job="kubernetes-service-endpoints", namespace="youtrack-prd", cronjob="youtrack-backup"}
+        values: 0x3420
+    alert_rule_test:
+      - {alertname: YouTrackBackupStale, eval_time: 53h}
+      - alertname: YouTrackBackupStale
+        eval_time: 53h1m
+        exp_alerts:
+          - &stale
+            exp_labels: {namespace: youtrack-prd, cronjob: youtrack-backup, severity: critical}
+            exp_annotations:
+              summary: YouTrack backup has not succeeded for 2d 4h 1m 0s
+              description: >-
+                Two nightly runs of the youtrack-backup CronJob in youtrack-prd have failed, so
+                no fresh copy of the tracker has reached the backup-server. Read the latest
+                youtrack-backup Job's logs: a rejected token, a backup error YouTrack reported, a
+                failed download or upload, or the 1 h deadline each fail the run.
+      - {alertname: YouTrackBackupStale, eval_time: 56h}
+
+  - name: a CronJob that never succeeded counts from its creation
+    interval: 1m
+    input_series:
+      - series: kube_cronjob_created{job="kubernetes-service-endpoints", namespace="youtrack-prd", cronjob="youtrack-backup"}
+        values: 3600x3181
+    alert_rule_test:
+      - {alertname: YouTrackBackupStale, eval_time: 53h}
+      - {alertname: YouTrackBackupStale, eval_time: 53h1m, exp_alerts: [*stale]}
+
+  - name: the newest success counts over the creation, and other CronJobs are not watched
+    interval: 1m
+    input_series:
+      # Created at 0 and succeeded at 50 h; the others last succeeded at 0.
+      - series: kube_cronjob_created{job="kubernetes-service-endpoints", namespace="youtrack-prd", cronjob="youtrack-backup"}
+        values: 0x3600
+      - series: kube_cronjob_status_last_successful_time{job="kubernetes-service-endpoints", namespace="youtrack-prd", cronjob="youtrack-backup"}
+        values: 180000x3600
+      - series: kube_cronjob_status_last_successful_time{job="kubernetes-service-endpoints", namespace="youtrack-dev", cronjob="youtrack-backup"}
+        values: 0x3600
+      - series: kube_cronjob_status_last_successful_time{job="kubernetes-service-endpoints", namespace="storage-prd", cronjob="s3-mirror"}
+        values: 0x3600
+    alert_rule_test:
+      - {alertname: YouTrackBackupStale, eval_time: 60h}
