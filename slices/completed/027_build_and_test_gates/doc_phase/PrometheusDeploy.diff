+# The backup-freshness group, over synthetic backup-server series. A value is a Unix time in
+# seconds, on the same clock as the test's: 21600 is 6 h in.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: an overdue stream fires once its validity passes and clears when a backup lands; the others stay quiet
+    interval: 1m
+    input_series:
+      # Valid until 6 h; a backup landing at 10 h makes it valid until 62 h.
+      - series: backup_server_stream_valid_until_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.234:8081", scope="postgres-pas", filename="design_assistant_prd_db.dump"}
+        values: 21600x599 223200x60
+      - series: backup_server_stream_valid_until_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.234:8081", scope="openbao", filename="openbao.snap"}
+        values: 223200x660
+      # Another namespace's backup-server, long overdue.
+      - series: backup_server_stream_valid_until_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-dev", service="backup-server", instance="172.16.128.200:8081", scope="postgres-pas", filename="design_assistant_dev_db.dump"}
+        values: 0x660
+    alert_rule_test:
+      - {alertname: BackupOverdue, eval_time: 6h}
+      - alertname: BackupOverdue
+        eval_time: 6h1m
+        exp_alerts:
+          - exp_labels: {scope: postgres-pas, filename: design_assistant_prd_db.dump, severity: critical}
+            exp_annotations:
+              summary: Backup postgres-pas/design_assistant_prd_db.dump is 1m 0s past its validity
+              description: &prd_db_description >-
+                No backup of design_assistant_prd_db.dump has reached backup-server's
+                postgres-pas scope within the validity its uploads declared. Read the uploader's
+                logs. For openbao: the openbao-backup unit's journal on the srvvaultN nodes; only
+                the Raft leader uploads, and the others log "not the Raft leader". For
+                postgres-pas: the latest postgres-backup Job in postgres-pas-prd.
+      - {alertname: BackupOverdue, eval_time: 10h}
+
+  - name: an overdue stream that leaves clears 6h after its last scrape; one a redeploy's new pod republishes fires once
+    interval: 1m
+    input_series:
+      # The old pod publishes both streams until 8 h. The Deployment is Recreate: the new pod
+      # scrapes from 8 h 30 m and publishes only the prd stream, after its first read at 8 h 40 m.
+      - series: backup_server_stream_valid_until_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.234:8081", scope="postgres-pas", filename="design_assistant_tst_db.dump"}
+        values: 21600x479 stale
+      - series: backup_server_stream_valid_until_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.234:8081", scope="postgres-pas", filename="design_assistant_prd_db.dump"}
+        values: 21600x479 stale
+      - series: backup_server_stream_valid_until_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.240:8081", scope="postgres-pas", filename="design_assistant_prd_db.dump"}
+        values: _x520 21600x400
+    alert_rule_test:
+      - alertname: BackupOverdue
+        eval_time: 8h20m
+        exp_alerts:
+          - exp_labels: &prd_db {scope: postgres-pas, filename: design_assistant_prd_db.dump, severity: critical}
+            exp_annotations:
+              summary: Backup postgres-pas/design_assistant_prd_db.dump is 2h 20m 0s past its validity
+              description: *prd_db_description
+          - exp_labels: &tst_db {scope: postgres-pas, filename: design_assistant_tst_db.dump, severity: critical}
+            exp_annotations:
+              summary: Backup postgres-pas/design_assistant_tst_db.dump is 2h 20m 0s past its validity
+              description: &tst_db_description >-
+                No backup of design_assistant_tst_db.dump has reached backup-server's
+                postgres-pas scope within the validity its uploads declared. Read the uploader's
+                logs. For openbao: the openbao-backup unit's journal on the srvvaultN nodes; only
+                the Raft leader uploads, and the others log "not the Raft leader". For
+                postgres-pas: the latest postgres-backup Job in postgres-pas-prd.
+      - alertname: BackupOverdue
+        eval_time: 13h58m
+        exp_alerts:
+          - exp_labels: *prd_db
+            exp_annotations:
+              summary: Backup postgres-pas/design_assistant_prd_db.dump is 7h 58m 0s past its validity
+              description: *prd_db_description
+          - exp_labels: *tst_db
+            exp_annotations:
+              summary: Backup postgres-pas/design_assistant_tst_db.dump is 7h 58m 0s past its validity
+              description: *tst_db_description
+      - alertname: BackupOverdue
+        eval_time: 13h59m
+        exp_alerts:
+          - exp_labels: *prd_db
+            exp_annotations:
+              summary: Backup postgres-pas/design_assistant_prd_db.dump is 7h 59m 0s past its validity
+              description: *prd_db_description
+
+  - name: a watcher whose reads keep failing is blind 6h after its newest read
+    interval: 1m
+    input_series:
+      # A fresh process publishes 0 until its first read, at 10 m; every read after fails.
+      - series: backup_server_refresh_last_success_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.234:8081"}
+        values: 0x9 600x410
+    alert_rule_test:
+      - {alertname: BackupWatcherBlind, eval_time: 6h10m}
+      - alertname: BackupWatcherBlind
+        eval_time: 6h11m
+        exp_alerts:
+          - &blind
+            exp_labels: {namespace: storage-prd, service: backup-server, severity: critical}
+            exp_annotations:
+              summary: 'Backup freshness is unwatched: backup-server has not read its cloud storage for over 6h'
+              description: >-
+                No scrape of backup-server in storage-prd in the last 6 h reported a successful
+                read of its cloud storage, so BackupOverdue cannot fire. Either Prometheus cannot
+                scrape it (its pod is down, crash-looping or gone; check the target in
+                Prometheus) or its hourly read fails (its pod logs "freshness refresh:" errors).
+
+  - name: a target that is gone is blind 6h after its newest read, and still once that sample leaves the look-back
+    interval: 1m
+    input_series:
+      # Read at 10 m; the target goes at 1 h.
+      - series: backup_server_refresh_last_success_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.234:8081"}
+        values: 0x9 600x50 stale
+    alert_rule_test:
+      - {alertname: BackupWatcherBlind, eval_time: 6h10m}
+      - {alertname: BackupWatcherBlind, eval_time: 6h11m, exp_alerts: [*blind]}
+      - {alertname: BackupWatcherBlind, eval_time: 7h1m, exp_alerts: [*blind]}
+
+  - name: a redeploy's new pod publishing 0 before its first read does not make the watcher blind
+    interval: 1m
+    input_series:
+      # The old pod reads at 10 m and hourly after, and goes at 6 h 40 m. The new pod is scraped
+      # from 7 h 11 m; its reads at 7 h 10 m, 8 h 10 m and 9 h 10 m fail, and the one at
+      # 10 h 10 m completes at 10 h 20 m.
+      - series: backup_server_refresh_last_success_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.234:8081"}
+        values: 0x9 600x59 4200x59 7800x59 11400x59 15000x59 18600x59 22200x29 stale
+      - series: backup_server_refresh_last_success_timestamp_seconds{job="kubernetes-service-endpoints", namespace="storage-prd", service="backup-server", instance="172.16.128.240:8081"}
+        values: _x431 0x188 37200x60
+    alert_rule_test:
+      - {alertname: BackupWatcherBlind, eval_time: 7h20m}
+      - {alertname: BackupWatcherBlind, eval_time: 10h19m}
+      - {alertname: BackupWatcherBlind, eval_time: 11h20m}
