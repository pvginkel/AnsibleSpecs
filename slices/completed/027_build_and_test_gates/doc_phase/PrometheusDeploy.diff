@@ -0,0 +1,254 @@
+# The node-memory-pressure group, over synthetic node-exporter series: the scenarios slice 018
+# witnessed when it set the thresholds. Memory is 16 GB; a stall counter rising 6 s/min is a
+# stall of 10% of wall-time, 42000 major faults/min is 700/s.
+rule_files:
+  - ../alerting_rules.yml
+evaluation_interval: 1m
+
+tests:
+  - name: the 2026-08-02 starvation fires both stall alerts after their for, and not the wedge warning
+    interval: 1m
+    input_series:
+      # A 10% stall throughout. 20% of memory available and 100 major faults/s, and from 20 m the
+      # starvation: 4% available, 700 faults/s.
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s1"}
+        values: 0+6x40
+      - series: node_memory_MemAvailable_bytes{job="kubernetes-service-endpoints", node="srvk8s1"}
+        values: 3200000000x19 640000000x20
+      - series: node_memory_MemTotal_bytes{job="kubernetes-service-endpoints", node="srvk8s1"}
+        values: 16000000000x40
+      - series: node_vmstat_pgmajfault{job="kubernetes-service-endpoints", node="srvk8s1"}
+        values: 0+6000x19 156000+42000x20
+    alert_rule_test:
+      - {alertname: NodeMemoryStalled, eval_time: 29m}
+      - alertname: NodeMemoryStalled
+        eval_time: 30m
+        exp_alerts:
+          - &srvk8s1_stalled
+            exp_labels: {node: srvk8s1, severity: critical}
+            exp_annotations:
+              summary: srvk8s1 stalled on memory 10% of wall-time
+              description: &stalled_description >-
+                Sustained full memory-pressure stall while the node is short of memory or
+                thrashing. The node is in direct reclaim and will start losing pods to
+                liveness-probe timeouts long before kubelet's eviction threshold is reached.
+                Compare per-node memory requests against actual usage and look for requestless
+                workloads.
+      - {alertname: NodeMemoryStallElevated, eval_time: 34m}
+      - alertname: NodeMemoryStallElevated
+        eval_time: 35m
+        exp_alerts:
+          - &srvk8s1_elevated
+            exp_labels: {node: srvk8s1, severity: warning}
+            exp_annotations:
+              summary: srvk8s1 under elevated memory pressure (10% of wall-time stalled)
+              description: &elevated_description >-
+                Above the 0.02 s/s ceiling the cluster is sized for, while the node is short of
+                memory or thrashing. Not yet service-affecting, but the node has no absorption
+                capacity left for a drain or a load spike.
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 40m}
+
+  - name: each memory signal alone corroborates a stall, and 0.02 to 0.05 is elevated only
+    interval: 1m
+    input_series:
+      # srvk8s2: a 3% stall while thrashing with half its memory available.
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 0+1.8x30
+      - series: node_memory_MemAvailable_bytes{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 8000000000x30
+      - series: node_memory_MemTotal_bytes{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 16000000000x30
+      - series: node_vmstat_pgmajfault{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 0+42000x30
+      # srvk8s3: a 10% stall, short of memory and not faulting.
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s3"}
+        values: 0+6x30
+      - series: node_memory_MemAvailable_bytes{job="kubernetes-service-endpoints", node="srvk8s3"}
+        values: 640000000x30
+      - series: node_memory_MemTotal_bytes{job="kubernetes-service-endpoints", node="srvk8s3"}
+        values: 16000000000x30
+      - series: node_vmstat_pgmajfault{job="kubernetes-service-endpoints", node="srvk8s3"}
+        values: 0x30
+    alert_rule_test:
+      - alertname: NodeMemoryStalled
+        eval_time: 20m
+        exp_alerts:
+          - exp_labels: {node: srvk8s3, severity: critical}
+            exp_annotations:
+              summary: srvk8s3 stalled on memory 10% of wall-time
+              description: *stalled_description
+      - alertname: NodeMemoryStallElevated
+        eval_time: 20m
+        exp_alerts:
+          - exp_labels: {node: srvk8s2, severity: warning}
+            exp_annotations:
+              summary: srvk8s2 under elevated memory pressure (3% of wall-time stalled)
+              description: *elevated_description
+          - exp_labels: {node: srvk8s3, severity: warning}
+            exp_annotations:
+              summary: srvk8s3 under elevated memory pressure (10% of wall-time stalled)
+              description: *elevated_description
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 20m}
+
+  - name: a healthy memory-tight node, a stall and a memory shortage on different nodes, and a host outside the cluster stay quiet
+    interval: 1m
+    input_series:
+      # srvk8s1: 3% available and 842 major faults/s, stalled 1% of wall-time.
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s1"}
+        values: 0+0.6x90
+      - series: node_memory_MemAvailable_bytes{job="kubernetes-service-endpoints", node="srvk8s1"}
+        values: 480000000x90
+      - series: node_memory_MemTotal_bytes{job="kubernetes-service-endpoints", node="srvk8s1"}
+        values: 16000000000x90
+      - series: node_vmstat_pgmajfault{job="kubernetes-service-endpoints", node="srvk8s1"}
+        values: 0+50520x90
+      # srvk8s2 stalls 10% with 20% available and 100 major faults/s; srvk8s3 is short of memory
+      # and thrashing without stalling.
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 0+6x90
+      - series: node_memory_MemAvailable_bytes{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 3200000000x90
+      - series: node_memory_MemTotal_bytes{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 16000000000x90
+      - series: node_vmstat_pgmajfault{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 0+6000x90
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s3"}
+        values: 0x90
+      - series: node_memory_MemAvailable_bytes{job="kubernetes-service-endpoints", node="srvk8s3"}
+        values: 640000000x90
+      - series: node_memory_MemTotal_bytes{job="kubernetes-service-endpoints", node="srvk8s3"}
+        values: 16000000000x90
+      - series: node_vmstat_pgmajfault{job="kubernetes-service-endpoints", node="srvk8s3"}
+        values: 0+42000x90
+      # A Proxmox host scraped by the homelab-nodes job, starving.
+      - series: node_pressure_memory_stalled_seconds_total{job="homelab-nodes", instance="pve1.home:9100", role="proxmox"}
+        values: 0+6x90
+      - series: node_memory_MemAvailable_bytes{job="homelab-nodes", instance="pve1.home:9100", role="proxmox"}
+        values: 640000000x90
+      - series: node_memory_MemTotal_bytes{job="homelab-nodes", instance="pve1.home:9100", role="proxmox"}
+        values: 16000000000x90
+      - series: node_vmstat_pgmajfault{job="homelab-nodes", instance="pve1.home:9100", role="proxmox"}
+        values: 0+42000x90
+    alert_rule_test:
+      - {alertname: NodeMemoryStalled, eval_time: 80m}
+      - {alertname: NodeMemoryStallElevated, eval_time: 80m}
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 80m}
+
+  - name: a wedged counter (srvk8s2 2026-09-07..13) fires only the wedge warning, which holds through a memory dip until a reboot resets the counter
+    interval: 1m
+    input_series:
+      # A 10% stall with no major faults. 20% of memory available, and from 10 m 37%, but for a
+      # 60 m dip to 3% at 700 faults/s from 120 m. The node reboots at 240 m: 10 m unscraped,
+      # then counters from 0 and a 0.1% stall.
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 0+6x239 _x10 0+0.06x30
+      - series: node_memory_MemAvailable_bytes{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 3200000000x9 5920000000x109 480000000x59 5920000000x59 _x10 5920000000x30
+      - series: node_memory_MemTotal_bytes{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 16000000000x239 _x10 16000000000x30
+      - series: node_vmstat_pgmajfault{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 0x119 42000+42000x59 2520000x59 _x10 0+132x30
+    alert_rule_test:
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 69m}
+      - alertname: NodeMemoryStallCounterWedged
+        eval_time: 70m
+        exp_alerts:
+          - &srvk8s2_wedged
+            exp_labels: {node: srvk8s2, severity: warning}
+            exp_annotations:
+              summary: srvk8s2 memory-stall counter looks wedged; its stall alerts are blind until it is rebooted
+              description: >-
+                The node reports 10% of wall-time stalled on memory while it has memory to spare
+                and no major faults: the kernel's PSI counter is stuck, not the node.
+                NodeMemoryStalled and NodeMemoryStallElevated cannot tell a real stall on this
+                node from the stuck counter until it is rebooted, which resets the counter and
+                resolves this alert.
+      - {alertname: NodeMemoryStalled, eval_time: 110m}
+      - {alertname: NodeMemoryStallElevated, eval_time: 110m}
+      # 30 m into the dip the stall alerts fire on the memory signals, and the warning holds.
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 150m, exp_alerts: [*srvk8s2_wedged]}
+      - alertname: NodeMemoryStalled
+        eval_time: 150m
+        exp_alerts:
+          - exp_labels: {node: srvk8s2, severity: critical}
+            exp_annotations:
+              summary: srvk8s2 stalled on memory 10% of wall-time
+              description: *stalled_description
+      - alertname: NodeMemoryStallElevated
+        eval_time: 150m
+        exp_alerts:
+          - exp_labels: {node: srvk8s2, severity: warning}
+            exp_annotations:
+              summary: srvk8s2 under elevated memory pressure (10% of wall-time stalled)
+              description: *elevated_description
+      # After the dip, the hour's major faults still disqualify the node; the warning holds.
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 200m, exp_alerts: [*srvk8s2_wedged]}
+      - {alertname: NodeMemoryStalled, eval_time: 200m}
+      - {alertname: NodeMemoryStallElevated, eval_time: 200m}
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 260m}
+
+  - name: after a reboot a wedge warning does not carry over into a real stall, which has to qualify afresh
+    interval: 1m
+    input_series:
+      # Wedged until the reboot at 90 m, 10 m unscraped, then starving: 4% available, 700 faults/s.
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 0+6x89 _x10 0+6x120
+      - series: node_memory_MemAvailable_bytes{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 5920000000x89 _x10 640000000x120
+      - series: node_memory_MemTotal_bytes{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 16000000000x89 _x10 16000000000x120
+      - series: node_vmstat_pgmajfault{job="kubernetes-service-endpoints", node="srvk8s2"}
+        values: 0x89 _x10 0+42000x120
+    alert_rule_test:
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 80m, exp_alerts: [*srvk8s2_wedged]}
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 125m}
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 170m}
+      - {alertname: NodeMemoryStallCounterWedged, eval_time: 220m}
+      - alertname: NodeMemoryStalled
+        eval_time: 170m
+        exp_alerts:
+          - exp_labels: {node: srvk8s2, severity: critical}
+            exp_annotations:
+              summary: srvk8s2 stalled on memory 10% of wall-time
+              description: *stalled_description
+
+  - name: a node-exporter chart upgrade's overlapping series, differing only in helm_sh_chart, give one alert per node
+    interval: 1m
+    input_series:
+      # srvk8s1 starving, srvk8s2 wedged, each scraped twice.
+      - series: node_pressure_memory_stalled_seconds_total{job="kubernetes-service-endpoints", node="srvk8s1", instance="10.1.0.27:9100", helm_sh_chart="prometheus-node-exporter-4.56.3"}
+        values: 0+6x70
