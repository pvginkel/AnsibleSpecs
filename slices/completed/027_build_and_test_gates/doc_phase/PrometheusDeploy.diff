@@ -0,0 +1,17 @@
+#!/bin/sh
+# prd's alerting rules as the upstream chart renders them into the server ConfigMap, at the pin
+# architecture.yaml's `upstream` gives: `promtool check rules`, then the unit tests under
+# tests/alert-rules/. promtool is the iac toolchain's, pinned to prd's Prometheus. The tests run
+# from copies in ./tests beside the render, which their `rule_files` names.
+set -eu
+cd "$(dirname "$0")/.."
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+helm template prometheus-prd "$(yq -er .upstream.chart architecture.yaml)" \
+  --repo "$(yq -er .upstream.repo architecture.yaml)" --version "$(yq -er .upstream.version architecture.yaml)" \
+  --namespace prometheus-prd --values config/prd/values.yaml --show-only templates/cm.yaml >"$work/cm.yaml"
+yq -er '.data["alerting_rules.yml"]' "$work/cm.yaml" >"$work/alerting_rules.yml"
+promtool check rules "$work/alerting_rules.yml"
+mkdir "$work/tests"
+cp tests/alert-rules/*.yml "$work/tests/"
+promtool test rules "$work"/tests/*.yml
