+# --------------------------------------------------------------------------- #
+# The artifact: strings a YAML 1.2 reader takes for numbers are quoted
+# --------------------------------------------------------------------------- #
+
+NUMBER_LIKE = [
+    "1e5",
+    "1.5e3",
+    "0o17",
+    "089",
+    "9e10234",
+    "1_0e5",
+    "0o1_7",
+    "0b1_0",
+    "+0x_F",
+    "-.5",
+    "1.",
+]
+
+
+class ArtifactQuotingTests(unittest.TestCase):
+    def test_strings_a_yaml_1_2_reader_takes_for_numbers_are_written_quoted(self):
+        """The validate service reads the artifact with js-yaml 4, where `9e10234` is a
+        float (Infinity) and `1_0e5` one million; PyYAML's 1.1 rules leave them plain."""
+        for value in NUMBER_LIKE:
+            with self.subTest(value=value):
+                text = ga.dump_yaml({"version": value})
+                self.assertEqual(text, f"version: '{value}'\n")
+                self.assertEqual(yaml.safe_load(text), {"version": value})
+
+    def test_other_strings_and_non_string_values_are_written_as_safe_dump_writes_them(self):
+        doc = {
+            "version": "1.2.3",
+            "build": "9e1x",
+            "trailing": "1_",
+            "underscored": "_1",
+            "hex": "0xG",
+            "name": "Hall blind — Ø",
+            "count": 42,
+            "ratio": 1.5e3,
+            "huge": float("inf"),
+            "on": True,
+            "none": None,
+            "tags": ["v1", "2024.10.1"],
+            "nested": {"image": "registry:5000/app:1.0"},
+        }
+
+        self.assertEqual(
+            ga.dump_yaml(doc),
+            yaml.safe_dump(doc, sort_keys=False, default_flow_style=False, allow_unicode=True),
+        )
