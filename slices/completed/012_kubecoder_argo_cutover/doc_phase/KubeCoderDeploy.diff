diff --git a/Jenkinsfile.promote b/Jenkinsfile.promote
new file mode 100644
index 0000000..9753efb
--- /dev/null
+++ b/Jenkinsfile.promote
@@ -0,0 +1,180 @@
+// KubeCoder's promote job (D2): moves a validated commit on `main` to prd, which Argo CD syncs
+// from the `prd` branch (D34). Run by hand; it promotes main's tip unless `commit` names an
+// earlier commit on main.
+//
+// D47's order, each step run only once the one before it succeeded, so `prd` never names a
+// `prd-<n>` tag that does not exist:
+//   1. every image the commit's config/prd/values.yaml pins to `prd-<n>` gets that tag, retagged
+//      from Build-Main's `<n>`;
+//   2. `prd` fast-forwards to the commit, and the first run creates it (D35);
+//   3. D48's annotated `release-<m>` tag goes on the commit, `<m>` this job's build number.
+//
+// No rollback parameter and no force-move (D47): a rollback is a revert on main, promoted like
+// any other commit (D36). The job holds the estate's GitHub credential and reaches the registry
+// over plain HTTP; it holds no cluster credential and deploys nothing itself.
+
+library identifier: 'JenkinsPipelineUtils', changelog: false
+
+properties([
+    disableConcurrentBuilds(),
+    parameters([
+        string(name: 'commit', defaultValue: '', trim: true,
+            description: 'SHA of the commit on main to promote, full or abbreviated. Empty promotes the tip of main.')
+    ])
+])
+
+podTemplate(inheritFrom: 'jenkins-agent', containers: [
+    // crane, and git for the steps against the deploy repo.
+    containerTemplates.k8s('k8s')
+]) {
+    node(POD_LABEL) {
+        container('k8s') {
+            String checkout = "${pwd(tmp: true)}/KubeCoderDeploy"
+            String release = "release-${currentBuild.number}"
+            String sha
+            List<Map<String, String>> pins
+
+            stage('Resolving the commit') {
+                String requested = params.commit ?: ''
+                if (requested && !(requested ==~ /[0-9a-f]{7,40}/)) {
+                    error("commit must be the SHA of a commit on main, full or abbreviated; got '${requested}'")
+                }
+
+                withCredentials([usernamePassword(
+                    // The estate's shared GitHub credential, the one every pipeline reaches
+                    // GitHub with.
+                    credentialsId: '5f6fbd66-b41c-405f-b107-85ba6fd97f10',
+                    usernameVariable: 'GIT_USER',
+                    passwordVariable: 'GIT_TOKEN')]) {
+
+                    // set +x: this is the one line where the shell expands the token. Every
+                    // later git command reuses the remote the clone stores.
+                    sh """
+                        set +x
+                        set -eu
+
+                        rm -rf '${checkout}'
+                        git clone --quiet \\
+                            "https://\${GIT_USER}:\${GIT_TOKEN}@github.com/pvginkel/KubeCoderDeploy.git" '${checkout}'
+                        git -C '${checkout}' config user.name 'jenkins'
+                        git -C '${checkout}' config user.email 'jenkins@webathome.org'
+                    """
+                }
+
+                String revision = requested ?: 'origin/main'
+                sha = sh(script: "git -C '${checkout}' rev-parse --verify '${revision}^{commit}'", returnStdout: true).trim()
+
+                if (sh(script: "git -C '${checkout}' merge-base --is-ancestor '${sha}' origin/main", returnStatus: true) != 0) {
+                    error("${sha} is not on main, and prd carries only commits main does (D35)")
+                }
+
+                String current = sh(script: "git -C '${checkout}' rev-parse --quiet --verify refs/remotes/origin/prd || true", returnStdout: true).trim()
+                if (current == sha) {
+                    error("prd is already at ${sha}: nothing to promote")
+                }
+                if (current && sh(script: "git -C '${checkout}' merge-base --is-ancestor '${current}' '${sha}'", returnStatus: true) != 0) {
+                    error("prd is at ${current}, which ${sha} does not descend from: a promotion only " +
+                        "fast-forwards prd (D35), and a rollback is a revert on main, promoted (D36)")
+                }
+
+                if (sh(script: "git -C '${checkout}' ls-remote --tags origin 'refs/tags/${release}'", returnStdout: true).trim()) {
+                    error("${release} already exists on origin")
+                }
+
+                pins = prdPins(readYaml(text: sh(
+                    script: "git -C '${checkout}' show '${sha}:config/prd/values.yaml'",
+                    returnStdout: true)))
+
+                echo "Promoting ${sha} to prd as ${release}" + (current ? ", from ${current}" : '; this creates prd')
+                currentBuild.description = "${release}: ${sha.substring(0, 12)}"
+            }
+
+            stage('Retagging the images') {
+                for (int i = 0; i < pins.size(); i++) {
+                    Map<String, String> pin = pins[i]
+
+                    // An existing `prd-<n>` was retagged from `<n>` by an earlier promotion and is
+                    // left as it is. D47 caps the bare family apart from the `prd-` one, so a
+                    // rollback promoting an older commit (D36) can pin a `prd-<n>` whose `<n>` is
+                    // already reaped.
+                    sh """
+                        set -eu
+
+                        if crane --insecure digest '${pin.image}:${pin.tag}' >/dev/null 2>&1; then
+                            echo '${pin.image}:${pin.tag} exists; left as it is'
+                        else
+                            crane --insecure tag '${pin.image}:${pin.build}' '${pin.tag}'
+                        fi
+                    """
+                }
+            }
+
+            stage('Advancing prd') {
+                // No `+` and no --force: GitHub refuses the push unless it fast-forwards prd,
+                // whatever moved prd since the check above.
+                sh "git -C '${checkout}' push origin '${sha}:refs/heads/prd'"
+            }
+
+            stage('Recording the release') {
+                String references = ''
+                for (int i = 0; i < pins.size(); i++) {
+                    references += "${pins[i].image}:${pins[i].tag}\n"
+                }
+
+                withEnv(["RELEASE_MESSAGE=${release}: ${sha} promoted to prd by ${env.JOB_NAME} #${currentBuild.number}\n\n${references}"]) {
+                    sh """
+                        set -eu
+
+                        git -C '${checkout}' tag -a '${release}' -m "\$RELEASE_MESSAGE" '${sha}'
+                        git -C '${checkout}' push origin 'refs/tags/${release}'
+                    """
+                }
+            }
+        }
+    }
+}
+
+/**
+ * Build-Main's seven pins in a prd values file (D47), as the references prd deploys: the five
+ * `images.*` tag suffixes the chart appends to `registry:5000/kubecoder-<key>`, and the two whole
+ * references under `controllerConfig.images`.
+ *
+ * Every one must be a `prd-<n>` tag in registry:5000, which is also what keeps each reference
+ * safe to quote into a shell line.
+ *
+ * @param values  config/prd/values.yaml of the commit being promoted, as readYaml parses it.
+ * @return [image:, build: '<n>', tag: 'prd-<n>'] per pin.
+ */
+List<Map<String, String>> prdPins(Map values) {
+    Map suffixes = values.images instanceof Map ? values.images : [:]
+    Map controllerConfig = values.controllerConfig instanceof Map ? values.controllerConfig : [:]
+    Map wholeReferences = controllerConfig.images instanceof Map ? controllerConfig.images : [:]
+
+    List<String> paths = []
+    List<String> references = []
+    List<String> suffixed = ['controller', 'bot', 'mcp', 'ingress', 'manual']
+    for (int i = 0; i < suffixed.size(); i++) {
+        String key = suffixed[i]
+        paths << "images.${key}".toString()
+        references << (suffixes[key] == null ? null : "registry:5000/kubecoder-${key}${suffixes[key]}".toString())
+    }
+    List<String> whole = ['worker', 'vsix']
+    for (int i = 0; i < whole.size(); i++) {
+        String key = whole[i]
+        paths << "controllerConfig.images.${key}".toString()
+        references << wholeReferences[key]?.toString()
+    }
+
+    List<Map<String, String>> pins = []
+    for (int i = 0; i < references.size(); i++) {
+        String reference = references[i]
+        if (reference == null || !(reference ==~ /registry:5000\/kubecoder-[a-z]+:prd-[0-9]+/)) {
+            error("config/prd/values.yaml pins ${paths[i]} to '${reference}', not a " +
+                'registry:5000/kubecoder-<name>:prd-<n> reference (D47)')
+        }
+        int colon = reference.lastIndexOf(':')
+        String tag = reference.substring(colon + 1)
+        pins << [image: reference.substring(0, colon), build: tag.substring('prd-'.length()), tag: tag]
+    }
+    return pins
+}
