+package org.webathome.jenkinspipelineutils;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import groovy.lang.GroovyClassLoader;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Stream;
+import org.codehaus.groovy.runtime.GStringImpl;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.junit.jupiter.params.provider.ValueSource;
+
+/**
+ * What architectureProducer's steps run and archive: generateCommand and validateCommand are the
+ * shell commands generate and validate run in the aac-tools container, archivePattern is what
+ * archive hands archiveArtifacts. All three are {@code @NonCPS}, so the CPS transform leaves their
+ * bodies to run as plain Groovy here.
+ */
+class ArchitectureProducerTest {
+
+    private static GroovyClassLoader loader;
+    private static Object architectureProducer;
+    private static Method generateCommand;
+    private static Method validateCommand;
+    private static Method archivePattern;
+
+    @BeforeAll
+    static void loadArchitectureProducer() throws Exception {
+        loader = LibraryCompileTest.trustedLoader();
+        Class<?> type = loader.loadClass("architectureProducer");
+        architectureProducer = type.getDeclaredConstructor().newInstance();
+        generateCommand = type.getMethod("generateCommand", Map.class);
+        validateCommand = type.getMethod("validateCommand", Map.class);
+        archivePattern = type.getMethod("archivePattern", Map.class);
+    }
+
+    @AfterAll
+    static void closeLoader() throws Exception {
+        loader.close();
+    }
+
+    private static String invoke(Method step, Map<String, Object> args) throws Exception {
+        try {
+            return (String) step.invoke(architectureProducer, args);
+        } catch (InvocationTargetException e) {
+            if (e.getCause() instanceof IllegalArgumentException refused) {
+                throw refused;
+            }
+            throw e;
+        }
+    }
+
+    /** Keys and values alternate; the map keeps their order, as a Groovy map literal does. */
+    private static Map<String, Object> ordered(Object... pairs) {
+        Map<String, Object> map = new LinkedHashMap<>();
+        for (int i = 0; i < pairs.length; i += 2) {
+            map.put((String) pairs[i], pairs[i + 1]);
+        }
+        return map;
+    }
+
+    @Test
+    void generateRunsGenArchitectureForTheStageAndProducer() throws Exception {
+        assertEquals(
+                "gen-architecture --stage prd --producer charts-deploy",
+                invoke(generateCommand, ordered("stage", "prd", "producer", "charts-deploy")));
+    }
+
+    // A file may interpolate a value: "${app}-deploy" is a GString, not a String.
+    @Test
+    void anInterpolatedProducerIsAProducer() throws Exception {
+        Object producer = new GStringImpl(new Object[] {"keycloak"}, new String[] {"", "-deploy-dev"});
+        assertEquals(
+                "gen-architecture --stage dev --producer keycloak-deploy-dev",
+                invoke(generateCommand, ordered("stage", "dev", "producer", producer)));
+    }
+
+    @Test
+    void validateRunsArchValidateOnEveryFileInTheOrderGiven() throws Exception {
+        assertEquals(
+                "arch-validate backend/docs/architecture/*.yaml frontend/docs/architecture/*.yaml",
+                invoke(validateCommand, Map.of("files", List.of(
+                        "backend/docs/architecture/*.yaml", "frontend/docs/architecture/*.yaml"))));
+    }
+
+    @Test
+    void archiveTakesEveryFileAsOnePattern() throws Exception {
+        assertEquals(
+                "backend/docs/architecture/architecture.yaml,backend/docs/architecture/deployed-architecture.yaml",
+                invoke(archivePattern, Map.of("files", List.of(
+                        "backend/docs/architecture/architecture.yaml",
+                        "backend/docs/architecture/deployed-architecture.yaml"))));
+    }
+
+    // Each pattern matches only files AaC/Architecture's filter takes.
+    @ParameterizedTest
+    @ValueSource(strings = {
+        "docs/architecture/*.yaml",
+        "docs/architecture/ansible-architecture.yaml",
+        "architecture/*.yaml",
+        "backend/docs/architecture/deployed-architecture.yaml",
+        "docs/architecture/**/*.yaml",
+    })
+    void archiveTakesAPatternTheCollectorCollects(String pattern) throws Exception {
+        assertEquals(pattern, invoke(archivePattern, Map.of("files", List.of(pattern))));
+    }
+
+    // DockerImages' per-image */architecture.yaml is the case: no directory named architecture.
+    @ParameterizedTest
+    @ValueSource(strings = {
+        "*/architecture.yaml",
+        "docs/architecture/*.yml",
+        "docs/architecture/**",
+        "docs/architecture/",
+        "docs/arch*/*.yaml",
+        "architecture.yaml",
+    })
+    void archiveRefusesAPatternTheCollectorDoesNotCollect(String pattern) {
+        IllegalArgumentException refused = assertThrows(
+                IllegalArgumentException.class,
+                () -> invoke(archivePattern, Map.of("files", List.of("docs/architecture/*.yaml", pattern))));
+        assertEquals(
+                "architectureProducer.archive: AaC/Architecture does not collect '" + pattern
+                        + "': a model is a .yaml file under a directory named architecture",
+                refused.getMessage());
+    }
+
+    static Stream<Arguments> refusals() {
+        return Stream.of(
+                Arguments.of(
+                        generateCommand, Map.of("stage", "prd"),
+                        "architectureProducer.generate: producer is required"),
+                Arguments.of(
+                        generateCommand, ordered("stage", "", "producer", "charts-deploy"),
+                        "architectureProducer.generate: stage is required"),
+                Arguments.of(
+                        generateCommand, ordered("stage", "prd", "producer", "charts-deploy", "repo", "."),
+                        "architectureProducer.generate: takes stage and producer; got repo"),
+                Arguments.of(
+                        validateCommand, Map.of(),
+                        "architectureProducer.validate: files is required"),
+                Arguments.of(
+                        validateCommand, Map.of("files", List.of()),
+                        "architectureProducer.validate: files is required"),
+                Arguments.of(
+                        validateCommand, Map.of("file", List.of("docs/architecture/*.yaml")),
+                        "architectureProducer.validate: takes files; got file"),
+                Arguments.of(
+                        validateCommand, Map.of("files", "docs/architecture/*.yaml"),
+                        "architectureProducer.validate: files takes a list of paths; got 'docs/architecture/*.yaml'"),
+                Arguments.of(
+                        archivePattern, Map.of(),
+                        "architectureProducer.archive: files is required"),
+                Arguments.of(
+                        archivePattern, ordered("files", List.of("docs/architecture/*.yaml"), "fingerprint", false),
+                        "architectureProducer.archive: takes files; got fingerprint"));
+    }
+
+    @ParameterizedTest(name = "{2}")
+    @MethodSource("refusals")
+    void aCallWithAMissingEmptyOrUnknownArgumentFailsNamingIt(Method step, Map<String, Object> args, String message) {
+        IllegalArgumentException refused = assertThrows(IllegalArgumentException.class, () -> invoke(step, args));
+        assertEquals(message, refused.getMessage());
+    }
+}
diff --git a/vars/architectureProducer.groovy b/vars/architectureProducer.groovy
new file mode 100644
index 0000000..85a701d
--- /dev/null
+++ b/vars/architectureProducer.groovy
@@ -0,0 +1,120 @@
+/**
+ * The steps an architecture producer's stages call. `generate` and `validate` run the
+ * architecture-as-code tools in the `aac-tools` container, which the pod declares with
+ * `podYaml(templates: ['aac-tools'])`; `archive` archives the models AaC/Architecture collects.
+ * Each is a call on the var's method, so a declarative stage runs it in `script {}`:
+ *
+ *     stage('Generate architecture') {
+ *         steps {
+ *             script {
+ *                 architectureProducer.generate(stage: 'prd', producer: 'charts-deploy')
+ *                 architectureProducer.archive(files: ['docs/architecture/*.yaml'])
+ *             }
+ *         }
+ *     }
+ *
+ * Every argument is required, with no default. A missing, empty or unknown argument fails
+ * the build, and the error names it.
+ */
+
+/**
+ * Runs `gen-architecture --stage <stage> --producer <producer>`, which renders the deploy repo's
+ * chart for that stage and writes docs/architecture/<producer>.yaml.
+ *
+ * @param stage     The stage the file publishes: config/<stage>/values.yaml.
+ * @param producer  The producer id, as Architecture's pipeline-producers.yaml registers it.
+ */
+def generate(Map args) {
+    String command = generateCommand(args)
+    container('aac-tools') {
+        sh command
+    }
+}
+
+/**
+ * Runs `arch-validate` on the files, which submits each to the architecture service.
+ *
+ * @param files  Paths or shell globs, relative to the workspace.
+ */
+def validate(Map args) {
+    String command = validateCommand(args)
+    container('aac-tools') {
+        sh command
+    }
+}
+
+/**
+ * Archives the files, fingerprinted, as the producer's artifact.
+ *
+ * @param files  Ant patterns, relative to the workspace, each of which AaC/Architecture collects.
+ */
+def archive(Map args) {
+    archiveArtifacts artifacts: archivePattern(args), fingerprint: true
+}
+
+@NonCPS
+String generateCommand(Map args) {
+    Map<String, Object> given = arguments('generate', args, ['stage', 'producer'])
+    return "gen-architecture --stage ${given.stage} --producer ${given.producer}".toString()
+}
+
+@NonCPS
+String validateCommand(Map args) {
+    return 'arch-validate ' + paths('validate', args).join(' ')
+}
+
+/**
+ * The files as one archiveArtifacts pattern. AaC/Architecture copies from a producer's last
+ * successful build each .yaml file under a directory named architecture, at any depth, and nothing
+ * else: a pattern outside that archives a model the collector never sees.
+ */
+@NonCPS
+String archivePattern(Map args) {
+    List<String> patterns = paths('archive', args)
+    patterns.each { String file ->
+        if (!collected(file)) {
+            throw new IllegalArgumentException(
+                "architectureProducer.archive: AaC/Architecture does not collect '${file}': a model is a .yaml file under a directory named architecture")
+        }
+    }
+    return patterns.join(',')
+}
+
+/**
+ * Whether every file the pattern matches lies under a directory named `architecture` and ends in
+ * `.yaml`.
+ */
+@NonCPS
+boolean collected(String pattern) {
+    List<String> segments = pattern.split('/') as List
+    return segments.size() > 1 && segments[0..-2].contains('architecture') && segments[-1].endsWith('.yaml')
+}
+
+@NonCPS
+List<String> paths(String step, Map args) {
+    def given = arguments(step, args, ['files']).files
+    if (!(given instanceof List)) {
+        throw new IllegalArgumentException("architectureProducer.${step}: files takes a list of paths; got '${given}'")
+    }
+    return given.collect { it.toString() }
+}
+
+/**
+ * `args` with every key a String, once it holds each of `names`, non-empty, and nothing else.
+ */
+@NonCPS
+Map<String, Object> arguments(String step, Map args, List<String> names) {
+    Map<String, Object> given = [:]
+    args.each { key, value -> given[key.toString()] = value }
+
+    def unknown = given.keySet() - names
+    if (unknown) {
+        throw new IllegalArgumentException("architectureProducer.${step}: takes ${names.join(' and ')}; got ${unknown.join(', ')}")
+    }
+    names.each { name ->
+        if (!given[name]) {
+            throw new IllegalArgumentException("architectureProducer.${step}: ${name} is required")
+        }
+    }
+    return given
+}
