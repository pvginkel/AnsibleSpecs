+"""chart_tools.audit_prd_orphans: reconciler ownership in desired state and the
+helm-release diff."""
+
+import json
+
+from chart_tools.audit_prd_orphans import cmd_diff, desired_state
+
+ZFS_TF = """\
+module "zfs" {
+  source  = "./terraform-modules/static-zfs-pv"
+  dataset = "${var.namespace}"
+}
+"""
+
+
+def _argo_entry():
+    return {"reconciler": "argo-cd", "deployed": True, "autoSync": False}
+
+
+def _shared_tf(repo, chart, text):
+    shared = repo / "configs" / "prd" / chart / "_shared"
+    shared.mkdir()
+    (shared / "infrastructure.tf").write_text(text)
+
+
+def _helm_report(repo, capsys, live_releases):
+    outdir = repo / "audit-live"
+    outdir.mkdir()
+    (outdir / "helm.json").write_text(
+        json.dumps([{"name": n, "namespace": n} for n in live_releases])
+    )
+    cmd_diff(str(repo), str(outdir))
+    return capsys.readouterr().out.split("[Helm releases]", 1)[1].split("\n[", 1)[0]
+
+
+def test_an_entry_another_reconciler_owns_is_no_desired_helm_release(repo, make_stage):
+    make_stage("prd", "app", "prd")
+    make_stage("prd", "kubecoder", "dev", release_yaml=_argo_entry())
+    _shared_tf(repo, "kubecoder", ZFS_TF)
+
+    state = desired_state(str(repo))
+
+    assert state["helm_releases"] == {"app-prd"}
+    assert state["owned_elsewhere"] == {"kubecoder-dev"}
+    assert state["namespaces"] == {"app-prd", "kubecoder-dev"}
+    assert state["zfs_zpool2"] == {"kubecoder-dev"}
+
+
+def test_a_disabled_flag_does_not_make_another_reconcilers_entry_ours(repo, make_stage):
+    make_stage("prd", "kubecoder", "dev", release_yaml={**_argo_entry(), "disabled": True})
+
+    state = desired_state(str(repo))
+
+    assert state["disabled"] == set()
+    assert state["owned_elsewhere"] == {"kubecoder-dev"}
+
+
+def test_an_entry_another_reconciler_owns_is_not_reported_missing(repo, make_stage, capsys):
+    make_stage("prd", "app", "prd")
+    make_stage("prd", "kubecoder", "dev", release_yaml=_argo_entry())
+
+    report = _helm_report(repo, capsys, ["app-prd"])
+
+    assert "MISSING" not in report
+    assert "clean" in report
+
+
+def test_a_live_release_another_reconciler_owns_is_never_an_orphan_candidate(
+    repo, make_stage, capsys
+):
+    make_stage("prd", "app", "prd")
+    make_stage("prd", "argocd", "prd", release_yaml=_argo_entry())
+
+    report = _helm_report(repo, capsys, ["app-prd", "argocd-prd", "gone-prd"])
+    orphans = report.split("ORPHAN CANDIDATES", 1)[1].split("\n\n", 1)[0]
+
+    assert "+ gone-prd" in orphans
+    assert "argocd-prd" not in orphans
+    assert "    = argocd-prd" in report
