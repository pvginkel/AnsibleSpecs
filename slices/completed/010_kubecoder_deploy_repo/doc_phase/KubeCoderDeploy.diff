+  }
+
+  assert {
+    condition     = kubernetes_persistent_volume_v1.env_storage.spec[0].capacity["storage"] == "80Gi"
+    error_message = "prd's PV capacity is not 80Gi"
+  }
+
+  assert {
+    condition = (
+      kubernetes_persistent_volume_v1.env_storage.spec[0].claim_ref[0].name == "kubecoder-prd-zfs-pvc"
+      && kubernetes_persistent_volume_v1.env_storage.spec[0].claim_ref[0].namespace == "kubecoder-prd"
+    )
+    error_message = "prd's PV is not claimed by kubecoder-prd/kubecoder-prd-zfs-pvc"
+  }
+
+  assert {
+    condition     = kubernetes_persistent_volume_v1.env_storage.spec[0].persistent_volume_reclaim_policy == "Retain"
+    error_message = "prd's PV is not Retain"
+  }
+
+  assert {
+    condition     = toset(kubernetes_persistent_volume_v1.env_storage.spec[0].node_affinity[0].required[0].node_selector_term[0].match_expressions[0].values) == toset(["srvk8s4"])
+    error_message = "prd's PV is not pinned to zpool5's node"
+  }
+}
+
+run "webhook" {
+  command = plan
+
+  assert {
+    condition     = length(github_repository_webhook.argocd) == 0
+    error_message = "prd claims the repository's webhook, which dev owns"
+  }
+}
diff --git a/terraform/variables.tf b/terraform/variables.tf
new file mode 100644
index 0000000..7fb88bf
--- /dev/null
+++ b/terraform/variables.tf
@@ -0,0 +1,39 @@
+# From the hook's environment.
+
+variable "namespace" {
+  description = "The Application's destination namespace, kubecoder-<stage> (TF_VAR_namespace). The chart creates it; nothing here does."
+  type        = string
+}
+
+variable "zfs_pools" {
+  description = "ZFS pool to node hostname on the prd cluster (TF_VAR_zfs_pools)."
+  type        = map(string)
+}
+
+variable "github_webhook_secret" {
+  description = "Argo CD's shared webhook secret, the one the relay verifies deliveries against (TF_VAR_github_webhook_secret)."
+  type        = string
+  sensitive   = true
+}
+
+# From config/<stage>/*.tfvars.
+
+variable "zfs_dataset" {
+  description = "Dataset name within the pool. Renaming it forces a destroy, which prevent_destroy refuses."
+  type        = string
+}
+
+variable "zfs_quota" {
+  description = "ZFS quota on the dataset: the real bound on env storage."
+  type        = string
+}
+
+variable "zfs_size" {
+  description = "PV capacity. Kubernetes accounting only."
+  type        = string
+}
+
+variable "manage_webhook" {
+  description = "Whether this stage's state owns the repository's GitHub webhook. True in exactly one stage: the webhook is per repository and the state per stage, so a second owner's apply fails on GitHub's hook-already-exists."
+  type        = bool
+}
diff --git a/terraform/webhook.tf b/terraform/webhook.tf
new file mode 100644
index 0000000..64245ca
--- /dev/null
+++ b/terraform/webhook.tf
@@ -0,0 +1,16 @@
+# This repository's push deliveries, to the webhook relay, which verifies the signature and
+# forwards each delivery to argocd-server (D39, D49).
+resource "github_repository_webhook" "argocd" {
+  count = var.manage_webhook ? 1 : 0
+
+  repository = "KubeCoderDeploy"
+  active     = true
+  events     = ["push"]
+
+  configuration {
+    url          = "https://deploy-hooks.webathome.org/api/webhook"
+    content_type = "json"
+    insecure_ssl = false
+    secret       = var.github_webhook_secret
+  }
+}
diff --git a/tests/terraform.sh b/tests/terraform.sh
new file mode 100755
index 0000000..9d194b3
--- /dev/null
+++ b/tests/terraform.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# terraform/ is formatted and valid, and each stage's tfvars, passed as the hook passes them,
+# plan the objects terraform/tests/<stage>.tftest.hcl asserts. No backend and no credentials:
+# `terraform test` keeps its state in memory and mock providers answer every call.
+set -eu
+
+cd "$(dirname "$0")/.."
+
+terraform fmt -check -diff -recursive
+terraform -chdir=terraform init -backend=false -input=false -no-color
+terraform -chdir=terraform validate -no-color
+
+for stage in dev prd; do
+  set --
+  for file in config/"$stage"/*.tfvars; do
+    set -- "$@" "-var-file=../$file"
+  done
+  terraform -chdir=terraform test -no-color "-filter=tests/$stage.tftest.hcl" "$@"
+done
