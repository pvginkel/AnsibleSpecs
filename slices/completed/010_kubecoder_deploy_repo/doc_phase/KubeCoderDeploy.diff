+# The controller-owned config (D058): profiles, the service catalog, the secret catalog,
+# the namespace whitelist, env-pod placement, storage roots, and images. Authored as the
+# `controllerConfig` values block and mounted read-only at /etc/kubecoder/controller.yaml.
+# The controller refuses to start if any profile/service container omits a memory limit
+# (acceptance #3), so a bad edit here fails the rollout loudly.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: kubecoder-controller-config
+data:
+  controller.yaml: |
+{{ .Values.controllerConfig | toYaml | indent 4 }}
diff --git a/chart/templates/controller-deployment.yaml b/chart/templates/controller-deployment.yaml
new file mode 100644
index 0000000..59d7485
--- /dev/null
+++ b/chart/templates/controller-deployment.yaml
@@ -0,0 +1,259 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: kubecoder-controller
+spec:
+  replicas: {{ .Values.controller.replicas }}
+  # Recreate (D141): the outgoing pod is fully terminated before the replacement starts, so
+  # two controllers never reconcile the cluster at once. The RWO ZFS share PVC mounted below
+  # pins this pod to one node anyway, so a surge replica would buy no availability.
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: kubecoder-controller
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: kubecoder-controller
+      annotations:
+        # The controller's deployment identity: the controller container reads this exact
+        # annotation key back as KUBECODER_DEPLOYMENT_ID (fieldRef below), so the two sites must
+        # name the same key. The value is the controllerConfig checksum — identical across
+        # renders of one commit, and never empty, since a blank id makes the controller roll
+        # every env on every start.
+        {{- $configChecksum := .Values.controllerConfig | toYaml | sha256sum }}
+        deployment: {{ $configChecksum | quote }}
+        checksum/config: {{ $configChecksum }}
+    spec:
+      serviceAccountName: kubecoder-controller
+      # No kubelet service-link env injection (D105): nothing in KubeCoder reads the
+      # Docker-link <SVC>_SERVICE_HOST/_PORT vars (the parts talk over REST via DNS).
+      enableServiceLinks: false
+      # The ZFS share PVC mounted below pins this pod to srvk8s4, which is taint-dedicated
+      # (D044), so it tolerates that one taint and no other (D050). A blanket `operator: Exists`
+      # would also tolerate node.kubernetes.io/unschedulable: the replacement pod would schedule
+      # straight back onto a node a drain has just cordoned and run its startup passes mid-drain,
+      # while the env pods around it are still being evicted — the one state KubeCoder's
+      # drain-recovery pass is written to assume cannot happen (D215).
+      tolerations:
+        - key: homelab.local/performance
+          operator: Equal
+          value: high
+          effect: NoSchedule
+      containers:
+        - name: kubecoder-controller
+          image: registry:5000/kubecoder-controller{{ .Values.images.controller }}
+          imagePullPolicy: Always
+          ports:
+            - containerPort: 8080
+          env:
+            - name: KUBECODER_CONFIG
+              value: /etc/kubecoder/controller.yaml
+            - name: KUBECODER_CATALOG_SECRET
+              value: kubecoder-secret-catalog
+            # The north MCP adapter's in-cluster endpoint and the name of the Secret holding its
+            # static bearer, under key `token` — the same Secret and key mcp-deployment.yaml
+            # reads. Together they are the deployment half of the fleetAdmin capability: either
+            # one absent or blank means this deployment cannot provide it, and an environment
+            # whose config.yaml asks for it starts without fleet reach and carries a warning.
+            # The controller never reads the Secret — it projects a secretKeyRef to it onto the
+            # granted environment's dev container, which resolves because env pods are composed
+            # into this namespace.
+            - name: KUBECODER_MCP_URL
+              value: http://kubecoder-mcp:8080/mcp
+            - name: KUBECODER_MCP_AUTH_SECRET
+              value: kubecoder-mcp-auth-token
+            # The root certificate the controller hands `step` as `--root` when it signs an
+            # env's SSH host key: the file the `ca` volume below mounts, from the
+            # kubecoder-controller-ca ConfigMap. A configured controllerConfig.sshd.stepCa requires
+            # this to name a CA root certificate the controller can read: unset, blank or
+            # unreadable REFUSES controller startup.
+            - name: KUBECODER_STEP_CA_ROOT
+              value: /etc/ssl/homelab/homelab-root.crt
+            # The API-server certificate check, from controller.verifyApiCertificate —
+            # values.yaml documents when a cluster has to opt out.
+            - name: KUBECODER_K8S_VERIFY_SSL
+              value: {{ .Values.controller.verifyApiCertificate | quote }}
+            # The controller's namespace + the node it lands on (pinned by the ZFS PVC):
+            # spec.nodeName is by construction the placement node the admission gate reads
+            # (D050/D058), so the node name is never hardcoded.
+            - name: KUBECODER_NAMESPACE
+              valueFrom:
+                fieldRef:
+                  fieldPath: metadata.namespace
+            - name: KUBECODER_NODE_NAME
+              valueFrom:
+                fieldRef:
+                  fieldPath: spec.nodeName
+            # This pod's own deploy stamp — the `deployment` annotation the pod template above
+            # carries, read back through the Downward API. The controller stamps it onto every
+            # env pod it creates and rolls the envs whose stamp differs, so a deploy never
+            # leaves an env on a stale worker. The coupling is fail-soft by design: a missing
+            # annotation key resolves to the empty string rather than failing admission, and a
+            # blank id makes the controller fall back to a per-process id — rolling every env
+            # on every start (wasteful, loud) instead of silently missing a roll.
+            - name: KUBECODER_DEPLOYMENT_ID
+              valueFrom:
+                fieldRef:
+                  fieldPath: metadata.annotations['deployment']
+            # Secret-backed operational tokens (ESO-materialised; never on ZFS — D031).
+            # One KUBECODER_CLIENT_TOKEN_<NAME> per client credential the stage declares — an
+            # externalSecrets leaf carrying `clientName:`. The var and the leaf render off that
+            # single declaration, so dropping a client's entry from the stage values removes its
+            # ExternalSecret, the Secret it owns and this var together: the redeploy that revokes
+            # a client is also what stops the controller holding its credential. `optional` is
+            # what keeps the other absence graceful: a leaf declared here whose OpenBao path is
+            # not seeded materialises no Secret, and the controller must boot with that var unset
+            # and simply not register the client rather than fail to start.
+{{- range $entry := .Values.externalSecrets.secrets }}
+{{- if $entry.clientName }}
+            - name: KUBECODER_CLIENT_TOKEN_{{ $entry.clientName | upper }}
+              valueFrom:
+                secretKeyRef:
+                  name: {{ $entry.targetName }}
+                  key: {{ (first $entry.data).secretKey }}
+                  optional: true
+{{- end }}
+{{- end }}
+            - name: KUBECODER_GITHUB_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: kubecoder-github-token
+                  key: token
+            # step-ca's kubecoder-jwk provisioner password, which the controller writes to a
+            # file under /run/kubecoder for the duration of a `step ssh certificate` call
+            # (--provisioner-password-file). One provisioner serves both stages, so the two
+            # stage-pathed OpenBao leaves hold the same value.
+            - name: KUBECODER_STEP_CA_PROVISIONER_PASSWORD
+              valueFrom:
+                secretKeyRef:
+                  name: kubecoder-step-ca-provisioner-password
+                  key: password
+          # Startup budget: ~2 min (12 x 10s). Boot passes that scale with the number of envs
+          # on the node run before uvicorn binds :8080 — the k8s watch baseline, the
+          # tunnel-reservation reaper and the recovery kick — so on a full fleet the port
+          # stays closed (probes get connection-refused, not a 503) past the ~30s the k8s
+          # probe defaults allow. A startupProbe suspends BOTH probes below until it first
+          # succeeds, so the pod can only ever join the Service later than /readyz alone
+          # would have let it, never earlier.
+          startupProbe:
+            httpGet:
+              path: /healthz
+              port: 8080
+            periodSeconds: 10
+            failureThreshold: 12
+          readinessProbe:
+            httpGet:
+              path: /readyz
+              port: 8080
+          livenessProbe:
+            httpGet:
+              path: /healthz
+              port: 8080
+          volumeMounts:
+            - name: zfs-share
+              mountPath: /zfs
+            - name: config
+              mountPath: /etc/kubecoder
+              readOnly: true
+            - name: ca
+              mountPath: /etc/ssl/homelab
+              readOnly: true
+            - name: run-kubecoder
+              mountPath: /run/kubecoder
+{{- if (index .Values.resources "kubecoder-controller" "kubecoder-controller") }}
+          resources:
+            {{- toYaml (index .Values.resources "kubecoder-controller" "kubecoder-controller") | nindent 12 }}
+{{- end }}
+        # The pod's front door (D159): a pure-routing nginx owning the Service's target port,
+        # fanning /help/ out to the manual sidecar and everything else — the whole REST surface,
+        # /healthz, /readyz, the SSE stream — to the controller on :8080. The Service's targetPort
+        # points HERE, not at the controller; the controller is no longer directly addressable.
+        - name: ingress
+          image: registry:5000/kubecoder-ingress{{ .Values.images.ingress }}
+          imagePullPolicy: Always
+          ports:
+            - containerPort: 8090
+          readinessProbe:
+            httpGet:
+              path: /health
+              port: 8090
+          livenessProbe:
+            httpGet:
+              path: /health
+              port: 8090
+{{- if (index .Values.resources "kubecoder-controller" "ingress") }}
+          resources:
+            {{- toYaml (index .Values.resources "kubecoder-controller" "ingress") | nindent 12 }}
+{{- end }}
+        # The operator manual (D158): nginx over the MkDocs build, served under /help/.
+        # LIVENESS ONLY — DELIBERATELY NO READINESS PROBE. A pod is an eligible Service endpoint
+        # only when EVERY container is ready, so a readiness probe here would let an unready manual
+        # drop the whole controller pod out of the Service: a broken docs sidecar would become a
+        # control-plane outage. Liveness still restarts it if it wedges.
+        - name: manual
+          image: registry:5000/kubecoder-manual{{ .Values.images.manual }}
+          imagePullPolicy: Always
+          ports:
+            - containerPort: 8081
+          env:
+            # This instance's own origin. The site is built once with a sentinel origin baked into
+            # its absolute-URL surfaces and one image serves every stage (D178), so the image's
+            # /docker-entrypoint.d script rewrites them to this value before nginx starts. Passed
+            # verbatim — no `/help/` suffix and trailing slashes are the script's to strip — and
+            # under a name of its own: the bot's KUBECODER_MANUAL_URL is a different value.
+            - name: KUBECODER_EXTERNAL_BASE_URL
+              value: {{ .Values.controllerConfig.externalBaseUrl | quote }}
+          livenessProbe:
+            httpGet:
+              path: /health
+              port: 8081
+{{- if (index .Values.resources "kubecoder-controller" "manual") }}
+          resources:
+            {{- toYaml (index .Values.resources "kubecoder-controller" "manual") | nindent 12 }}
+{{- end }}
+        # The dev-tunnel reclaim actuator (slice 105): a loopback-only Flask sidecar the controller's
+        # reaper POSTs an env's code_tunnel.json to, which runs `code tunnel unregister` to release
+        # that tunnel reservation. It binds 127.0.0.1:8092 only — no Service, no ingress route, reached
+        # solely over pod loopback. DELIBERATELY NO READINESS PROBE: a pod is an eligible Service
+        # endpoint only when every container is ready, so gating readiness on this private actuator
+        # would let a wedged reclaimer drop the whole controller pod out of the Service (the same
+        # shared-fate reasoning as `manual`). No httpGet liveness either — the listener is
+        # loopback-bound, so the kubelet's pod-IP probe cannot reach it. Its ONLY mount is the shared
+        # account token.json, read-only via subPath: no write access to /zfs and no per-env mounts
+        # (every env's code_tunnel.json arrives in the POST body). The mountPath is the image's default
+        # SHARED_TOKEN_PATH.
+        - name: tunnel-reclaim
+          image: registry:5000/kube-coder-tunnel-reclaim{{ .Values.images.tunnelReclaim }}
+          imagePullPolicy: Always
+          ports:
+            - containerPort: 8092
+          volumeMounts:
+            - name: zfs-share
+              mountPath: /vscode-cli-shared/token.json
+              subPath: system/home/.vscode-cli-shared/token.json
+              readOnly: true
+{{- if (index .Values.resources "kubecoder-controller" "tunnel-reclaim") }}
+          resources:
+            {{- toYaml (index .Values.resources "kubecoder-controller" "tunnel-reclaim") | nindent 12 }}
+{{- end }}
+      volumes:
+        - name: zfs-share
+          persistentVolumeClaim:
+            claimName: kubecoder-{{ .Values.global.environment }}-zfs-pvc
+        - name: config
+          configMap:
+            name: kubecoder-controller-config
+        - name: ca
+          configMap:
+            name: kubecoder-controller-ca
+        # Scratch for secret material the controller hands to `step` as a file — the
+        # provisioner password above, plus whatever `step` writes beside it. Memory-backed so
+        # it never reaches disk, and mounted at the same /run/kubecoder path the worker uses
+        # inside an env pod. A Memory emptyDir is charged against the pod's memory, hence the
+        # explicit cap.
+        - name: run-kubecoder
+          emptyDir:
+            medium: Memory
+            sizeLimit: 10Mi
diff --git a/chart/templates/controller-role.yaml b/chart/templates/controller-role.yaml
new file mode 100644
index 0000000..424b8ec
--- /dev/null
+++ b/chart/templates/controller-role.yaml
@@ -0,0 +1,26 @@
+# Namespaced Role for the controller. The controller creates/reconciles all per-env objects
+# imperatively. Nothing in the product asks Kubernetes for exec — the controller drives env pods
+# via the worker API + its direct ZFS share mount, and in-pod `cexec` reaches a sibling tool
+# container over a Unix socket — so this Role grants no RBAC-authoring verbs and no `pods/exec`.
+apiVersion: rbac.authorization.k8s.io/v1
+kind: Role
+metadata:
+  name: kubecoder-controller
+rules:
+  # Pods are reconciled via create/delete and watched as the source of truth (D002); the
+  # controller never updates a pod in place, so no `update` verb here.
+  - apiGroups: [""]
+    resources: ["pods"]
+    verbs: ["create", "get", "list", "watch", "delete"]
+  # services/secrets/configmaps SURVIVE a stop (only the pod is deleted); `start` re-runs
+  # bring-up, which create-or-REPLACEs each one (HTTP PUT = the `update` verb). Without
+  # `update`, start is denied the moment RBAC is enforced (the "breaks itself on flip" bug).
+  - apiGroups: [""]
+    resources: ["services", "secrets", "configmaps"]
+    verbs: ["create", "get", "list", "watch", "update", "delete"]
+  # Per-env memory USAGE from metrics-server (slice 086): the capacity view shows each running
+  # env's actual usage beside its limits. PodMetrics is namespaced, like the env pods themselves;
+  # the node-wide counterpart lives in the cluster-scoped nodes Role.
+  - apiGroups: ["metrics.k8s.io"]
+    resources: ["pods"]
+    verbs: ["get", "list"]
