diff --git a/chart/templates/mcp-deployment.yaml b/chart/templates/mcp-deployment.yaml
new file mode 100644
index 0000000..57828f3
--- /dev/null
+++ b/chart/templates/mcp-deployment.yaml
@@ -0,0 +1,89 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: kubecoder-mcp
+spec:
+  replicas: {{ .Values.mcp.replicas }}
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: kubecoder-mcp
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: kubecoder-mcp
+    spec:
+      # The MCP adapter is the bot's structural twin (D151): a second north client of the
+      # controller REST boundary (surface ①). Like the bot it is unpinned (D039) — no taint
+      # toleration, no ZFS pin, no RBAC — and reaches the controller over in-namespace Service
+      # DNS, never the Docker-link <SVC>_SERVICE_HOST/_PORT vars (D105).
+      enableServiceLinks: false
+      containers:
+        - name: kubecoder-mcp
+          image: registry:5000/kubecoder-mcp{{ .Values.images.mcp }}
+          imagePullPolicy: Always
+          # The Streamable-HTTP MCP surface (path /mcp). Unlike the bot (outbound-only), the
+          # adapter serves inbound, so it carries a Service (mcp-service.yaml, plus the
+          # internet-reachable mcp-public-service.yaml where a stage configures one).
+          ports:
+            - containerPort: 8080
+          env:
+            # The controller REST API (surface ①) the adapter drives; in-namespace Service DNS.
+            - name: KUBECODER_CONTROLLER_URL
+              value: http://kubecoder-controller:8080
+            # South leg: this client's own surface-① credential, which the controller resolves
+            # to the named client `mcp` (ESO leaf kubecoder-client-token-mcp). Unrestricted like
+            # every named client, but revocable on its own. main fails fast if unset (D031).
+            - name: KUBECODER_CLIENT_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: kubecoder-client-token-mcp
+                  key: token
+            # North leg (D151), first principal: the static inbound bearer. It is the permanent
+            # path for the in-cluster consumer, which cannot drive an interactive OAuth flow.
+            # Its own ESO leaf kubecoder-mcp-auth-token; the OpenBao KV path
+            # eso/prd/kubecoder/prd/mcp-auth-token is seeded out-of-band by the operator.
+            - name: KUBECODER_MCP_AUTH_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: kubecoder-mcp-auth-token
+                  key: token
+{{- if or .Values.mcp.oidc.issuerUrl .Values.mcp.oidc.jwksUrl .Values.mcp.oidc.audience .Values.mcp.oidc.publicUrl .Values.mcp.oidc.scope }}
+            # North leg, second principal: IdP-issued JWTs, validated natively by the adapter as
+            # an OAuth 2.1 resource server. These five are all-or-nothing and the adapter refuses
+            # to start on a partial set, or on any of them present-but-empty — so a stage with no
+            # authorization server leaves mcp.oidc unset entirely and renders none of them.
+            - name: KUBECODER_MCP_OIDC_ISSUER_URL
+              value: {{ .Values.mcp.oidc.issuerUrl | quote }}
+            - name: KUBECODER_MCP_OIDC_JWKS_URL
+              value: {{ .Values.mcp.oidc.jwksUrl | quote }}
+            # A resource identifier, never a client id: an ID token's `aud` IS the client id, so
+            # a client id here would admit ID tokens as access tokens.
+            - name: KUBECODER_MCP_OIDC_AUDIENCE
+              value: {{ .Values.mcp.oidc.audience | quote }}
+            # The with-path URL a client dials; the RFC 9728 metadata the adapter advertises and
+            # the metadata hint in its 401 are both built from it.
+            - name: KUBECODER_MCP_PUBLIC_URL
+              value: {{ .Values.mcp.oidc.publicUrl | quote }}
+            # The one scope advertised as scopes_supported and required on every JWT; the static
+            # bearer carries it by construction. It must exist on the authorization server and be
+            # assigned to the connector's client.
+            - name: KUBECODER_MCP_OIDC_SCOPE
+              value: {{ .Values.mcp.oidc.scope | quote }}
+            # Admitted token `sub` values, CSV (the bot's KUBECODER_ALLOWED_CHAT_IDS pattern,
+            # D040). Empty admits no JWT at all. The static bearer above is a different
+            # principal and is not subject to this list.
+            - name: KUBECODER_MCP_ALLOWED_SUBJECTS
+              value: {{ .Values.mcp.oidc.allowedSubjects | join "," | quote }}
+{{- end }}
+          readinessProbe:
+            httpGet:
+              path: /readyz
+              port: 8080
+          livenessProbe:
+            httpGet:
+              path: /healthz
+              port: 8080
+{{- if (index .Values.resources "kubecoder-mcp" "kubecoder-mcp") }}
+          resources:
+            {{- toYaml (index .Values.resources "kubecoder-mcp" "kubecoder-mcp") | nindent 12 }}
+{{- end }}
