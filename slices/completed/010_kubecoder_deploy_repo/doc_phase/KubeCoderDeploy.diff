+# The homelab root certificate the controller hands `step` as `--root` when it signs an env's
+# SSH host key, mounted read-only into the controller container by controller-deployment.yaml
+# and named to it by KUBECODER_STEP_CA_ROOT. files/ca/homelab-root.crt is a copy of
+# HelmCharts' homelab-root.crt, not a symlink — Argo's repo-server refuses a symlink that leaves
+# the repository — so a root rotation has to update it here too.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: kubecoder-controller-ca
+data:
+  {{- (.Files.Glob "files/ca/**").AsConfig | nindent 2 }}
diff --git a/chart/templates/controller-clusterrole.yaml b/chart/templates/controller-clusterrole.yaml
new file mode 100644
index 0000000..a7da5b7
--- /dev/null
+++ b/chart/templates/controller-clusterrole.yaml
@@ -0,0 +1,18 @@
+# Cluster-scoped node reads — the admission gate / GET /capacity need the dev node's allocatable
+# memory (D051) and its ACTUAL memory usage from metrics-server (slice 086). Name is env-suffixed
+# for cluster uniqueness across stages.
+apiVersion: rbac.authorization.k8s.io/v1
+kind: ClusterRole
+metadata:
+  name: kubecoder-{{ .Values.global.environment }}-nodes
+rules:
+  - apiGroups: [""]
+    resources: ["nodes"]
+    verbs: ["get", "list"]
+  # NodeMetrics is a cluster-scoped resource, hence this Role rather than the namespaced one that
+  # carries the matching PodMetrics grant. GET /capacity reports the node's real usage next to the
+  # committed limits; the read is non-fatal (this APIService flaps), so a missing grant degrades
+  # the view to committed-only instead of breaking it.
+  - apiGroups: ["metrics.k8s.io"]
+    resources: ["nodes"]
+    verbs: ["get", "list"]
