@@ -0,0 +1,26 @@
+# Curated entry points for KubeCoderDeploy. Helm lives in the `iac` toolchain
+# sidecar, so the verbs carry their `cexec` prefix here and only here.
+
+projects:
+  root:
+    description: >-
+      KubeCoder's deploy repo: its Helm chart on the homelab-shared library
+      dependency and the per-stage configuration Argo CD syncs KubeCoder from.
+      There is no Jenkinsfile and no `jenkins:` key, and that is deliberate
+      rather than missing — a deploy repo publishes no image, and Argo deploys it.
+    # helm lint reads the built dependency, so the deps step comes first. The
+    # hook.* values stand in for the four helm parameters the ApplicationSet
+    # passes; the library `required`-guards each one.
+    lint:
+      - cexec iac tests/build-deps.sh
+      - >-
+        cexec iac helm lint chart --values config/dev/values.yaml
+        --set hook.repo=https://github.com/pvginkel/KubeCoderDeploy.git,hook.revision=0123456789abcdef0123456789abcdef01234567,hook.stage=dev,hook.namespace=kubecoder-dev
+      - >-
+        cexec iac helm lint chart --values config/prd/values.yaml
+        --set hook.repo=https://github.com/pvginkel/KubeCoderDeploy.git,hook.revision=0123456789abcdef0123456789abcdef01234567,hook.stage=prd,hook.namespace=kubecoder-prd
+    # The gate is the render: tests/render-chart.py renders both stages as the
+    # ApplicationSet does and asserts against the objects helm produces.
+    test:
+      - cexec iac tests/build-deps.sh
+      - cexec iac tests/render-chart.py
