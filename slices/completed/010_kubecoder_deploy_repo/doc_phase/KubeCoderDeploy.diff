+mock_provider "homelab" {}
+mock_provider "kubernetes" {}
+
+# What the hook's environment supplies.
+variables {
+  namespace             = "kubecoder-dev"
+  zfs_pools             = { zpool2 = "srvk8s1", zpool3 = "srvk8s2", zpool4 = "srvk8s3", zpool5 = "srvk8s4" }
+  github_webhook_secret = "shared-webhook-secret"
+}
+
+run "storage" {
+  command = plan
+
+  assert {
+    condition     = homelab_zfs_dataset.env_storage.pool == "zpool5" && homelab_zfs_dataset.env_storage.name == "kubecoder-dev"
+    error_message = "dev's dataset is not zpool5/kubecoder-dev"
+  }
+
+  assert {
+    condition     = homelab_zfs_dataset.env_storage.quota == "20G"
+    error_message = "dev's dataset quota is not 20G"
+  }
+
+  assert {
+    condition     = kubernetes_persistent_volume_v1.env_storage.metadata[0].name == "kubecoder-dev-zfs-pv"
+    error_message = "dev's PV is not kubecoder-dev-zfs-pv"
+  }
+
+  assert {
+    condition     = kubernetes_persistent_volume_v1.env_storage.spec[0].capacity["storage"] == "20Gi"
+    error_message = "dev's PV capacity is not 20Gi"
+  }
+
+  assert {
+    condition = (
+      kubernetes_persistent_volume_v1.env_storage.spec[0].claim_ref[0].name == "kubecoder-dev-zfs-pvc"
+      && kubernetes_persistent_volume_v1.env_storage.spec[0].claim_ref[0].namespace == "kubecoder-dev"
+    )
+    error_message = "dev's PV is not claimed by kubecoder-dev/kubecoder-dev-zfs-pvc"
+  }
+
+  assert {
+    condition     = kubernetes_persistent_volume_v1.env_storage.spec[0].persistent_volume_reclaim_policy == "Retain"
+    error_message = "dev's PV is not Retain"
+  }
+
+  assert {
+    condition     = toset(kubernetes_persistent_volume_v1.env_storage.spec[0].node_affinity[0].required[0].node_selector_term[0].match_expressions[0].values) == toset(["srvk8s4"])
+    error_message = "dev's PV is not pinned to zpool5's node"
+  }
+}
+
+run "webhook" {
+  command = plan
+
+  assert {
+    condition     = length(github_repository_webhook.argocd) == 1
+    error_message = "dev does not own the repository's webhook"
+  }
+
+  assert {
+    condition = (
+      github_repository_webhook.argocd[0].repository == "KubeCoderDeploy"
+      && github_repository_webhook.argocd[0].active
+      && toset(github_repository_webhook.argocd[0].events) == toset(["push"])
+    )
+    error_message = "the webhook is not an active push hook on KubeCoderDeploy"
+  }
+
+  assert {
+    condition = (
+      github_repository_webhook.argocd[0].configuration[0].url == "https://deploy-hooks.webathome.org/api/webhook"
+      && github_repository_webhook.argocd[0].configuration[0].content_type == "json"
+      && !github_repository_webhook.argocd[0].configuration[0].insecure_ssl
+    )
+    error_message = "the webhook does not deliver JSON to the relay over verified TLS"
+  }
+
+  assert {
+    condition     = nonsensitive(github_repository_webhook.argocd[0].configuration[0].secret == var.github_webhook_secret)
+    error_message = "the webhook is not signed with the hook environment's shared secret"
