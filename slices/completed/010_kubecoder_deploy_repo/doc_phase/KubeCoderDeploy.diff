@@ -0,0 +1,18 @@
+[global]
+
+workgroup = WORKGROUP
+server string = kubecoder
+comment = KubeCoder /work
+include = /etc/samba/defaults.conf
+username map = /etc/samba/smbusers
+
+# Serve /work as the env user (uid 1000). The samba image's `smb` account is uid 1000 /
+# gid 1000 (DockerImages samba/Dockerfile: addgroup -g 1000 smb + adduser --uid 1000 smb),
+# matching the env pod's runAsUser/fsGroup, so forcing all file operations to `smb` keeps
+# SMB-written files co-owned with the uid-1000 dev container.
+force user = smb
+force group = smb
+
+[work]
+
+path = /work
