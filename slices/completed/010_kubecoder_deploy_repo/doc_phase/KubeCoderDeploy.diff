+#!/bin/sh
+
+set -e
+
+add_user() {
+    local username="$1" password="$2" aliases="$3"
+
+    useradd -g smb -s /sbin/nologin -M "$username"
+    cat << EOF | smbpasswd -a -s "$username"
+$password
+$password
+EOF
+
+    if [ "$aliases" != "" ]; then
+        echo "$username = $aliases" >> /etc/samba/smbusers
+    fi
+}
+
+add_user pvginkel "$PASSWORD_pvginkel" "pieter pvginkel@gmail.com"
