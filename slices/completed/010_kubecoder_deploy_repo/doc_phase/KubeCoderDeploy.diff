@@ -0,0 +1,25 @@
+apiVersion: v1
+kind: Service
+metadata:
+  name: kubecoder-controller
+  annotations:
+{{ if .Values.service.controller.dnsName }}
+    dns.webathome.org/hostname: {{ .Values.service.controller.dnsName }}
+{{ end }}
+{{ if .Values.service.controller.serverName }}
+    nginx.webathome.org/server-name: {{ .Values.service.controller.serverName }}
+    nginx.webathome.org/is-public: {{ .Values.service.controller.isPublic | quote }}
+    nginx.webathome.org/enable-ssl: "yes"
+    nginx.webathome.org/target-port: "8080"
+{{ end }}
+spec:
+  type: {{ .Values.service.controller.type }}
+  selector:
+    app.kubernetes.io/name: kubecoder-controller
+  ports:
+    # The Service port stays 8080 (and so does the nginx.webathome.org/target-port annotation
+    # above — that names the SERVICE port, not the container's). Only the target moves: traffic
+    # now lands on the ingress sidecar (:8090), which routes /help/ to the manual and everything
+    # else to the controller. One door into the pod (D159).
+    - port: 8080
+      targetPort: 8090
