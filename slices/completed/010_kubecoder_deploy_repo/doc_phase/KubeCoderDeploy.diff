+#!/bin/sh
+# Resolve chart/Chart.lock into chart/charts/, the same verb Argo's repo-server
+# runs (D17). `helm dependency build` resolves a dependency's repository through
+# helm's local repository list, so the entry has to exist first.
+set -eu
+
+cd "$(dirname "$0")/.."
+
+helm repo add charts-home https://charts.home --force-update >/dev/null
+helm dependency build chart
diff --git a/tests/render-chart.py b/tests/render-chart.py
new file mode 100755
index 0000000..9ea8683
--- /dev/null
+++ b/tests/render-chart.py
@@ -0,0 +1,307 @@
+#!/usr/bin/env python3
+"""The gate: KubeCoder's chart renders each stage the way Argo CD renders it.
+
+A stage is templated the way the releases ApplicationSet has Argo produce it
+(/work/ArgoCDDeploy/chart/templates/applicationsets.yaml:84-120): `chart` under the
+Application's own name `kubecoder-<stage>`, into that namespace, with
+`../config/<stage>/values.yaml` and the four `hook.*` helm parameters as `--set`. The
+library dependency is built from chart/Chart.lock, as the repo-server builds it.
+
+Run tests/build-deps.sh first; the render needs chart/charts/ populated.
+"""
+
+import hashlib
+import pathlib
+import re
+import subprocess
+import sys
+import time
+
+import yaml
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+CHART = REPO / "chart"
+STAGES = ("dev", "prd")
+# Exact (D17), from the chart repository Argo's repo-server resolves it from.
+LIBRARY = {"name": "homelab-shared", "version": "0.2.0", "repository": "https://charts.home"}
+DEFINE = re.compile(r"\{\{-?\s*define\b")
+# The registry entry's `repo:` form, and a SHA of the shape `$ARGOCD_APP_REVISION` becomes.
+HOOK_REPO = "https://github.com/pvginkel/KubeCoderDeploy.git"
+HOOK_REVISION = "0123456789abcdef0123456789abcdef01234567"
+# Where the library's Job template puts the hook
+# (/work/Charts/charts/homelab-shared/templates/_tf-presync-hook.tpl).
+HOOK_NAMESPACE = "argocd-hooks"
+HOOK_GUARD = "is required by the Terraform PreSync hook"
+# The annotation key KUBECODER_DEPLOYMENT_ID's fieldRef reads
+# (templates/controller-deployment.yaml).
+DEPLOYMENT_ID = "deployment"
+# The `releases` AppProject's clusterResourceWhitelist as (group, kind)
+# (/work/ArgoCDDeploy/chart/templates/appproject.yaml:40-47). Argo refuses to sync a
+# cluster-scoped object outside it.
+CLUSTER_WHITELIST = {
+    ("", "Namespace"),
+    ("apiextensions.k8s.io", "CustomResourceDefinition"),
+    ("rbac.authorization.k8s.io", "ClusterRole"),
+    ("rbac.authorization.k8s.io", "ClusterRoleBinding"),
+}
+# Every namespaced kind the chart renders. A render cannot tell a kind's scope, so a kind in
+# neither set fails the gate until it is classified.
+NAMESPACED = {
+    ("", "ConfigMap"),
+    ("", "PersistentVolumeClaim"),
+    ("", "Service"),
+    ("", "ServiceAccount"),
+    ("apps", "Deployment"),
+    ("batch", "Job"),
+    ("external-secrets.io", "ExternalSecret"),
+    ("rbac.authorization.k8s.io", "Role"),
+    ("rbac.authorization.k8s.io", "RoleBinding"),
+}
+
+failures = []
+
+
+def check(condition, message):
+    if not condition:
+        failures.append(message)
+
+
+def namespace(stage):
+    return f"kubecoder-{stage}"
+
+
+def hook_parameters(stage):
+    # In the library's argument order: repo, revision, stage, namespace.
+    return {
+        "hook.repo": HOOK_REPO,
+        "hook.revision": HOOK_REVISION,
+        "hook.stage": stage,
+        "hook.namespace": namespace(stage),
+    }
+
+
+def template(stage, parameters, extra=()):
+    args = [
+        "helm", "template", namespace(stage), "chart",
+        "--namespace", namespace(stage),
+        "--values", f"config/{stage}/values.yaml",
+    ]
+    for name, value in parameters.items():
+        args += ["--set", f"{name}={value}"]
+    return subprocess.run([*args, *extra], cwd=REPO, capture_output=True, text=True)
+
+
+def render(stage, extra=()):
+    result = template(stage, hook_parameters(stage), extra)
+    if result.returncode != 0:
+        sys.exit(f"helm template failed for {stage}:\n{result.stderr}")
+    return result.stdout
+
+
+def objects(stdout):
+    return [doc for doc in yaml.safe_load_all(stdout) if doc]
+
+
+def find(docs, kind, name):
+    for doc in docs:
+        if doc["kind"] == kind and doc["metadata"].get("name") == name:
+            return doc
+    return None
+
+
+def label(doc):
+    metadata = doc["metadata"]
+    return f"{doc['kind']}/{metadata.get('name') or metadata.get('generateName')}"
+
+
+def check_library():
+    chart = yaml.safe_load((CHART / "Chart.yaml").read_text())
+    check(
+        chart.get("dependencies") == [LIBRARY],
+        f"chart/Chart.yaml does not pin exactly {LIBRARY}: {chart.get('dependencies')} (R2)",
+    )
+    links = sorted(str(p.relative_to(REPO)) for p in CHART.rglob("*") if p.is_symlink())
+    check(not links, f"symlinks under chart/, which Argo's repo-server refuses: {links}")
+    defines = sorted(
+        p.name for p in (CHART / "templates").iterdir() if DEFINE.search(p.read_text())
+    )
+    check(not defines, f"templates define helpers the library chart provides: {defines} (R2)")
+    tracked = subprocess.run(
+        ["git", "ls-files", "chart/charts"], cwd=REPO, capture_output=True, text=True, check=True
+    ).stdout.split()
+    check(not tracked, f"the built dependency is committed: {tracked}")
+
+
+def check_stage_values(stage):
+    values = yaml.safe_load((REPO / "config" / stage / "values.yaml").read_text())
+    check(
+        (values.get("global") or {}).get("environment") == stage,
+        f"config/{stage}/values.yaml does not set global.environment to {stage!r} (R4)",
+    )
+
+
+def check_namespace_manifest(stage, docs):
+    ns = namespace(stage)
+    names = [doc["metadata"]["name"] for doc in docs if doc["kind"] == "Namespace"]
+    check(names == [ns], f"{stage}: renders Namespaces {names}, not the one {ns} (D25)")
+    manifest = find(docs, "Namespace", ns)
+    if manifest is None:
+        return
+    annotations = manifest["metadata"].get("annotations") or {}
+    check(
+        annotations.get("argocd.argoproj.io/sync-wave") == "-1",
+        f"{stage}: Namespace/{ns} is missing sync-wave -1 (D25)",
+    )
+    check(
+        annotations.get("argocd.argoproj.io/sync-options") == "Prune=false",
+        f"{stage}: Namespace/{ns} is missing sync-options Prune=false (D26)",
+    )
+
+
+def check_stage_identity(stage, docs):
+    ns = namespace(stage)
+    nodes = f"kubecoder-{stage}-nodes"
+    claim = f"kubecoder-{stage}-zfs-pvc"
+    volume = f"kubecoder-{stage}-zfs-pv"
+
+    check(find(docs, "ClusterRole", nodes) is not None, f"{stage}: no ClusterRole/{nodes} (R4)")
+    binding = find(docs, "ClusterRoleBinding", nodes)
+    check(binding is not None, f"{stage}: no ClusterRoleBinding/{nodes} (R4)")
+    if binding is not None:
+        check(
+            binding["roleRef"]["name"] == nodes,
+            f"{stage}: ClusterRoleBinding/{nodes} binds {binding['roleRef']['name']} (R4)",
+        )
+        subjects = [(s["kind"], s["name"], s.get("namespace")) for s in binding["subjects"]]
+        check(
+            subjects == [("ServiceAccount", "kubecoder-controller", ns)],
+            f"{stage}: ClusterRoleBinding/{nodes} subjects are {subjects}, not the controller in {ns} (R4)",
+        )
+
+    pvc = find(docs, "PersistentVolumeClaim", claim)
+    check(pvc is not None, f"{stage}: no PersistentVolumeClaim/{claim} (R4)")
+    if pvc is not None:
+        check(
+            pvc["spec"].get("volumeName") == volume,
+            f"{stage}: PersistentVolumeClaim/{claim} binds {pvc['spec'].get('volumeName')}, not {volume}",
+        )
+    controller = find(docs, "Deployment", "kubecoder-controller")
+    claims = [
+        v["persistentVolumeClaim"]["claimName"]
+        for v in controller["spec"]["template"]["spec"]["volumes"]
+        if "persistentVolumeClaim" in v
+    ]
+    check(claims == [claim], f"{stage}: the controller mounts claims {claims}, not {claim} (R4)")
+
+
+def pod_annotations(docs, name):
+    return find(docs, "Deployment", name)["spec"]["template"]["metadata"].get("annotations") or {}
+
+
+def deployment_id(docs):
+    return pod_annotations(docs, "kubecoder-controller").get(DEPLOYMENT_ID)
+
+
+def check_deployment_identity(stage, docs):
+    identity = deployment_id(docs)
+    config = find(docs, "ConfigMap", "kubecoder-controller-config")["data"]["controller.yaml"]
+    # Helm's toYaml drops the final newline the ConfigMap's block scalar puts back, so this is
+    # the exact text `sha256sum` hashed.
+    checksum = hashlib.sha256(config.removesuffix("\n").encode()).hexdigest()
+    check(
+        identity == checksum,
+        f"{stage}: the controller's {DEPLOYMENT_ID!r} annotation is {identity!r}, not the "
+        f"checksum of the controllerConfig it mounts, {checksum} (R3)",
+    )
+    for name in ("kubecoder-bot", "kubecoder-mcp"):
+        check(
+            DEPLOYMENT_ID not in pod_annotations(docs, name),
+            f"{stage}: Deployment/{name} carries a {DEPLOYMENT_ID!r} stamp",
+        )
+
+    probed = objects(render(stage, ["--set", "controllerConfig.renderGateProbe=changed"]))
+    check(
+        deployment_id(probed) != identity,
+        f"{stage}: changing controllerConfig leaves the deployment identity unchanged (R3)",
+    )
+
+
+def check_hook_job(stage, docs):
+    jobs = [doc for doc in docs if doc["kind"] == "Job"]
+    check(len(jobs) == 1, f"{stage}: renders {len(jobs)} Jobs, not the one PreSync hook (R6)")
+    if len(jobs) != 1:
+        return
+    metadata = jobs[0]["metadata"]
+    check(
+        metadata.get("generateName") == "tf-presync-" and metadata.get("namespace") == HOOK_NAMESPACE,
+        f"{stage}: the hook Job is {label(jobs[0])} in {metadata.get('namespace')}, not tf-presync- in {HOOK_NAMESPACE} (R6)",
+    )
+    check(
+        (metadata.get("annotations") or {}).get("argocd.argoproj.io/hook") == "PreSync",
+        f"{stage}: the hook Job is not a PreSync hook (R6)",
+    )
+    args = [c.get("args") for c in jobs[0]["spec"]["template"]["spec"]["containers"]]
+    expected = list(hook_parameters(stage).values())
+    check(args == [expected], f"{stage}: the hook Job's args are {args}, not {expected} (R6)")
+
+    for omitted in hook_parameters(stage):
+        parameters = {k: v for k, v in hook_parameters(stage).items() if k != omitted}
+        result = template(stage, parameters)
+        check(
+            result.returncode != 0 and f"{omitted} {HOOK_GUARD}" in result.stderr,
+            f"{stage}: rendering without {omitted} does not fail on the library's guard (R6)",
+        )
+
+
+def check_scope(stage, docs):
+    for doc in docs:
+        api_version = doc["apiVersion"]
+        group_kind = (api_version.split("/")[0] if "/" in api_version else "", doc["kind"])
+        if group_kind in CLUSTER_WHITELIST:
+            continue
+        check(
+            group_kind in NAMESPACED,
+            f"{stage}: {label(doc)} is a kind this gate has not classified; a cluster-scoped kind "
+            "needs the releases AppProject to whitelist it first (R7)",
+        )
+        explicit = doc["metadata"].get("namespace")
+        check(
+            explicit in (None, HOOK_NAMESPACE),
+            f"{stage}: {label(doc)} renders into {explicit}, outside the Application's destination",
+        )
+
+
+def check_render_stable(first):
+    # `now` renders to the second, so a render more than a second later differs if any value
+    # reads the clock; one reading randomness differs on any second render.
+    time.sleep(1.1)
+    for stage in STAGES:
+        check(
+            render(stage) == first[stage],
+            f"{stage}: two renders of the same commit differ (R3)",
+        )
+
+
+def main():
+    check_library()
+    first = {}
+    for stage in STAGES:
+        first[stage] = render(stage)
+        docs = objects(first[stage])
+        check_stage_values(stage)
+        check_namespace_manifest(stage, docs)
+        check_stage_identity(stage, docs)
+        check_deployment_identity(stage, docs)
+        check_hook_job(stage, docs)
+        check_scope(stage, docs)
+    check_render_stable(first)
+
+    if failures:
+        for failure in failures:
+            print(f"FAIL: {failure}", file=sys.stderr)
+        sys.exit(1)
+    counts = ", ".join(f"{stage} {len(objects(first[stage]))}" for stage in STAGES)
+    print(f"ok: both stages render as Argo renders them ({counts} objects)")
+
+
+main()

