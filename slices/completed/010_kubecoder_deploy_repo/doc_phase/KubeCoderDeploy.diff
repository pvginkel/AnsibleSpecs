@@ -0,0 +1,183 @@
+global:
+  # Carries the stage. The chart names the node ClusterRole, its binding's namespace and the ZFS
+  # claim from it, and nothing but this file sets it.
+  environment: prd
+
+service:
+  controller:
+    serverName: kubecoder.home, kubecoder
+  # The MCP adapter's internet-reachable Service. The intranet `mcp` Service is untouched, so
+  # the in-cluster consumer keeps dialling kubecoder-mcp:8080 as before.
+  mcpPublic:
+    serverName: kubecoder-mcp.ginbov.nl
+    isPublic: yes
+
+images:
+  controller: :prd-latest
+  bot: :prd-latest
+  mcp: :prd-latest
+  ingress: :prd-latest
+  manual: :prd-latest
+
+controller:
+  # Both stages run on the same MicroK8s cluster, whose API-server CA certificate carries no
+  # keyUsage extension — the X.509 verification in the controller's runtime rejects it. The API
+  # server is reached over the trusted pod network and the ServiceAccount token authenticates
+  # the client.
+  verifyApiCertificate: false
+
+# Authorised Telegram chat ids (R5/Q013) → KUBECODER_ALLOWED_CHAT_IDS (CSV). DM-only;
+# the bot ignores everyone else.
+bot:
+  allowedChatIds: ["8524367576"]
+
+# The MCP adapter's north leg also accepts IdP-issued JWTs on the public Service above; the
+# static bearer keeps working unchanged for the in-cluster consumer.
+mcp:
+  oidc:
+    issuerUrl: https://auth.ginbov.nl/realms/homelab
+    jwksUrl: https://auth.ginbov.nl/realms/homelab/protocol/openid-connect/certs
+    # Must be bound IdP-side as the `aud` of every token issued for the client; it is the
+    # adapter's own public URL, not a client id.
+    audience: https://kubecoder-mcp.ginbov.nl/mcp
+    publicUrl: https://kubecoder-mcp.ginbov.nl/mcp
+    # The client scope the connector requests: it exists on the authorization server and is
+    # assigned to the connector's client, and every token issued through it echoes it in `scope`.
+    scope: kubecoder-mcp
+    # Empty admits no JWT at all — the operator's own `sub` goes here once their client is
+    # registered with the authorization server.
+    allowedSubjects: ["03811f1f-63f9-4e24-b27f-993490cd5db6"]
+
+# Controller-owned config (D058). The Headlamp deep link moved here from bot.headlampLogsUrl in
+# slice 085: the controller resolves it behind its own short `GET /logs/{envId}` redirect (D171),
+# so the URL is declared once and the bot renders the short link it is handed.
+controllerConfig:
+  # Headlamp deep link to the env pod's dev-container logs (Headlamp ≥0.42 ?view=logs
+  # deep-link; the pod name IS the env id, in the release namespace).
+  headlampLogsUrl: "http://headlamp/c/main/pods/kubecoder-prd/{env_id}?view=logs&container=dev"
+  images:
+    worker: registry:5000/kubecoder-worker:prd-latest
+    vsix: registry:5000/kubecoder-vsix:prd-latest
+
+  # The in-pod SSH transport (slice 170): deployment-wide, no per-env override — every env pod
+  # this controller composes gets an unprivileged sshd and port 22 on its LoadBalancer Service.
+  # Declared per stage rather than in the chart default, because `controllerConfig` is
+  # extra=forbid and a controller image that predates this key refuses to start on it (D191):
+  # dev leads, prd's own overlay follows its promotion.
+  # authorizedKeys is the operator's workstation key; it is read once at env start, so a change
+  # here reaches a running env only on its next roll. An ENABLED sshd with no authorizedKeys, or
+  # a stepCa block without KUBECODER_STEP_CA_PROVISIONER_PASSWORD (the step-ca-provisioner-password
+  # leaf below) or without a KUBECODER_STEP_CA_ROOT naming a CA root certificate the controller can
+  # read (both are env vars the controller Deployment sets), REFUSES controller startup.
+  sshd:
+    enabled: true
+    authorizedKeys:
+      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMOB2beR+Af+8CLWnyOdoQTa3SK/THTr00PwqykISP5W pvginkel
+    # Signs each env's SSH host key. One provisioner serves both stages; it is used for SSH HOST
+    # certificates only. Omitting this block would leave sshd on a bare host key (client TOFU).
+    stepCa:
+      caUrl: https://ca.home
+      provisioner: kubecoder-jwk
+
+# ESO leaves materialised into kubecoder-prd namespace Secrets (no controller OpenBao
+# identity — D031). OpenBao KV paths under eso/prd/kubecoder/prd/*. The `secret-catalog`
+# Secret is what the controller projects into env pods by secretKeyRef.
+externalSecrets:
+  secrets:
+    bot-token:
+      targetName: kubecoder-bot-token
+      data:
+        - {
+            secretKey: token,
+            path: eso/prd/kubecoder/prd/bot-token,
+            property: token,
+          }
+    # Surface-① client credentials, one leaf per client: `clientName` is what makes the
+    # controller render KUBECODER_CLIENT_TOKEN_<NAME> for it, so removing an entry here
+    # revokes that client and reaches no other client's secret.
+    client-token-bot:
+      clientName: bot
+      targetName: kubecoder-client-token-bot
+      data:
+        - {
+            secretKey: token,
+            path: eso/prd/kubecoder/prd/client-token-bot,
+            property: token,
+          }
+    client-token-mcp:
+      clientName: mcp
+      targetName: kubecoder-client-token-mcp
+      data:
+        - {
+            secretKey: token,
+            path: eso/prd/kubecoder/prd/client-token-mcp,
+            property: token,
+          }
+    # The MCP adapter's north-leg inbound bearer (D151) — enforced on every /mcp request
+    # (KUBECODER_MCP_AUTH_TOKEN). The OpenBao KV path eso/prd/kubecoder/prd/mcp-auth-token
+    # (property: token) is seeded out-of-band by the operator before deploy.
+    mcp-auth-token:
+      targetName: kubecoder-mcp-auth-token
+      data:
+        - {
+            secretKey: token,
+            path: eso/prd/kubecoder/prd/mcp-auth-token,
+            property: token,
+          }
+    github-token:
+      targetName: kubecoder-github-token
+      data:
+        - {
+            secretKey: token,
+            path: eso/prd/kubecoder/prd/github-token,
+            property: token,
+          }
+    # Password of step-ca's kubecoder-jwk provisioner (slice 165) →
+    # KUBECODER_STEP_CA_PROVISIONER_PASSWORD on the controller. One provisioner serves both
+    # stages, so this leaf and its dev twin hold the SAME value.
+    step-ca-provisioner-password:
+      targetName: kubecoder-step-ca-provisioner-password
+      data:
+        - {
+            secretKey: password,
+            path: eso/prd/kubecoder/prd/step-ca-provisioner-password,
+            property: password,
+          }
+    secret-catalog:
+      targetName: kubecoder-secret-catalog
+      path: eso/prd/kubecoder/prd/catalog
+    # Samba /work sidecar credential (slice 069) — a DEDICATED single-key Secret the controller
+    # projects into the samba sidecar by envFrom (so it sees ONLY its own credential). The key is
+    # PASSWORD_pvginkel (the samba make-users script reads $PASSWORD_pvginkel). The OpenBao path
+    # shared/samba/users#pvginkel already exists (scantopdf/media use it) — operator applies at deploy.
+    samba-users:
+      targetName: kubecoder-samba-credential
+      data:
+        - {
+            secretKey: PASSWORD_pvginkel,
+            path: shared/samba/users,
+            property: pvginkel,
+          }
+
+resources:
+  kubecoder-controller:
+    ingress:
+      requests:
+        memory: 8Mi
+    tunnel-reclaim:
+      requests:
+        memory: 40Mi
+    kubecoder-controller:
+      requests:
+        memory: 160Mi
+    manual:
+      requests:
+        memory: 7Mi
+  kubecoder-mcp:
+    kubecoder-mcp:
+      requests:
+        memory: 64Mi
+  kubecoder-bot:
+    kubecoder-bot:
+      requests:
+        memory: 64Mi
