diff --git a/chart/values.yaml b/chart/values.yaml
new file mode 100644
index 0000000..4975072
--- /dev/null
+++ b/chart/values.yaml
@@ -0,0 +1,786 @@
+# KubeCoder control-plane chart. Deploys the three long-lived services (controller + bot +
+# the north-facing MCP adapter) and the shared substrate (RBAC, the ZFS share PV that anchors
+# placement, ESO secrets).
+# It does NOT template per-env objects — the controller creates those at runtime (D022).
+# See KubeCoderSpecs/slices/helm-chart.md.
+
+images:
+  controller: :latest # registry:5000/kubecoder-controller{{ .Values.images.controller }}
+  bot: :latest # registry:5000/kubecoder-bot{{ .Values.images.bot }}
+  mcp: :latest # registry:5000/kubecoder-mcp{{ .Values.images.mcp }}
+  # The controller pod's two sidecars (slice 084): the pure-routing nginx front door and the
+  # operator manual it serves at /help/. Both ride IN the controller's pod, so both images must
+  # already be in the registry before this chart rolls — a missing image takes the controller down.
+  ingress: :latest # registry:5000/kubecoder-ingress{{ .Values.images.ingress }}
+  manual: :latest # registry:5000/kubecoder-manual{{ .Values.images.manual }}
+  # The controller pod's dev-tunnel reclaim actuator (slice 105): a loopback-only sidecar that runs
+  # `code tunnel unregister`. Like the two sidecars above it rides IN the controller's pod, so its
+  # image must be in the registry before this chart rolls — a missing image takes the controller down.
+  tunnelReclaim: :latest # registry:5000/kube-coder-tunnel-reclaim{{ .Values.images.tunnelReclaim }}
+
+controller:
+  replicas: 1
+  # Whether the controller verifies the Kubernetes API server's certificate
+  # (KUBECODER_K8S_VERIFY_SSL). A cluster whose API-server CA certificate the controller's
+  # X.509 verification rejects — microk8s', which carries no keyUsage extension — must set
+  # this false; the API server is reached over the trusted pod network and the ServiceAccount
+  # token authenticates the client either way.
+  verifyApiCertificate: true
+
+bot:
+  replicas: 1
+  # Authorised Telegram chat ids (R5/Q013) → KUBECODER_ALLOWED_CHAT_IDS (CSV). DM-only;
+  # the bot ignores everyone else. Empty here ⇒ the bot answers nobody until set per-stage
+  # (config/<stage>/values.yaml) once the operator provides the id.
+  allowedChatIds: []
+
+# The north-facing MCP adapter (D151) — the bot's twin, a second client of surface ①.
+mcp:
+  replicas: 1
+  # The north leg's optional OAuth 2.1 resource-server configuration: with it, the adapter also
+  # admits IdP-issued JWTs, for clients that cannot be handed a bearer token. Which authorization
+  # server sits behind these URLs is deployment configuration the adapter knows nothing about.
+  # issuerUrl / jwksUrl / audience / publicUrl / scope are all-or-nothing: set together they turn
+  # OIDC on, and the adapter refuses to start on a partial set or on any of them
+  # present-but-empty.
+  # Leave the whole block unset on a stage without an authorization server — the adapter then
+  # keeps its static-bearer gate and the Deployment renders none of these variables.
+  oidc:
+    issuerUrl:
+    jwksUrl:
+    # A resource identifier, never a client id, and conventionally the same value as publicUrl.
+    # It must be bound IdP-side on every token issued for the client.
+    audience:
+    # The with-path URL a client dials (https://<public host>/mcp).
+    publicUrl:
+    # One scope, required alongside the four above: advertised in the adapter's protected-resource
+    # metadata and required on every JWT. It must exist on the authorization server and be
+    # assigned to the connector's client — a hosted connector requests the scopes the resource
+    # advertises and its own beside them, offline_access among those.
+    scope:
+    # Admitted token `sub` values (the bot's allowedChatIds pattern, D040). Empty admits no JWT
+    # at all, so an OIDC-enabled stage refuses every one until this is set per-stage.
+    allowedSubjects: []
+
+# Controller-owned config (D058), rendered verbatim into the kubecoder-controller-config
+# ConfigMap and mounted at /etc/kubecoder/controller.yaml. The secret-backed operational
+# bits (API/GitHub tokens) arrive as env vars, not here.
+#
+# EVERY `container:` dict below states `imagePullPolicy: Always` — an INTERIM override of D145's
+# version-pinning direction (D145, amended by slice 100), removed when that pinning lands. These
+# images float on mutable tags, so a node that already holds the layer otherwise keeps serving a
+# stale rebuild. It is stated even where the tag would already yield Always under the kubelet
+# default: these lines are the sunset's checklist, so the redundant-looking ones are load-bearing
+# and must not be cleaned up. The three containers the controller builds from scratch (home-seed
+# init, samba sidecar, image builder) carry the same policy in controller code
+# (podcomposer.CONFIG_IMAGE_PULL_POLICY); the two `images.*` ImageVolumes are a deliberate
+# carve-out, as are author-supplied inline manifest tool images.
+controllerConfig:
+  # The controller's external https origin (nginx-fronted at kubecoder.home, D089). The
+  # surfaced tunnel `url` is an https link under this origin
+  # (https://kubecoder.home/environments/<id>/tunnel/open) that 307-redirects to the worker's
+  # vscode:// deep link, so it is tappable in Telegram. REQUIRED with no default in the
+  # controller config (extra=forbid) — this value and the controller image that needs it must
+  # deploy together (coupled config+chart, D085-style).
+  externalBaseUrl: https://kubecoder.home
+  # The operator's real Headlamp container-logs deep link, carrying a literal {env_id} token the
+  # controller substitutes when `GET /logs/{envId}` 307-redirects to it (D171). This is the ONE
+  # place the Headlamp URL is declared: the bot no longer holds a template of its own — the
+  # controller mints the short link (<externalBaseUrl>/logs/<envId>) onto Environment.logs_url and
+  # the bot renders it verbatim, exactly as it does the tunnel link. OPTIONAL (the controller
+  # config is extra=forbid, so this defaults rather than being required); unset ⇒ logs_url is null,
+  # the route 404s and no link is rendered. Set per-stage — the URL embeds the release namespace
+  # (env pods run in the controller's namespace).
+  headlampLogsUrl:
+  # The controller's IN-CLUSTER base URL — the Service DNS an env pod dials to reach surface ①
+  # for its in-pod self-actions (e.g. `kc env restart`, slice 039 / D101-D102). REQUIRED with no
+  # default in the controller config (extra=forbid), mirroring externalBaseUrl, so this value and
+  # the controller image that needs it must deploy together (coupled config+chart). Short
+  # same-namespace Service form.
+  internalBaseUrl: http://kubecoder-controller:8080
+  # Cap on the concurrent dev-tunnel reservations KubeCoder allocates against the shared account
+  # (slice 105). Bounds only KUBECODER's own reservations — the operator may spend the account's
+  # remaining slots elsewhere — and is never a claim about the account's true total. OPTIONAL: the
+  # controller defaults it to 10 (ControllerConfig.max_tunnels), so this is the operator's explicit
+  # knob, not a required key.
+  max_tunnels: 10
+  defaultProfile: claude-dev
+  profiles:
+    claude-dev:
+      # The dev (main) container as a k8s container spec (D030). The controller fills in
+      # volumeMounts/env when it composes the env pod (Phase 3b); resources.limits.memory
+      # is the admission-gate source of truth and is mandatory.
+      mainContainer:
+        name: dev
+        image: registry:5000/kube-coder-dev:latest
+        imagePullPolicy: Always
+        resources:
+          limits:
+            memory: 8Gi
+      # Setup-wide plain, non-secret env vars projected onto every env pod's dev container
+      # (D167). A sibling of `mainContainer`, NOT a key inside it — the composer assigns the
+      # dev container's `env` wholesale, so anything authored under `mainContainer.env` is
+      # silently discarded. A project overrides any name here in its own `.kubecoder/config.yaml`
+      # `env:` (the manifest wins); names only one level declares are unioned in.
+      # Secret material does NOT belong here — it keeps its `manifest.secrets` → ESO path (D031).
+      # Names the platform owns (the `KUBECODER_*` prefix, plus HOME/TZ/PATH/GH_TOKEN
+      # and the VSCODE_CLI_* trio), a repeat, or a non-POSIX name REFUSE controller startup —
+      # a typo here crash-loops the controller rather than degrading quietly.
+      # cexec caveat before adding one: a name starting `KUBERNETES_` or containing `_PORT` /
+      # `_SERVICE_` reaches the dev container but is dropped from every cexec'd tool, silently
+      # (hence KEYCLOAK_URL, not KEYCLOAK_PORT).
+      # This key and the controller image that understands it must deploy together (coupled
+      # config+chart, D085-style): a controller without D167's schema sees an unknown key and
+      # refuses to start.
+      env:
+        - { name: KEYCLOAK_URL, value: http://keycloak-dev }
+        - { name: KEYCLOAK_REALM, value: homelab-dev }
+        - { name: GIT_USER_NAME, value: "Pieter van Ginkel" }
+        - { name: GIT_USER_EMAIL, value: pvginkel@gmail.com }
+  # Service catalog (native sidecars, D029). The four data services are dev-tuned definitions
+  # DERIVED from DesignAssistant's CI services (Jenkinsfile / tools/suite_runner/remote.py),
+  # deliberately NOT copied: small footprints sized for several envs sharing one node
+  # (Q004/Q006). Each container MUST set resources.limits.memory (the startup guard).
+  # `dataPath` hostPath-mounts the env's `sidecars/<catalog key>` directory so the service's data
+  # survives a pod restart/stop-start. `secrets:` maps ENV_VAR -> catalog key; the controller
+  # projects each as a secretKeyRef into the sidecar against its configured catalog Secret (D031),
+  # and a key the live catalog lacks drops the whole service with a warning rather than failing the
+  # env. That field and the controller image that understands it must deploy together (coupled
+  # config+chart, D085-style): a controller without it sees an unknown key and refuses to start.
+  services:
+    postgres:
+      # Plain latest PostgreSQL (Q004: DA's pgvector is no longer used). Dev-tuned: small
+      # shared_buffers + few connections — a throwaway per-project DB, not a prod cluster.
+      description: >-
+        PostgreSQL 18 relational database, dev-tuned (small buffers, 50 connections); data
+        persists across restarts.
+      instructions: >-
+        PostgreSQL 18, running as a sidecar in this environment's pod and reachable at
+        localhost:5432. Connect as user `postgres` with password `postgres`; the default database
+        is also `postgres`. Only the password is configured anywhere — on the sidecar's own
+        environment; the user and database are the image's defaults, set nowhere. None of it
+        reaches the dev container: Kubernetes service-link variables are disabled and there is no
+        connection secret. If the repo configures its own connection string, prefer that over
+        hardcoding these values. The data directory persists per environment and survives a pod
+        restart. It is a small dev-tuned instance (128MB shared_buffers, 50 connections), not a
+        production cluster.
+      container:
+        image: postgres:18
+        imagePullPolicy: Always
+        args:
+          [
+            -c,
+            shared_buffers=128MB,
+            -c,
+            max_connections=50,
+            -c,
+            effective_cache_size=256MB,
+            -c,
+            work_mem=8MB,
+          ]
+        env:
+          - { name: POSTGRES_PASSWORD, value: postgres }
+          - { name: PGDATA, value: /var/lib/postgresql/data/pgdata }
+        # Root so the official entrypoint can initdb + own PGDATA on the hostPath subfolder
+        # (the pod's runAsUser=1000 has no passwd entry the postgres tooling can resolve).
+        securityContext: { runAsUser: 0, runAsGroup: 0 }
+        # No memory request — the pod composer books it at 0 (D124) so capacity is governed
+        # solely by the env count cap; the limit still caps usage.
+        resources:
+          limits: { memory: 512Mi }
+      dataPath: /var/lib/postgresql/data
+      ports:
+        - { port: 5432, type: tcp }
+    opensearch:
+      # Single-node, security off (dev). Heap is the knob that matters most for fitting
+      # several envs on one node — kept lean (CI uses 192m; a usable dev node gets a little
+      # more) and single-processor. Runs as its native uid 1000 (data dir chowned to it).
+      description: >-
+        OpenSearch 2 search and analytics engine — single-node, security disabled, lean heap.
+      instructions: >-
+        OpenSearch 2, running as a sidecar in this environment's pod and reachable at
+        http://localhost:9200. The security plugin is disabled, so it is plain HTTP with no
+        credentials and no TLS — query it directly. It runs single-node with a 256MB heap and one
+        processor, so treat it as a small dev index rather than something to load-test. Its data
+        directory persists per environment and survives a pod restart.
+      container:
+        image: opensearchproject/opensearch:2
+        imagePullPolicy: Always
+        env:
+          - { name: discovery.type, value: single-node }
+          - { name: plugins.security.disabled, value: "true" }
+          - { name: DISABLE_INSTALL_DEMO_CONFIG, value: "true" }
+          - { name: bootstrap.memory_lock, value: "false" }
+          - {
+              name: OPENSEARCH_JAVA_OPTS,
+              value: "-Xms256m -Xmx256m -XX:MaxDirectMemorySize=64m -Dnode.processors=1",
+            }
+        # No memory request — the pod composer books it at 0 (D124) so capacity is governed
+        # solely by the env count cap; the limit still caps usage.
+        resources:
+          limits: { memory: 768Mi }
+      dataPath: /usr/share/opensearch/data
+      ports:
+        - { port: 9200, type: http }
+    minio:
+      # MinIO S3-compatible object store (DA stores documents here). Tiny dev footprint.
+      description: >-
+        MinIO S3-compatible object store, with the web console on the second port.
+      instructions: >-
+        MinIO, an S3-compatible object store running as a sidecar in this environment's pod. The
+        S3 API is at http://localhost:9000 and the web console at http://localhost:9001; both use
+        access key `minioadmin` and secret key `minioadmin`. No buckets are pre-created — the
+        container only runs the server — so create whatever the repo needs. Its data directory
+        persists per environment and survives a pod restart.
+      container:
+        image: minio/minio
+        imagePullPolicy: Always
+        command: [minio]
+        args: [server, /data, --console-address, ":9001"]
+        env:
+          - { name: MINIO_ROOT_USER, value: minioadmin }
+          - { name: MINIO_ROOT_PASSWORD, value: minioadmin }
+        # No memory request — the pod composer books it at 0 (D124) so capacity is governed
+        # solely by the env count cap; the limit still caps usage.
+        resources:
+          limits: { memory: 256Mi }
+      dataPath: /data
+      ports:
+        - { port: 9000, type: http }
+        - { port: 9001, type: http }
+    rabbitmq:
+      # RabbitMQ broker (DA's async work) with the management UI. Runs as root: the Erlang
+      # runtime wants a resolvable user + HOME and to own /var/lib/rabbitmq on the hostPath.
+      description: >-
+        RabbitMQ 4.3 message broker, with the management UI on the second port.
+      instructions: >-
+        RabbitMQ 4.3 with the management plugin, running as a sidecar in this environment's pod.
+        AMQP is at localhost:5672 and the management UI at http://localhost:15672. No user is
+        configured, so the image's default `guest`/`guest` applies. RabbitMQ accepts `guest` only
+        over a loopback interface, which is exactly the case here: every container in the pod
+        shares one network namespace, so the dev container reaches the broker as localhost. Its
+        data directory persists per environment and survives a pod restart.
+      container:
+        image: rabbitmq:4.3-management
+        imagePullPolicy: Always
+        securityContext: { runAsUser: 0, runAsGroup: 0 }
+        # No memory request — the pod composer books it at 0 (D124) so capacity is governed
+        # solely by the env count cap; the limit still caps usage.
+        resources:
+          limits: { memory: 512Mi }
+      dataPath: /var/lib/rabbitmq
+      ports:
+        - { port: 5672, type: tcp }
+        - { port: 15672, type: http }
+    terraform-backend-git:
+      # The git-backed Terraform state backend that pvginkel/Ansible's `backend "http"` blocks
+      # address at http://localhost:6061 — reachable because every container in the env pod
+      # shares one network namespace, and published nowhere outside it (only a manifest's
+      # `expose:` folds a port into the env's Service). No dataPath: the daemon clones
+      # pvginkel/TerraformState into an in-memory working tree (shallow, one per repository,
+      # cached until the sidecar restarts) and writes nothing to disk. The image declares no
+      # ENTRYPOINT (its CMD is `bash`), so the binary is named as the command.
+      description: >-
+        terraform-backend-git — a Terraform HTTP state backend that stores state in a git
+        repository, SOPS/age encrypted.
+      instructions: >-
+        terraform-backend-git, running as a sidecar in this environment's pod and reachable at
+        http://localhost:6061. It serves Terraform's HTTP state protocol, keeping state in a git
+        repository and encrypting it with SOPS/age. Which repository, which state path and which
+        encryption are all carried by the backend URL, so use the `backend "http"` blocks the
+        repo already declares rather than composing your own. Its GitHub token and age keys are
+        configured on the sidecar itself and are not readable from the dev container. It writes
+        nothing to disk: the state repository is cloned into an in-memory working tree, which is
+        kept for the sidecar's lifetime and shared across requests.
+      container:
+        image: ghcr.io/plumber-cd/terraform-backend-git:v0.1.11
+        imagePullPolicy: Always
+        command: [terraform-backend-git]
+        args: [--access-logs]
+        env:
+          - { name: GIT_USERNAME, value: x-access-token }
+          - { name: TF_BACKEND_HTTP_ENCRYPTION_PROVIDER, value: sops }
+        # Root so go-git can resolve the calling user when it commits a lock file: the image
+        # carries no passwd entry for the pod's runAsUser=1000, and without one every LOCK
+        # fails with a 500 and no `terraform apply` completes.
+        securityContext: { runAsUser: 0, runAsGroup: 0 }
+        # No memory request — the pod composer books it at 0 (D124) so capacity is governed
+        # solely by the env count cap; the limit still caps usage.
+        resources:
+          limits: { memory: 256Mi }
+      # GITHUB_TOKEN reuses the shared github-rw catalog key: a catalog service is
+      # operator-curated, so these are projected regardless of the environment's declared
+      # `capabilities.github` level. The two age keys live in the same catalog leaf, seeded
+      # there by the operator.
+      secrets:
+        GITHUB_TOKEN: github-rw
+        SOPS_AGE_KEY: tf-backend-age-secret-key
+        TF_BACKEND_HTTP_SOPS_AGE_RECIPIENTS: tf-backend-age-public-key
+      ports:
+        - { port: 6061, type: http }
+  # Toolchain catalog (D115, slice 054) — operator-curated reusable dev/tool sidecars, selected
+  # from a repo manifest's `tools` list by `{use: <name>}` exactly as `services` are. Each is a
+  # raw container spec (parallel to a service), MINUS the service-data field (no dataPath —
+  # toolchains carry no service data). Most images are built on the shared kube-coder-dev-base;
+  # `esp-idf` and `arm64-cross` are thin layers on the upstream image the repos they serve already
+  # build with in CI (slice 214), which is why those two are the only entries reaching for
+  # `activationWrapper` or `skipParityChecks`. A toolchain MUST declare a `resources.limits.memory`
+  # and MUST NOT declare `command`/`args` — the controller refuses to start on either, and it
+  # composes the exec daemon as the container command itself, so a declared one would fight it
+  # (slice 125). Limit only, no request (the pod composer books the request at 0; D124).
+  # A matrix-built image publishes only its resolved tag and no `:latest`, so its entry pins that
+  # tag — frontend, modern-app, java and esp-idf; every other entry takes `:latest`. Adding a
+  # second version of a matrix image therefore needs a second entry here as well as a second matrix
+  # row. Selecting one yields an exec-ready sidecar carrying the dev
+  # container's full home stack (D-S3). A toolchain declares the writable persistent home paths it
+  # needs in its OWN `homeOverlays:` (a sibling of `container:`, not a key inside it); the
+  # controller unions and dedupes that with its built-in list and the selecting repo manifest's
+  # `homeOverlays:`, so a repo need not know what a toolchain requires — see frontend/modern-app
+  # and `.corepack` below, the first case of this. There is no inheritance between entries: an
+  # image built FROM another toolchain's image declares the same overlays again on its own entry.
+  # An overlay MASKS whatever the image baked at that path, so an entry declaring one must not
+  # also bake content there.
+  toolchains:
+    python:
+      description: >-
+        Python 3.13 with uv, Poetry and Ruff.
+      instructions: >-
+        The Python toolchain. It carries Poetry, Ruff and uv, all in system paths. Python itself
+        is the base image's own 3.13; no second interpreter is installed.
+      container:
+        image: registry:5000/kube-coder-python-toolchain:latest
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 1Gi }
+    frontend:
+      # Runs Playwright (browser automation) — the larger limit is for the headless browser.
+      # Declares the node re-download caches this toolchain owns, so each persists per env instead
+      # of being re-fetched on every pod start:
+      #   - .bun: bun's package cache at ~/.bun/install/cache. The image installs the binary into
+      #     /usr/local/bin and leaves BUN_INSTALL out of its ENV precisely so bun's mutable state
+      #     stays under ~/.bun, where uid 1000 can write it and this overlay can keep it.
+      #   - .corepack: the image sets COREPACK_HOME=/home/ubuntu/.corepack and bakes no pnpm, so
+      #     corepack downloads the version a repo pins in `packageManager` on first use — the path
+      #     must be writable by uid 1000 (the old system-path /opt/corepack was root-owned and
+      #     failed with "Failed to create cache directory").
+      #   - .npm: npm's cache at ~/.npm. slice 116 drops .npm from the controller's built-in overlay
+      #     list, so a node repo now gets its per-env npm cache from this declaration.
+      #   - .pnpm: pnpm's content store. Persisting it depends on the image's
+      #     PNPM_HOME=/home/ubuntu/.pnpm (+ store-dir under it) ENV — the declaration alone is an
+      #     empty dir with no writer.
+      # The image bakes nothing at any of the four, so none masks baked content.
+      description: >-
+        Node.js 24 with npm, pnpm and bun, plus the Chromium system libraries Playwright needs
+        (browsers are not bundled — the repo installs them).
+      instructions: >-
+        The frontend toolchain. It carries Node 24 with corepack enabled, bun, and Playwright's OS
+        dependencies, but no browser bundle, so browsers must be installed before browser tests
+        can run.
+      homeOverlays: [.bun, .corepack, .npm, .pnpm]
+      container:
+        image: registry:5000/kube-coder-frontend-toolchain:node-24
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 5Gi }
+    modern-app:
+      # The python + frontend toolsets in one sidecar (image kube-coder-modern-app-toolchain, built
+      # FROM the frontend toolchain + the python tools), for full-stack repos. Matrix-built off the
+      # frontend toolchain's shared build-matrix, so it carries the same node-$NODE_VERSION tag and
+      # no `:latest`. Carries Playwright via the frontend layer, but unlike frontend it also boots the
+      # app under test: a full-stack E2E suite spawns the backend (+ SSE + frontend) per Playwright
+      # worker alongside chromium, and backend pytest runs in the same sidecar — which pushed past
+      # frontend's 3Gi (OOMKilled during IoTSupport onboarding), hence 5Gi. Built FROM the frontend
+      # image, it inherits that image's node env (COREPACK_HOME + PNPM_HOME) and its bun install, so
+      # it needs the same [.bun, .corepack, .npm, .pnpm] overlays for the same reasons as frontend
+      # (see its note) — re-declared here on its own entry, since the union reads each selected
+      # toolchain's own list and does not follow image inheritance.
+      description: >-
+        The frontend and Python toolchains in one sidecar for full-stack repos: Node.js 24 with
+        npm, pnpm and bun and the Chromium system libraries, plus uv, Poetry and Ruff.
+      instructions: >-
+        The frontend and Python toolchains together in one sibling container, for full-stack
+        repos. Built from the frontend toolchain image, so it carries Node 24 with corepack, bun
+        and Playwright's OS dependencies (no browser bundle), plus Poetry, Ruff and uv.
+      homeOverlays: [.bun, .corepack, .npm, .pnpm]
+      container:
+        image: registry:5000/kube-coder-modern-app-toolchain:node-24
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 5Gi }
+    go:
+      # Declares `go` to persist the GOPATH module cache: Go defaults GOPATH to ~/go and downloads
+      # modules into ~/go/pkg/mod, so persisting the whole ~/go overlay keeps them across pod
+      # restarts instead of re-fetching per pod. The image sets no GOPATH/GOMODCACHE ENV and bakes
+      # nothing under ~/go, so the overlay masks nothing. (Go's build cache lives under the
+      # system-covered ~/.cache, so it needs no declaration here.)
+      description: >-
+        Go with golangci-lint.
+      instructions: >-
+        The Go toolchain. It carries the Go compiler (the distribution's golang-go package) and
+        golangci-lint.
+      homeOverlays: [go]
+      container:
+        image: registry:5000/kube-coder-go-toolchain:latest
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 2Gi }
+    iac:
+      # Declares `.terraform-plugin-cache` to persist terraform's provider plugin cache, so
+      # `terraform init` reuses downloaded providers instead of re-fetching them per pod. Persisting
+      # it depends on the image's TF_PLUGIN_CACHE_DIR=/home/ubuntu/.terraform-plugin-cache ENV — the
+      # declaration alone is an empty dir with no writer. The dirname is dot-free by necessity:
+      # `.terraform.d` would derive the invalid k8s volume name `home-terraform.d`. The image bakes
+      # nothing there, so the overlay masks nothing.
+      description: >-
+        Infrastructure tooling: Terraform, Helm 4, kubectl, OpenBao (bao) and step-cli — on top
+        of the Python toolchain.
+      instructions: >-
+        The infrastructure toolchain. It carries kubectl, helm, terraform, bao (OpenBao) and
+        step-cli, and is layered on the Python toolchain, so Poetry, Ruff and uv are present too.
+      homeOverlays: [.terraform-plugin-cache]
+      container:
+        image: registry:5000/kube-coder-iac-toolchain:latest
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 1Gi }
+    java:
+      # Declares `.m2` to persist Maven's local repository at ~/.m2/repository — the downloaded
+      # artifact cache — so builds do not re-fetch dependencies per pod. The image bakes nothing
+      # under ~/.m2, so the overlay masks nothing.
+      description: >-
+        OpenJDK 21 with Maven.
+      instructions: >-
+        The Java toolchain. It carries OpenJDK 21 and Maven.
+      homeOverlays: [.m2]
+      container:
+        image: registry:5000/kube-coder-java-toolchain:jdk-21
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 1Gi }
+    esp-idf:
+      # Slice 214, serving the firmware repos. A thin layer on `espressif/idf:v5.5.3` rather than
+      # on kube-coder-dev-base, so the toolchain set is Espressif's own; the image is matrix-built
+      # and carries no `:latest`, hence the pinned tag below.
+      # `activationWrapper` is what puts IDF on PATH: the composer overwrites the container command
+      # with the exec daemon, so the image's own ENTRYPOINT never runs and `cexec` prepends this
+      # argv instead. /opt/esp/entrypoint.sh is upstream's export-then-`exec "$@"` script, verified
+      # present and executable in the built image — a declared wrapper that does not resolve is a
+      # hard error, and one that only sources is a silent no-op.
+      # Declares `.ccache` to persist the compiler cache upstream's IDF_CCACHE_ENABLE=1 fills, at
+      # the image's CCACHE_DIR=/home/ubuntu/.ccache; the image bakes nothing there. The IDF tools
+      # are deliberately NOT overlaid — they sit at IDF_TOOLS_PATH=/opt/esp, a system path, and an
+      # overlay there would mask the whole toolchain out of existence at pod start. The component
+      # manager's download cache is under the controller's built-in `.cache` already.
+      # 4Gi is an UNMEASURED starting point — tune it against a real firmware build.
+      description: >-
+        ESP-IDF 5.5.3 for ESP32 firmware: idf.py with the Xtensa and RISC-V toolchains.
+      instructions: >-
+        The ESP-IDF toolchain, at version 5.5.3. It is Espressif's own image, so `idf.py`, the
+        Xtensa and RISC-V cross compilers and the IDF Python environment are present and are
+        activated for you: every command run here already runs inside the IDF environment. Project
+        components are resolved from Espressif's component registry at build time, not baked in.
+      homeOverlays: [.ccache]
+      activationWrapper: [/opt/esp/entrypoint.sh]
+      container:
+        image: registry:5000/kube-coder-esp-idf-toolchain:idf-5.5.3
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 4Gi }
+    dotnet:
+      # Slice 214. Declares `.nuget` to persist NuGet's global packages folder at its
+      # ~/.nuget/packages default — the restored-package cache — so builds do not re-fetch
+      # dependencies per pod. The image sets no NUGET_PACKAGES and bakes nothing under ~/.nuget, so
+      # the overlay masks nothing. NuGet's HTTP cache needs no declaration of its own: the image
+      # points NUGET_HTTP_CACHE_PATH under the controller's built-in `.cache` overlay.
+      # 2Gi is an UNMEASURED starting point — tune it against a real build.
+      description: >-
+        The .NET 8 and 9 SDKs side by side.
+      instructions: >-
+        The .NET toolchain. It carries the 8.0 and 9.0 SDKs installed side by side behind one
+        `dotnet` on PATH. A project builds with the SDK its `global.json` names, else the highest
+        installed one, and that SDK builds any target framework it has a targeting pack for — so
+        `dotnet build`, `dotnet test` and `dotnet publish` work against a net8.0 project and a
+        net9.0 project alike. No global dotnet tools are baked.
+      homeOverlays: [.nuget]
+      container:
+        image: registry:5000/kube-coder-dotnet-toolchain:latest
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 2Gi }
+    android:
+      # Slice 214. Two overlays, each persisting a download a build would otherwise repeat per pod:
+      #   - .gradle: Gradle's user home at its ~/.gradle default. The image bakes NO Gradle — each
+      #     repo's wrapper fetches the distribution that repo pins — and a repo pinning its JVM
+      #     through gradle-daemon-jvm.properties has Gradle provision that JDK into ~/.gradle/jdks
+      #     as well (~350 MB for JetBrains Runtime 21). Load-bearing, not a nicety.
+      #   - .android: the SDK's per-user directory, ~/.android — its download cache and the
+      #     debug.keystore, which must stay stable across pods for a debug build to keep its
+      #     signing identity.
+      # The image bakes nothing at either, and the SDK itself is on the system path
+      # ANDROID_HOME=/opt/android-sdk, so no overlay masks it. Licences are accepted in the image
+      # and the SDK tree is uid-1000-owned, so a component download AGP starts finishes rather than
+      # stopping on a prompt or on permissions.
+      # 5Gi is an UNMEASURED starting point — tune it against a real build.
+      description: >-
+        The Android SDK: platform 35, build-tools 35.0.0 and cmdline-tools on JDK 17.
+      instructions: >-
+        The Android toolchain. It carries JDK 17 and the Android SDK at /opt/android-sdk — platform
+        35, build-tools 35.0.0 and cmdline-tools, with the licences accepted — so sdkmanager,
+        apksigner, aapt2, zipalign and d8 all resolve on PATH. Gradle is NOT in the image: run each
+        repo's own `./gradlew` wrapper, which fetches the version that repo pins.
+      homeOverlays: [.gradle, .android]
+      container:
+        image: registry:5000/kube-coder-android-toolchain:latest
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 5Gi }
+    arm64-cross:
+      # Slice 214, serving KitchenDisplay. A thin layer on `dockcross/linux-arm64` rather than on
+      # kube-coder-dev-base — the image that repo's CI cross-builds with — so the cross triple,
+      # CROSS_ROOT, the compiler variables and the CMake toolchain file all arrive as that base's
+      # own ENV and nothing here shadows them.
+      # That base is Debian and carries no passwd entry for uid 1000 (confirmed against the built
+      # image: `getent passwd 1000` is empty), so `skipParityChecks` mutes cexec's advisory passwd
+      # warning that would otherwise fire on every command. It grants no capability.
+      # No homeOverlays: everything a cross build reads is image ENV, and its output lands in the
+      # checkout's own build tree — nothing worth persisting is written under $HOME.
+      # 4Gi is an UNMEASURED starting point — tune it against a real build.
+      description: >-
+        An aarch64 cross-compiler toolchain (dockcross/linux-arm64) with CMake and Make.
+      instructions: >-
+        The arm64 cross toolchain, for building aarch64 binaries. It is CROSS-ONLY: $CC and $CXX
+        are the aarch64-unknown-linux-gnu compilers and its `cmake` injects the cross toolchain
+        file, so a pass that is meant to produce native x86_64 binaries will silently cross-compile
+        if you run it here — run that pass in another container.
+      skipParityChecks: true
+      container:
+        image: registry:5000/kube-coder-arm64-cross-toolchain:latest
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 4Gi }
+    native:
+      # Native x86_64 C/C++ on kube-coder-dev-base. It also carries clang-format and clang-tidy,
+      # which the esp-idf and arm64-cross stock images do not, so a repo whose build runs in one of
+      # those selects this one alongside it for its formatting gate. Every tool is the base Ubuntu
+      # release's apt package, so clang-format's major version changes only with the base.
+      # No homeOverlays: a build writes into the checkout, and the image configures no ccache.
+      # 4Gi is an UNMEASURED starting point — tune it against a real build.
+      description: >-
+        Native x86_64 C and C++: GCC, Clang, clang-format, clang-tidy, CMake, Ninja and gdb.
+      instructions: >-
+        The native C/C++ toolchain, for building and checking x86_64 code. It carries
+        build-essential (gcc, g++, make), clang, clang-format, clang-tidy, CMake with Ninja, gdb
+        and pkg-config, all from the base Ubuntu release. CC and CXX are unset, so `cc` is gcc;
+        select clang by name. A repo that builds in esp-idf or arm64-cross runs its clang-format
+        here, since neither of those carries it.
+      container:
+        image: registry:5000/kube-coder-native-toolchain:latest
+        imagePullPolicy: Always
+        resources:
+          limits: { memory: 4Gi }
+  # The kubeconfig files this deployment projects under ~/.kube (D085), in projection order.
+  # `catalogKey` is the catalog Secret key holding the file and `file` the bare name it lands as,
+  # so this list is also the set of catalog keys every env's catalog must carry. An entry without
+  # a `grant` reaches every env; a `grant` names the `capabilities.<name>` key an env's manifest
+  # sets to override the `default` here. The controller declares no kubeconfig of its own.
+  # Each `description` is rendered VERBATIM into the env's CLAUDE.md, after "- `~/.kube/<file>` - ",
+  # so it carries its own terminal full stop and states only what this deployment's file grants:
+  # kubectl's mechanism (which file is the default, the identical mount in every tool container,
+  # elevated files never merged into KUBECONFIG) is the worker's template prose, not repeated here.
+  kubeconfigs:
+    - file: config
+      catalogKey: kubeconfig
+      description: >-
+        has contexts `dev` and `prd` (current context `prd`), granting **read-only** access on both
+        the `dev` and `prd` clusters **plus** read-write access in the `prd` cluster's
+        `development` namespace.
+    - file: config-dev-write
+      catalogKey: kubeconfig-dev-write
+      description: >-
+        an **elevated** dev-write kubeconfig (context `dev`).
+      grant:
+        name: kubeDevWrite
+        default: false
+    - file: config-prd-write
+      catalogKey: kubeconfig-prd-write
+      description: >-
+        an **elevated** prd-write kubeconfig (context `prd`), bound to `cluster-admin`: every verb
+        on every resource, cluster-scoped included — nodes, PersistentVolumes, namespaces and RBAC
+        are all writable.
+      grant:
+        name: kubePrdWrite
+        default: false
+  whitelist:
+    - { namespace: pvginkel, kind: user }
+  # Env-pod placement stamped by the controller (D050): want the node that has the share
+  # AND is high-performance, and tolerate its NoSchedule taint (D044).
+  placement:
+    nodeAffinity:
+      - { key: homelab.local/storage, value: zpool5 }
+      - { key: homelab.local/performance, value: high }
+    tolerations:
+      - {
+          key: homelab.local/performance,
+          operator: Equal,
+          value: high,
+          effect: NoSchedule,
+        }
+  # How an env is reachable from outside the cluster (slice 201, D191): the DNS suffix every
+  # naming site joins the env-id onto (`<env-id>.home`, and `<port-name>.<env-id>.home` for an
+  # offloaded port), the annotation this homelab's DNS controller reads off the env Service, and
+  # the three its nginx edge reads off each `sslOffload` front Service. `{host}` is the Service's
+  # own DNS name and `{port}` the offloaded port number — the only placeholders either map may
+  # name, checked at load, so a typo fails the deploy rather than every later pod composition. No
+  # `is-public` annotation among them: the absent flag is what keeps an offloaded port
+  # intranet-only, on step-ca (D086). OPTIONAL — the controller defaults each key to exactly what
+  # stands here, so declaring them changes no behaviour; it moves the homelab's own exposure
+  # vocabulary out of controller code and into this deployment, where a different edge or DNS
+  # provider costs config rather than code.
+  exposure:
+    dnsSuffix: home
+    serviceAnnotations:
+      dns.webathome.org/hostname: "{host}"
+    frontServiceAnnotations:
+      nginx.webathome.org/server-name: "{host}"
+      nginx.webathome.org/enable-ssl: "yes"
+      nginx.webathome.org/target-port: "{port}"
+  storage:
+    zfsMountPath: /zfs # where the controller mounts the env-storage share
+    zfsHostPath: /zpool5/kubecoder # the dataset's node path (env pods hostPath-mount here)
+    # The single ZFS home shared by every env pod (D061): <zfsHostPath>/system/home, mounted
+    # at /home/<homeUser>. homeUid (default 1000) owns it + is the env pod's runAsUser/fsGroup.
+    homeUser: ubuntu
+  github:
+    apiBaseUrl: https://api.github.com
+    # The one host the controller builds clone URLs on, accepts shared extra repos on, and embeds
+    # its PAT for (D135). A bare host name: a scheme, a path or a space refuses startup. Not
+    # derived from apiBaseUrl: the credential's destination is declared, never inferred from a
+    # differently-purposed setting.
+    cloneHost: github.com
+  images:
+    # Image root IS the worker's bin directory, mounted as an ImageVolume at TWO paths: at
+    # /opt/kubecoder/bin on the dev container and every parity tool sidecar, and at
+    # /kubecoderenvtools/bin on the image-builder sidecar, which resolves kanikod straight from
+    # the image root. Change this key and BOTH mount points need checking (D121, slice 104).
+    worker: registry:5000/kubecoder-worker:latest
+    # The packaged VS Code extension alone (extension.vsix at the image root), mounted as an
+    # ImageVolume at /opt/kubecoder/share on the dev container only (D095, slice 104).
+    vsix: registry:5000/kubecoder-vsix:latest
+    # Distributed as a Kubernetes ImageVolume mounting the image root at $HOME/.local (slice 011)
+    localHome: registry:5000/kube-coder-dev-local-home:latest
+  # Samba /work sidecar (D139, slice 069) — controller-composed env-pod infrastructure that
+  # exposes each env's /work over authenticated SMB (445) so the operator can browse/transfer
+  # the source tree from their desktop. The PRESENCE of this block is the deployment-wide on/off
+  # switch (omit it and no env gets samba). NOT a services catalog entry, NOT manifest-selected.
+  # The image keeps the tracking :latest tag (own image in registry:5000) and is not pinned. This
+  # block carries no raw container dict, so the sidecar's `imagePullPolicy: Always` is set in
+  # controller code (_samba_sidecar), not here.
+  # configMap = the smb.conf + make-users ConfigMap (templates/samba-configmap.yaml);
+  # credentialSecret = the dedicated samba-only Secret (samba-users ExternalSecret, key
+  # PASSWORD_pvginkel). Exposure posture (root + shareProcessNamespace) is documented in the
+  # controller's docs/platform/samba-work-share.md; Triage #137 owns the hardening follow-up.
+  samba:
+    image: registry:5000/samba:latest
+    configMap: kubecoder-samba-config
+    credentialSecret: kubecoder-samba-credential
+    resources:
+      limits: { memory: 256Mi }
+  # The per-env image builder (slice 140) — controller-composed env-pod infrastructure that runs
+  # the worker's `kanikod` daemon as a sidecar; the dev container reaches it with the `kaniko`
+  # client over a dedicated unix socket, streaming the build context as a gzipped tar. Unlike
+  # `samba` above, this block's presence is only HALF the switch: it says the deployment CAN
+  # build, and an environment's own `.kubecoder/config.yaml` `imageBuilder: true` says it DOES —
+  # either half alone composes no builder. The sidecar mounts nothing of the environment (no
+  # /work at any path), so the streamed context is the only thing a build can read.
+  # Stock upstream kaniko on its tracking tag: a third-party image like any other, not pinned per
+  # stage and not built here. This block carries no raw container dict, so the sidecar's
+  # `imagePullPolicy: Always` is set in controller code (_image_builder_sidecar), not here; limit
+  # only, no request (D124), and image builds are memory-heavy (layer snapshotting).
+  # `executorFlags` is the trailing argv the controller hands the daemon's command line, which it
+  # prepends to every build — chart-side precisely so a flag change is a chart change and never a
+  # worker release; --insecure-registry=registry:5000 is this homelab's registry policy. All three
+  # keys are REQUIRED: the controller config is extra=forbid, and an absent executorFlags refuses
+  # startup rather than composing a builder that cannot reach the registry (an empty list is legal
+  # and means no flags). This block and the controller image that understands it must deploy
+  # together (coupled config+chart, D085-style).
+  kaniko:
+    image: registry.gitlab.com/gitlab-ci-utils/container-images/kaniko:debug
+    resources:
+      limits: { memory: 4Gi }
+    executorFlags:
+      - --insecure
+      - --insecure-registry=registry:5000
+      - --skip-tls-verify
+      - --cleanup
+      - --snapshot-mode=redo
+      - --use-new-run
+      - --compressed-caching=false
+  # Admission gate: a per-node cap on the number of environments — count, NOT memory, because
+  # every composed container books a memory request of 0 (D124), leaving the scheduler nothing
+  # to bound them by. Keyed by node name; the controller resolves which node an env lands on
+  # from the zpool placement labels read off node metadata. A node with no entry here is
+  # refused admission (D140), so add an entry per node you run env pods on.
+  nodes:
+    srvk8s4:
+      maxEnvironments: 5
+  # When a repo has no .kubecoder/config.yaml, the controller drops a default one in (launch
+  # in the repo dir, this trust level + the default profile) so any whitelisted repo onboards
+  # without a hand-authored manifest. `github` is the trust grant for those auto-onboarded
+  # envs (none|rw) — set to none if rw-by-default is too permissive.
+  defaultManifest:
+    github: rw
+
+service:
+  # Optional nginx-fronted exposure of the controller REST API (per-stage; off unless set).
+  # serverName drives nginx routing + DNS; dnsName is the separate dns.webathome.org hostname.
+  controller:
+    type: ClusterIP
+    dnsName:
+    serverName:
+    isPublic: false
+  # The MCP adapter's intranet Service, which its in-cluster consumer dials; never nginx-fronted.
+  mcp:
+    type: ClusterIP
+  # A second Service onto the same pod, internet-reachable (per-stage; renders only once
+  # serverName is set). It cannot be an annotation on `mcp` above: nginx.webathome.org/is-public
+  # is one flag per Service.
+  mcpPublic:
+    type: ClusterIP
+    dnsName:
+    serverName:
+    isPublic: false
+
+storage:
+  zfs:
+    # k8s capacity accounting only; the ZFS dataset quota (infrastructure.tf) is the
+    # real bound. The PVC pre-binds the TF-owned PV by volumeName.
+    size: 80Gi
+
+# Per-container resources, keyed <deployment>.<container>. Filled per-stage by
+# `poetry run recommend-resources`; null = no resources block rendered.
+resources:
+  kubecoder-controller:
+    kubecoder-controller:
+    ingress:
+    manual:
+    tunnel-reclaim:
+  kubecoder-bot:
+    kubecoder-bot:
+  kubecoder-mcp:
+    kubecoder-mcp:
+
+# ESO wiring (homelab-shared.externalsecrets helper). Leaves are defined per-stage in
+# config/<stage>/values.yaml. The controller has NO OpenBao
+# identity of its own (D031) — ESO materialises these into namespace Secrets.
+# A leaf that also carries `clientName: <name>` is a surface-① client credential:
+# controller-deployment.yaml renders it as KUBECODER_CLIENT_TOKEN_<NAME>, so that one
+# entry declares both the leaf and the controller's registration of the client.
+externalSecrets:
+  refreshInterval: 1h
+  storeRef:
+    name: openbao-prd
+    kind: ClusterSecretStore
+  secrets: {}
+
+global:
+  environment: # the stage (dev/prd) — set by each config/<stage>/values.yaml
