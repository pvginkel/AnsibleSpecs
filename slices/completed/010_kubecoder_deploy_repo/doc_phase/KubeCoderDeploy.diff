index 0000000..9921d1c
--- /dev/null
+++ b/terraform/providers.tf
@@ -0,0 +1,33 @@
+# Applied only by the Argo CD PreSync hook (/work/ArgoCDTools/presync), from its own clone. It
+# fills the empty http backend at init, exports its environment (TF_VAR_*, HOMELAB_*,
+# GITHUB_TOKEN, KUBE_CONFIG_PATH) and passes config/<stage>/*.tfvars at apply.
+
+terraform {
+  required_providers {
+    github = {
+      source = "integrations/github"
+    }
+    homelab = {
+      source = "pvginkel/homelab"
+    }
+    kubernetes = {
+      source = "hashicorp/kubernetes"
+    }
+  }
+
+  backend "http" {}
+}
+
+# zfs_pools is a provider attribute with no environment fallback; every other homelab setting is
+# read from HOMELAB_*.
+provider "homelab" {
+  zfs_pools = var.zfs_pools
+}
+
+# Follows KUBE_CONFIG_PATH, a kubeconfig the hook mints from its own ServiceAccount.
+provider "kubernetes" {}
+
+# Authenticates with GITHUB_TOKEN.
+provider "github" {
+  owner = "pvginkel"
+}
diff --git a/terraform/storage.tf b/terraform/storage.tf
new file mode 100644
index 0000000..0d46bfb
--- /dev/null
+++ b/terraform/storage.tf
@@ -0,0 +1,63 @@
+# KubeCoder's env-storage share on zpool5. The PV's node affinity is the placement anchor:
+# mounting the PVC (chart/templates/zfs-pvc.yaml) pins the controller to the pool's node, and the
+# controller stamps the same node onto env pods. The share also holds the single shared env home
+# at <share>/system/home.
+#
+# The dataset is managed through the iac-provisioner agent on the pool's node, so an apply needs
+# that agent up.
+
+locals {
+  zfs_pool = "zpool5"
+}
+
+resource "homelab_zfs_dataset" "env_storage" {
+  pool  = local.zfs_pool
+  name  = var.zfs_dataset
+  quota = var.zfs_quota
+
+  lifecycle {
+    prevent_destroy = true
+  }
+}
+
+resource "kubernetes_persistent_volume_v1" "env_storage" {
+  metadata {
+    name = "${var.namespace}-zfs-pv"
+  }
+
+  spec {
+    access_modes                     = ["ReadWriteOnce"]
+    persistent_volume_reclaim_policy = "Retain"
+    storage_class_name               = ""
+    volume_mode                      = "Filesystem"
+
+    capacity = {
+      storage = var.zfs_size
+    }
+
+    # The chart's PVC, which names this PV as its volumeName.
+    claim_ref {
+      name      = "${var.namespace}-zfs-pvc"
+      namespace = var.namespace
+    }
+
+    persistent_volume_source {
+      local {
+        path = homelab_zfs_dataset.env_storage.mountpoint_resolved
+      }
+    }
+
+    # A local volume exists only on the node carrying its pool.
+    node_affinity {
+      required {
+        node_selector_term {
+          match_expressions {
+            key      = "kubernetes.io/hostname"
+            operator = "In"
+            values   = [var.zfs_pools[local.zfs_pool]]
+          }
+        }
+      }
+    }
+  }
+}
