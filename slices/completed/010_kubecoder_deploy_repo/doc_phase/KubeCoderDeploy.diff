+++ b/config/dev/values.yaml
@@ -0,0 +1,146 @@
+global:
+  # Carries the stage. The chart names the node ClusterRole, its binding's namespace and the ZFS
+  # claim from it, and nothing but this file sets it.
+  environment: dev
+
+service:
+  controller:
+    serverName: kubecoder-dev.home
+
+images:
+  controller: :dev-latest
+  bot: :dev-latest
+  mcp: :dev-latest
+  ingress: :dev-latest
+  manual: :dev-latest
+
+controller:
+  # Both stages run on the same MicroK8s cluster, whose API-server CA certificate carries no
+  # keyUsage extension — the X.509 verification in the controller's runtime rejects it. The API
+  # server is reached over the trusted pod network and the ServiceAccount token authenticates
+  # the client.
+  verifyApiCertificate: false
+
+# Authorised Telegram chat ids (R5/Q013) → KUBECODER_ALLOWED_CHAT_IDS (CSV). DM-only;
+# the bot ignores everyone else. Same operator chat as prd; the dev instance has its
+# own bot identity (the bot-token leaf below).
+bot:
+  allowedChatIds: ["8524367576"]
+
+# Controller-owned config (D058).
+controllerConfig:
+  # Must agree with service.controller.serverName above — the controller mints its
+  # tunnel/logs links under this origin.
+  externalBaseUrl: https://kubecoder-dev.home
+  # Headlamp deep link to the env pod's dev-container logs (Headlamp ≥0.42 ?view=logs
+  # deep-link; the pod name IS the env id, in the release namespace).
+  headlampLogsUrl: "http://headlamp/c/main/pods/kubecoder-dev/{env_id}?view=logs&container=dev"
+  images:
+    worker: registry:5000/kubecoder-worker:dev-latest
+    vsix: registry:5000/kubecoder-vsix:dev-latest
+  storage:
+    # Node path of this stage's ZFS dataset — must stay in sync with the stage-derived
+    # "kubecoder-${var.stage}" dataset name in ../_shared/infrastructure.tf.
+    zfsHostPath: /zpool5/kubecoder-dev
+  # prd + dev share srvk8s4; the env-count caps split the node between them (D124).
+  nodes:
+    srvk8s4:
+      maxEnvironments: 2
+  # The in-pod SSH transport (slice 170): deployment-wide, no per-env override — every env pod
+  # this controller composes gets an unprivileged sshd and port 22 on its LoadBalancer Service.
+  # Declared per stage rather than in the chart default, because `controllerConfig` is
+  # extra=forbid and a controller image that predates this key refuses to start on it (D191):
+  # dev leads, prd's own overlay follows its promotion.
+  # authorizedKeys is the operator's workstation key; it is read once at env start, so a change
+  # here reaches a running env only on its next roll. An ENABLED sshd with no authorizedKeys, or
+  # a stepCa block without KUBECODER_STEP_CA_PROVISIONER_PASSWORD (the step-ca-provisioner-password
+  # leaf below) or without a KUBECODER_STEP_CA_ROOT naming a CA root certificate the controller can
+  # read (both are env vars the controller Deployment sets), REFUSES controller startup.
+  sshd:
+    enabled: true
+    authorizedKeys:
+      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMOB2beR+Af+8CLWnyOdoQTa3SK/THTr00PwqykISP5W pvginkel
+    # Signs each env's SSH host key. One provisioner serves both stages; it is used for SSH HOST
+    # certificates only. Omitting this block would leave sshd on a bare host key (client TOFU).
+    stepCa:
+      caUrl: https://ca.home
+      provisioner: kubecoder-jwk
+
+# ESO leaves materialised into kubecoder-dev namespace Secrets (no controller OpenBao
+# identity — D031). The chart default for this map is empty and helm merges exactly one
+# stage overlay, so EVERY leaf must be declared here — an absent leaf renders no
+# ExternalSecret. OpenBao KV paths under eso/prd/kubecoder/dev/* (samba-users excepted,
+# see below). targetNames are namespace-local, so they match prd's; isolation is by
+# namespace. The `secret-catalog` Secret is what the controller projects into env pods
+# by secretKeyRef.
+externalSecrets:
+  secrets:
+    bot-token:
+      targetName: kubecoder-bot-token
+      data:
+        - {secretKey: token, path: eso/prd/kubecoder/dev/bot-token, property: token}
+    # Surface-① client credentials, one leaf per client: `clientName` is what makes the
+    # controller render KUBECODER_CLIENT_TOKEN_<NAME> for it, so removing an entry here
+    # revokes that client and reaches no other client's secret.
+    client-token-bot:
+      clientName: bot
+      targetName: kubecoder-client-token-bot
+      data:
+        - {secretKey: token, path: eso/prd/kubecoder/dev/client-token-bot, property: token}
+    client-token-mcp:
+      clientName: mcp
+      targetName: kubecoder-client-token-mcp
+      data:
+        - {secretKey: token, path: eso/prd/kubecoder/dev/client-token-mcp, property: token}
+    # The MCP adapter's north-leg inbound bearer (D151) — enforced on every /mcp request
+    # (KUBECODER_MCP_AUTH_TOKEN).
+    mcp-auth-token:
+      targetName: kubecoder-mcp-auth-token
+      data:
+        - {secretKey: token, path: eso/prd/kubecoder/dev/mcp-auth-token, property: token}
+    github-token:
+      targetName: kubecoder-github-token
+      data:
+        - {secretKey: token, path: eso/prd/kubecoder/dev/github-token, property: token}
+    # Password of step-ca's kubecoder-jwk provisioner (slice 165) →
+    # KUBECODER_STEP_CA_PROVISIONER_PASSWORD on the controller. One provisioner serves both
+    # stages, so this leaf and its prd twin hold the SAME value.
+    step-ca-provisioner-password:
+      targetName: kubecoder-step-ca-provisioner-password
+      data:
+        - {secretKey: password, path: eso/prd/kubecoder/dev/step-ca-provisioner-password, property: password}
+    secret-catalog:
+      targetName: kubecoder-secret-catalog
+      path: eso/prd/kubecoder/dev/catalog
+    # Samba /work sidecar credential (slice 069) — deliberately NOT dev-pathed: the
+    # shared/samba/users#pvginkel credential is stage-independent (scantopdf/media read
+    # the same leaf) and has no dev twin. The leaf must still be declared here or the
+    # kubecoder-samba-credential Secret never renders — every env pod's samba sidecar
+    # envFroms that Secret.
+    samba-users:
+      targetName: kubecoder-samba-credential
+      data:
+        - {secretKey: PASSWORD_pvginkel, path: shared/samba/users, property: pvginkel}
+
+resources:
+  kubecoder-controller:
+    tunnel-reclaim:
+      requests:
+        memory: 40Mi
+    ingress:
+      requests:
+        memory: 8Mi
+    manual:
+      requests:
+        memory: 7Mi
+    kubecoder-controller:
+      requests:
+        memory: 112Mi
+  kubecoder-bot:
+    kubecoder-bot:
+      requests:
+        memory: 64Mi
+  kubecoder-mcp:
+    kubecoder-mcp:
+      requests:
+        memory: 56Mi
