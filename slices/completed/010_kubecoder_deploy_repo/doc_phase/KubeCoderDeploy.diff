@@ -0,0 +1,66 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: kubecoder-bot
+spec:
+  replicas: {{ .Values.bot.replicas }}
+  # Recreate (D141): the outgoing pod is fully terminated before the replacement starts.
+  # Telegram grants a single getUpdates lock per bot token, so an overlapping replacement
+  # would race the outgoing pod for it and both would take Conflict errors.
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: kubecoder-bot
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: kubecoder-bot
+    spec:
+      # The bot is unpinned (D039) — no placement constraint, no toleration, no RBAC.
+      # No kubelet service-link env injection (D105): the bot talks to the controller over
+      # REST via DNS, never the Docker-link <SVC>_SERVICE_HOST/_PORT vars.
+      enableServiceLinks: false
+      containers:
+        - name: kubecoder-bot
+          image: registry:5000/kubecoder-bot{{ .Values.images.bot }}
+          imagePullPolicy: Always
+          ports:
+            - containerPort: 8080
+          env:
+            # The controller REST API (surface ①) the bot drives; in-namespace Service DNS.
+            - name: KUBECODER_CONTROLLER_URL
+              value: http://kubecoder-controller:8080
+            # The operator manual, served by the controller pod's own `manual` sidecar under
+            # the controller's external origin — hence derived from externalBaseUrl rather than
+            # declared a second time. The bot renders no manual pointer when this is unset.
+            - name: KUBECODER_MANUAL_URL
+              value: {{ printf "%s/help/" (trimSuffix "/" .Values.controllerConfig.externalBaseUrl) | quote }}
+            # Allow-listed Telegram chat ids (R5/Q013); CSV. Empty ⇒ the bot answers nobody.
+            - name: KUBECODER_ALLOWED_CHAT_IDS
+              value: {{ .Values.bot.allowedChatIds | join "," | quote }}
+            # Secret-backed tokens (ESO-materialised; never in code/config — R5/D031).
+            - name: KUBECODER_BOT_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: kubecoder-bot-token
+                  key: token
+            # South leg: this client's own surface-① credential, which the controller
+            # resolves to the named client `bot` (ESO leaf kubecoder-client-token-bot).
+            - name: KUBECODER_CLIENT_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: kubecoder-client-token-bot
+                  key: token
+          readinessProbe:
+            httpGet:
+              path: /readyz
+              port: 8080
+          livenessProbe:
+            httpGet:
+              path: /healthz
+              port: 8080
+{{- if (index .Values.resources "kubecoder-bot" "kubecoder-bot") }}
+          resources:
+            {{- toYaml (index .Values.resources "kubecoder-bot" "kubecoder-bot") | nindent 12 }}
+{{- end }}
