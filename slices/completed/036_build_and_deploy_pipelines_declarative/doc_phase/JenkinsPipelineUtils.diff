+    private static Map<String, Object> fieldnotesWith(String key, Object value) {
+        Map<String, Object> call = fieldnotes();
+        call.put(key, value);
+        return call;
+    }
+
+    private static Map<String, Object> fieldnotesWithout(String key) {
+        Map<String, Object> call = fieldnotes();
+        call.remove(key);
+        return call;
+    }
