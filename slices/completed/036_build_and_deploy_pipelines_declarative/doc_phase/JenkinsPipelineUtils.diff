+/**
+ * The step the Test stage of a ModernAppTemplate app's build calls. `test` runs the app's test
+ * suite in a Kubernetes Job, on a copy of the workspace, beside the services the suite needs. It
+ * runs kubectl in the `k8s` container, which the pod declares with `podYaml(templates: ['k8s'])`.
+ * It is a call on the var's method, so a declarative stage runs it in `script {}`:
+ *
+ *     stage('Test') {
+ *         steps {
+ *             script {
+ *                 modernApp.test(
+ *                     job: 'dhcp-app-validation',
+ *                     install: 'poetry install --no-interaction --without dev',
+ *                     run: 'poetry run',
+ *                     suites: ['backend', 'frontend'],
+ *                     services: [],
+ *                     env: [:],
+ *                     secrets: [],
+ *                 )
+ *             }
+ *         }
+ *     }
+ *
+ * Every argument is required, with no default; services, env and secrets may be empty. A missing,
+ * empty or unknown argument fails the build, and the error names it.
+ */
+
+/**
+ * Streams the workspace into a Job that runs podYaml's `modern-app-toolchain` image, installs the
+ * app there with `install` and runs `<run> run-suite`. Once the suite is done, copies its JUnit
+ * files out, summarises them per suite into validation-summary.log, archives the logs and the
+ * JUnit files, publishes the JUnit report and sets the build description. Fails the build on a
+ * missing or non-zero exit code. Deletes the Job whatever happened.
+ *
+ * @param job       The Job's name, to which the build number is appended, and its
+ *                  app.kubernetes.io/name label.
+ * @param install   The command that installs the app's dependencies at the root of the tree.
+ * @param run       The command run-suite runs under: `poetry run`, `uv run --no-sync`.
+ * @param suites    The suites the summary counts, by run-suite's JUnit file stems.
+ * @param services  The containers beside the suite: maps with name, image and any of env and
+ *                  resources.
+ * @param env       The suite's environment, name -> value. A secret goes in `secrets`.
+ * @param secrets   Variables of the build's environment the suite gets under the same name, such
+ *                  as the ones `withVault` sets.
+ */
+def test(Map args) {
+    Map<String, Object> given = testArguments(args)
+    String image = podYaml.sidecars()['modern-app-toolchain'].image
+    String build = currentBuild.number.toString()
+    String job = "${given.job}-${build}"
+
+    container('k8s') {
+        String namespace = kubectl.currentNamespace()
+        sh 'tar czf /tmp/context.tar.gz --exclude=.git --exclude=node_modules --exclude=.venv --exclude=test-results --exclude=.pnpm-store .'
+
+        try {
+            writeYaml file: 'validation-job.yaml', data: jobManifest(given, job, namespace, build, image), overwrite: true
+            if (given.secrets) {
+                withEnv(["VALIDATION_SECRETS=${given.secrets.join(' ')}"]) {
+                    sh secretsScript()
+                }
+            } else {
+                sh 'kubectl apply -f validation-job.yaml'
+            }
+
+            String pod = kubectl.getJobPodName(job, namespace)
+            kubectl.waitForContainer(pod, 'validation', namespace)
+            sh "kubectl cp -n ${namespace} -c validation /tmp/context.tar.gz ${pod}:/work/staging/context.tar.gz"
+            sh "kubectl exec -n ${namespace} -c validation ${pod} -- touch /work/staging/ready"
+
+            // The suite's container outlives the suite (sleep infinity), so the results are
+            // copied out of it once the exit code is written.
+            kubectl.waitForFile(pod, 'validation', namespace, '/work/results/exit-code')
+            kubectl.savePodLogs(pod, 'validation', namespace, 'validation-raw.log')
+            utils.cleanLog('validation-raw.log', 'validation.log')
+            sh 'mkdir -p test-results'
+            sh "kubectl cp -n ${namespace} -c validation ${pod}:/work/results/. test-results/"
+
+            String exitCode = fileExists('test-results/exit-code') ? readFile('test-results/exit-code').trim() : ''
+            Map<String, Object> result = summary(readFile('validation.log'), given.suites)
+            writeFile file: 'validation-summary.log', text: result.text
+            sh 'rm -f validation-raw.log /tmp/context.tar.gz test-results/exit-code'
+
+            archiveArtifacts artifacts: 'validation*.log, test-results/*.xml', allowEmptyArchive: true
+            junit testResults: 'test-results/*.xml', allowEmptyResults: true
+            currentBuild.description = "exit=${exitCode ?: 'n/a'}, ${result.passed} passed, ${result.failed} failed, ${result.skipped} skipped"
+
+            if (!exitCode) {
+                String reason = kubectl.getJobFailReason(job, namespace)
+                error("Validation failed: no exit code recorded${reason ? " (job: ${reason})" : ''}")
+            } else if (exitCode != '0') {
+                error("Validation failed: exit code ${exitCode}")
+            }
+        } finally {
+            kubectl.deleteJob(job, namespace)
+        }
+    }
+}
+
+/**
+ * The Job `test` applies, named `job`. Its `validation` container runs the toolchain image as
+ * uid 1000, which cannot create /work at the filesystem root, so the pod mounts an emptyDir there.
+ */
+@NonCPS
+Map<String, Object> jobManifest(Map<String, Object> given, String job, String namespace, String build, String image) {
+    Map<String, Object> suite = [
+        name: 'validation',
+        image: image,
+        imagePullPolicy: 'Always',
+        securityContext: [runAsUser: 1000, runAsGroup: 1000],
+        volumeMounts: [[name: 'work', mountPath: '/work']],
+        command: ['sh', '-c'],
+        args: [suiteScript(given)],
+        resources: [requests: [cpu: '1', memory: '3584Mi']],
+    ]
+    if (given.env) {
+        suite.env = envList(given.env)
+    }
+
+    return [
+        apiVersion: 'batch/v1',
+        kind: 'Job',
+        metadata: [
+            name: job,
+            namespace: namespace,
+            labels: [
+                'app.kubernetes.io/name': given.job,
+                'app.kubernetes.io/managed-by': 'jenkins',
+                'jenkins/build-number': build,
+            ],
+        ],
+        spec: [
+            backoffLimit: 0,
+            activeDeadlineSeconds: 3600,
+            ttlSecondsAfterFinished: 3600,
+            template: [
+                metadata: [labels: ['job-name': job]],
+                spec: [
+                    restartPolicy: 'Never',
+                    tolerations: [[key: 'size', operator: 'Equal', value: 'large', effect: 'PreferNoSchedule']],
+                    volumes: [[name: 'work', emptyDir: [:]]],
+                    containers: [suite] + given.services,
+                ],
+            ],
+        ],
+    ]
+}
+
+/**
+ * The shell that applies the Job with each variable `VALIDATION_SECRETS` names added to the
+ * `validation` container's environment. A value goes from the shell's environment into kubectl's
+ * arguments, so it never enters a Groovy string or a step's arguments (SEC-4). kubectl takes an
+ * argument's value whole; its `-e -` reader cuts a value at `#` and splits it at a line break. The
+ * sh step's -x would trace the value into the log. The `.` keeps $(…) from stripping the value's
+ * trailing newlines, and `%?.` drops it with printenv's own.
+ */
+@NonCPS
+String secretsScript() {
+    return '''
+        set +x
+        set -euo pipefail
+        set --
+        for name in $VALIDATION_SECRETS; do
+            value=$(printenv "$name" && echo .) || {
+                echo "modernApp.test: $name is not set in the build's environment" >&2
+                exit 1
+            }
+            set -- "$@" "$name=${value%?.}"
+        done
+        kubectl set env --local -f validation-job.yaml -c validation -o yaml "$@" | kubectl apply -f -
+    '''
+}
+
+/**
+ * What the `validation` container runs: it waits for `test` to copy the tree in, installs and runs
+ * the suite, writes run-suite's exit code beside the JUnit files, and stays alive so that `test`
+ * can copy them out.
+ */
+@NonCPS
+String suiteScript(Map<String, Object> given) {
+    return [
+        'mkdir -p /work/staging /work/results',
+        'echo "Waiting for code upload..."',
+        'while [ ! -f /work/staging/ready ]; do sleep 1; done',
+        'echo "Code received, extracting..."',
+        'tar xzf /work/staging/context.tar.gz -C /work',
+        'rm -rf /work/staging',
+        "cd /work && ${given.install}",
+        "${given.run} run-suite --output-mode full --junitxml-dir /work/results --retries 2",
+        'echo $? > /work/results/exit-code',
+        'sleep infinity',
+    ].join('\n') + '\n'
+}
+
+/**
+ * The summary of the suite's log as `text`, a line per suite and a total, and the totals as
+ * `passed`, `failed` and `skipped`. run-suite logs `===SUITE_RESULT:<stem>:<passed>:<failed>:<skipped>===`
+ * for each JUnit file it writes; a suite counts each marker whose stem is its name or starts with
+ * `<name>-`.
+ */
+@NonCPS
+Map<String, Object> summary(String log, List<String> suites) {
+    List<List<String>> results = log.split('\n')
+        .findAll { it.startsWith('===SUITE_RESULT:') }
+        .collect { it.replace('===SUITE_RESULT:', '').replace('===', '').split(':') as List }
+
+    List<String> lines = []
+    int passed = 0, failed = 0, skipped = 0
+    suites.each { suite ->
+        List<List<String>> counted = results.findAll { it[0] == suite || it[0].startsWith("${suite}-") }
+        if (counted) {
+            int p = 0, f = 0, s = 0
+            counted.each { counts ->
+                p += counts[1] as int
+                f += counts[2] as int
+                s += counts[3] as int
+            }
+            passed += p
+            failed += f
+            skipped += s
+            lines << String.format('  %-12s %3d passed  %3d failed  %3d skipped', suite, p, f, s)
+        } else {
+            lines << String.format('  %-12s status unknown (no test results produced)', suite)
+        }
+    }
+
+    String rule = '============================================'
+    String text = (['', rule, '  TEST SUMMARY', rule] + lines + [
+        '--------------------------------------------',
+        String.format('  %-12s %3d passed  %3d failed  %3d skipped', 'TOTAL', passed, failed, skipped),
+        rule,
+    ]).join('\n') + '\n'
+    return [text: text, passed: passed, failed: failed, skipped: skipped]
+}
+
+/**
+ * `args` with every key a String and every value in the form `jobManifest` renders, once it holds
+ * each argument, `job`, `install`, `run` and `suites` non-empty, and nothing else.
+ */
+@NonCPS
+Map<String, Object> testArguments(Map args) {
+    Map<String, Object> given = [:]
+    args.each { key, value -> given[key.toString()] = value }
+
+    List<String> names = ['job', 'install', 'run', 'suites', 'services', 'env', 'secrets']
+    def unknown = given.keySet() - names
+    if (unknown) {
+        throw new IllegalArgumentException(
+            "modernApp.test: takes ${names[0..-2].join(', ')} and ${names[-1]}; got ${unknown.join(', ')}")
+    }
+    names.each { name ->
+        if (!given.containsKey(name) || (name in ['job', 'install', 'run', 'suites'] && !given[name])) {
+            throw new IllegalArgumentException("modernApp.test: ${name} is required")
+        }
+    }
+
+    if (!(given.suites instanceof List)) {
+        throw new IllegalArgumentException("modernApp.test: suites takes a list of suite names; got '${given.suites}'")
+    }
+    if (!(given.services instanceof List)) {
+        throw new IllegalArgumentException("modernApp.test: services takes a list of containers; got '${given.services}'")
+    }
+    if (!(given.env instanceof Map)) {
+        throw new IllegalArgumentException("modernApp.test: env takes a map of name -> value; got '${given.env}'")
+    }
+    if (!(given.secrets instanceof List)) {
+        throw new IllegalArgumentException("modernApp.test: secrets takes a list of variable names; got '${given.secrets}'")
+    }
+
+    List<String> secrets = given.secrets.collect { it.toString() }
+    secrets.each { name ->
+        if (!(name ==~ /[A-Za-z_][A-Za-z0-9_]*/)) {
+            throw new IllegalArgumentException("modernApp.test: secrets takes variable names; got '${name}'")
+        }
+    }
+
+    return [
+        job: given.job.toString(),
+        install: given.install.toString(),
+        run: given.run.toString(),
+        suites: given.suites.collect { it.toString() },
+        services: given.services.collect { service(it) },
+        env: environment('env', given.env),
+        secrets: secrets,
+    ]
+}
+
+/**
+ * A `services` entry as a container: `name` and `image`, then `env` and `resources` when given.
+ */
+@NonCPS
+Map<String, Object> service(entry) {
+    if (!(entry instanceof Map)) {
+        throw new IllegalArgumentException("modernApp.test: a services entry is a map with name and image; got '${entry}'")
+    }
+    Map<String, Object> given = [:]
+    entry.each { key, value -> given[key.toString()] = value }
+
+    def unknown = given.keySet() - ['name', 'image', 'env', 'resources']
+    if (unknown) {
+        throw new IllegalArgumentException(
+            "modernApp.test: a services entry takes name, image, env and resources; got ${unknown.join(', ')}")
+    }
+    if (!given.name || !given.image) {
+        throw new IllegalArgumentException("modernApp.test: a services entry is a map with name and image; got '${entry}'")
+    }
+
+    String name = given.name.toString()
+    Map<String, Object> container = [name: name, image: given.image.toString()]
+    if (given.env) {
+        container.env = envList(environment("the service '${name}'", given.env))
+    }
+    if (given.resources) {
+        Map<String, Map<String, String>> resources = [:]
+        given.resources.each { kind, quantities ->
+            if (!(kind.toString() in ['requests', 'limits'])) {
+                throw new IllegalArgumentException(
+                    "modernApp.test: resources takes requests and limits; the service '${name}' has '${kind}'")
+            }
+            Map<String, String> byResource = [:]
+            quantities.each { resource, quantity -> byResource[resource.toString()] = quantity.toString() }
+            resources[kind.toString()] = byResource
+        }
+        container.resources = resources
+    }
+    return container
+}
+
+/**
+ * An environment map with every name and value a String; `owner` names it in the error for a null
+ * value.
+ */
+@NonCPS
+Map<String, String> environment(String owner, Map variables) {
+    Map<String, String> env = [:]
+    variables.each { variable, value ->
+        if (value == null) {
+            throw new IllegalArgumentException("modernApp.test: ${owner} sets ${variable} to null")
+        }
+        env[variable.toString()] = value.toString()
+    }
+    return env
+}
+
+@NonCPS
+List<Map<String, String>> envList(Map<String, String> env) {
+    return env.collect { variable, value -> [name: variable, value: value] }
+}
