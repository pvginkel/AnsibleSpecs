+package org.webathome.jenkinspipelineutils;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import groovy.lang.GroovyClassLoader;
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.Arguments;
+import org.junit.jupiter.params.provider.MethodSource;
+
+/**
+ * Where espFirmware's steps run and what build runs there: buildStep is the directory and the
+ * command build runs in the idf container, uploadDirectory the directory upload runs the repo's
+ * upload script in. Both are {@code @NonCPS}, so the CPS transform leaves their bodies to run as
+ * plain Groovy here.
+ */
+class EspFirmwareTest {
+
+    private static GroovyClassLoader loader;
+    private static Object espFirmware;
+    private static Method buildStep;
+    private static Method uploadDirectory;
+
+    @BeforeAll
+    static void loadEspFirmware() throws Exception {
+        loader = LibraryCompileTest.trustedLoader();
+        Class<?> type = loader.loadClass("espFirmware");
+        espFirmware = type.getDeclaredConstructor().newInstance();
+        buildStep = type.getMethod("buildStep", Map.class);
+        uploadDirectory = type.getMethod("uploadDirectory", Map.class);
+    }
+
+    @AfterAll
+    static void closeLoader() throws Exception {
+        loader.close();
+    }
+
+    private static Object invoke(Method step, Map<String, Object> args) throws Exception {
+        try {
+            return step.invoke(espFirmware, args);
+        } catch (InvocationTargetException e) {
+            if (e.getCause() instanceof IllegalArgumentException refused) {
+                throw refused;
+            }
+            throw e;
+        }
+    }
+
+    /** Keys and values alternate; the map keeps their order, as a Groovy map literal does. */
+    private static Map<String, Object> ordered(Object... pairs) {
+        Map<String, Object> map = new LinkedHashMap<>();
+        for (int i = 0; i < pairs.length; i += 2) {
+            map.put((String) pairs[i], pairs[i + 1]);
+        }
+        return map;
+    }
+
+    @Test
+    void buildRunsIdfPyBuildInTheRepoDirectory() throws Exception {
+        assertEquals(
+                Map.of("dir", "PaperClock", "command", "/opt/esp/entrypoint.sh idf.py build"),
+                invoke(buildStep, Map.of("dir", "PaperClock")));
+    }
+
+    @Test
+    void buildPassesTheHardwareVersionToIdfPy() throws Exception {
+        assertEquals(
+                Map.of("dir", "Intercom", "command", "/opt/esp/entrypoint.sh idf.py -DHARDWARE_VERSION=2 build"),
+                invoke(buildStep, ordered("dir", "Intercom", "hardwareVersion", 2)));
+    }
+
+    @Test
+    void uploadRunsInTheRepoDirectory() throws Exception {
+        assertEquals("ThermostatProxy", invoke(uploadDirectory, Map.of("dir", "ThermostatProxy")));
+    }
+
+    static Stream<Arguments> refusals() {
+        return Stream.of(
+                Arguments.of(
+                        buildStep, Map.of(),
+                        "espFirmware.build: dir is required"),
+                Arguments.of(
+                        buildStep, Map.of("dir", ""),
+                        "espFirmware.build: dir is required"),
+                Arguments.of(
+                        buildStep, ordered("dir", "PaperClock", "idfVersion", "v5.5.3"),
+                        "espFirmware.build: takes dir and hardwareVersion; got idfVersion"),
+                Arguments.of(
+                        buildStep, ordered("dir", "Intercom", "hardwareVersion", "v2"),
+                        "espFirmware.build: hardwareVersion is a number; got 'v2'"),
+                Arguments.of(
+                        buildStep, ordered("dir", "Intercom", "hardwareVersion", null),
+                        "espFirmware.build: hardwareVersion is a number; got 'null'"),
+                Arguments.of(
+                        uploadDirectory, Map.of(),
+                        "espFirmware.upload: dir is required"),
+                Arguments.of(
+                        uploadDirectory, ordered("dir", "Intercom", "hardwareVersion", 1),
+                        "espFirmware.upload: takes dir; got hardwareVersion"));
+    }
+
+    @ParameterizedTest(name = "{2}")
+    @MethodSource("refusals")
+    void aCallWithAMissingEmptyOrUnknownArgumentFailsNamingIt(Method step, Map<String, Object> args, String message) {
+        IllegalArgumentException refused = assertThrows(IllegalArgumentException.class, () -> invoke(step, args));
+        assertEquals(message, refused.getMessage());
+    }
+}
