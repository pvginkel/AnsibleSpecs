@@ -0,0 +1,107 @@
+/**
+ * The steps an ESP-IDF firmware file's stages call. `build` builds the firmware and `upload`
+ * uploads it to the devices over the air, through IoTSupport. Both run in the `idf` container,
+ * which the pod declares as a named `images:` entry with the file's own ESP-IDF image:
+ * `podYaml(images: [[image: 'espressif/idf:v5.5.3', name: 'idf']])`. Each is a call on the var's
+ * method, so a declarative stage runs it in `script {}`:
+ *
+ *     stage('Build firmware') {
+ *         steps {
+ *             script {
+ *                 espFirmware.build(dir: 'PaperClock')
+ *             }
+ *         }
+ *     }
+ *
+ * `dir` is required, with no default; `build` also takes an optional `hardwareVersion`. A missing,
+ * empty or unknown argument fails the build, and the error names it.
+ */
+
+/**
+ * Runs `idf.py build` in the repo's directory, with `-DHARDWARE_VERSION=<n>` when the call gives
+ * a hardware version.
+ *
+ * @param dir              The directory the file's Checkout stage checked the repo out into.
+ * @param hardwareVersion  Optional: the hardware version to build the firmware for.
+ */
+def build(Map args) {
+    Map<String, String> invocation = buildStep(args)
+    dir(invocation.dir) {
+        container('idf') {
+            // The idf image cannot run as the agent's uid, and git refuses a checkout another uid
+            // owns.
+            sh "git config --global --add safe.directory '*'"
+            sh invocation.command
+        }
+    }
+}
+
+/**
+ * Runs the repo's `scripts/upload.sh` against IoTSupport, which hands the firmware the build made
+ * to the devices. The IoTSupport client secret exists only while the upload runs.
+ *
+ * @param dir  The directory the file's Checkout stage checked the repo out into.
+ */
+def upload(Map args) {
+    String directory = uploadDirectory(args)
+    dir(directory) {
+        container('idf') {
+            sh 'chmod +x scripts/upload.sh'
+            withVault([vaultSecrets: [
+                [path: 'kv/jenkins/iotsupport-pipeline-oidc', engineVersion: 2, secretValues: [
+                    [envVar: 'IOTSUPPORT_CLIENT_ID', vaultKey: 'client_id'],
+                    [envVar: 'IOTSUPPORT_CLIENT_SECRET', vaultKey: 'client_secret'],
+                ]],
+            ]]) {
+                sh 'scripts/upload.sh https://iot.ginbov.nl'
+            }
+        }
+    }
+}
+
+/**
+ * The directory `build` runs in and the command it runs there, as `dir` and `command`.
+ */
+@NonCPS
+Map<String, String> buildStep(Map args) {
+    Map<String, Object> given = arguments('build', args, ['dir'], ['hardwareVersion'])
+    String flags = ''
+    if (given.containsKey('hardwareVersion')) {
+        String version = String.valueOf(given.hardwareVersion)
+        if (!(version ==~ /[0-9]+/)) {
+            throw new IllegalArgumentException("espFirmware.build: hardwareVersion is a number; got '${version}'")
+        }
+        flags = "-DHARDWARE_VERSION=${version} "
+    }
+    return [
+        dir: given.dir.toString(),
+        command: "/opt/esp/entrypoint.sh idf.py ${flags}build".toString(),
+    ]
+}
+
+@NonCPS
+String uploadDirectory(Map args) {
+    return arguments('upload', args, ['dir'], []).dir.toString()
+}
+
+/**
+ * `args` with every key a String, once it holds each of `required`, non-empty, and nothing beyond
+ * `required` and `optional`.
+ */
+@NonCPS
+Map<String, Object> arguments(String step, Map args, List<String> required, List<String> optional) {
+    Map<String, Object> given = [:]
+    args.each { key, value -> given[key.toString()] = value }
+
+    List<String> names = required + optional
+    def unknown = given.keySet() - names
+    if (unknown) {
+        throw new IllegalArgumentException("espFirmware.${step}: takes ${names.join(' and ')}; got ${unknown.join(', ')}")
+    }
+    required.each { name ->
+        if (!given[name]) {
+            throw new IllegalArgumentException("espFirmware.${step}: ${name} is required")
+        }
+    }
+    return given
+}
