+    private static String suiteScript(String install, String run) {
+        return SUITE_SCRIPT_START
+                + "cd /work && " + install + "\n"
+                + run + " run-suite --output-mode full --junitxml-dir /work/results --retries 2\n"
+                + "echo $? > /work/results/exit-code\n"
+                + "sleep infinity\n";
+    }
+
+    private static String quoted(String text) {
+        return "\"" + text.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n") + "\"";
+    }
