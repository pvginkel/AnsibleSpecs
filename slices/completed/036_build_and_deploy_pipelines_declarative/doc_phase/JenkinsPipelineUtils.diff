+
+    /** What a run of secretsScript under {@code sh -xe}, as the sh step runs it, left behind. */
+    private record ShellRun(int exit, String trace, List<String> setEnv, String applied) {}
+
+    /**
+     * Runs secretsScript in {@code dir} with {@code environment} added, on a kubectl that records
+     * its arguments and reads its input: {@code set} answers with a manifest, {@code apply} saves
+     * what it read.
+     */
+    private static ShellRun runSecretsScript(Path dir, Map<String, String> environment) throws Exception {
+        Path bin = Files.createDirectories(dir.resolve("bin"));
+        Path kubectl = bin.resolve("kubectl");
+        Files.writeString(kubectl, """
+                #!/bin/sh
+                printf '%s\\0' "$@" > "$1.args"
+                if [ "$1" = set ]; then cat > /dev/null; echo 'kind: Job'; else cat > applied; fi
+                """);
+        assertTrue(kubectl.toFile().setExecutable(true));
+        Files.writeString(dir.resolve("secrets.sh"), (String) invoke(secretsScript));
+
+        ProcessBuilder shell = new ProcessBuilder("sh", "-xe", "secrets.sh")
+                .directory(dir.toFile())
+                .redirectInput(ProcessBuilder.Redirect.from(new java.io.File("/dev/null")))
+                .redirectOutput(ProcessBuilder.Redirect.DISCARD);
+        shell.environment().putAll(environment);
+        shell.environment().put("PATH", bin + ":" + System.getenv("PATH"));
+        Process process = shell.start();
+        String trace = new String(process.getErrorStream().readAllBytes(), StandardCharsets.UTF_8);
+        int exit = process.waitFor();
+
+        Path setEnv = dir.resolve("set.args");
+        Path applied = dir.resolve("applied");
+        return new ShellRun(
+                exit,
+                trace,
+                Files.exists(setEnv) ? List.of(Files.readString(setEnv).split("\0")) : List.of(),
+                Files.exists(applied) ? Files.readString(applied) : null);
+    }
+
