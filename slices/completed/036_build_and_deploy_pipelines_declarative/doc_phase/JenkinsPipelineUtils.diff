+                "VALIDATION_SECRETS", "KEYCLOAK_ADMIN_CLIENT_ID KEYCLOAK_ADMIN_CLIENT_SECRET",
+                "KEYCLOAK_ADMIN_CLIENT_ID", "-iot#support",
+                "KEYCLOAK_ADMIN_CLIENT_SECRET", clientSecret));
+
+        assertEquals(0, run.exit(), run.trace());
+        assertEquals(
+                List.of("set", "env", "--local", "-f", "validation-job.yaml", "-c", "validation", "-o", "yaml",
+                        "KEYCLOAK_ADMIN_CLIENT_ID=-iot#support",
+                        "KEYCLOAK_ADMIN_CLIENT_SECRET=" + clientSecret),
+                run.setEnv());
+        assertEquals("kind: Job\n", run.applied());
+        assertFalse(run.trace().contains("iot#support"), run.trace());
+        assertFalse(run.trace().contains("ab#cd"), run.trace());
+    }
