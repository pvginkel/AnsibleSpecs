+                Arguments.of(
+                        fieldnotesWith("services", List.of(Map.of("image", "rustfs/rustfs:latest"))),
+                        "modernApp.test: a services entry is a map with name and image; got '[image:rustfs/rustfs:latest]'"),
+                Arguments.of(
